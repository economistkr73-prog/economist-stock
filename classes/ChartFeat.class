    /**
     * 화면 등록부.
     *   pref  차트틀(지표 세트) 기억 키 = chart_pref 의 축 행 접두어. 두 화면이 나눠 쓸 수 있다
     *   style 차트 스타일 갤러리의 구성 번호
     *   data  이 화면이 실제로 들고 있는 데이터 (여기 없는 의존성은 켤 수 없다)
     *   lock  화면 성립 조건이라 끌 수 없는 기능
     *   on/off 카탈로그 기본값을 화면 사정에 맞게 뒤집는 것
     */
    public const SCREENS = [
        'fund' => [
            'label' => '재무분석 종목상세', 'pref' => 'fund', 'style' => 1,
            'url' => '/stock/index.php?mode=fund',
            'data' => [], 'lock' => ['overlay.sue_markers'], 'on' => [], 'off' => [],
            'note' => '실적과 주가를 견주는 자리 — 공시 마커가 이 화면의 뼈대라 잠금',
        ],
        'position' => [
            'label' => '보유종목 → 종목 상세', 'pref' => 'position', 'style' => 2,
