    /** 도구모음이 아예 없는 차트 — 설정 대상이 아니지만 지도에서 빠지면 「빠뜨린 것」이 된다 */
    public const BARELESS = [
        ['갤러리 2~5번 미리보기', 'chart_gallery.php', '상단 바 하나가 4개를 함께 조종'],
        ['어닝 사례분석 (mode=earncase)', 'stock/index.php', '사례마다 작은 차트 — 박스+공시 마커 고정'],
        ['퀀트 패턴분석 (mode=pattern)', 'stock/index.php', '사례마다 작은 차트 — 신호박스 고정'],
        ['단타 분봉 2종 (mode=short)', 'stock/index.php', '화면 자체의 기간 바(1·3·5·10일)가 조종'],
    ];

    public static function screen(string $key): ?array
    {
        return self::SCREENS[$key] ?? null;
    }

    /** 그 화면에서 이 기능을 켤 수 있나 (데이터 의존성) */
    public static function available(string $screen, string $feat): bool
    {
        $s = self::SCREENS[$screen] ?? null;
        $f = self::FEATURES[$feat] ?? null;
        if (!$s || !$f) return false;
        return $f['dep'] === null || in_array($f['dep'], $s['data'], true);
    }

    /** 잠금 = 끌 수 없음. 공통 핵심 전부 + 화면이 지정한 lock */
    public static function locked(string $screen, string $feat): bool
    {
        $s = self::SCREENS[$screen] ?? null;
        $f = self::FEATURES[$feat] ?? null;
        if (!$s || !$f) return false;
        return $f['g'] === 'core' || in_array($feat, $s['lock'], true);
    }

    /** 카탈로그 기본값 (사용자 저장분을 얹기 전) → {feature_key: 0|1} */
    public static function defaults(string $screen): array
    {
        $s = self::SCREENS[$screen] ?? null;
        if (!$s) return [];
        $out = [];
        foreach (self::FEATURES as $k => $f) {
            $v = $f['def'];
            if (in_array($k, $s['on'], true))  $v = 1;
            if (in_array($k, $s['off'], true)) $v = 0;
            if (!self::available($screen, $k)) $v = 0;          // 데이터가 없으면 켤 수 없다
            if (self::locked($screen, $k))     $v = 1;
            $out[$k] = (int)$v;
        }
        return $out;
    }

    /**
     * 카탈로그 기본값 + 저장된 차분 → 최종 구성.
     * $over 는 {feature_key: 0|1}. 잠금·데이터 없음은 저장값이 있어도 무시한다.
     */
    public static function merge(string $screen, $over): array
    {
        $out = self::defaults($screen);
        if (is_string($over)) $over = json_decode($over, true);
        if (is_array($over)) {
            foreach ($over as $k => $v) {
                if (!isset($out[$k])) continue;
                if (self::locked($screen, $k) || !self::available($screen, $k)) continue;
                $out[$k] = $v ? 1 : 0;
            }
        }
        return $out;
    }

    /** 저장할 차분만 남긴다 — 기본값과 같은 항목은 버린다(카탈로그를 고치면 따라오게) */
    public static function diff(string $screen, array $vals): array
    {
        $def = self::defaults($screen);
        $out = [];
        foreach ($vals as $k => $v) {
            if (!isset($def[$k])) continue;
            if (self::locked($screen, $k) || !self::available($screen, $k)) continue;
            $v = $v ? 1 : 0;
            if ($v !== $def[$k]) $out[$k] = $v;
        }
        return $out;
    }

    /**
     * 화면이 쓸 최종 구성 — 페이지 렌더의 유일한 진입점.
     * 표·컬럼이 아직 없어도(이행 전) 카탈로그 기본값으로 살아난다 — 설정 하나 때문에 화면이
     * 죽으면 안 된다. 가벼운 단일 SELECT 라 ChartIndicator(ensureTable) 를 부르지 않는다.
     */
    private static array $cache = [];

    public static function vals(string $screen, ?PDO $pdo = null): array
    {
        if (isset(self::$cache[$screen])) return self::$cache[$screen];
        // 화면 함수들이 $pdo 를 늘 인자로 받지는 않는다 (폼·스크립트 조각) — 전역을 폴백으로
        if (!$pdo instanceof PDO) $pdo = $GLOBALS['pdo'] ?? null;
        $over = null;
        if ($pdo instanceof PDO) {
            try {
                $st = $pdo->prepare("SELECT features_json FROM chart_pref WHERE chart_key=?");
                $st->execute([$screen]);
                $over = $st->fetchColumn() ?: null;
            } catch (Throwable $e) {
                $over = null;
            }
        }
        return self::$cache[$screen] = self::merge($screen, $over);
    }

    /** 그 구성을 JS 로 넘기는 한 줄 — style/dailychart.js 의 DailyChart.feats() 가 읽는다 */
    public static function script(array $vals): string
    {
        return '<script>var DC_FEATS=' . json_encode($vals, JSON_UNESCAPED_UNICODE) . ';</script>';
    }

    /**
     * 화면이 차트를 그리기 «전에» 심는 한 줄 — 기능 구성 + 화면 식별자 + 화면이 기억한 보기 값.
     *   DC_SCREEN 이 있어야 모듈이 「이 높이는 어느 화면 것인지」를 안다
     *   (차트틀 키 opts.key 와 다르다 — 보유종목 상세와 종목추가 사다리는 차트틀만 공유한다).
     *   DC_VIEW 를 «서버가» 심는 이유: 높이를 나중에 받아 오면 화면이 한 번 튄다.
     */
    public static function boot(string $screen, ?PDO $pdo = null): string
    {
        if (!$pdo instanceof PDO) $pdo = $GLOBALS['pdo'] ?? null;
        $view = [];
        if ($pdo instanceof PDO) {
            try {
                $st = $pdo->prepare("SELECT view_json FROM chart_pref WHERE chart_key=?");
                $st->execute([$screen]);
                $d = json_decode((string)$st->fetchColumn(), true);
                if (is_array($d)) $view = $d;
            } catch (Throwable $e) {
                $view = [];          // 컬럼이 아직 없어도 화면은 페이지 기본 높이로 뜬다
            }
        }
        return '<script>var DC_SCREEN=' . json_encode($screen)
             . ';var DC_VIEW=' . json_encode($view ?: new stdClass(), JSON_UNESCAPED_UNICODE)
             . ';var DC_FEATS=' . json_encode(self::vals($screen, $pdo), JSON_UNESCAPED_UNICODE)
             . ';</script>';
    }

    /** 화면에 심을 카탈로그 (JS 가 체크리스트·미리보기를 그리는 데 쓴다) */
    public static function catalog(): array
    {
        return [
            'groups'   => self::GROUPS,
            'data'     => self::DATA,
            'features' => self::FEATURES,
            'screens'  => self::SCREENS,
            'bareless' => self::BARELESS,
        ];
    }
}
?>
