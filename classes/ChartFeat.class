<?php
/**
 * ChartFeat.class — 차트 「기능 구성」 카탈로그 (원본)
 *
 * 차트에는 축이 둘 있다.
 *   스타일 = 어떻게 그리나 (색·마커 모양·라이트/다크)  → chart_gallery.php 의 구성 5종
 *   기능   = 무엇을 보여주고 조작하게 하나 (도구모음 버튼·마커 레이어·보조 차트)  → 이 파일
 * 두 축은 독립이다 — 같은 스타일을 쓰는 두 화면이 서로 다른 기능 구성을 가질 수 있다
 * (②포트폴리오형을 함께 쓰는 「보유종목 상세」와 「종목추가 사다리」가 실제로 그렇다).
 *
 * ★이 파일이 유일한 원본이다. 화면·JS 어디에도 기능 목록을 다시 적지 않는다
 *   (Thr.class 와 같은 결 — 손으로 옮겨 적으면 원본을 고칠 때 사본이 조용히 거짓이 된다).
 *   기능을 하나 늘리려면 FEATURES 에 한 줄, 화면에 열어 주려면 SCREENS 에 한 글자.
 *
 * 저장: chart_pref.features_json — 카탈로그 기본값과의 <b>차분</b>만 담는다(null = 전부 기본값).
 *       행 키는 축 접미사 없는 화면키(`fund`·`position`…). 축별 「마지막 쓴 차트」 행
 *       (`fund_day`·`fund_week`)과 같은 표를 쓰되 서로 부딪히지 않는다 — ChartIndicator 참조.
 */
class ChartFeat
{
    /** 묶음 — 화면에서 이 순서로 보인다 */
    public const GROUPS = [
        'core'   => ['label' => '공통 핵심', 'desc' => '항상 표시 — 끌 수 없습니다'],
        'common' => ['label' => '공통 선택', 'desc' => '화면마다 켜고 끕니다'],
        'module' => ['label' => '이동 가능 모듈', 'desc' => '데이터가 있는 화면에서만 켜집니다'],
    ];

    /** 데이터 의존성 — 화면이 이 데이터를 갖고 있어야 그 기능을 켤 수 있다 */
    public const DATA = [
        'position' => '보유 포지션(누적단가·자동매도가)',
        'fills'    => '체결 이력',
        'realfills' => '실계좌 체결(pf_trade)',
        'intraday' => '당일 시세',
        'minute'   => '분봉',
        'daily'    => '일봉',
        /* ★단타 전용 의존성. 「분봉이 있느냐」(minute)와 다르다 — 다른 화면의 분봉은
         *   «클릭할 때 받아 버리는 당일치»고, 여기 있는 것은 «쌓아 둔 10거래일 원장»이다.
         *   이 이름이 없으면 단타 기능(보조 패널·swap·자동갱신)이 다른 화면의 설정에
         *   «켜도 아무 일 없는 스위치»로 새 나간다. */
        'dtmin'    => '단타 분봉 원장(dt_min · 10거래일)',
        'surge'    => '최고 거래대금 박스(krx_surge)',
    ];

    /**
     * 기능 카탈로그.
