<?php

class Stock_Analysis_Repository {

private $pdo;
private $stmtGetStockInfo = null; // 🚀 쿼리 캐싱 준비

	public function __construct($pdo) {
        $this->pdo = $pdo;
    }



// 1. [AJAX 검색] 키워드로 종목 찾기
public function searchStocks(string $keyword): array {
        // 💡 파라미터 이름을 :kw_like1, :kw_like2 로 각각 다르게 분리했습니다.
        $sql = "SELECT stock_code, stock_name 
                FROM all_stock_info 
                WHERE stock_code LIKE :kw_like1 OR stock_name LIKE :kw_like2 
                ORDER BY CASE WHEN stock_name = :kw_exact THEN 1 ELSE 2 END, stock_name ASC 
                LIMIT 12";
        
        $stmt = $this->pdo->prepare($sql);
        
        // 바인딩 배열도 3개로 맞춰줍니다.
        $stmt->execute([
            'kw_like1'  => '%' . $keyword . '%',
            'kw_like2'  => '%' . $keyword . '%',
            'kw_exact'  => $keyword
        ]);
        
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    // 2. [업로드] 특정 종목코드의 기존 데이터 모두 삭제
    public function deleteDataByStockCode(string $stockCode): int {
        $sql = "DELETE FROM analysis_stock WHERE stock_code = ?";
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([$stockCode]);
        
        return $stmt->rowCount(); // 삭제된 행 개수 반환
    }

    // 3. [업로드] 엑셀 대량 INSERT를 위한 Prepared Statement 반환
    // (메모리 최적화를 위해 쿼리문 자체를 밖으로 넘겨주어 while문 안에서 바인딩만 하도록 합니다)
    public function getInsertStatement() {
        $sql = "INSERT INTO analysis_stock 
                (trade_date, stock_code, open_price, high_price, low_price, close_price, trade_vol, trade_vol_cap) 
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
                
        return $this->pdo->prepare($sql);
    }



// 4. [대시보드] 하단 요약 정보 가져오기 (🚀 쿼리 최적화 + 최신 등록순 정렬 적용)
    public function getSummaryData(): array {
        $sql = "
            SELECT 
                sub.stock_code,
                IFNULL(s.stock_name, '알 수 없음') AS stock_name,
                sub.data_count,
                sub.start_date,
                sub.end_date
            FROM (
                SELECT 
                    stock_code,
                    COUNT(*) AS data_count,
                    MIN(trade_date) AS start_date,
                    MAX(trade_date) AS end_date,
                    MAX(create_at) AS latest_create_at -- 💡 각 종목별 가장 최근 등록/수정 시간 추출
                FROM analysis_stock
                GROUP BY stock_code
            ) sub
            LEFT JOIN all_stock_info s ON sub.stock_code = s.stock_code
            -- 💡 최신순이므로 DESC 사용 (시간이 같으면 이름순 정렬)
            ORDER BY sub.latest_create_at DESC, s.stock_name ASC
        ";
        
        $stmt = $this->pdo->query($sql);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
    // 끝: getSummaryData 함수


// [Repository] 차트를 그리기 위한 일자별 시계열 데이터 추출
    public function getChartData(array $stockCodes, string $s_date = '', string $e_date = ''): array {
        if (empty($stockCodes)) return [];

        $results = [];
        // 종목 순서를 유지하기 위해 루프 사용
        foreach ($stockCodes as $code) {
            // 날짜 조건이 있으면 쿼리에 추가
            $whereDate = "";
            $params = ['code' => $code];
            
            if (!empty($s_date)) {
                $whereDate .= " AND trade_date >= :s_date";
                $params['s_date'] = $s_date;
            }
            if (!empty($e_date)) {
                $whereDate .= " AND trade_date <= :e_date";
                $params['e_date'] = $e_date;
            }

            $sql = "
                SELECT trade_date, close_price 
                FROM analysis_stock 
                WHERE stock_code = :code 
                $whereDate
                ORDER BY trade_date ASC
            ";
            
            $stmt = $this->pdo->prepare($sql);
            $stmt->execute($params);
            $data = $stmt->fetchAll(PDO::FETCH_ASSOC);

            // 데이터가 없으면 건너뜀
            if (empty($data)) continue;

            $firstPrice = $data[0]['close_price'];
            $seriesData = [];
            
            foreach ($data as $row) {
                // ApexCharts 시간축에 맞추기 위해 밀리초 변환
                $timestamp = strtotime($row['trade_date']) * 1000; 
                // 상대 수익률 계산
                $relativeValue = ($firstPrice > 0) ? round(($row['close_price'] / $firstPrice) * 100, 2) : 0;
                $seriesData[] = [$timestamp, $relativeValue, (float)$row['close_price']];
            }

            // 💡 [완성] all_stock_info 테이블에서 종목명을 정확히 가져옵니다!
            $stmtName = $this->pdo->prepare("SELECT stock_name FROM all_stock_info WHERE stock_code = ? LIMIT 1");
            $stmtName->execute([$code]);
            $stockName = $stmtName->fetchColumn();

            $results[] = [
                'name' => $stockName ? $stockName : $code, // 이름이 없으면 코드로 대체
                'data' => $seriesData
            ];
        }

        return $results;
    }
#################################################################





// 6. [대시보드] 선택된 종목들의 교집합 기간 수익률 조회
    public function getPerformanceData(?array $stockCodes, string $start_date = '', string $end_date = ''): array {


        if (empty($stockCodes)) {
            return ['period' => ['calc_start' => date('Y-m-d'), 'calc_end' => date('Y-m-d')], 'data' => []];
        }

        $placeholders = implode(',', array_fill(0, count($stockCodes), '?'));
	
        // 💡 1. 시작일 또는 종료일 중 하나라도 비어있을 때만 DB에서 공통 기간을 조회합니다.
        if (empty($start_date) || empty($end_date)) {
            $periodSql = "
                SELECT MAX(min_d) as calc_start, MIN(max_d) as calc_end 
                FROM (
                    SELECT MIN(trade_date) as min_d, MAX(trade_date) as max_d 
                    FROM analysis_stock 
                    WHERE stock_code IN ($placeholders) 
                    GROUP BY stock_code
                ) as sub
            ";
            $stmt = $this->pdo->prepare($periodSql);
            $stmt->execute($stockCodes);
            $period = $stmt->fetch(PDO::FETCH_ASSOC);
            

            // 💡 핵심 수정: 파라미터로 넘어온 값이 있으면 그 값을 유지하고, 빈 값일 때만 DB 조회값을 채워줍니다.
            $start_date = !empty($start_date) ? $start_date : ($period['calc_start'] ?? date('Y-m-d'));
            $end_date = !empty($end_date) ? $end_date : ($period['calc_end'] ?? date('Y-m-d'));
        }



        // 2. 해당 기간 수익률 계산
        $sql = "
            SELECT stock_code, 
            (SELECT close_price FROM analysis_stock WHERE stock_code = a.stock_code AND trade_date >= ? ORDER BY trade_date ASC LIMIT 1) as start_p,
            (SELECT close_price FROM analysis_stock WHERE stock_code = a.stock_code AND trade_date <= ? ORDER BY trade_date DESC LIMIT 1) as end_p
            FROM analysis_stock a 
            WHERE stock_code IN ($placeholders) 
            GROUP BY stock_code
        ";
        
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute(array_merge([$start_date, $end_date], $stockCodes));
        $data = $stmt->fetchAll(PDO::FETCH_ASSOC);

        $results = ['period' => ['calc_start' => $start_date, 'calc_end' => $end_date], 'data' => []];
        foreach ($data as $row) {
            $yield = ($row['start_p'] > 0) ? (($row['end_p'] - $row['start_p']) / $row['start_p']) * 100 : 0;
            $results['data'][$row['stock_code']] = round($yield, 2);
        }
        
        return $results;
    }
#################################################################

########################################################### 
// 💡 대시보드용 조건 검색 리스트 가져오기 (초고속 튜닝 & 정렬 완벽 적용)
########################################################### 
public function getConditionDashboardList($limit = 100) {
    // 🚀 최적화: 무거운 서브쿼리를 제거하고 ash(요약 테이블)를 조인하여 etf_count를 즉시 가져옵니다.
    $query = "
        SELECT 
            c.stock_code,
            c.analysis_type, 
            s.stock_name, 
            c.stock_rate, 
            c.market_cap AS base_cap, 
            c.market_cap_t1, 
            c.market_cap_t2, 
            c.market_cap_t3,
            c.ref_date,
            c.hit_count,
            c.last_hit_date,
            
            -- 💡 서브쿼리 대신 요약 테이블의 값을 바로 사용 (없으면 0)
            IFNULL(ash.etf_count, 0) AS etf_count
            
        FROM all_condition_analysis c
        JOIN all_stock_info s ON c.stock_code = s.stock_code
        
        -- 🚀 요약 테이블 조인 (ETF 편입 갯수)
        LEFT JOIN all_stock_holdings_info ash ON c.stock_code = ash.stock_code
        
        -- 🚀 메타 테이블 조인 (정렬 순서 추출용)
        LEFT JOIN condition_type_meta m ON c.analysis_type = m.type_code

        ORDER BY 
            COALESCE(m.sort_order, 999) ASC, -- [2순위] 지정된 조건 정렬 순서
			c.ref_date DESC,                 -- [1순위] 최신 포착일 기준
            etf_count DESC                   -- [3순위] ETF 편입 갯수 많은 순
            
        LIMIT " . (int)$limit;
        
    $stmt = $this->pdo->query($query);
    return $stmt->fetchAll(PDO::FETCH_ASSOC);
} # 끝: getConditionDashboardList
###########################################################



// 💡 [신규 추가] 조건타입 메타데이터를 정렬 순서대로 가져옵니다.
    public function getConditionTypesMeta() {
        $query = "SELECT * FROM condition_type_meta ORDER BY sort_order ASC";
        $stmt = $this->pdo->query($query);
        
        $meta = [];
        while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
            $meta[$row['type_code']] = $row;
        }
        return $meta; 
        // 결과: ['c1' => [...], 'c2' => [...], ...] 형태의 배열
    }








} # end of class