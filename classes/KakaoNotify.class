<?php
/**
 * KakaoNotify — 카카오톡 "나에게 보내기" 알림 클래스
 *
 * 사용법:
 *   require_once "./env/kakao.inc";
 *   KakaoNotify::send("📈 삼성전자 70,000원 돌파!", "https://너의도메인/etf_stock.php");
 *
 * access_token 은 자동으로 refresh_token 을 이용해 재발급한다.
 */
class KakaoNotify
{
    /** refresh_token 으로 access_token 재발급 */
    private static function refreshAccessToken(): string
    {
        if (!file_exists(KAKAO_TOKEN_FILE)) {
            throw new Exception("토큰 파일이 없습니다. kakao_oauth.php 로 최초 인증을 먼저 진행하세요.");
        }
        $tok = json_decode(file_get_contents(KAKAO_TOKEN_FILE), true);
        if (empty($tok['refresh_token'])) {
            throw new Exception("refresh_token 이 없습니다. 재인증이 필요합니다.");
        }

        $ch = curl_init("https://kauth.kakao.com/oauth/token");
        curl_setopt_array($ch, [
            CURLOPT_POST           => true,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POSTFIELDS     => http_build_query([
                "grant_type"    => "refresh_token",
                "client_id"     => KAKAO_REST_API_KEY,
                "client_secret" => KAKAO_CLIENT_SECRET,
                "refresh_token" => $tok['refresh_token'],
            ]),
        ]);
        $res  = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        $data = json_decode($res, true);
        if ($code !== 200 || empty($data['access_token'])) {
            throw new Exception("access_token 재발급 실패: " . $res);
        }

        // 새 access_token 저장. refresh_token 도 갱신되면 교체
        $tok['access_token'] = $data['access_token'];
        if (!empty($data['refresh_token'])) {
            $tok['refresh_token'] = $data['refresh_token'];
        }
        file_put_contents(KAKAO_TOKEN_FILE, json_encode($tok, JSON_UNESCAPED_UNICODE));

        return $data['access_token'];
    }

    /**
     * 나에게 텍스트 메시지 전송
     * @param string $text 메시지 (최대 200자 권장)
     * @param string $link 클릭 시 이동할 URL (선택)
     * @return bool 성공 여부
     */
    public static function send(string $text, string $link = ''): bool
    {
        $accessToken = self::refreshAccessToken();

        $webUrl = $link !== '' ? $link : 'https://developers.kakao.com';
        $templateObject = [
            "object_type" => "text",
            "text"        => $text,
            "link"        => ["web_url" => $webUrl, "mobile_web_url" => $webUrl],
        ];
        // JSON_UNESCAPED_UNICODE 를 쓰지 않음 → 한글이 \uXXXX 로 안전하게 인코딩되어 깨짐 방지

        $ch = curl_init("https://kapi.kakao.com/v2/api/talk/memo/default/send");
        curl_setopt_array($ch, [
            CURLOPT_POST           => true,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER     => [
                "Authorization: Bearer {$accessToken}",
                "Content-Type: application/x-www-form-urlencoded",
            ],
            CURLOPT_POSTFIELDS     => http_build_query([
                "template_object" => json_encode($templateObject),
            ]),
        ]);
        $res  = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($code !== 200) {
            error_log("KakaoNotify 전송 실패({$code}): " . $res);
            return false;
        }
        return true;
    }
}
?>