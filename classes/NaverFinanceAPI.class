<?php
// 한글 깨짐 방지
//header('Content-Type: text/plain; charset=utf-8');
class NaverFinanceAPI {

    private $pcUserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';
    private $mobileUserAgent = 'Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.0 Mobile/15E148 Safari/604.1';

    private function fetch($url, $headers, $isEuckr = false) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 10);
        curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        $response = curl_exec($ch);
        $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $curl_error = curl_error($ch);
        curl_close($ch);
        if ($response === false) return ["error" => "cURL 에러: " . $curl_error];
        if ($http_code !== 200) return ["error" => "HTTP 에러: " . $http_code];
        if ($isEuckr) $response = mb_convert_encoding($response, 'UTF-8', 'EUC-KR');
        $data = json_decode(trim($response), true);
        if (json_last_error() !== JSON_ERROR_NONE) return ["error" => "JSON 파싱 에러"];
        return ["success" => $data];
    }

    public function getAllNaverEtfs() {
        $timestamp = round(microtime(true) * 1000);
        $url = "https://finance.naver.com/api/sise/etfItemList.nhn?_=" . $timestamp;
        $headers = [
            'User-Agent: ' . $this->pcUserAgent,
            'Referer: https://finance.naver.com/sise/etf.naver',
            'Cache-Control: no-cache',
            'Pragma: no-cache'
        ];
        $result = $this->fetch($url, $headers, true);
        if (isset($result['error'])) return $result;
        if (isset($result['success']['result']['etfItemList'])) {
            return ["success" => $result['success']['result']['etfItemList']];
        }
        return ["error" => "ETF 데이터 구조 변경됨"];
    }

    public function getAllNaverStocks($market = 'KOSPI') {
        $market = strtoupper($market);
        if (!in_array($market, ['KOSPI', 'KOSDAQ'])) return ["error" => "잘못된 시장(Market) 이름입니다."];
        $all_stocks = [];
        $page = 1;
        $pageSize = 100;
        $headers = ['User-Agent: ' . $this->mobileUserAgent, 'Referer: https://m.stock.naver.com/'];
        while (true) {
            $timestamp = round(microtime(true) * 1000);
            $url = "https://m.stock.naver.com/api/stocks/marketValue/{$market}?page={$page}&pageSize={$pageSize}&_={$timestamp}";
            $result = $this->fetch($url, $headers, false);
            if (isset($result['error'])) return $result;
            $data = $result['success'];
            if (empty($data['stocks'])) break;
            $all_stocks = array_merge($all_stocks, $data['stocks']);
            $page++;
            usleep(200000);
        }
        return ["success" => $all_stocks];
    }

    public function getNaverFinanceNews(string $stockCode, int $limit = 10): array {
        $url = "https://finance.naver.com/item/news_news.naver?code=" . $stockCode;
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_REFERER, "https://finance.naver.com/item/news.naver?code=" . $stockCode);
        curl_setopt($ch, CURLOPT_USERAGENT, "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0 Safari/537.36");
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        $html = curl_exec($ch);
        curl_close($ch);
        if (!$html) return [];
        $html = mb_convert_encoding($html, 'UTF-8', 'EUC-KR');
        $html = preg_replace('/<meta[^>]+charset=[\'"]?(euc-kr|EUC-KR)[\'"]?[^>]*>/i', '', $html);
        $html = '<?xml encoding="UTF-8">' . $html;
        libxml_use_internal_errors(true);
        $dom = new DOMDocument();
        @$dom->loadHTML($html, LIBXML_NOERROR | LIBXML_NOWARNING);
        libxml_clear_errors();
        $xpath = new DOMXPath($dom);
        $rows = $xpath->query("//table[contains(@class, 'type5')]//tr");
        $newsList = []; $seenTitles = []; $fetched_count = 0;
        foreach ($rows as $row) {
            if ($fetched_count >= $limit) break;
            $titleNode = $xpath->query(".//td[contains(@class, 'title')]/a", $row)->item(0);
            if (!$titleNode) $titleNode = $xpath->query(".//a[contains(@class, 'tit')]", $row)->item(0);
            $infoNode = $xpath->query(".//td[contains(@class, 'info')]", $row)->item(0);
            $dateNode = $xpath->query(".//td[contains(@class, 'date')]", $row)->item(0);
            if ($titleNode && $dateNode) {
                $title = trim($titleNode->nodeValue);
                if (in_array($title, $seenTitles)) continue;
                $seenTitles[] = $title;
                // ★모바일 대응: 구형 finance.naver.com news_read(?article_id&office_id) 는 모바일에서
                //   기사로 못 열고 목록으로 떨어짐 → 모던 네이버뉴스 URL(n.news.naver.com/article/oid/aid)로 변환
                $nhref = $titleNode->getAttribute('href');
                if (preg_match('/article_id=(\d+)/', $nhref, $aM) && preg_match('/office_id=(\d+)/', $nhref, $oM)) {
                    $nlink = "https://n.news.naver.com/article/{$oM[1]}/{$aM[1]}";
                } else {
                    $nlink = (strpos($nhref, 'http') === 0) ? $nhref : "https://finance.naver.com" . $nhref;
                }
                $newsList[] = [
                    'title' => $title,
                    'link'  => $nlink,
                    'info'  => $infoNode ? trim($infoNode->nodeValue) : '',
                    'date'  => trim($dateNode->nodeValue)
                ];
                $fetched_count++;
            }
        }
        if (empty($newsList)) echo "<h3 style='color:#e1234a;'>[디버깅] 뉴스를 찾지 못했습니다.</h3>";
        return $newsList;
    }

    public function get_market_keywords($news_titles, $limit = 8, array $extra_stopwords = []) {
        if (empty($news_titles)) return [];
        $text = implode(" ", $news_titles);
        $text = preg_replace('/[^\p{Hangul}A-Za-z0-9\s]/u', ' ', $text);
        $words = preg_split('/\s+/', $text, -1, PREG_SPLIT_NO_EMPTY);
        $keyword_counts = [];
        $stopwords = array_flip($extra_stopwords);
        foreach ($words as $word) {
            $word = preg_replace('/(은|는|이|가|을|를|과|와|의|에|에서|로|으로|까지|부터)$/u', '', $word);
            if (mb_strlen($word) >= 2 && !isset($stopwords[$word]) && !preg_match('/^\d+$/', $word)) {
                $keyword_counts[$word] = ($keyword_counts[$word] ?? 0) + 1;
            }
        }
        arsort($keyword_counts);
        return array_slice($keyword_counts, 0, $limit, true);
    }

    function get_analysis_report($pdo) {
        $sql = "SELECT * FROM (
                    SELECT stock_code, stock_name, stock_price, stock_rate, stock_rate_rt, stock_cap, stock_vol_cap
                    FROM all_stock_info ORDER BY stock_cap DESC LIMIT 100
                ) as top_100_stocks WHERE stock_rate >= 2 ORDER BY stock_rate DESC";
        return $pdo->query($sql)->fetchAll(PDO::FETCH_ASSOC);
    }

    function get_expected_rising_etfs($pdo, $rising_stocks, $etf_limit = 10, $min_market_cap = 1000, $min_trading_val = 0) {
        if (empty($rising_stocks)) return [];
        $stock_codes = array_column($rising_stocks, 'stock_code');
        $in_clause   = "'" . implode("','", $stock_codes) . "'";
        $limit_val   = (int)$etf_limit;
        $cap_val     = (int)$min_market_cap;
        $trade_val   = (int)$min_trading_val;
        $sql = "SELECT h.etf_code, i.etf_name, e.etf_rate, e.etf_rate_prev, e.trading_value, e.market_cap,
                    SUM(h.holdings_ratio * s.stock_rate) as expected_impact,
                    GROUP_CONCAT(CONCAT(s.stock_name,'|',s.stock_rate,'|',s.stock_code)
                        ORDER BY (h.holdings_ratio * s.stock_rate) DESC SEPARATOR '||') as raw_contributing_stocks
                FROM all_etf_holdings_info h
                JOIN all_stock_info s ON h.stock_code = s.stock_code
                JOIN all_etf_price e ON h.etf_code = e.etf_code
                JOIN all_etf_info i ON h.etf_code = i.etf_code
                WHERE h.stock_code IN ($in_clause)
                  AND e.market_cap >= {$cap_val} AND e.trading_value >= {$trade_val}
                GROUP BY h.etf_code, i.etf_name, e.etf_rate, e.trading_value, e.market_cap
                ORDER BY expected_impact DESC LIMIT {$limit_val}";
        return $pdo->query($sql)->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * ★★<b>NXT(넥스트레이드) 시간외 시세를 쓰지 않는다</b> (2026-08-06 사용자 결정).
     *
     * 왜 껐나 — `all_stock_info` 는 <b>사이트 전 화면이 읽는 단일 원천</b>인데,
     * 여기에 NXT 값이 들어오면 마감 뒤 <b>목록과 차트가 다른 말을 한다</b>:
     *   목록(NXT 시간외) 231,500  vs  분봉·일봉(정규장) 230,500   ← 실측 2026-08-06 20:49
     * 판단·기록의 기준을 <b>정규장 하나</b>로 두기로 했다. 종가는 15:50 `dart_eod` 가 넣는 값으로 굳는다.
     *
     * 껐을 때 무슨 일이 일어나나 — `stock_news` 크론의 <b>08:05·17:05·19:05</b> fire 는
     * 시세 갱신 단계를 <b>건너뛴다</b>(그 셋이 NXT 창이다). 그 회차의 나머지 일
     * (급등 TOP 9 · 종목 뉴스 · 키워드)은 그대로 돈다 — 정규장 종가 기준으로 도는 편이 오히려 맞다.
     * `data_update_status` 의 `all_data_from_nxt` 키는 더 이상 갱신되지 않는다(그게 사실이다).
     *
     * ★<b>정규 경로로 돌리지 않고 «건너뛴다»</b>. 장 밖에 전종목 목록을 다시 받아 봐야 값이 그대로인데,
     *   그 경로에는 <code>DELETE … NOT IN</code> 이 있어 부분 응답이 오면 종목이 통째로 사라진다.
     *   얻을 것이 없는 위험은 지지 않는다.
     *
     * ★되살리려면 이 상수만 true 로 바꾼다 — `update_stock_price_from_nxt()`·`getAllNxtSise()` 는
     *   지우지 않고 그대로 뒀다.
     */
    const USE_NXT = false;

    public function get_real_time_data_from_naver($pdo) {
        $t = (int)date('H') * 60 + (int)date('i');
        $is_nxt_window = ($t >= 480 && $t < 530) || ($t > 930 && $t <= 1200);
        if ($is_nxt_window) {
            if (!self::USE_NXT) {
                echo "NXT 창(08:00~08:49 · 15:31~20:00) — 시세 갱신을 건너뜁니다 "
                   . "(USE_NXT=false · 정규장 값을 유지).<br>\n";
                return true;   // «실패»가 아니다 — 호출자가 경고를 찍지 않게 true 를 준다
            }
            return $this->update_stock_price_from_nxt($pdo);
        }

        $api = new NaverFinanceAPI();
        echo "데이터 수집을 시작합니다...<br>\n";

        $kospi_res  = $api->getAllNaverStocks('KOSPI');
        $kosdaq_res = $api->getAllNaverStocks('KOSDAQ');
        $etf_res    = $api->getAllNaverEtfs();

        $kospi  = $kospi_res['success']  ?? [];
        $kosdaq = $kosdaq_res['success'] ?? [];
        $etfs   = $etf_res['success']    ?? [];

        /* ★부분 응답 가드 (2026-09-04) — 한 시장이라도 못 받았으면(페이지 하나가 실패하면 그 시장이
         *   통째로 빈다) 아래 «DELETE … NOT IN» 을 건너뛴다. 받은 것만 갱신하고 지우지는 않는다.
         *   지우면 그 시장 전 종목이 이름·현재가를 잃고, 다음 회차까지 화면이 코드만 보인다. */
        $partial = empty($kospi) || empty($kosdaq) || isset($kospi_res['error']) || isset($kosdaq_res['error']);
        if ($partial) {
            echo "⚠️ 전종목 목록이 불완전합니다 (KOSPI " . count($kospi) . " · KOSDAQ " . count($kosdaq)
               . ") — 이번 회차는 삭제 단계를 건너뜁니다.<br>\n";
        }

        $stock_market_data = [];
        $etf_market_data   = [];
        $etf_codes = array_column($etfs, 'itemcode');

        foreach (array_merge($kospi, $kosdaq) as $stock) {
            if (in_array($stock['itemCode'], $etf_codes)) continue;
            if (mb_strpos($stock['stockName'], 'ETN') !== false) continue;
            $trade_val_raw = (float) str_replace(',', '', $stock['accumulatedTradingValue'] ?? 0);
            $stock_market_data[] = [
                ':code'       => $stock['itemCode'],
                ':name'       => $stock['stockName'],
                ':price'      => (int)   str_replace(',', '', $stock['closePrice'] ?? 0),
                ':high_price' => 0,
                ':yrate'      => (int)   str_replace(',', '', $stock['compareToPreviousClosePrice'] ?? 0),
                ':rate'       => (float) $stock['fluctuationsRatio'],
                ':vol'        => (int)   str_replace(',', '', $stock['accumulatedTradingVolume'] ?? 0),
                ':vol_cap'    => round($trade_val_raw / 100, 2),
                ':cap'        => (int)   str_replace(',', '', $stock['marketValue'] ?? 0)
            ];
        }

        foreach ($etfs as $etf) {
            $etf_market_data[] = [
                ':code'          => $etf['itemcode'],
                ':price'         => (int)   $etf['nowVal'],
                ':rate'          => (float) $etf['changeRate'],
                ':trading_value' => (int)   round(((int)($etf['amonut'] ?? 0)) / 100),
                ':market_cap'    => (int)   $etf['marketSum']
            ];
        }

        if (empty($stock_market_data) && empty($etf_market_data)) {
            echo "업데이트할 데이터가 없습니다.<br>\n";
            return false;
        }

        // ★ stock_vol_tot 컬럼 명시 추가 (DEFAULT 없는 컬럼)
        $sql_stock = "INSERT INTO all_stock_info
                      (stock_code, stock_name, stock_price, stock_high_price, stock_yrate, stock_rate, stock_vol, stock_vol_cap, stock_cap, stock_vol_tot)
                      VALUES (:code, :name, :price, :high_price, :yrate, :rate, :vol, :vol_cap, :cap, 0)
                      ON DUPLICATE KEY UPDATE
                      stock_rate_rt = stock_rate,
                      stock_name    = VALUES(stock_name),
                      stock_price   = VALUES(stock_price),
                      stock_yrate   = VALUES(stock_yrate),
                      stock_rate    = VALUES(stock_rate),
                      stock_vol     = VALUES(stock_vol),
                      stock_vol_cap = VALUES(stock_vol_cap),
                      stock_cap     = VALUES(stock_cap)";
        $stmt_stock = $pdo->prepare($sql_stock);

        $sql_etf = "INSERT INTO all_etf_price
                    (etf_code, etf_price, etf_rate, etf_rate_prev, trading_value, market_cap, turnover_ratio, is_locked, uDate)
                    VALUES (:code, :price, :rate, 0, :trading_value, :market_cap, 0, 0, CURDATE())
                    ON DUPLICATE KEY UPDATE
                    etf_rate_prev = etf_rate,
                    etf_price     = VALUES(etf_price),
                    etf_rate      = VALUES(etf_rate),
                    trading_value = VALUES(trading_value),
                    market_cap    = VALUES(market_cap),
                    uDate         = CURDATE()";
        $stmt_etf = $pdo->prepare($sql_etf);

        $success_stock_count = 0; $success_etf_count = 0;
        $deleted_stock_count = 0; $deleted_etf_count = 0;

        $pdo->beginTransaction();
        try {
            foreach ($stock_market_data as $data) { $stmt_stock->execute($data); $success_stock_count++; }
            foreach ($etf_market_data   as $data) { $stmt_etf->execute($data);   $success_etf_count++;   }

            $received_stock_codes = array_column($stock_market_data, ':code');
            /* ★★지켜보는 종목(보유·관심·단타 풀·포트폴리오 종목)은 목록에 없어도 지우지 않는다 (2026-09-04).
             *   네이버 전종목 목록은 상장 종목을 빠뜨린다 — 실측 유니트론텍 142210: 네이버 종목 페이지에선
             *   KOSDAQ·거래중인데 marketValue 목록엔 없다(헝셩그룹 900270 도 같다 · 경방·DL 도 빠진 적 있다).
             *   빠진 종목을 여기서 지우면 ①단타·관심 목록이 이름 대신 코드를 보이고 ②현재가·등락률이 비며
             *   ③장중 실시간 갱신(UPDATE)이 맞힐 행이 없어 헛돈다. 그 종목은 아래 «메우기»가 폴링 API 로 채운다.
             *   판정 단일본은 keepCodes() — 여기에 SQL 을 다시 적지 않는다. */
            $keep = self::keepCodes($pdo);
            if (!empty($received_stock_codes) && !$partial) {
                $protect = array_values(array_unique(array_merge($received_stock_codes, $keep)));
                $ph  = implode(',', array_fill(0, count($protect), '?'));
                $del = $pdo->prepare("DELETE FROM all_stock_info WHERE stock_code NOT IN ($ph)");
                $del->execute($protect);
                $deleted_stock_count = $del->rowCount();
            }

            $received_etf_codes = array_column($etf_market_data, ':code');
            if (!empty($received_etf_codes)) {
                $ph = implode(',', array_fill(0, count($received_etf_codes), '?'));
                $del = $pdo->prepare("DELETE FROM all_etf_price WHERE etf_code NOT IN ($ph)");
                $del->execute($received_etf_codes);
                $deleted_etf_count = $del->rowCount();
            }

            $pdo->commit();
            echo "✅ 주식 {$success_stock_count}개 갱신 ➔ all_stock_info<br>\n";
            echo "✅ ETF {$success_etf_count}개 갱신 ➔ all_etf_price<br>\n";
            echo "🧹 정리 — 주식 {$deleted_stock_count}개, ETF {$deleted_etf_count}개 삭제<br>\n";
            data_upTime('all_data_from_naver', 'update', $pdo);

            /* ★목록 밖 종목 메우기 (2026-09-04) — 지켜보는 종목 중 이번 목록에 없던 것을 폴링 API 로
             *   받아 행을 만든다(refreshQuotes 가 없는 행은 INSERT 한다). 100종목이 1콜이라 회차당 1콜 안팎.
             *   상장폐지된 옛 종목은 폴링이 답을 안 주므로 그대로 비어 있다 — 그건 맞는 상태다. */
            $gap = array_values(array_diff($keep, $received_stock_codes));
            if ($gap) {
                try {
                    $g = $api->refreshQuotes($pdo, $gap, true);
                    echo "🩹 목록 밖 종목 " . count($gap) . "개 메움 (폴링 API) — 받음 "
                       . (int)($g['fetched'] ?? 0) . " · 반영 " . (int)($g['updated'] ?? 0)
                       . " : " . implode(', ', $gap) . "<br>\n";
                } catch (Throwable $e) {
                    echo "⚠️ 목록 밖 종목 메우기 실패: " . $e->getMessage() . "<br>\n";
                }
            }
            return true;

        } catch (Exception $e) {
            $pdo->rollBack();
            echo "❌ DB 갱신 중 오류: " . $e->getMessage() . "<br>\n";
            return false;
        }
    }

    public function update_stock_price_from_nxt($pdo) {
        echo "🌙 NXT 장외 시세 갱신을 시작합니다...<br>\n";
        $nxt_res = $this->getAllNxtSise('ALL');
        if (isset($nxt_res['error'])) { echo "❌ NXT 시세 수집 실패: " . $nxt_res['error'] . "<br>\n"; return false; }
        $stocks = $nxt_res['success'] ?? [];
        if (empty($stocks)) { echo "업데이트할 NXT 데이터가 없습니다.<br>\n"; return false; }

        $sql = "UPDATE all_stock_info SET
                    stock_rate_rt = stock_rate,
                    stock_price   = :price,
                    stock_yrate   = :yrate,
                    stock_rate    = :rate,
                    stock_vol     = :vol,
                    stock_vol_cap = :vol_cap,
                    stock_cap     = :cap
                WHERE stock_code = :code";
        $stmt = $pdo->prepare($sql);
        $updated = 0;
        $pdo->beginTransaction();
        try {
            foreach ($stocks as $s) {
                $code = $s['stock_code'] ?? '';
                if ($code === '') continue;
                $stmt->execute([
                    ':price'   => (int)   $s['price'],
                    ':yrate'   => (int)   $s['change'],
                    ':rate'    => (float) $s['rate'],
                    ':vol'     => (int)   $s['volume'],
                    ':vol_cap' => round(((float)$s['trading_val']) / 100, 2),
                    ':cap'     => (int)   $s['market_cap'],
                    ':code'    => $code,
                ]);
                $updated += $stmt->rowCount();
            }
            $pdo->commit();
            echo "✅ NXT 시세로 주식 {$updated}개 갱신 완료<br>\n";
            data_upTime('all_data_from_naver', 'update', $pdo);
            data_upTime('all_data_from_nxt', 'update', $pdo);
            return true;
        } catch (Exception $e) {
            $pdo->rollBack();
            echo "❌ NXT 갱신 중 오류: " . $e->getMessage() . "<br>\n";
            return false;
        }
    }

    public function discover_new_domestic_etfs($pdo) {
        $res = $this->getAllNaverEtfs();
        if (isset($res['error'])) { echo "❌ 네이버 ETF 수집 실패: " . $res['error'] . "<br>\n"; return false; }
        $etfs = $res['success'] ?? [];
        if (empty($etfs)) { echo "수집된 ETF가 없습니다.<br>\n"; return false; }

        $existing  = array_flip($pdo->query("SELECT etf_code FROM all_etf_info")->fetchAll(PDO::FETCH_COLUMN));
        $class_map = ['1' => '국내 시장지수', '2' => '국내 업종/테마', '3' => '국내 파생'];

        $sql  = "INSERT IGNORE INTO all_etf_info
                     (etf_code, etf_name, Listing_Date, classification, return_rate,
                      underlying_index, total_nav, volatility, holdings_count, skip_update, is_new)
                 VALUES (:code, :name, CURDATE(), :class, 0, '', 0, 0, 0, 0, 'Y')";
        $stmt = $pdo->prepare($sql);

        $inserted = 0; $new_names = [];
        foreach ($etfs as $e) {
            $tab  = (string)($e['etfTabCode'] ?? '');
            if (!isset($class_map[$tab])) continue;
            $code = $e['itemcode'] ?? '';
            $name = trim($e['itemname'] ?? '');
            if ($code === '' || isset($existing[$code])) continue;
            if (mb_strpos($name, 'ETN') !== false) continue;
            $stmt->execute([':code' => $code, ':name' => $name, ':class' => $class_map[$tab]]);
            if ($stmt->rowCount() > 0) { $inserted++; $new_names[] = "{$name}({$code})"; $existing[$code] = true; }
        }

        echo $inserted > 0
            ? "✅ 신규 국내 ETF {$inserted}개 등록: " . implode(', ', $new_names) . "<br>\n"
            : "신규 등록할 국내 ETF가 없습니다.<br>\n";
        return $inserted;
    }

    public function getSectionNews(string $date, bool $fetchAllPages = false, int $limit = 20, ?string $since = null): array {
        $newsList = []; $seenTitles = []; $fetched = 0;
        $maxPage = 1; $page = 1; $stopped = false;

        while ($page <= $maxPage && !$stopped) {
            $url = "https://finance.naver.com/news/news_list.naver?mode=LSS2D&section_id=101&section_id2=258&date={$date}&page={$page}";
            $ch = curl_init();
            curl_setopt_array($ch, [
                CURLOPT_URL => $url, CURLOPT_RETURNTRANSFER => true,
                CURLOPT_REFERER => "https://finance.naver.com/news/news_list.naver",
                CURLOPT_USERAGENT => "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                CURLOPT_SSL_VERIFYPEER => false, CURLOPT_TIMEOUT => 10,
            ]);
            $html = curl_exec($ch); curl_close($ch);
            if (!$html) break;

            $html = mb_convert_encoding($html, 'UTF-8', 'EUC-KR');
            $html = preg_replace('/<meta[^>]+charset=[\'"]?(euc-kr|EUC-KR)[\'"]?[^>]*>/i', '', $html);
            $html = '<?xml encoding="UTF-8">' . $html;
            libxml_use_internal_errors(true);
            $dom = new DOMDocument();
            @$dom->loadHTML($html, LIBXML_NOERROR | LIBXML_NOWARNING);
            libxml_clear_errors();
            $xpath = new DOMXPath($dom);

            if ($page === 1 && $fetchAllPages) {
                $pgRR = $xpath->query("//td[contains(@class,'pgRR')]/a")->item(0);
                if ($pgRR && preg_match('/page=(\d+)/', $pgRR->getAttribute('href'), $m)) $maxPage = (int)$m[1];
            }

            $subjects = $xpath->query("//dt[contains(@class,'articleSubject')]|//dd[contains(@class,'articleSubject')]");
            if ($subjects->length === 0) break;

            foreach ($subjects as $subject) {
                if (!$fetchAllPages && $fetched >= $limit) break 2;
                $aTag = $xpath->query("./a", $subject)->item(0);
                if (!$aTag) continue;
                $title = trim($aTag->nodeValue);
                if (empty($title) || isset($seenTitles[$title])) continue;
                $seenTitles[$title] = true;
                $href = $aTag->getAttribute('href');
                $link = (strpos($href, 'http') === 0) ? $href : "https://finance.naver.com" . $href;
                $summaryNode = $xpath->query("following-sibling::dd[contains(@class,'articleSummary')][1]", $subject)->item(0);
                $press = $date_str = '';
                if ($summaryNode) {
                    $pn = $xpath->query(".//span[contains(@class,'press')]", $summaryNode)->item(0);
                    $dn = $xpath->query(".//span[contains(@class,'wdate')]", $summaryNode)->item(0);
                    $press    = $pn ? trim($pn->nodeValue) : '';
                    $date_str = $dn ? trim($dn->nodeValue) : '';
                }
                if ($since !== null && !empty($date_str) && $date_str < $since) { $stopped = true; break; }
                $newsList[] = ['title' => $title, 'link' => $link, 'press' => $press, 'date' => $date_str];
                $fetched++;
            }
            $page++;
            if ($page <= $maxPage && !$stopped) usleep(300000);
        }
        return $newsList;
    }

    public function getNxtSise(string $stockCode): array {
        $url = "https://m.stock.naver.com/api/stock/{$stockCode}/nxt";
        $headers = [
            'User-Agent: ' . $this->mobileUserAgent,
            'Referer: https://m.stock.naver.com/domestic/stock/' . $stockCode . '/nxt',
            'Accept: application/json, text/plain, */*',
        ];
        $result = $this->fetch($url, $headers, false);
        if (isset($result['error'])) return $result;
        $raw = $result['success'] ?? [];
        return [
            'nxtPrice'       => (int)   ($raw['nxtPrice']       ?? $raw['closePrice']       ?? 0),
            'nxtChangePrice' => (int)   ($raw['nxtChangePrice']  ?? $raw['compareToPreviousClosePrice'] ?? 0),
            'nxtChangeRate'  => (float) ($raw['nxtChangeRate']   ?? $raw['fluctuationsRatio'] ?? 0.0),
            'nxtVolume'      => (int)   ($raw['nxtVolume']       ?? $raw['accumulatedTradingVolume']    ?? 0),
            'marketStatus'   => (string)($raw['marketStatus']    ?? $raw['tradeStopType']               ?? ''),
        ];
    }

    public function getAllNxtSise(string $market = 'ALL'): array {
        $targets = []; $market = strtoupper($market);
        if ($market === 'KOSPI'  || $market === 'ALL') $targets[] = ['sosok' => 0, 'label' => 'KOSPI'];
        if ($market === 'KOSDAQ' || $market === 'ALL') $targets[] = ['sosok' => 1, 'label' => 'KOSDAQ'];
        if (empty($targets)) return ['error' => "market 파라미터는 'KOSPI', 'KOSDAQ', 'ALL' 중 하나여야 합니다."];

        $all_stocks = [];
        foreach ($targets as $target) {
            $sosok = $target['sosok']; $marketName = $target['label']; $max_page = 1;
            for ($page = 1; $page <= $max_page; $page++) {
                $url = "https://finance.naver.com/sise/nxt_sise_market_sum.naver?sosok={$sosok}&page={$page}";
                $ch = curl_init();
                curl_setopt_array($ch, [
                    CURLOPT_URL => $url, CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 10,
                    CURLOPT_SSL_VERIFYPEER => false, CURLOPT_USERAGENT => $this->pcUserAgent,
                    CURLOPT_REFERER => 'https://finance.naver.com/sise/nxt_sise_market_sum.naver',
                    CURLOPT_HTTPHEADER => ['Accept-Language: ko-KR,ko;q=0.9'],
                ]);
                $html = curl_exec($ch); $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE); $curlErr = curl_error($ch); curl_close($ch);
                if (!$html || $httpCode !== 200) return ['error' => "HTTP {$httpCode} / cURL: {$curlErr}"];

                $html = mb_convert_encoding($html, 'UTF-8', 'EUC-KR');
                $html = preg_replace('/<meta[^>]+charset=[\'"]?(euc-kr|EUC-KR)[\'"]?[^>]*>/i', '', $html);
                $html = '<?xml encoding="UTF-8">' . $html;
                libxml_use_internal_errors(true);
                $dom = new DOMDocument();
                @$dom->loadHTML($html, LIBXML_NOERROR | LIBXML_NOWARNING);
                libxml_clear_errors();
                $xpath = new DOMXPath($dom);

                if ($page === 1) {
                    $pgRR = $xpath->query("//td[contains(@class,'pgRR')]/a")->item(0);
                    if ($pgRR && preg_match('/page=(\d+)/', $pgRR->getAttribute('href'), $m)) $max_page = (int)$m[1];
                }

                foreach ($xpath->query("//table[contains(@class,'type_2')]//tr") as $row) {
                    $tds = $xpath->query(".//td", $row);
                    if ($tds->length < 10) continue;
                    $rank = (int) trim($tds->item(0)->nodeValue);
                    if ($rank <= 0) continue;
                    $a_tag = $xpath->query(".//a", $tds->item(1))->item(0);
                    if (!$a_tag) continue;
                    $stock_name = trim($a_tag->nodeValue);
                    preg_match('/code=(\d{6})/', $a_tag->getAttribute('href'), $cm);
                    $stock_code  = $cm[1] ?? '';
                    $price       = (int)   preg_replace('/[^0-9]/',   '', $tds->item(2)->nodeValue);
                    $change_cell = $tds->item(3)->nodeValue;
                    $change_num  = (int)   preg_replace('/[^0-9]/',   '', $change_cell);
                    $change_img  = $xpath->query(".//img", $tds->item(3))->item(0);
                    $change_alt  = $change_img ? $change_img->getAttribute('alt') : '';
                    if (mb_strpos($change_alt, '하락') !== false || mb_strpos($change_cell, '하락') !== false) $change_num = -$change_num;
                    $rate_str    = trim($tds->item(4)->nodeValue);
                    $rate        = (float) preg_replace('/[^0-9.\-]/', '', str_replace('+', '', $rate_str));
                    if (mb_strpos($rate_str, '-') !== false || mb_strpos($rate_str, '하락') !== false) $rate = -abs($rate);
                    $all_stocks[] = [
                        'rank' => $rank, 'stock_code' => $stock_code, 'stock_name' => $stock_name,
                        'price' => $price, 'change' => $change_num, 'rate' => $rate,
                        'volume'      => (int) preg_replace('/[^0-9]/', '', $tds->item(5)->nodeValue),
                        'trading_val' => (int) preg_replace('/[^0-9]/', '', $tds->item(6)->nodeValue),
                        'bid'         => (int) preg_replace('/[^0-9]/', '', $tds->item(7)->nodeValue),
                        'ask'         => (int) preg_replace('/[^0-9]/', '', $tds->item(8)->nodeValue),
                        'market_cap'  => (int) preg_replace('/[^0-9]/', '', $tds->item(9)->nodeValue),
                        'market'      => $marketName,
                    ];
                }
                if ($page < $max_page) usleep(300000);
            }
        }
        if (empty($all_stocks)) return ['error' => '수집된 종목이 없습니다. 네이버 HTML 구조가 변경되었을 수 있습니다.'];
        return ['success' => $all_stocks];
    }

    /**
     * 일봉 OHLC 수집 — 네이버 fchart siseJson (timeframe=day)
     * 반환: ['success'=>[ ['t'=>'YYYY-MM-DD','o','h','l','c','v'], ... ]] | ['error'=>msg]
     * (영업일 100개 확보 위해 달력일 기준 넉넉히 받음; 정렬은 과거→현재 오름차순)
     */
    public function getDailyOhlc(string $stockCode, int $days = 160): array {
        $code = preg_replace('/[^0-9A-Za-z]/', '', $stockCode);
        if ($code === '') return ['error' => '종목코드 누락'];

        $end   = date('Ymd');
        $start = date('Ymd', strtotime("-{$days} days"));
        $url = "https://fchart.stock.naver.com/siseJson.nhn?symbol={$code}"
             . "&requestType=1&startTime={$start}&endTime={$end}&timeframe=day";

        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 10);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_USERAGENT, $this->pcUserAgent);
        curl_setopt($ch, CURLOPT_REFERER, "https://finance.naver.com/item/main.naver?code={$code}");
        $raw  = curl_exec($ch);
        $http = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $err  = curl_error($ch);
        curl_close($ch);

        if ($raw === false) return ['error' => "cURL 에러: {$err}"];
        if ($http !== 200)  return ['error' => "HTTP 에러: {$http}"];

        // siseJson 은 비표준 JSON(헤더행이 작은따옴표) → 따옴표 정규화 후 디코드
        $rows = json_decode(str_replace("'", '"', trim($raw)), true);
        if (!is_array($rows)) return ['error' => 'fchart 파싱 실패'];

        $out = [];
        foreach ($rows as $i => $r) {
            if ($i === 0) continue;                 // 헤더 [날짜,시가,고가,저가,종가,거래량,외국인소진율]
            if (!is_array($r) || !isset($r[0], $r[4])) continue;
            $d = (string) $r[0];                    // YYYYMMDD
            if (strlen($d) !== 8) continue;
            $out[] = [
                't' => substr($d, 0, 4) . '-' . substr($d, 4, 2) . '-' . substr($d, 6, 2),
                'o' => (float) $r[1],
                'h' => (float) $r[2],
                'l' => (float) $r[3],
                'c' => (float) $r[4],
                'v' => (int)   ($r[5] ?? 0),
            ];
        }
        return ['success' => $out];
    }
    /**
     * 기간 지정 일봉 OHLC 수집 — api.finance.naver.com/siseJson.naver
     *
     * getDailyOhlc() 는 "최근 N일"이라 백테스트용 장기 구간에는 모자란다.
     * 이쪽은 시작·종료일을 그대로 넘겨 10년치도 한 번에 받는다 (2,600행 ≈ 160KB).
     *
     * @param string $start YYYYMMDD
     * @param string $end   YYYYMMDD
     * @return array ['success'=>[ ['t'=>'YYYY-MM-DD','o','h','l','c','v'], ... ]] | ['error'=>msg]
     */
    public function getDailyOhlcRange(string $stockCode, string $start, string $end): array {
        $code  = preg_replace('/[^0-9A-Za-z]/', '', $stockCode);
        $start = preg_replace('/[^0-9]/', '', $start);
        $end   = preg_replace('/[^0-9]/', '', $end);
        if ($code === '')                                   return ['error' => '종목코드 누락'];
        if (strlen($start) !== 8 || strlen($end) !== 8)      return ['error' => '기간 형식 오류 (YYYYMMDD)'];
        if ($start > $end)                                   return ['error' => '시작일이 종료일보다 뒤입니다.'];

        $url = "https://api.finance.naver.com/siseJson.naver?symbol={$code}"
             . "&requestType=1&startTime={$start}&endTime={$end}&timeframe=day";

        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 30);            // 10년치는 응답이 크다
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        curl_setopt($ch, CURLOPT_USERAGENT, $this->pcUserAgent);
        curl_setopt($ch, CURLOPT_REFERER, "https://finance.naver.com/item/main.naver?code={$code}");
        $raw  = curl_exec($ch);
        $http = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $err  = curl_error($ch);
        curl_close($ch);

        if ($raw === false) return ['error' => "cURL 에러: {$err}"];
        if ($http !== 200)  return ['error' => "HTTP 에러: {$http}"];

        // 헤더행만 작은따옴표를 쓰는 비표준 JSON → 따옴표를 맞춰 준 뒤 디코드
        $rows = json_decode(str_replace("'", '"', trim($raw)), true);
        if (!is_array($rows)) return ['error' => '네이버 응답 파싱 실패 (형식 변경 가능성)'];

        $out = [];
        foreach ($rows as $i => $r) {
            if ($i === 0) continue;                 // [날짜,시가,고가,저가,종가,거래량,외국인소진율]
            if (!is_array($r) || !isset($r[0], $r[4])) continue;
            $d = (string) $r[0];
            if (strlen($d) !== 8) continue;
            $out[] = [
                't' => substr($d, 0, 4) . '-' . substr($d, 4, 2) . '-' . substr($d, 6, 2),
                'o' => (float) $r[1],
                'h' => (float) $r[2],
                'l' => (float) $r[3],
                'c' => (float) $r[4],
                'v' => (int)   ($r[5] ?? 0),
            ];
        }
        if (!$out) return ['error' => '해당 기간에 시세가 없습니다. 종목코드와 기간을 확인하세요.'];

        usort($out, fn($a, $b) => strcmp($a['t'], $b['t']));
        return ['success' => $out];
    }
    /**
     * 당일 1분봉 OHLC 수집 — 네이버 모바일차트 API (정상 OHLC + 분당 거래량 제공)
     *   api.stock.naver.com/chart/domestic/item/{code}/minute?count=400
     * 반환: ['success'=>[ ['t'=>'YYYY-MM-DD HH:MM','o','h','l','c','v'], ... ]] | ['error'=>msg]
     * count=400 이면 당일 09:00~15:30 전 구간 커버. 가장 최근 거래일(당일)만 오름차순 반환.
     */
    public function getMinuteOhlc(string $stockCode, int $count = 400): array {
        $code = preg_replace('/[^0-9A-Za-z]/', '', $stockCode);
        if ($code === '') return ['error' => '종목코드 누락'];

        $url = "https://api.stock.naver.com/chart/domestic/item/{$code}/minute?count={$count}";
        $headers = ['User-Agent: ' . $this->mobileUserAgent, 'Referer: https://m.stock.naver.com/'];
        $res = $this->fetch($url, $headers);          // 클린 JSON → 기존 fetch() 재사용
        if (isset($res['error'])) return $res;
        $data = $res['success'] ?? [];
        if (!is_array($data) || empty($data)) return ['success' => []];

        // 가장 최근 거래일만 = 당일 (순서 무관하게 max 날짜 기준 필터)
        $maxDay = '';
        foreach ($data as $r) {
            $d = substr((string)($r['localDateTime'] ?? ''), 0, 8);
            if ($d > $maxDay) $maxDay = $d;
        }

        $out = [];
        foreach ($data as $r) {
            $dt = (string)($r['localDateTime'] ?? '');   // YYYYMMDDHHmmss
            if (strlen($dt) < 12) continue;
            if (substr($dt, 0, 8) !== $maxDay) continue; // 당일만
            $out[] = [
                't' => substr($dt,0,4).'-'.substr($dt,4,2).'-'.substr($dt,6,2).' '.substr($dt,8,2).':'.substr($dt,10,2),
                'o' => (float)($r['openPrice']    ?? 0),
                'h' => (float)($r['highPrice']    ?? 0),
                'l' => (float)($r['lowPrice']     ?? 0),
                'c' => (float)($r['currentPrice'] ?? 0),
                'v' => (int)  ($r['accumulatedTradingVolume'] ?? 0),
            ];
        }
        usort($out, static fn($a, $b) => strcmp($a['t'], $b['t'])); // 오름차순 보장
        return ['success' => $out];
    }
    /**
     * 여러 종목의 현재 시세를 <b>한 번에</b> 가져온다 (네이버 실시간 폴링 API).
     *
     * 종목별로 부르지 않아도 되는 것이 이 API 의 값어치다 — 실측(2026-07-29) 5종목이 17~30ms 다.
     * 응답에 네이버가 권장하는 폴링 간격(pollingInterval, 7000ms)도 들어 있다.
     *
     * ★ NXT(시간외) 목록과 무관하게 <b>전 종목</b>을 준다.
     *   getAllNxtSise() 는 604종목뿐이라 나머지 2,154종목은 장 마감 뒤 갱신할 길이 없었다.
     *
     * ★ closePrice 는 이름과 달리 "종가"가 아니라 <b>그 시점 값</b>이다 —
     *   장중이면 현재가, 마감 뒤면 정규장 종가다. marketStatus(OPEN/CLOSE) 로 구분할 수 있다.
     *
     * @param  string[] $codes 6자리 종목코드
     * @return array [ code => ['price'=>int, 'rate'=>float, 'diff'=>int, 'open'=>int, 'high'=>int,
     *                          'low'=>int, 'vol'=>int, 'cap'=>int, 'name'=>string,
     *                          'status'=>'OPEN'|'CLOSE', 'traded_at'=>string] ]
     *                 실패하면 빈 배열 — 부르는 쪽이 기존 값을 그대로 쓰면 된다
     */
    public function getRealtimeQuotes(array $codes): array
    {
        $codes = array_values(array_unique(array_filter(array_map(
            static fn($c) => preg_match('/^\w{6}$/', trim((string)$c)) ? trim((string)$c) : null, $codes))));
        if (!$codes) return [];

        $out = [];
        // 주소 길이가 무한하지 않다. 100개씩 끊어 부른다 (실측 5개 17ms 라 여유가 크다)
        foreach (array_chunk($codes, 100) as $chunk) {
            $url = 'https://polling.finance.naver.com/api/realtime/domestic/stock/' . implode(',', $chunk);
            $ch  = curl_init($url);
            curl_setopt_array($ch, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT        => 10,
                CURLOPT_SSL_VERIFYPEER => false,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_HTTPHEADER     => [
                    'User-Agent: ' . $this->pcUserAgent,
                    'Referer: https://finance.naver.com/',
                    'Accept: application/json',
                ],
            ]);
            $body = curl_exec($ch);
            $http = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            if ($body === false || $http !== 200) continue;

            $j = json_decode((string)$body, true);
            if (!is_array($j)) continue;

            foreach (($j['datas'] ?? []) as $x) {
                $code = (string)($x['itemCode'] ?? '');
                // Raw 계열이 콤마 없는 숫자다. 없으면 콤마를 떼고 쓴다.
                $num = static function ($raw, $fmt) {
                    if ($raw !== null && $raw !== '') return (float)$raw;
                    $v = str_replace(',', '', (string)$fmt);
                    return is_numeric($v) ? (float)$v : 0.0;
                };
                $px = $num($x['closePriceRaw'] ?? null, $x['closePrice'] ?? '');
                if ($code === '' || $px <= 0) continue;

                $out[$code] = [
                    'name'      => (string)($x['stockName'] ?? ''),
                    'price'     => (int)round($px),
                    'diff'      => (int)round($num($x['compareToPreviousClosePriceRaw'] ?? null, $x['compareToPreviousClosePrice'] ?? '')),
                    'rate'      => (float)$num($x['fluctuationsRatioRaw'] ?? null, $x['fluctuationsRatio'] ?? ''),
                    'open'      => (int)round($num($x['openPriceRaw'] ?? null, $x['openPrice'] ?? '')),
                    'high'      => (int)round($num($x['highPriceRaw'] ?? null, $x['highPrice'] ?? '')),
                    'low'       => (int)round($num($x['lowPriceRaw'] ?? null, $x['lowPrice'] ?? '')),
                    'vol'       => (int)round($num($x['accumulatedTradingVolumeRaw'] ?? null, $x['accumulatedTradingVolume'] ?? '')),
                    'val'       => (float)$num($x['accumulatedTradingValueRaw'] ?? null, ''),
                    'cap'       => (float)$num($x['marketValueFullRaw'] ?? null, ''),
                    'status'    => (string)($x['marketStatus'] ?? ''),
                    'traded_at' => (string)($x['localTradedAt'] ?? ''),
                ];
            }
        }
        return $out;
    }

    /** 정규장 마감 시각. 이 뒤로는 update_stock_price_from_nxt() 가 all_stock_info 를 갱신한다. */
    const MARKET_CLOSE = '15:30';

    /** 장중에 이만큼 지난 값이면 새로 받는다(초). */
    const QUOTE_MAX_AGE = 300;

    /**
     * 「이 시각보다 오래된 <code>uDate</code> 는 낡음」 — <b>신선도 판정의 단일본</b>.
     *
     * ★ 이 규칙이 두 군데 있으면 안 되는 이유: 마감 뒤에는 <b>「오늘 15:30 이전」</b> 이라야
     *   NXT 갱신분(uDate 가 15:31 이후)이 저절로 빠져 정규장 종가와 서로를 밀어내지 않는다.
     *   한쪽만 고치면 종가와 장외가가 번갈아 덮어쓰는 상태로 돌아간다.
     *
     * ★ <code>refreshQuotes()</code>(네이버로 받아 온다)와 <code>Dt::refreshQuotesLive()</code>
     *   (키움으로 받아 온다)가 <b>둘 다 이것을 본다</b> — 소스가 달라도 「무엇이 낡았나」는 하나여야
     *   한 화면이 두 값을 말하지 않는다.
     *
     * @param  ?int $maxAge 장중 신선도(초). null 이면 QUOTE_MAX_AGE
     * @return int  유닉스 타임스탬프 — 이 값보다 오래된 uDate 가 「낡음」
     */
    public static function staleCutoff(?int $maxAge = null): int
    {
        $now   = time();
        $close = strtotime(date('Y-m-d') . ' ' . self::MARKET_CLOSE);
        if ($now > $close) return $close;                     // 마감 뒤 — 시각 규칙이 이긴다
        $age = ($maxAge !== null && $maxAge > 0) ? $maxAge : self::QUOTE_MAX_AGE;
        return $now - $age;
    }

    /**
     * all_stock_info 의 <b>낡은 시세만</b> 골라 실시간 값으로 메운다.
     *
     * 왜 필요한가 (실측 2026-07-29):
     *   장 마감 뒤 all_stock_info 를 갱신하는 것은 update_stock_price_from_nxt() 인데
     *   NXT 는 <b>604종목뿐</b>이다(전체 2,758 중 21.9%). 목록에 없는 종목은 UPDATE 문이 아예 걸리지 않아
     *   <b>15:30 종가조차 못 받고</b> 마지막 장중 값에 멈춘다 —
     *   현대차우 175,600(15:05 장중값) vs 실제 종가 179,200 으로 2% 어긋나 있었다.
     *   getRealtimeQuotes() 는 NXT 여부와 무관하게 전 종목을 주므로 그 구멍을 메울 수 있다.
     *
     * ★ NXT 로 갱신된 값은 건드리지 않는다. 시각으로 가른다:
     *     장중    : uDate 가 QUOTE_MAX_AGE 보다 오래된 종목
     *     마감 뒤 : uDate 가 <b>오늘 15:30 이전</b>인 종목
     *   마감 뒤 NXT 갱신분은 uDate 가 15:31 이후라 이 조건에서 저절로 빠진다.
     *   그래서 정규장 종가와 NXT 값이 서로를 밀어내는 일이 없다.
     *
     * ★ 장중 신선도는 <b>호출자가 정할 수 있다</b>($maxAge). 화면마다 필요한 촘촘함이 다르다 —
     *   단타는 차트가 10초로 도는데 목록만 5분이면 <b>같은 종목이 한 화면에서 두 값을 말한다</b>.
     *   기본값(QUOTE_MAX_AGE)은 그대로라 기존 호출자(크론·포트폴리오 계열)는 안 바뀐다.
     *   ★<b>마감 뒤 규칙에는 영향이 없다</b> — 거기서는 늘 「오늘 15:30 이전」이라야 NXT 와 안 부딪힌다.
     *
     * @param  PDO      $pdo
     * @param  string[] $codes 빈 배열이면 all_stock_info 전 종목
     * @param  bool     $force true 면 신선도를 따지지 않고 전부 다시 받는다
     * @param  ?int     $maxAge 장중 신선도(초). null 이면 QUOTE_MAX_AGE. 마감 뒤에는 무시된다
     * @return array [target, stale, fetched, updated]
     */
    /**
     * ★★<b>지켜보는 종목</b> — 네이버 전종목 목록에서 빠져도 <code>all_stock_info</code> 에 남겨야 하고,
     *   빠지면 폴링 API 로 메워야 하는 종목의 단일본 (2026-09-04).
     *   = 포트폴리오 종목(pf_stock · 청산분 포함 — Pf::refreshQuotes 가 그 집합을 갱신하므로 같은 집합이라야
     *     넣고 지우는 왕복이 없다) ∪ 살아있는 포지션(Dt::heldCodes) ∪ 관심종목(pf_watchlist) ∪ 단타 풀(dt_pool).
     *   표가 없어도 죽지 않는다 — 시세 수집이 본업이다.
     *
     * @return string[] 6자리 종목코드
     */
    public static function keepCodes(PDO $pdo): array
    {
        $set = [];
        $add = static function (array $codes) use (&$set) {
            foreach ($codes as $c) {
                $c = trim((string)$c);
                if (preg_match('/^\w{6}$/', $c)) $set[$c] = 1;
            }
        };
        foreach ([
            "SELECT code FROM pf_stock",
            "SELECT stock_code FROM pf_watchlist",
            "SELECT code FROM dt_pool WHERE active = 1",
        ] as $sql) {
            try { $add($pdo->query($sql)->fetchAll(PDO::FETCH_COLUMN)); } catch (Throwable $e) { }
        }
        try { if (class_exists('Dt')) $add((new Dt($pdo))->heldCodes()); } catch (Throwable $e) { }
        return array_keys($set);
    }

    public function refreshQuotes(PDO $pdo, array $codes = [], bool $force = false, ?int $maxAge = null): array
    {
        $codes = array_values(array_unique(array_filter($codes,
            static fn($c) => preg_match('/^\w{6}$/', (string)$c))));

        if ($codes) {
            $ph  = implode(',', array_fill(0, count($codes), '?'));
            $sql = "SELECT stock_code, uDate FROM all_stock_info WHERE stock_code IN ($ph)";
            $st  = $pdo->prepare($sql);
            $st->execute($codes);
        } else {
            $st = $pdo->query("SELECT stock_code, uDate FROM all_stock_info");
        }
        $rows = $st->fetchAll(PDO::FETCH_KEY_PAIR);
        /* ★표에 없는 종목도 대상이다 (2026-09-04) — 네이버 전종목 목록이 빠뜨린 종목(유니트론텍 142210)은
         *   행이 없어서 여기서 영영 「대상 아님」이 됐고, 그래서 이름도 현재가도 못 채웠다.
         *   요청받은 코드 중 행이 없는 것은 «낡음»으로 보고 아래 UPSERT 가 행을 만든다. */
        foreach ($codes as $c) if (!array_key_exists($c, $rows)) $rows[$c] = null;
        if (!$rows) return ['target' => 0, 'stale' => 0, 'fetched' => 0, 'updated' => 0];

        $cutoff = self::staleCutoff($maxAge);

        $stale = [];
        foreach ($rows as $code => $uDate) {
            if ($force || $uDate === null || strtotime((string)$uDate) < $cutoff) $stale[] = (string)$code;
        }
        if (!$stale) return ['target' => count($rows), 'stale' => 0, 'fetched' => 0, 'updated' => 0];

        $q = $this->getRealtimeQuotes($stale);
        if (!$q) return ['target' => count($rows), 'stale' => count($stale), 'fetched' => 0, 'updated' => 0];

        /* 이 API 가 주는 컬럼만 쓴다. eps·per 따위는 주지 않고, 애초에 전 종목 0인 껍데기라 손대지 않는다.
         * stock_cap 단위는 억원이다.
         *
         * ★ uDate 를 <b>명시적으로</b> 찍는다. ON UPDATE CURRENT_TIMESTAMP 에 맡기면
         *   값이 하나도 안 바뀐 행(거래정지 등)은 MySQL 이 UPDATE 자체를 건너뛰어 uDate 가 그대로 남는다.
         *   그러면 그 종목은 <b>매 실행마다 영원히 "낡음"</b> 으로 잡혀 네이버를 다시 두드린다
         *   (실측 — 2,154종목을 받았는데 값이 같은 130종목이 다음 실행에서 또 대상이 됐다).
         *   uDate 는 "값이 바뀐 시각"이 아니라 <b>"마지막으로 확인한 시각"</b> 이어야 신선도 판정이 맞는다. */
        /* ★UPSERT 다 (2026-09-04 · UPDATE 에서 바꿈) — 없는 행은 만든다. 이름은 <b>비어 있을 때만</b> 채우고
         *   (정규 수집이 준 거래소명을 폴링 응답으로 덮지 않는다), 거래대금(억)은 <b>만들 때만</b> 넣는다
         *   (갱신 때 안 건드리는 것은 예전과 같다 — 회전율 배지가 0원을 그리지 않게 첫 값만 준다). */
        $up = $pdo->prepare("
            INSERT INTO all_stock_info
                   (stock_code, stock_name, stock_price, stock_yrate, stock_rate, stock_vol,
                    stock_vol_cap, stock_cap, stock_vol_tot, uDate)
            VALUES (:code, :name, :price, :yrate, :rate, :vol, :amt, :cap, 0, NOW())
            ON DUPLICATE KEY UPDATE
                   stock_name    = IF(stock_name = '', VALUES(stock_name), stock_name),
                   stock_rate_rt = stock_rate,
                   stock_price   = VALUES(stock_price),
                   stock_yrate   = VALUES(stock_yrate),
                   stock_rate    = VALUES(stock_rate),
                   stock_vol     = VALUES(stock_vol),
                   stock_cap     = VALUES(stock_cap),
                   uDate         = NOW()
        ");

        $n = 0;
        $pdo->beginTransaction();
        try {
            foreach ($q as $code => $x) {
                $up->execute([
                    ':code'  => $code,
                    ':name'  => mb_substr(trim((string)($x['name'] ?? '')), 0, 40),
                    ':price' => (int)$x['price'],
                    ':yrate' => (int)$x['diff'],
                    ':rate'  => (float)$x['rate'],
                    ':vol'   => (int)$x['vol'],
                    ':amt'   => round(((float)($x['val'] ?? 0)) / 100000000, 2),
                    ':cap'   => (int)round(((float)$x['cap']) / 100000000),
                ]);
                if ($up->rowCount() > 0) $n++;   // INSERT 1 · UPDATE 2 — 「종목 수」로 센다
            }
            $pdo->commit();
        } catch (Throwable $e) {
            $pdo->rollBack();
            return ['target' => count($rows), 'stale' => count($stale), 'fetched' => count($q), 'updated' => 0];
        }

        return ['target' => count($rows), 'stale' => count($stale), 'fetched' => count($q), 'updated' => $n];
    }
    /* ── 기간 고가·저가 ────────────────────────────────────────────────
     *
     * "지금 주가가 최근 6개월 고점에서 얼마나 빠졌나"는 재무만으로는 못 보는 축이다.
     * 재무가 좋은데 주가가 빠진 종목을 찾는 것이 스크리너의 목적이므로 같이 봐야 한다.
     *
     * ★ 종목마다 한 번씩 불러야 한다 — 이 API 에는 묶음 호출이 없다.
     *   실측(2026-07-29) 6개월 121행이 종목당 25ms 라, 전종목 2,758개가 순차로 1~2분이다.
     *   화면을 열 때마다 할 수는 없으니 <b>크론이 미리 채워 두고</b> 화면은 표를 읽기만 한다.
     *
     * ★ 현재가는 여기 담지 않는다. 고가·저가만 담는다.
     *   현재가는 all_stock_info(네이버 실시간)가 단일 소스이고, 낙폭은 볼 때 계산한다
     *   — 저장하면 장중에 주가가 움직여도 낙폭이 안 따라온다.
     */
    const RANGE_MONTHS = 6;

    /** 기간 고가·저가 표. 쓰는 쪽(Dart::ensureTables)에서도 부르므로 public 이다. */
    public static function ensureRangeTable(PDO $pdo): void
    {
        $pdo->exec("
            CREATE TABLE IF NOT EXISTS stock_price_range (
              stock_code VARCHAR(10)   NOT NULL,
              months     TINYINT       NOT NULL DEFAULT 6 COMMENT '구간 길이(개월) — 6 하나만 쓰지만 나중에 12를 더할 수 있게 키에 넣는다',
              hi         DECIMAL(18,2) NOT NULL DEFAULT 0 COMMENT '구간 최고가(장중 고가)',
              hi_date    DATE          NULL,
              lo         DECIMAL(18,2) NOT NULL DEFAULT 0 COMMENT '구간 최저가(장중 저가)',
              lo_date    DATE          NULL,
              bars       SMALLINT      NOT NULL DEFAULT 0 COMMENT '쓴 일봉 개수 — 신규상장이면 적다',
              from_date  DATE          NULL,
              to_date    DATE          NULL,
              rebuilt_at DATE          NULL COMMENT '일봉을 통째로 다시 받은 날 — 매일 도는 이어붙이기와 구분한다',
              updated_at DATETIME      NOT NULL COMMENT '마지막으로 손댄 시각(이어붙이기 포함)',
              PRIMARY KEY (stock_code, months)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        /* 일별 고·저 원본. stock_price_range 는 이걸 6개월로 접은 <b>캐시</b>일 뿐이다.
         *
         * ★★ 이 표가 있어야 6개월 창이 <b>스스로 흐른다</b>.
         *   집계만 들고 있으면 창을 벗어난 옛 고점이 빠질 길이 없어 주기적으로
         *   전종목 일봉(2,766회 · 6분)을 다시 받아야 했다. 그런데 크론 타임아웃이 30초다
         *   (cron-job.org 실측 — job=fresh 78초짜리가 매일 timeout 으로 실패하고 있었다).
         *   30초에 들어가는 방법은 "다시 받지 않는 것"뿐이고, 그래서 원본을 쌓는다.
         *
         * 크기: 2,766종목 × 6개월(약 121거래일) ≈ 33만 행. 8개월이 지난 행은 매일 지운다.
         */
        $pdo->exec("
            CREATE TABLE IF NOT EXISTS stock_daily_range (
              stock_code VARCHAR(10)   NOT NULL,
              bas_dd     DATE          NOT NULL COMMENT '거래일',
              hi         DECIMAL(18,2) NOT NULL COMMENT '장중 고가 (거래정지일은 종가)',
              lo         DECIMAL(18,2) NOT NULL COMMENT '장중 저가 (거래정지일은 종가)',
              PRIMARY KEY (stock_code, bas_dd),
              KEY idx_sdr_dd (bas_dd)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        // 뒤늦게 붙인 컬럼 — 이미 만들어진 표에도 넣는다
        $has = $pdo->query("
            SELECT COUNT(*) FROM information_schema.COLUMNS
             WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'stock_price_range'
               AND COLUMN_NAME = 'rebuilt_at'
        ")->fetchColumn();
        if (!$has) {
            $pdo->exec("ALTER TABLE stock_price_range ADD rebuilt_at DATE NULL AFTER to_date");
            // 기존 행은 전부 전체 재수집으로 만든 것이라 그날이 곧 재수집일이다
            $pdo->exec("UPDATE stock_price_range SET rebuilt_at = DATE(updated_at) WHERE rebuilt_at IS NULL");
        }
    }

    /**
     * 전종목(또는 지정 종목)의 최근 N개월 고가·저가를 받아 stock_price_range 에 채운다.
     *
     * 오늘 이미 받은 종목은 건너뛴다 — 크론이 두 번 돌아도 두 번 부르지 않고,
     * 시간 예산에 걸려 잘려도 다시 실행하면 <b>남은 것부터</b> 이어받는다.
     *
     * @param  string[] $codes 빈 배열이면 all_stock_info 전 종목
     * @param  int      $secs  0 이면 무제한. 넘기면 그 자리에서 멈추고 remain 을 돌려준다
     * @param  int      $gapUs 호출 간 간격.
     *
     * ★★ 이 값은 <b>예의가 아니라 보험</b>이다.
     *   처음엔 20ms 로 뒀다가 전종목이 111초에 끝났는데, 그게 <b>초당 25건</b>이다.
     *   순차 호출이라 동시 접속은 아니지만 한 IP 에서 낼 속도는 아니다.
     *
     *   잃을 것이 이 기능 하나가 아니라는 게 요점이다 — 이 사이트의 시세는 전부 네이버에서 온다
     *   (all_stock_info 장중 크론 · 포트폴리오 실시간 시세 · 시뮬레이터 일봉).
     *   차단당하면 부가 열 두 개가 아니라 <b>사이트 전체의 주가가 멈춘다</b>.
     *   얻는 것에 비해 잃을 것이 너무 크므로 느린 쪽으로 기운다.
     *
     *   100ms = 초당 8건, 전종목 약 6분. 밤에 도는 배치라 6분이 아깝지 않다.
     * @return array [target, todo, fetched, saved, failed, remain]
     */
    public function refreshPriceRange(PDO $pdo, array $codes = [], int $months = self::RANGE_MONTHS,
                                      bool $force = false, int $secs = 0, ?callable $onProgress = null,
                                      int $gapUs = 100000): array
    {
        self::ensureRangeTable($pdo);
        $months = max(1, min(120, $months));

        $codes = array_values(array_unique(array_filter($codes,
            static fn($c) => preg_match('/^\w{6}$/', (string)$c))));
        if (!$codes) {
            /* 모집단은 <b>네이버 목록 ∪ KRX 최근 거래일</b>이다.
             *
             * all_stock_info 만 쓰면 구멍이 난다 — 네이버 목록엔 누락이 있어
             * DL(000210)·경방(000050) 같은 정상 상장 종목이 빠져 있다(실측 2026-07-29).
             * 스크리너의 모집단은 KRX 쪽이므로, 그쪽에 있는 종목이 빠지면 열이 통째로 빈칸이 된다.
             * 반대로 KRX 에 없는 종목(당일 미거래)도 값은 보여 주는 편이 맞아 둘을 합집합으로 본다. */
            $codes = $pdo->query("
                SELECT stock_code FROM all_stock_info
                UNION
                SELECT stock_code FROM krx_daily WHERE bas_dd = (SELECT MAX(bas_dd) FROM krx_daily)
            ")->fetchAll(PDO::FETCH_COLUMN);
        }
        $target = count($codes);
        if (!$target) return ['target' => 0, 'todo' => 0, 'fetched' => 0, 'saved' => 0, 'failed' => 0, 'remain' => 0];

        /* 이미 씨를 뿌린 종목은 건너뛴다.
         * 판정 기준은 "일별 원본이 창 시작까지 닿아 있나"다 — 날짜가 아니라 <b>덮은 구간</b>이다.
         * 그래야 며칠에 걸쳐 나눠 돌려도, 중간에 끊겨도 남은 종목만 이어받는다.
         * 신규상장은 상장일 이전 자료가 없으니 여유 7일을 준다. */
        $done = [];
        if (!$force) {
            $st = $pdo->prepare("
                SELECT stock_code FROM stock_daily_range
                 GROUP BY stock_code
                HAVING MIN(bas_dd) <= DATE_ADD(DATE_SUB(CURDATE(), INTERVAL ? MONTH), INTERVAL 7 DAY)
            ");
            $st->execute([$months]);
            $done = array_flip($st->fetchAll(PDO::FETCH_COLUMN));
        }
        $todo = array_values(array_filter($codes, static fn($c) => !isset($done[$c])));
        if (!$todo) {
            return ['target' => $target, 'todo' => 0, 'fetched' => 0, 'saved' => 0, 'failed' => 0, 'remain' => 0];
        }

        $from = date('Ymd', strtotime("-{$months} months"));
        $to   = date('Ymd');

        $up = $pdo->prepare("
            INSERT INTO stock_price_range
                   (stock_code, months, hi, hi_date, lo, lo_date, bars, from_date, to_date, rebuilt_at, updated_at)
            VALUES (:code, :months, :hi, :hid, :lo, :lod, :bars, :from, :to, CURDATE(), NOW())
            ON DUPLICATE KEY UPDATE
                   hi = VALUES(hi), hi_date = VALUES(hi_date),
                   lo = VALUES(lo), lo_date = VALUES(lo_date),
                   bars = VALUES(bars), from_date = VALUES(from_date), to_date = VALUES(to_date),
                   rebuilt_at = CURDATE(), updated_at = NOW()
        ");

        $t0 = microtime(true);
        $fetched = $saved = $failed = 0;
        $i = 0;
        foreach ($todo as $code) {
            if ($secs > 0 && (microtime(true) - $t0) >= $secs) break;
            $i++;

            /* 통신 자체가 실패했을 때만 한 번 더 부른다. 2,700회를 도는 배치라
             * 순간적인 실패 하나로 그 종목이 하루 종일 빈칸이 되는 것을 막는 값싼 보험이다.
             * (처음 5.4% 실패는 이것 때문이 아니라 아래 거래정지일 처리 때문이었다 —
             *  통신은 멀쩡했고 121행을 잘 받아 왔다.) */
            $r = $this->getDailyOhlcRange($code, $from, $to);
            if (isset($r['error']) || !$r['success']) {
                usleep(300000);
                $r = $this->getDailyOhlcRange($code, $from, $to);
            }
            if (isset($r['error']) || !$r['success']) { $failed++; usleep($gapUs); continue; }
            $fetched++;
            $rows = $r['success'];

            /* 고가·저가는 <b>장중 고가/저가</b>로 잡는다 (종가 아님).
             * "고점 대비 얼마나 빠졌나"에서 고점은 실제로 그 가격이 있었던 자리여야 한다.
             *
             * ★★ 거래정지일을 걸러야 한다. 그날은 <b>시·고·저·거래량이 0 이고 종가만</b> 온다.
             *   그대로 min() 을 돌리면 저가가 0 이 되어 저점대비 상승률이 무한대가 된다.
             *   실측(2026-07-29) 전종목의 5.4%인 150종목이 이 경우였다 — 파두·금양·삼표시멘트처럼
             *   멀쩡히 거래되는 종목들이고, 6개월 안에 정지된 날이 하루라도 있으면 걸린다.
             *   네이버가 막은 것이 아니었다.
             *
             * 정지일은 버리지 않고 <b>종가를 그날의 고·저로</b> 본다 — 정지 중의 종가는
             * 마지막 체결가라 실재한 가격이고, 그 구간을 통째로 도려내면 흐름이 끊긴다. */
            $hi = $lo = null; $hid = $lod = null; $used = 0;
            foreach ($rows as $x) {
                $h = $x['h'] > 0 ? $x['h'] : $x['c'];
                $l = $x['l'] > 0 ? $x['l'] : $x['c'];
                if ($h <= 0 || $l <= 0) continue;     // 종가마저 0 이면 그날은 자료가 없는 것이다
                $used++;
                if ($hi === null || $h > $hi) { $hi = $h; $hid = $x['t']; }
                if ($lo === null || $l < $lo) { $lo = $l; $lod = $x['t']; }
            }
            if (!$used || !$hi || !$lo) { $failed++; usleep($gapUs); continue; }

            $up->execute([
                ':code' => $code, ':months' => $months,
                ':hi' => $hi, ':hid' => $hid, ':lo' => $lo, ':lod' => $lod,
                ':bars' => $used,
                ':from' => $rows[0]['t'], ':to' => end($rows)['t'],
            ]);

            /* 일별 원본도 같이 쌓는다 — 이게 있어야 창이 스스로 흐른다.
             * 121행을 한 문장으로 밀어 넣는다 (종목마다 121번 execute 하면 느리다). */
            $vals = []; $args = [];
            foreach ($rows as $x) {
                $h = $x['h'] > 0 ? $x['h'] : $x['c'];
                $l = $x['l'] > 0 ? $x['l'] : $x['c'];
                if ($h <= 0 || $l <= 0) continue;
                $vals[] = '(?,?,?,?)';
                array_push($args, $code, $x['t'], $h, $l);
            }
            if ($vals) {
                $pdo->prepare("INSERT INTO stock_daily_range (stock_code, bas_dd, hi, lo)
                               VALUES " . implode(',', $vals) . "
                               ON DUPLICATE KEY UPDATE hi = VALUES(hi), lo = VALUES(lo)")
                    ->execute($args);
            }
            $saved++;
            if ($onProgress && $i % 200 === 0) $onProgress($i, count($todo), $saved, $failed);
            usleep($gapUs);
        }

        return ['target' => $target, 'todo' => count($todo), 'fetched' => $fetched,
                'saved' => $saved, 'failed' => $failed, 'remain' => count($todo) - $i];
    }
    /**
     * <b>오늘의 고·저를 일별 원본에 한 줄 추가한다.</b> 매일 도는 값싼 쪽이다.
     *
     * ★★ 요점은 <b>묶음 호출</b>이다. 일봉 API 는 종목마다 1회라 전종목이 2,766회지만,
     *   실시간 폴링 API 는 <b>100종목씩</b> 주면서 그날의 고가·저가까지 함께 준다.
     *   그래서 매일 몫이 2,766회 → <b>28회</b>가 된다.
     *   실측(2026-07-29) 값은 같은 날 일봉과 <b>완전히 일치</b>했다
     *   (삼성전자 고 234,000 저 189,200 · SK하이닉스 고 1,619,000 저 1,246,000).
     *
     * ★ 반드시 <b>장 마감 뒤</b>에 불러야 한다. 장 전에는 고·저가 0 으로 온다
     *   (실측 2026-07-30 08:53 marketStatus=PREOPEN → high=0 low=0).
     *   0 인 종목은 그냥 건너뛰므로, 휴장일에 크론이 돌아도 가짜 행이 생기지 않는다.
     *
     * @return array [target, fetched, saved, skipped]
     */
    public function appendTodayRange(PDO $pdo, int $months = self::RANGE_MONTHS): array
    {
        self::ensureRangeTable($pdo);
        $months = max(1, min(120, $months));

        $codes = $pdo->query("
            SELECT stock_code FROM all_stock_info
            UNION
            SELECT stock_code FROM krx_daily WHERE bas_dd = (SELECT MAX(bas_dd) FROM krx_daily)
        ")->fetchAll(PDO::FETCH_COLUMN);
        $out = ['target' => count($codes), 'fetched' => 0, 'saved' => 0, 'skipped' => 0];
        if (!$codes) return $out;

        $q = $this->getRealtimeQuotes($codes);
        $out['fetched'] = count($q);
        if (!$q) return $out;

        $today = date('Y-m-d');
        $vals = []; $args = [];
        foreach ($q as $code => $x) {
            $h = (float)($x['high'] ?? 0);
            $l = (float)($x['low']  ?? 0);
            // 거래정지·휴장·장 전이면 0 이다. 그걸 최저가로 삼으면 저점대비가 무한대가 된다.
            if ($h <= 0 || $l <= 0) { $out['skipped']++; continue; }
            $vals[] = '(?,?,?,?)';
            array_push($args, $code, $today, $h, $l);
        }
        if (!$vals) return $out;

        // 같은 날 여러 번 돌려도 덮어쓰기라 안전하다 (장중에 불러도 그때까지의 고·저가 남는다)
        foreach (array_chunk($vals, 500) as $i => $chunk) {
            $slice = array_slice($args, $i * 500 * 4, count($chunk) * 4);
            $pdo->prepare("INSERT INTO stock_daily_range (stock_code, bas_dd, hi, lo)
                           VALUES " . implode(',', $chunk) . "
                           ON DUPLICATE KEY UPDATE hi = VALUES(hi), lo = VALUES(lo)")
                ->execute($slice);
            $out['saved'] += count($chunk);
        }
        return $out;
    }

    /**
     * 일별 원본 → 6개월 집계(stock_price_range) 재계산. SQL 한 문장이다.
     *
     * ★ 이 함수가 있어서 <b>창이 스스로 흐른다</b> — 매번 창 시작일을 다시 계산해
     *   그 안의 MAX/MIN 을 새로 접으므로, 6개월을 벗어난 옛 고점이 저절로 빠진다.
     *
     * 고가일·저가일은 GROUP_CONCAT 정렬의 <b>첫 항목</b>으로 집는다.
     * group_concat_max_len(기본 1024) 에 걸려 뒤가 잘려도 첫 항목은 온전하므로 안전하다.
     *
     * @return int 집계에 들어 있는 종목 수
     */
    public function syncPriceRange(PDO $pdo, int $months = self::RANGE_MONTHS): int
    {
        self::ensureRangeTable($pdo);
        $months = max(1, min(120, $months));

        $st = $pdo->prepare("
            INSERT INTO stock_price_range
                   (stock_code, months, hi, hi_date, lo, lo_date, bars, from_date, to_date, updated_at)
            SELECT stock_code, ?,
                   MAX(hi),
                   SUBSTRING_INDEX(GROUP_CONCAT(bas_dd ORDER BY hi DESC), ',', 1),
                   MIN(lo),
                   SUBSTRING_INDEX(GROUP_CONCAT(bas_dd ORDER BY lo ASC),  ',', 1),
                   COUNT(*), MIN(bas_dd), MAX(bas_dd), NOW()
              FROM stock_daily_range
             WHERE bas_dd >= DATE_SUB(CURDATE(), INTERVAL ? MONTH)
             GROUP BY stock_code
            ON DUPLICATE KEY UPDATE
                   hi = VALUES(hi), hi_date = VALUES(hi_date),
                   lo = VALUES(lo), lo_date = VALUES(lo_date),
                   bars = VALUES(bars), from_date = VALUES(from_date), to_date = VALUES(to_date),
                   updated_at = NOW()
        ");
        $st->execute([$months, $months]);

        /* rowCount 를 쓰면 안 된다 — MySQL 은 ON DUPLICATE KEY UPDATE 로 <b>갱신</b>된 행을
         * 2로 센다(끼운 행은 1). 2,766종목이 5,532로 보고돼 로그가 거짓말을 했다. */
        $cnt = $pdo->prepare("SELECT COUNT(*) FROM stock_price_range WHERE months = ?");
        $cnt->execute([$months]);
        return (int)$cnt->fetchColumn();
    }

    /**
     * 창을 벗어나 쓸모없어진 일별 행을 지운다.
     * 창(6개월)보다 넉넉히 남겨 둔다 — 지웠다가 다시 받으려면 종목마다 1회짜리 일봉을 또 불러야 한다.
     *
     * @return int 지운 행 수
     */
    public function pruneDailyRange(PDO $pdo, int $keepMonths = 8): int
    {
        self::ensureRangeTable($pdo);
        $st = $pdo->prepare("DELETE FROM stock_daily_range
                              WHERE bas_dd < DATE_SUB(CURDATE(), INTERVAL ? MONTH)");
        $st->execute([max(1, min(120, $keepMonths))]);
        return $st->rowCount();
    }
} # end of class
?>