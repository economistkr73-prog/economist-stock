<?php
/**
 * classes/StockName.class — 종목 마스터 + 종목명 단일본 (2026-09-04)
 *
 * ══ 왜 만들었나 ═══════════════════════════════════════════════════════════
 * 단타 「보유」 목록에 유니트론텍(142210)이 이름 대신 <b>종목코드</b>로 떴다. 포트폴리오는 「유니트론텍」인데.
 * 원인은 이름을 <code>all_stock_info</code> 한 표에서만 읽은 것 — 그 표는 <b>네이버 전종목 목록</b>의
 * 스냅샷인데, 그 목록이 상장 종목을 빠뜨린다(실측 2026-09-04: 142210 은 네이버 종목 페이지에선
 * KOSDAQ·거래중인데 marketValue 목록엔 없다 · 헝셩그룹 900270 도 같다 · 경방·DL 도 빠졌던 적이 있다).
 * 게다가 그 표의 정규 수집은 <code>DELETE … NOT IN</code> 으로 목록 밖 종목을 <b>지운다</b>.
 * 시세 스냅샷을 「종목 마스터」로 쓰고 있었던 것이 사고의 뿌리다.
 *
 * 화면마다 이름을 제각각 붙이고 있었다 —
 *   · 단타 보유 목록: all_stock_info 만 (없으면 코드)
 *   · 단타 풀 목록:   all_stock_info → dt_pool.name
 *   · 관심종목:       all_stock_info → dart_corp_code (Pf::watchList · stock_analysis_api 에 <b>같은 SQL 사본</b>)
 *   · 포트폴리오:     pf_stock.name (편입 때 복사)
 *   · 재무분석:       krx_daily (거래소 종목명 우선)
 * 같은 종목이 화면마다 다른 이름(또는 코드)으로 보이는 구조였다. <b>종목 정보의 주인은 한 표여야 한다.</b>
 *
 * ══ 종목 마스터 <code>stock_master</code> (사용자 지시 2026-09-04 — 「무조건 한 테이블에 종목정보가 있게」) ═══
 *   code · name · market · first_seen · last_seen · updated_at
 *   원천은 <b>KRX 전종목</b>(<code>krx_daily</code> · 크론 <code>dart_krx</code> 13:05 · T+1)이다 — 네이버 2,760 보다
 *   많은 2,765 종목이 매일 온다. 그 크론 끝에서 <code>StockName::sync()</code> 가 UPSERT 한다(API 0회).
 *   ★<b>지우지 않는다</b> — KRX 에서 사라지면 <code>last_seen</code> 이 멈출 뿐이다. 상장폐지 종목도 포트폴리오
 *     이력·아카이브에서 이름이 필요하다. 「지금 상장인가」는 <code>last_seen</code> 으로 가른다.
 *   ★사명이 바뀌면 KRX 가 새 이름을 주고 <code>name</code> 이 따라간다(더 최신 날짜의 이름만 덮는다).
 *
 * ══ 규칙 ═══════════════════════════════════════════════════════════════════
 * ★ 이름이 필요하면 이 클래스를 부른다 — <code>SELECT stock_name FROM all_stock_info</code> 를 새로 적지 않는다.
 * ★ 마스터에 없을 때만 CHAIN 의 나머지가 잇는다(신규상장 첫날 · 옛 상장폐지 종목의 포트폴리오 기록).
 *   사슬은 <b>여기 한 벌</b>이고, 설정 > 시세 설정 ⑦ 이 이 표를 읽어 그린다(Thr·ChartFeat 와 같은
 *   「원본 → 화면 표시」 패턴). 원천을 늘리면 CHAIN 에 한 줄 — 화면은 손대지 않는다.
 * ★ 표마다 <b>따로</b> 읽어 PHP 에서 잇는다 — all_stock_info(utf8mb3) 와 krx 계열(utf8mb4)은
 *   SQL 조인이 콜레이션에서 어긋난다(사이트 공통 함정). 표가 없어도 죽지 않는다(try/catch).
 * ★ DDL 은 <code>sync()</code>(크론)에서만 — 요청 경로에서 <code>ensureTable()</code> 을 부르지 않는다
 *   (재무분석 느린 렌더의 교훈 — 매 요청 DDL 은 메타데이터 잠금 대기).
 * ★ 이름을 <b>저장</b>하는 자리(pf_stock·dt_pool)는 여전히 자기 표에 복사한다 — 그건 스냅샷이고,
 *   이 클래스는 <b>보여 줄 때</b> 잇는 자다.
 */
final class StockName
{
    public const TABLE = 'stock_master';

    /**
     * 이름 사슬 — 위에서부터 찾고, 처음 찾은 것을 쓴다. 첫 줄이 <b>주인</b>이고 나머지는 보험이다.
     *   [표, 이름 컬럼, 코드 컬럼, 어떤 이름인가, 함정]
     * 설정 > 시세 설정 「종목명은 어디서 오나」 표가 이 배열을 그대로 그린다.
     */
    public const CHAIN = [
        ['stock_master',   'name',       'code',       '★종목 마스터 — KRX 전종목에서 매일 동기화 (dart_krx 13:05 · T+1)',
         '주인. 여기 없으면 신규상장 첫날이거나 KRX 에 없는 코드다. 상장폐지도 지우지 않는다(last_seen 이 멈춘다)'],
        ['all_stock_info', 'stock_name', 'stock_code', '거래소 종목명 (네이버 전종목 시세 스냅샷)',
         '네이버 목록이 상장 종목을 빠뜨린다(실측 유니트론텍·헝셩그룹) — 여기 없다고 「없는 종목」이 아니다. 시세 표이지 마스터가 아니다'],
        ['krx_daily',      'stock_name', 'stock_code', '거래소 종목명 (KRX 최근 10거래일 원본)',
         '마스터의 원천. 마스터 동기화 전(13:05 이전 신규상장)에만 여기서 먼저 걸린다'],
        ['dart_corp_code', 'corp_name',  'stock_code', 'DART 법인명',
         '「현대자동차」처럼 거래소명(「현대차」)과 다를 수 있다 — 거래소명이 있으면 쓰지 않는다'],
        ['pf_stock',       'name',       'code',       '포트폴리오가 편입 때 복사해 둔 이름',
         '편입 이후 사명이 바뀌어도 옛 이름이다'],
        ['dt_pool',        'name',       'code',       '단타 풀이 담을 때 적은 이름',
         '담은 뒤 사명이 바뀌어도 옛 이름이다'],
    ];

    // ══ 마스터 표 ═══════════════════════════════════════════════════════
    /** 표 생성 — 크론(sync)과 스키마 잡에서만 부른다. 요청 경로 금지. */
    public static function ensureTable(PDO $pdo): void
    {
        $pdo->exec("CREATE TABLE IF NOT EXISTS " . self::TABLE . " (
            code       VARCHAR(10) NOT NULL PRIMARY KEY COMMENT '6자리 종목코드',
            name       VARCHAR(80) NOT NULL DEFAULT '' COMMENT '거래소 종목명 (KRX)',
            market     VARCHAR(10) NOT NULL DEFAULT '' COMMENT 'KOSPI / KOSDAQ',
            first_seen DATE NULL COMMENT 'krx_daily 에서 처음 본 거래일',
            last_seen  DATE NULL COMMENT 'krx_daily 에서 마지막으로 본 거래일 — 멈추면 상장폐지·거래정지 의심',
            updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
            KEY idx_name (name),
            KEY idx_last (last_seen)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci
          COMMENT='종목 마스터 — KRX 전종목 · classes/StockName.class 가 주인 (2026-09-04)'");
    }

    /**
     * <code>krx_daily</code> → 마스터 UPSERT. 크론 <code>dart_krx</code> 끝에서 매일 부른다 (API 0회).
     * krx_daily 는 최근 10거래일뿐이라, 종목별 <b>가장 최근 행</b>의 이름·시장을 쓰고
     * first_seen 은 더 이른 값만, last_seen 은 더 늦은 값만 남긴다.
     *
     * @return array{date:string,rows:int,inserted:int,total:int}
     */
    public static function sync(PDO $pdo): array
    {
        self::ensureTable($pdo);
        $rows = $pdo->query("
            SELECT k.stock_code AS code, k.stock_name AS name, k.market, m.mn AS first_seen, m.mx AS last_seen
              FROM krx_daily k
              JOIN (SELECT stock_code, MIN(bas_dd) AS mn, MAX(bas_dd) AS mx FROM krx_daily GROUP BY stock_code) m
                ON m.stock_code = k.stock_code AND m.mx = k.bas_dd
        ")->fetchAll(PDO::FETCH_ASSOC);
        $out = ['date' => '', 'rows' => count($rows), 'inserted' => 0, 'total' => 0];
        if (!$rows) return $out;

        $up = $pdo->prepare("
            INSERT INTO " . self::TABLE . " (code, name, market, first_seen, last_seen)
            VALUES (:code, :name, :market, :first, :last)
            ON DUPLICATE KEY UPDATE
                name       = IF(VALUES(last_seen) >= IFNULL(last_seen, '1900-01-01') AND VALUES(name) <> '', VALUES(name), name),
                market     = IF(VALUES(last_seen) >= IFNULL(last_seen, '1900-01-01') AND VALUES(market) <> '', VALUES(market), market),
                first_seen = LEAST(IFNULL(first_seen, VALUES(first_seen)), VALUES(first_seen)),
                last_seen  = GREATEST(IFNULL(last_seen, VALUES(last_seen)), VALUES(last_seen))
        ");
        $ins = 0;
        $pdo->beginTransaction();
        try {
            foreach ($rows as $r) {
                $code = trim((string)$r['code']);
                if ($code === '') continue;
                $up->execute([
                    ':code'   => $code,
                    ':name'   => mb_substr(trim((string)$r['name']), 0, 80),
                    ':market' => strtoupper(trim((string)$r['market'])),
                    ':first'  => $r['first_seen'],
                    ':last'   => $r['last_seen'],
                ]);
                if ($up->rowCount() === 1) $ins++;        // INSERT 1 · UPDATE 2 · 무변경 0
                if ((string)$r['last_seen'] > $out['date']) $out['date'] = (string)$r['last_seen'];
            }
            $pdo->commit();
        } catch (Throwable $e) {
            $pdo->rollBack();
            throw $e;
        }
        $out['inserted'] = $ins;
        $out['total']    = (int)$pdo->query("SELECT COUNT(*) FROM " . self::TABLE)->fetchColumn();
        return $out;
    }

    /**
     * 마스터 한 줄(이름·시장·first/last_seen). 없으면 null. 「지금 상장인가」는 last_seen 으로 가른다.
     */
    public static function get(PDO $pdo, string $code): ?array
    {
        try {
            $st = $pdo->prepare("SELECT code, name, market, first_seen, last_seen FROM " . self::TABLE . " WHERE code = ?");
            $st->execute([trim($code)]);
            return $st->fetch(PDO::FETCH_ASSOC) ?: null;
        } catch (Throwable $e) {
            return null;
        }
    }

    // ══ 이름 ════════════════════════════════════════════════════════════
    /**
     * 여러 종목의 이름 — <b>찾은 것만</b> 돌려준다 (code → name). 못 찾은 코드는 키가 없다.
     *
     * @param  string[] $codes 6자리 종목코드
     * @return array<string,string>
     */
    public static function many(PDO $pdo, array $codes): array
    {
        $want = [];
        foreach ($codes as $c) {
            $c = trim((string)$c);
            if ($c !== '' && strlen($c) <= 12) $want[$c] = 1;
        }
        if (!$want) return [];

        $out = [];
        foreach (self::CHAIN as [$table, $nameCol, $codeCol]) {
            $left = array_keys(array_diff_key($want, $out));
            if (!$left) break;
            $ph = implode(',', array_fill(0, count($left), '?'));
            /* krx_daily 는 (종목, 날짜)라 최신 날짜의 이름을 쓴다 — 최신일에 그 종목이 없는 날(거래정지)도
             * 있으니 「그 종목의 가장 최근 행」으로 잡는다(표는 10거래일뿐이라 값싸다). */
            $sql = ($table === 'krx_daily')
                ? "SELECT {$codeCol} AS c, {$nameCol} AS n FROM {$table}
                    WHERE {$codeCol} IN ({$ph}) ORDER BY bas_dd DESC"
                : "SELECT {$codeCol} AS c, {$nameCol} AS n FROM {$table} WHERE {$codeCol} IN ({$ph})";
            try {
                $st = $pdo->prepare($sql);
                $st->execute($left);
                foreach ($st->fetchAll(PDO::FETCH_ASSOC) as $r) {
                    $c = (string)$r['c'];
                    $n = trim((string)$r['n']);
                    if ($n === '' || isset($out[$c]) || !isset($want[$c])) continue;
                    $out[$c] = $n;
                }
            } catch (Throwable $e) {
                /* 표가 없거나 컬럼이 다르다 — 이 원천만 건너뛴다. 이름 하나 때문에 목록을 죽이지 않는다. */
            }
        }
        return $out;
    }

    /**
     * 한 종목의 이름. 못 찾으면 $fallback — null 이면 <b>코드 그대로</b>(화면용) · '' 를 주면 빈 값(저장용).
     */
    public static function one(PDO $pdo, string $code, ?string $fallback = null): string
    {
        $code = trim($code);
        if ($code === '') return $fallback ?? '';
        $m = self::many($pdo, [$code]);
        return $m[$code] ?? ($fallback ?? $code);
    }

    /**
     * 행 배열의 빈 이름(또는 코드와 같은 이름)을 채운다 — 목록 화면이 마지막에 한 번 부른다.
     * 한 번의 사슬 조회로 전 행을 채우므로 행마다 부르지 않는다.
     *
     * @param array $rows       참조로 받아 그 자리에서 고친다
     * @param bool  $codeIfNone 끝내 못 찾으면 코드를 이름 자리에 둘지 (화면은 true · 저장은 false)
     */
    public static function fill(PDO $pdo, array &$rows, string $codeKey = 'code', string $nameKey = 'name',
                                bool $codeIfNone = true): void
    {
        $bare = [];
        foreach ($rows as $i => $r) {
            $c = (string)($r[$codeKey] ?? '');
            $n = trim((string)($r[$nameKey] ?? ''));
            if ($c !== '' && ($n === '' || $n === $c)) $bare[$i] = $c;
        }
        if (!$bare) return;
        $names = self::many($pdo, array_values(array_unique($bare)));
        foreach ($bare as $i => $c) {
            if (isset($names[$c]))      $rows[$i][$nameKey] = $names[$c];
            elseif ($codeIfNone)        $rows[$i][$nameKey] = $c;
        }
    }
}
?>
