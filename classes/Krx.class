<?php
/**
 * Krx.class — 한국거래소 오픈API 수집 + DB 전담
 *
 * ══ 시세 테이블 두 개의 역할 분담 ══════════════════════════════════════
 *   all_stock_info (네이버)  <b>주가</b> — 사이트 전체가 쓰는 단일 시세 소스.
 *                            장중 5~10회 갱신되어 사실상 실시간이다.
 *   krx_daily      (여기)    <b>상장주식수</b>·<b>거래종목 판정</b>.
 *                            시세 컬럼도 받아 두지만 <b>폴백 전용</b>이다.
 *
 * 중복이 아니라 분업이다 — 네이버엔 상장주식수 컬럼이 아예 없고(값도 전부 0인 eps·per 껍데기만 있다),
 * KRX 주가는 T+1 이라 하루 묵는다. 각자 상대가 못 주는 것을 준다.
 *
 * 쓰는 곳은 두 가지다.
 *   ① <b>거래 가능 종목 판정</b> — 거래소 원본이라 상장폐지·거래정지가 정확히 빠진다.
 *      네이버 목록(all_stock_info)은 누락이 있다 — 실측(2026-07-29)에서
 *      DL(000210)·경방(000050)이 네이버엔 있는데 우리 DB엔 없었고, KRX엔 정확히 있었다.
 *   ② <b>상장주식수</b>(LIST_SHRS) — 전종목 EPS·BPS 를 만드는 마지막 조각.
 *      DART 는 주당 값을 종목별 호출로만 주는데 전종목이면 하루 한도를 넘는다.
 *      순이익·자본총계(이미 있음) ÷ 상장주식수로 계산하면 한 번에 끝난다.
 *
 * ★ 실시간 시세용이 아니다. 갱신은 <b>T+1</b> 이고, 그것도 다음 날 오전에야 올라온다.
 *   실측(2026-07-29): 01:19 에는 7/28 이 없어 7/27 이 최신이었는데, 11:58 에는 7/28 이 있었다.
 *   ⇒ <b>새벽에 돌리면 하루 더 묵은 값을 받는다.</b> 크론은 오전 이후에 둔다.
 *
 * ★★ 앞서 "최근 며칠치만 준다"고 적어 뒀던 것은 <b>틀렸다</b>(2026-07-29 재측정).
 *   30·60·90·180·365·730일 전을 찍어 보니 <b>2년 전까지 전부 정상</b>으로 온다.
 *   0 건이던 7/17 은 보관이 끝난 게 아니라 그냥 <b>휴장일</b>이었다 —
 *   네이버 일봉에도 7/17 이 없는 것으로 교차 확인했다.
 *
 * ★★★ 그리고 그 「2년」도 <b>한도가 아니었다</b>(2026-07-31 재측정).
 *   위에서 730일까지만 찍고 멈췄던 탓에 한동안 "보관 730일"로 적혀 다녔는데,
 *   4·5·6·7·9·11년 전을 찍어 보니 <b>2015-08-03 까지 전부 정상</b>이다.
 *   ⇒ 과거 데이터에 시한이 없다. 백필 깊이는 <b>용량과 시간만 보고</b> 정하면 된다.
 *   ★ 판정할 때는 <b>한 지점에 이틀 이상</b>을 찍는다 — 하루만 보면 연휴에 걸린 0 행을
 *     "보관 만료"로 오독한다(2024-02-12 설 대체공휴일에서 실제로 그럴 뻔했다).
 *   ⇒ 과거 시세가 필요하면 KRX 로도 받을 수 있다. 지금 네이버 일봉을 쓰는 것은
 *     당일 종가까지 준다는 이유(KRX 는 T+1)지 KRX 가 못 줘서가 아니다.
 */
class Krx
{
    const BASE = 'https://data-dbg.krx.co.kr/svc/apis/';

    /** 시장별 엔드포인트. 이용신청이 승인된 것만 부를 수 있다. */
    const MARKETS = [
        'sto/stk_bydd_trd' => 'KOSPI',
        'sto/ksq_bydd_trd' => 'KOSDAQ',
    ];

    private PDO $pdo;
    private string $key;

    public function __construct(PDO $pdo, string $key = '')
    {
        $this->pdo = $pdo;
        $this->key = $key !== '' ? $key : (defined('KRX_API_KEY') ? KRX_API_KEY : '');
    }

    public function hasKey(): bool
    {
        return $this->key !== '';
    }

    // ══ 스키마 ══════════════════════════════════════════════════════════
    public function ensureTables(): void
    {
        // 하루 2,765행. 며칠치만 받아 오므로 커질 일이 없다.
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS krx_daily (
              stock_code VARCHAR(10) NOT NULL,
              bas_dd     DATE        NOT NULL COMMENT '기준일',
              market     VARCHAR(10) NOT NULL DEFAULT '' COMMENT 'KOSPI / KOSDAQ',
              stock_name VARCHAR(80) NOT NULL DEFAULT '',
              close_prc  BIGINT      NULL COMMENT '종가',
              open_prc   BIGINT      NULL,
              high_prc   BIGINT      NULL,
              low_prc    BIGINT      NULL,
              fluc_rt    DECIMAL(8,2) NULL COMMENT '등락률(%)',
              acc_vol    BIGINT      NULL COMMENT '거래량',
              acc_val    BIGINT      NULL COMMENT '거래대금',
              mktcap     BIGINT      NULL COMMENT '시가총액(원)',
              list_shrs  BIGINT      NULL COMMENT '상장주식수 — EPS·BPS 계산의 분모',
              updated_at DATETIME    NOT NULL,
              PRIMARY KEY (stock_code, bas_dd),
              KEY idx_krx_dd (bas_dd)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");
    }

    // ══ HTTP ════════════════════════════════════════════════════════════
    /**
     * 실패는 예외로 올린다. 특히 401 은 "이용신청 안 됨"이라 조용히 넘기면 원인을 못 찾는다.
     */
    private function call(string $path, array $q): array
    {
        if ($this->key === '') throw new RuntimeException('KRX 인증키가 없습니다 (env/krx.inc).');

        $ch = curl_init(self::BASE . $path . '?' . http_build_query($q));
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 60,
            CURLOPT_FOLLOWLOCATION => true,      // http→https 302 를 따라가야 한다
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_HTTPHEADER     => ['AUTH_KEY: ' . $this->key, 'Accept: application/json'],
            CURLOPT_USERAGENT      => 'Mozilla/5.0',
        ]);
        $body = curl_exec($ch);
        $err  = curl_error($ch);
        $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($body === false || $err !== '') throw new RuntimeException("KRX 통신 실패({$path}): {$err}");

        $j = json_decode((string)$body, true);
        if (!is_array($j)) throw new RuntimeException("KRX 응답이 JSON 이 아닙니다({$path}): " . mb_substr((string)$body, 0, 120));

        if (isset($j['respCode']) && (string)$j['respCode'] !== '000') {
            $msg = (string)($j['respMsg'] ?? '');
            if ((string)$j['respCode'] === '401') {
                $msg .= ' — openapi.krx.co.kr 에서 이 API 의 이용신청이 승인됐는지 확인하세요.';
            }
            throw new RuntimeException("KRX 오류 {$j['respCode']}: {$msg}");
        }
        if ($code !== 200) throw new RuntimeException("KRX HTTP {$code} ({$path})");

        return $j['OutBlock_1'] ?? [];
    }

    /** "1,234" · "" · "-" → 숫자. 값이 없으면 null */
    private static function num($v): ?float
    {
        $v = trim((string)$v);
        if ($v === '' || $v === '-') return null;
        $v = str_replace([',', ' '], '', $v);
        if (!preg_match('/^-?\d+(\.\d+)?$/', $v)) return null;
        return (float)$v;
    }

    // ══ 수집 ════════════════════════════════════════════════════════════
    /**
     * 하루치 전종목(코스피+코스닥)을 받아 저장한다.
     *
     * @return array [date, rows] — 휴장일이면 rows = 0
     */
    public function collect(string $ymd): array
    {
        $rows = [];
        foreach (self::MARKETS as $path => $mk) {
            foreach ($this->call($path, ['basDd' => $ymd]) as $x) {
                $code = trim((string)($x['ISU_CD'] ?? ''));
                // 표준코드(KR7005930003)로 오는 경우를 대비해 단축코드로 맞춘다
                if (strlen($code) === 12) $code = substr($code, 3, 6);
                if (!preg_match('/^\w{6}$/', $code)) continue;

                $rows[] = [
                    $code,
                    substr($ymd, 0, 4) . '-' . substr($ymd, 4, 2) . '-' . substr($ymd, 6, 2),
                    (string)($x['MKT_NM'] ?? $mk),
                    mb_substr((string)($x['ISU_NM'] ?? ''), 0, 80),
                    self::num($x['TDD_CLSPRC'] ?? null),
                    self::num($x['TDD_OPNPRC'] ?? null),
                    self::num($x['TDD_HGPRC']  ?? null),
                    self::num($x['TDD_LWPRC']  ?? null),
                    self::num($x['FLUC_RT']    ?? null),
                    self::num($x['ACC_TRDVOL'] ?? null),
                    self::num($x['ACC_TRDVAL'] ?? null),
                    self::num($x['MKTCAP']     ?? null),
                    self::num($x['LIST_SHRS']  ?? null),
                ];
            }
        }

        if ($rows) $this->save($rows);
        return ['date' => $ymd, 'rows' => count($rows)];
    }

    /**
     * 가장 최근 거래일을 찾아 받아 온다.
     *
     * 오늘 것은 없다(T+1). 게다가 휴장일·연휴가 섞이므로 며칠 거슬러 올라가며 찾는다.
     * 언제 돌려도 "그 시점의 최신 거래일"을 받아 오므로, 크론을 하루 여러 번 걸어도 안전하다.
     *
     * @param int $back 몇 일까지 거슬러 볼지
     */
    public function collectLatest(int $back = 10): array
    {
        for ($i = 0; $i <= $back; $i++) {
            $ymd = date('Ymd', strtotime("-{$i} day"));
            $r   = $this->collect($ymd);
            if ($r['rows'] > 0) return $r;
        }
        return ['date' => '', 'rows' => 0];
    }

    private function save(array $rows): void
    {
        $st = $this->pdo->prepare("
            INSERT INTO krx_daily
                (stock_code, bas_dd, market, stock_name, close_prc, open_prc, high_prc, low_prc,
                 fluc_rt, acc_vol, acc_val, mktcap, list_shrs, updated_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,NOW())
            ON DUPLICATE KEY UPDATE
                market=VALUES(market), stock_name=VALUES(stock_name),
                close_prc=VALUES(close_prc), open_prc=VALUES(open_prc),
                high_prc=VALUES(high_prc), low_prc=VALUES(low_prc), fluc_rt=VALUES(fluc_rt),
                acc_vol=VALUES(acc_vol), acc_val=VALUES(acc_val),
                mktcap=VALUES(mktcap), list_shrs=VALUES(list_shrs), updated_at=NOW()
        ");

        $this->pdo->beginTransaction();
        try {
            foreach ($rows as $r) $st->execute($r);
            $this->pdo->commit();
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
    }

    /**
     * 최근 $keep 개 기준일만 남기고 지운다.
     *
     * 화면이 쓰는 것은 <b>가장 최근 하루</b>뿐이다(screenRows 가 MAX(bas_dd) 로 붙인다).
     * 그래도 며칠은 남긴다 — 수집이 하루 실패해도 직전 값으로 화면이 계속 돌아가야 한다.
     * 더 옛날 것을 안 쌓는 이유는 용량이 아니라, <b>KRX 가 2년 전까지 언제든 다시 주기 때문</b>이다.
     * 안 쓰는 데이터를 쌓아 두면 "이게 최신인가" 를 매번 되묻게 된다.
     *
     * @return int 지운 행 수
     */
    public function prune(int $keep = 10): int
    {
        if ($keep < 1) return 0;

        $dates = $this->pdo->query("
            SELECT DISTINCT bas_dd FROM krx_daily ORDER BY bas_dd DESC
        ")->fetchAll(PDO::FETCH_COLUMN);

        if (count($dates) <= $keep) return 0;

        $st = $this->pdo->prepare("DELETE FROM krx_daily WHERE bas_dd < ?");
        $st->execute([$dates[$keep - 1]]);
        return $st->rowCount();
    }

    // ══ 조회 ════════════════════════════════════════════════════════════
    /** 저장된 가장 최근 기준일 (없으면 '') */
    public function lastDate(): string
    {
        $v = $this->pdo->query("SELECT MAX(bas_dd) FROM krx_daily")->fetchColumn();
        return $v === false || $v === null ? '' : (string)$v;
    }

    /** 그 날 거래된 종목 수 */
    public function countAt(string $date): int
    {
        $st = $this->pdo->prepare("SELECT COUNT(*) FROM krx_daily WHERE bas_dd = ?");
        $st->execute([$date]);
        return (int)$st->fetchColumn();
    }

    /** 한 종목의 최근 시세 (없으면 null) */
    public function quote(string $stockCode): ?array
    {
        $st = $this->pdo->prepare("
            SELECT * FROM krx_daily WHERE stock_code = ? ORDER BY bas_dd DESC LIMIT 1
        ");
        $st->execute([$stockCode]);
        $r = $st->fetch(PDO::FETCH_ASSOC);
        return $r ?: null;
    }
}
?>
