<?php
/**
 * NotionArchive — 뉴스레터 본문을 노션 데이터베이스 페이지로 적재 (선택 기능)
 *
 * 사전 준비: env/notion.inc 참고 (Integration 토큰 발급 + 대상 DB 를 Integration 과 연결).
 * 미설정이면 enabled()==false → 호출측에서 조용히 스킵.
 *
 * 사용법:
 *   if (NotionArchive::enabled()) NotionArchive::add("제목", "본문 텍스트", "2026-06-15");
 */
class NotionArchive
{
    const API_URL     = 'https://api.notion.com/v1/pages';
    const API_VERSION = '2022-06-28';
    const BLOCK_MAX    = 1900;  // 노션 rich_text 한 블록 2000자 제한 → 여유있게 분할

    private static function loadConfig(): void
    {
        if (defined('NOTION_TOKEN')) return;
        $f = __DIR__ . '/../env/notion.inc';
        if (is_file($f)) require_once $f;
    }

    private static function cred(string $const, string $env): string
    {
        if (defined($const) && constant($const) !== '') return (string) constant($const);
        $v = getenv($env);
        return $v !== false ? (string) $v : '';
    }

    /** 토큰 + DB ID 가 모두 설정돼 있어야 동작 */
    public static function enabled(): bool
    {
        self::loadConfig();
        return self::cred('NOTION_TOKEN', 'NOTION_TOKEN') !== ''
            && self::cred('NOTION_DB_ID', 'NOTION_DB_ID') !== '';
    }

    /**
     * 노션 DB 에 페이지 1개 생성
     *
     * @param string $title   페이지 제목 (title 속성)
     * @param string $body    본문 텍스트 (paragraph 블록으로 적재)
     * @param string $isoDate YYYY-MM-DD (빈값이면 날짜 속성 생략)
     * @return bool 성공 여부
     */
    public static function add(string $title, string $body, string $isoDate = ''): bool
    {
        if (!self::enabled()) return false;

        $token     = self::cred('NOTION_TOKEN', 'NOTION_TOKEN');
        $dbId      = self::cred('NOTION_DB_ID', 'NOTION_DB_ID');
        $titleProp = defined('NOTION_TITLE_PROP') ? NOTION_TITLE_PROP : 'Name';
        $dateProp  = defined('NOTION_DATE_PROP')  ? NOTION_DATE_PROP  : 'Date';

        $props = [
            $titleProp => ['title' => [[ 'text' => ['content' => self::cut($title, 1900)] ]]],
        ];
        if ($isoDate !== '' && $dateProp !== '') {
            $props[$dateProp] = ['date' => ['start' => $isoDate]];
        }

        // 본문 → 2000자 제한 회피 위해 청크 분할한 paragraph 블록들
        $children = [];
        foreach (self::chunks($body, self::BLOCK_MAX) as $chunk) {
            $children[] = [
                'object' => 'block',
                'type'   => 'paragraph',
                'paragraph' => ['rich_text' => [[ 'text' => ['content' => $chunk] ]]],
            ];
        }

        $payload = [
            'parent'     => ['database_id' => $dbId],
            'properties' => $props,
        ];
        if ($children) $payload['children'] = $children;

        $ch = curl_init(self::API_URL);
        curl_setopt_array($ch, [
            CURLOPT_POST           => true,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 20,
            CURLOPT_HTTPHEADER     => [
                'Authorization: Bearer ' . $token,
                'Notion-Version: ' . self::API_VERSION,
                'Content-Type: application/json',
            ],
            CURLOPT_POSTFIELDS     => json_encode($payload, JSON_UNESCAPED_UNICODE),
        ]);
        $res  = curl_exec($ch);
        $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($code === 200) {
            error_log('[Notion] 페이지 적재 성공');
            return true;
        }
        error_log("[Notion] 페이지 적재 실패({$code}): " . $res);
        return false;
    }

    /** 멀티바이트 안전 절단 */
    private static function cut(string $s, int $max): string
    {
        return mb_strcut(trim($s), 0, $max);
    }

    /** 멀티바이트 안전 청크 분할 */
    private static function chunks(string $s, int $size): array
    {
        $s = trim($s);
        if ($s === '') return [''];
        $out = [];
        $len = mb_strlen($s);
        for ($i = 0; $i < $len; $i += $size) {
            $out[] = mb_substr($s, $i, $size);
        }
        return $out;
    }
}
?>
