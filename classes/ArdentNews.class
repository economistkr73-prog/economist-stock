<?php
/**
 * ArdentNews.class — 아덴트뉴스 '국내여행' 기사 크롤러 (HTTP + 파싱, DB 미사용 서비스 클래스)
 *
 * 역할: 목록/상세 HTML 을 받아 우리 표준 입력 포맷({place, ref})으로 추출한다.
 *       DB 적재(ingest)·좌표화(geocode)는 호출측(cron_ardent_crawl.php / Place / GeoCoder)이 담당.
 *       GeoCoder / NaverFinanceAPI 와 같은 결의 외부 I/O 전담 클래스.
 *
 * 설계 출처: CRAWLER_BRIEF.md
 *   - 데이터 1순위 = <meta> 태그(안정적), 보조 = 본문 정규식(주소/전화/시간/입장료)
 *   - 저작권: 본문 전문 저장 금지 → 제목·URL·발행일·기자·이미지 + 우리가 가공한 구조화 데이터만
 *   - 필터(A): '국내여행' 섹션 + 한국 지역/주소가 실제로 추출돼야 적재(아니면 skip)
 */
class ArdentNews
{
    const HOST      = 'https://www.ardentnews.co.kr';
    const LIST_URL  = 'https://www.ardentnews.co.kr/news/articleList.html?page=%d&total=6475&box_idxno=&sc_sub_section_code=S2N3&view_type=sm';
    // ★ 실제 페이지네이션은 이 AJAX 엔드포인트가 담당(articleList.html 의 raw HTML 은 page 무시→항상 1p).
    //   JSON 반환. Referer + X-Requested-With 헤더 없으면 "정상적인 접근이 아닙니다" 거부.
    //   total=섹션 기사 수(≈6475), list_per_page=20 → ÷20≈324p.
    const LIST_AJAX = 'https://www.ardentnews.co.kr/news/ajaxArticlePaging.php?total=6475&list_per_page=20&page_per_page=10&page=%d&sc_section_code=S1N8&sc_sub_section_code=S2N3&view_type=sm';
    const VIEW_URL  = 'https://www.ardentnews.co.kr/news/articleView.html?idxno=%d';
    const SECTION   = '국내여행';
    // 이 CMS(ND소프트)는 봇 UA 에 기본(1페이지) 응답을 주는 듯 → 브라우저 UA 사용.
    // 신원은 From 헤더(아래 httpGet)로 유지. robots.txt 는 /news/ 크롤 허용.
    const UA        = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36';
    const CONTACT   = 'economist.kr73@gmail.com';

    // ── Claude 추출 규칙(system 프롬프트). 기사→방문장소 정밀 추출. (2026-07) ──
    //  ★규칙 수정은 이 상수만 고치면 다음 수집부터 반영(Claude 에 매 호출 system 으로 전송).
    const EXTRACT_MODEL  = 'claude-sonnet-5';
    const EXTRACT_SYSTEM = <<<'SYS'
당신은 국내 여행 기사에서 '기사가 비중 있게 소개하는 방문 장소'만 정확히 추출하는 전문가입니다.

[채택 기준 — 매우 중요]
- 기사가 실제로 3개 문장(약 3줄) 이상, 또는 하나의 독립된 문단으로 '구체적으로 설명'하는 장소만 채택합니다.
- 총정리·베스트N·목록형 기사도 같은 기준을 적용합니다(이름만 짧게 나열된 곳은 제외).
- 다음은 모두 제외합니다:
  · 한두 줄만 스쳐 언급된 곳(위치·교통 설명 중 이름만, 인근 연계 소개)
  · 향후 계획/예정으로만 언급된 곳
  · 행정기관·터미널·일반명사 등 방문 여행지가 아닌 것
- 이미 채택한 상위 장소의 내부/부속 요소(같은 경내·부지 안의 다리·누각·전시관·정원 내 조형물 등)는
  별도로 채택하지 말고 상위 장소에 포함합니다. (예: 사찰 안 돌다리 → 사찰 하나로)

[각 채택 장소 필드]
- name: 기사 표기 그대로의 장소명
- category: travel | restaurant | cafe | stay | etc  (방문 목적 기준)
- address: 기사에 명시된 주소가 있으면 그대로, 없으면 ""  (절대 추측 금지)
- region: "시도 시군구" 형식 (예: "강원 춘천시", "제주 서귀포시")
- desc: 그 장소를 한 문장으로 압축(마커·목록 표시용, 40~60자)
- summary: 추천 판단용 요약. 3~5문장(200~350자). 아래 6개 축을 '기사에 있는 만큼' 일관되게 담습니다
  (없는 정보는 지어내지 말고 생략). 자연스러운 문장으로 씁니다.
    ① 유형·지형(무엇인가: 호숫가 정원/용암동굴/해변 등)
    ② 핵심 볼거리·활동(왜 가는가)
    ③ 추천 시기·소요·난이도(계절/월, 걷는 거리, 등산 여부)
    ④ 비용·주차·접근(무료/유료, 주차, 차·대중교통·캠핑카 진입 가능 여부)
    ⑤ 분위기·대상(가족/연인/혼자/반려동물)
    ⑥ 이 곳만의 차별점
- features: 특성 태그 배열. 아래 어휘에서 해당하는 것만 고름(없으면 []).
    지형: 호수, 바다, 해변, 계곡, 강, 산, 숲, 섬, 동굴, 폭포, 정원, 습지, 도심
    활동: 물놀이, 산책, 트레킹, 전망, 야경, 일출, 일몰, 캠핑, 오토캠핑, 드라이브, 사진, 축제
    편의: 무료, 유료, 반려동물, 아이동반, 주차, 실내, 대중교통
- months: 방문하기 좋은 월 숫자 배열(1~12). 기사에 계절·시기 단서가 있으면 반영(없으면 []).

[출력] 오직 아래 JSON만 출력(설명·코드펜스 금지):
{"places":[{"name":"","category":"","address":"","region":"","desc":"","summary":"","features":[""],"months":[]}],"excluded":[{"name":"","reason":""}]}
SYS;

    private ?string $cacheDir;
    private string  $cookieJar;   // 세션 쿠키 저장 파일 (페이지네이션이 세션에 의존)
    private bool    $warmed = false;

    /** @param ?string $cacheDir 원본 HTML 캐시 폴더(같은 페이지 재요청 방지). null 이면 캐시 끔 */
    public function __construct(?string $cacheDir = null)
    {
        $this->cacheDir = $cacheDir;
        if ($cacheDir && !is_dir($cacheDir)) @mkdir($cacheDir, 0777, true);
        $this->cookieJar = ($cacheDir ?: sys_get_temp_dir()) . '/ardent_cookies.txt';
    }

    // ======================================================
    // HTTP — cURL + 재시도(지수 백오프) + 선택적 캐시
    // ======================================================
    /** @return ?string 본문 HTML, 실패 시 null */
    public function httpGet(string $url, ?string $cacheKey = null, int $maxRetry = 3, array $extraHeaders = []): ?string
    {
        // 캐시 우선
        $cacheFile = $this->cacheKeyToFile($cacheKey);
        if ($cacheFile && is_file($cacheFile)) {
            $c = file_get_contents($cacheFile);
            if ($c !== false && $c !== '') return $c;
        }

        $attempt = 0;
        while ($attempt < $maxRetry) {
            $attempt++;
            $ch = curl_init($url);
            curl_setopt_array($ch, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_MAXREDIRS      => 3,
                CURLOPT_TIMEOUT        => 15,
                CURLOPT_CONNECTTIMEOUT => 8,
                CURLOPT_USERAGENT      => self::UA,
                CURLOPT_HTTPHEADER     => array_merge(['Accept: text/html,application/xhtml+xml', 'Accept-Language: ko-KR,ko', 'From: ' . self::CONTACT], $extraHeaders),
                CURLOPT_REFERER        => self::HOST . '/news/articleList.html?sc_sub_section_code=S2N3&view_type=sm',
                CURLOPT_COOKIEJAR      => $this->cookieJar, // 세션 쿠키 저장
                CURLOPT_COOKIEFILE     => $this->cookieJar, // 저장된 쿠키 전송 (페이지네이션 세션 유지)
                CURLOPT_SSL_VERIFYPEER => true,
                CURLOPT_ENCODING       => '', // gzip 등 자동 해제
            ]);
            $body = curl_exec($ch);
            $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);

            if ($body !== false && $code >= 200 && $code < 300 && $body !== '') {
                $body = self::toUtf8($body);
                if ($cacheFile) @file_put_contents($cacheFile, $body);
                return $body;
            }
            // 실패 → 지수 백오프 후 재시도 (1s, 2s, 4s)
            if ($attempt < $maxRetry) sleep(1 << ($attempt - 1));
        }
        return null;
    }

    private function cacheKeyToFile(?string $key): ?string
    {
        if (!$this->cacheDir || !$key) return null;
        return rtrim($this->cacheDir, '/\\') . '/' . preg_replace('/[^a-zA-Z0-9_\-]/', '_', $key) . '.html';
    }

    /** 응답을 UTF-8 로 정규화 (사이트가 EUC-KR 일 가능성 대비) */
    private static function toUtf8(string $html): string
    {
        // meta charset 확인
        if (preg_match('/charset\s*=\s*["\']?\s*(euc-kr|ks_c_5601-1987|cp949)/i', $html)) {
            $conv = @mb_convert_encoding($html, 'UTF-8', 'CP949');
            if ($conv !== false) return $conv;
        }
        if (!mb_check_encoding($html, 'UTF-8')) {
            $conv = @mb_convert_encoding($html, 'UTF-8', 'CP949,EUC-KR,UTF-8');
            if ($conv !== false) return $conv;
        }
        return $html;
    }

    // ======================================================
    // 목록 페이지 → idxno 목록
    // ======================================================
    public function fetchListIdxnos(int $page): array
    {
        // AJAX 페이지네이션(JSON). Referer(섹션목록) + X-Requested-With 헤더로 보호 통과.
        $json = $this->httpGet(sprintf(self::LIST_AJAX, $page), null, 3, [
            'X-Requested-With: XMLHttpRequest',
            'Accept: application/json, text/javascript, */*; q=0.01',
        ]);
        return self::parseListJson($json);
    }

    /** ajaxArticlePaging.php JSON 응답에서 idxno 추출 (data[].idxno) */
    public static function parseListJson(?string $json): array
    {
        if (!$json) return [];
        $d = json_decode($json, true);
        $rows = $d['data'] ?? null;
        if (!is_array($rows)) return [];
        $seen = [];
        foreach ($rows as $row) {
            $id = (int)($row['idxno'] ?? 0);
            if ($id > 0) $seen[$id] = true;
        }
        return array_keys($seen);
    }

    /**
     * 목록 페이지에서 본문 리스트의 idxno 만 추출(중복 제거, 순서 유지).
     * ★ 본문 목록 = <section id="section-list"> 영역. 그 뒤의 class="auto-article"
     *   (인기기사·추천 위젯)은 매 페이지 동일하므로 반드시 제외해야 페이지네이션이 동작.
     */
    public static function parseListIdxnos(?string $html): array
    {
        if (!$html) return [];

        // 본문 목록 영역만 스코프: section-list 시작 ~ 첫 auto-article(사이드바) 직전
        $scope = $html;
        $start = stripos($html, 'section-list');
        if ($start !== false) {
            $rest = substr($html, $start);
            $cut  = stripos($rest, 'auto-article');
            $scope = $cut !== false ? substr($rest, 0, $cut) : $rest;
        }

        if (!preg_match_all('/articleView\.html\?idxno=(\d+)/', $scope, $m)) return [];
        $seen = [];
        foreach ($m[1] as $id) {
            $id = (int)$id;
            if ($id > 0) $seen[$id] = true; // key 로 dedup (썸네일/제목/리드 3중 링크 합침)
        }
        return array_keys($seen);
    }

    // ======================================================
    // 기사 상세 → 표준 입력 포맷
    // ======================================================
    public function fetchArticle(int $idxno): ?string
    {
        return $this->httpGet(sprintf(self::VIEW_URL, $idxno), "view_{$idxno}");
    }

    /**
     * 상세 HTML 파싱 → 추출 결과.
     * @return array ['ok'=>bool, 'reason'=>string, 'meta'=>array, 'item'=>array|null]
     *   ok=false 면 reason 에 skip 사유(필터 A 등). item 은 {place, ref} 표준 포맷.
     */
    public static function parseArticle(?string $html, int $idxno): array
    {
        if (!$html) {
            return ['ok' => false, 'reason' => 'HTML 없음(요청 실패)', 'meta' => [], 'item' => null];
        }

        $meta = self::extractMeta($html);
        $title   = $meta['og:title']                ?? '';
        $url     = $meta['og:url']                  ?? sprintf(self::VIEW_URL, $idxno);
        $section = $meta['classification']          ?? ($meta['article:section1'] ?? ($meta['article:section'] ?? ''));
        $pubRaw  = $meta['article:published_time']  ?? '';
        $author  = $meta['author']                  ?? '';
        $thumb   = $meta['og:image']                ?? '';
        $kwRaw   = $meta['keywords']                ?? '';

        // 본문 영역만 추출(저장 안 함, 정규식 입력용)
        $bodyText = self::extractBodyText($html);

        // keywords: "경기도 포천시,비둘기낭 폭포,한탄강…" → [0]=지역, [1]=장소명 경향
        $keywords = array_values(array_filter(array_map('trim', explode(',', $kwRaw)), fn($s) => $s !== ''));

        // ── 본문 정규식 추출 ──────────────────────────
        $address   = self::extractAddress($bodyText, $keywords);
        $phone     = self::extractPhone($bodyText);
        $hours     = self::extractHours($bodyText);
        $admission = self::extractAdmission($bodyText);

        // 장소명: keywords 장소형 접미어 → 비지역 토큰 → 본문 최빈 장소명
        $name = self::pickName($keywords, $title, $bodyText);

        // ── 필터(A): 국내여행 섹션 + (주소 또는 지역) 추출돼야 적재 ──
        $isTravel = ($section === '') ? true : (mb_strpos($section, self::SECTION) !== false); // 섹션 메타 없으면 일단 통과(본문조건으로 거름)
        if (!$isTravel) {
            return ['ok' => false, 'reason' => "비여행 섹션({$section})", 'meta' => $meta, 'item' => null];
        }
        if ($address === '' && $name === '') {
            return ['ok' => false, 'reason' => '주소·장소명 추출 실패(여행 무관 추정)', 'meta' => $meta, 'item' => null];
        }

        // 지역 분해
        [$lv1, $lv2, $lv3] = self::splitRegion($address, $keywords);
        if ($name === '' && $lv2 !== '') $name = $lv2; // 최후 보루

        // 카테고리 추정
        $category = self::guessCategory($keywords, $title);

        // ── 표준 입력 포맷 구성 ──────────────────────
        $attributes = array_filter([
            'hours'       => $hours,
            'admission'   => $admission,
            'keywords'    => $keywords ?: null,
            'thumbnail'   => $thumb ?: null,
            'source_site' => 'ardentnews',
        ], fn($v) => $v !== '' && $v !== null && $v !== []);

        $place = array_filter([
            'name'           => $name,
            'category'       => $category,
            'address'        => $address ?: null,
            'region_lv1'     => $lv1 ?: null,
            'region_lv2'     => $lv2 ?: null,
            'region_lv3'     => $lv3 ?: null,
            'phone'          => $phone ?: null,
            'geocode_status' => 'pending', // 좌표는 배치에서
            'attributes'     => $attributes ?: null,
        ], fn($v) => $v !== null && $v !== '');

        $ref = array_filter([
            'source_type'  => 'article',
            'title'        => $title ?: null,
            'url'          => $url,
            'summary'      => self::makeSummary($meta, $name, $lv2),
            'published_at' => self::isoToDate($pubRaw),
            'extra'        => array_filter([
                'author'    => $author ?: null,
                'idxno'     => $idxno,
                'thumbnail' => $thumb ?: null,
                'keywords'  => $keywords ?: null,
            ], fn($v) => $v !== null && $v !== ''),
        ], fn($v) => $v !== null && $v !== '');

        return [
            'ok'     => true,
            'reason' => '',
            'meta'   => $meta,
            'item'   => ['place' => $place, 'ref' => $ref],
        ];
    }

    // ======================================================
    // Claude(AI) 추출 — 기사 본문 → 방문장소 목록(JSON)
    // ======================================================
    /**
     * 기사 제목+본문을 Claude 에 넣어 '비중 있게 소개된 방문 장소'만 추출.
     * @return array ['ok'=>bool, 'places'=>[{name,category,address,region,desc,features[],months[]}],
     *                'excluded'=>[{name,reason}], 'in'=>int, 'out'=>int, 'error'=>?string]
     */
    public static function extractPlacesAI(string $title, string $bodyText, string $apiKey, ?string $model = null): array
    {
        $user = trim($title . "\n\n" . $bodyText);
        if ($user === '')   return ['ok' => false, 'error' => '빈 본문', 'places' => [], 'excluded' => []];
        if ($apiKey === '') return ['ok' => false, 'error' => 'API 키 없음', 'places' => [], 'excluded' => []];

        $r = self::claudeCall($apiKey, $model ?: self::EXTRACT_MODEL, self::EXTRACT_SYSTEM, $user);
        if (!$r['ok']) return ['ok' => false, 'error' => $r['error'], 'places' => [], 'excluded' => []];

        $txt = trim(preg_replace('/^```json|```$/m', '', trim($r['text'])));
        $j = json_decode($txt, true);
        if (!is_array($j) || !isset($j['places'])) {
            return ['ok' => false, 'error' => 'JSON 파싱 실패', 'raw' => $r['text'],
                    'places' => [], 'excluded' => [], 'in' => $r['in'], 'out' => $r['out']];
        }
        // 최소 정규화
        $places = [];
        foreach (($j['places'] ?? []) as $p) {
            $nm = trim((string)($p['name'] ?? ''));
            if ($nm === '') continue;
            $places[] = [
                'name'     => $nm,
                'category' => in_array(($p['category'] ?? ''), ['travel','restaurant','cafe','stay','etc'], true) ? $p['category'] : 'travel',
                'address'  => trim((string)($p['address'] ?? '')),
                'region'   => trim((string)($p['region'] ?? '')),
                'desc'     => trim((string)($p['desc'] ?? '')),
                'summary'  => trim((string)($p['summary'] ?? '')),
                'features' => array_values(array_filter(array_map('trim', (array)($p['features'] ?? [])), fn($s) => $s !== '')),
                'months'   => array_values(array_filter(array_map('intval', (array)($p['months'] ?? [])), fn($m) => $m >= 1 && $m <= 12)),
            ];
        }
        return ['ok' => true, 'places' => $places, 'excluded' => $j['excluded'] ?? [],
                'in' => $r['in'], 'out' => $r['out']];
    }

    /** Anthropic Messages API 호출(raw cURL). @return ['ok'=>bool,'text'=>str,'in'=>int,'out'=>int,'error'=>?str] */
    private static function claudeCall(string $key, string $model, string $system, string $user): array
    {
        $body = ['model' => $model, 'max_tokens' => 2048, 'system' => $system,
                 'messages' => [['role' => 'user', 'content' => $user]]];
        // 추출은 사고 불필요 → Sonnet/Opus 는 thinking off(비용·지연 절감). Haiku 는 파라미터 불필요.
        if (strpos($model, 'sonnet') !== false || strpos($model, 'opus') !== false) {
            $body['thinking'] = ['type' => 'disabled'];
        }
        $ch = curl_init('https://api.anthropic.com/v1/messages');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true, CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => json_encode($body, JSON_UNESCAPED_UNICODE), CURLOPT_TIMEOUT => 120,
            CURLOPT_HTTPHEADER => ['x-api-key: ' . $key, 'anthropic-version: 2023-06-01', 'content-type: application/json'],
        ]);
        $resp = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $cerr = curl_error($ch);
        curl_close($ch);
        if ($resp === false) return ['ok' => false, 'error' => 'cURL: ' . $cerr];
        $j = json_decode($resp, true);
        if ($code !== 200 || !is_array($j)) {
            return ['ok' => false, 'error' => ($j['error']['message'] ?? ('HTTP ' . $code . ' ' . substr((string)$resp, 0, 200)))];
        }
        $t = '';
        foreach (($j['content'] ?? []) as $b) if (($b['type'] ?? '') === 'text') $t .= $b['text'];
        return ['ok' => true, 'text' => $t,
                'in' => (int)($j['usage']['input_tokens'] ?? 0), 'out' => (int)($j['usage']['output_tokens'] ?? 0)];
    }

    // ======================================================
    // 파싱 헬퍼들
    // ======================================================

    /** 모든 <meta> 를 [name|property(소문자) => content] 맵으로 */
    public static function extractMeta(string $html): array
    {
        $out = [];
        if (!preg_match_all('/<meta\b[^>]*>/i', $html, $tags)) return $out;
        foreach ($tags[0] as $tag) {
            $key = '';
            if (preg_match('/\b(?:name|property)\s*=\s*"([^"]+)"/i', $tag, $k)) $key = strtolower(trim($k[1]));
            elseif (preg_match("/\b(?:name|property)\s*=\s*'([^']+)'/i", $tag, $k)) $key = strtolower(trim($k[1]));
            if ($key === '') continue;
            $val = '';
            if (preg_match('/\bcontent\s*=\s*"([^"]*)"/i', $tag, $c)) $val = $c[1];
            elseif (preg_match("/\bcontent\s*=\s*'([^']*)'/i", $tag, $c)) $val = $c[1];
            if ($val === '' && !isset($out[$key])) $out[$key] = '';
            elseif ($val !== '') $out[$key] = html_entity_decode($val, ENT_QUOTES | ENT_HTML5, 'UTF-8');
        }
        return $out;
    }

    /**
     * 본문 컨테이너만 떼어내 태그 제거한 평문(정규식 입력용, 저장 안 함).
     * 중첩 div 에 잘리지 않도록 "본문 시작 위치 → 저작권/편집자 마커"까지 통째로 잡고,
     * footer(신문사 연락처 등)는 마커에서 잘라 오추출을 방지한다.
     */
    public static function extractBodyText(string $html): string
    {
        // 1) 스크립트/스타일 먼저 제거 → JS 안의 'article-view-content-div' 참조가 사라짐
        $clean = preg_replace('/<script\b[^>]*>.*?<\/script>/is', ' ', $html);
        $clean = preg_replace('/<style\b[^>]*>.*?<\/style>/is', ' ', $clean);

        // 2) 본문 컨테이너 위치(이제 진짜 div) 찾아 여는 태그 '>' 다음부터
        $body = $clean;
        $pos = stripos($clean, 'article-view-content-div');
        if ($pos !== false) {
            $gt   = strpos($clean, '>', $pos);
            $rest = substr($clean, $gt !== false ? $gt + 1 : $pos);
            // 본문 끝 추정 마커에서 컷 (가장 먼저 나오는 것 → footer 신문사 연락처 등 제거)
            $endMarkers = ['저작권자', '무단전재', '무단 전재', 'id="article-bottom', 'class="view-editors',
                           'id="article-view-footer', 'class="copyright'];
            $cut = strlen($rest);
            foreach ($endMarkers as $mk) {
                $ep = stripos($rest, $mk);
                if ($ep !== false && $ep < $cut) $cut = $ep;
            }
            $body = substr($rest, 0, $cut);
        } elseif (preg_match('/<article\b[^>]*>(.*?)<\/article>/is', $clean, $m)) {
            $body = $m[1];
        }
        $body = preg_replace('/<br\s*\/?>/i', "\n", $body);
        $text = html_entity_decode(strip_tags($body), ENT_QUOTES | ENT_HTML5, 'UTF-8');
        $text = preg_replace('/[ \t\x{00A0}]+/u', ' ', $text);
        return trim($text);
    }

    /** 시/도 목록(정규식용) */
    private static function sidoPattern(): string
    {
        return '서울|부산|대구|인천|광주|대전|울산|세종|경기|강원|충청북도|충청남도|충북|충남|'
             . '전라북도|전라남도|전북|전남|경상북도|경상남도|경북|경남|제주';
    }

    /** 본문 괄호 안 또는 keywords 에서 한국 주소 추출 */
    public static function extractAddress(string $bodyText, array $keywords): string
    {
        $sido = self::sidoPattern();
        // 1) 괄호 안: (경기도 포천시 영북면 대회산리 415-2)
        if (preg_match('/[(（]\s*((?:' . $sido . ')[가-힣A-Za-z0-9·\s\-]{2,80}?)\s*[)）]/u', $bodyText, $m)) {
            return self::normalizeAddrForGeo(self::cleanAddr($m[1]));
        }
        // 2) 본문 평문 중 도로명/지번 패턴
        if (preg_match('/((?:' . $sido . ')[가-힣]*\s+[가-힣]+(?:시|군|구)\s+[가-힣0-9][가-힣0-9·\s\-]{2,60}?\d)/u', $bodyText, $m)) {
            return self::normalizeAddrForGeo(self::cleanAddr($m[1]));
        }
        return '';
    }

    /** 지오코딩을 방해하는 꼬리말(일원/일대/연안/인근…) 제거 → 네이버가 읽을 수 있는 주소로 */
    private static function normalizeAddrForGeo(string $s): string
    {
        $s = preg_replace('/(\s+(일원|일대|인근|연안|주변|앞|내|등|지역|방면|쪽))+\s*$/u', '', $s);
        return trim($s);
    }

    private static function cleanAddr(string $s): string
    {
        $s = preg_replace('/\s+/u', ' ', trim($s));
        return $s;
    }

    public static function extractPhone(string $bodyText): string
    {
        if (preg_match('/\b(0\d{1,2}-\d{3,4}-\d{4})\b/', $bodyText, $m)) return $m[1];
        return '';
    }

    public static function extractHours(string $bodyText): string
    {
        // 09:00~18:00 / 09:00 - 18:00
        if (preg_match('/(\d{1,2}:\d{2}\s*[~\-–]\s*\d{1,2}:\d{2})/u', $bodyText, $m)) {
            return preg_replace('/\s+/', '', $m[1]);
        }
        // 오전 9시부터 오후 6시까지
        if (preg_match('/(오전\s*\d{1,2}시[^,\.\n]{0,12}?오후\s*\d{1,2}시[^,\.\n]{0,6}?까지)/u', $bodyText, $m)) {
            return self::cleanAddr($m[1]);
        }
        return '';
    }

    public static function extractAdmission(string $bodyText): string
    {
        // 입장료/관람료/이용료 (는/은/가/이 등 조사 허용) + 무료 또는 금액
        if (preg_match('/(?:입장료|관람료|이용료)\s*[:：]?\s*(?:는|은|가|이|:)?\s*(무료|0\s*원|[\d,]+\s*원)/u', $bodyText, $m)) {
            return preg_replace('/\s+/', '', $m[1]);
        }
        // 무료 입장/개방/관람/이용
        if (preg_match('/무료\s*(?:입장|개방|관람|이용|운영)/u', $bodyText)) return '무료';
        return '';
    }

    /** 장소형 접미어(이걸로 끝나면 관광지 이름일 확률 높음) */
    const PLACE_SUFFIX = '폭포|계곡|구곡|해수욕장|해변|해안|바닷가|수목원|자연휴양림|휴양림|생태공원|공원|유원지'
        . '|저수지|호수|동굴|전망대|구름다리|출렁다리|왕릉|고분군|고분|능원|사찰|산성|읍성|향교|서원|고택'
        . '|항|포구|등대|정원|숲길|둘레길|벽화마을|한옥마을|민속마을|마을|전통시장|시장|온천|식물원|동물원'
        . '|미술관|박물관|기념관|타워|대교|폭포|섬|봉|재|령|성당|성지|놀이공원|테마파크|아쿠아리움';

    /**
     * 장소명 추출 3단계:
     *   1) keywords 중 장소형 접미어를 가진 토큰 (예: "돌머리해수욕장")
     *   2) keywords 중 지역명(시/도/시군구)이 아닌 토큰
     *   3) 본문에서 장소형 접미어 명사 최빈값 (keywords 에 장소명 없을 때, 예: "이끼폭포")
     */
    private static function pickName(array $keywords, string $title, string $bodyText): string
    {
        $sfx  = self::PLACE_SUFFIX;
        $sido = self::sidoPattern();

        // 1) keywords 중 장소형 접미어 토큰 우선
        foreach ($keywords as $kw) {
            if (mb_strlen($kw) >= 2 && preg_match('/(?:' . $sfx . ')$/u', $kw)) return $kw;
        }
        // 2) keywords 중 지역명/시군구명 아닌 토큰
        foreach ($keywords as $kw) {
            if (mb_strlen($kw) < 2) continue;
            if (preg_match('/^(?:' . $sido . ')[가-힣\s]*?(시|군|구|도)?$/u', $kw) && mb_strlen($kw) <= 8) continue;
            if (preg_match('/^[가-힣]{2,4}(시|군|구)$/u', $kw)) continue; // 단독 시군구명 스킵
            return $kw;
        }
        // 3) 본문에서 장소형 접미어 명사 최빈값
        if (preg_match_all('/([가-힣]{2,10}(?:' . $sfx . '))/u', $bodyText, $mm)) {
            $cnt = array_count_values($mm[1]);
            arsort($cnt);
            return (string)array_key_first($cnt);
        }
        return '';
    }

    /** 주소/keywords 에서 region_lv1/2/3 분해. lv1 표기 통일(경기도→경기 등) */
    public static function splitRegion(string $address, array $keywords): array
    {
        $src = $address;
        if ($src === '' && $keywords) $src = $keywords[0]; // keywords 첫 토큰이 보통 "경기도 포천시"
        $src = self::cleanAddr($src);
        $parts = preg_split('/\s+/u', $src);
        $lv1 = $parts[0] ?? '';
        $lv2 = $parts[1] ?? '';
        $lv3 = $parts[2] ?? '';
        // lv1 정규화
        $map = [
            '서울특별시'=>'서울','부산광역시'=>'부산','대구광역시'=>'대구','인천광역시'=>'인천',
            '광주광역시'=>'광주','대전광역시'=>'대전','울산광역시'=>'울산','세종특별자치시'=>'세종',
            '경기도'=>'경기','강원도'=>'강원','강원특별자치도'=>'강원','충청북도'=>'충북','충청남도'=>'충남',
            '전라북도'=>'전북','전북특별자치도'=>'전북','전라남도'=>'전남','경상북도'=>'경북','경상남도'=>'경남',
            '제주특별자치도'=>'제주','제주도'=>'제주',
        ];
        $lv1 = $map[$lv1] ?? preg_replace('/(특별자치도|특별자치시|특별시|광역시|도)$/u', '', $lv1);
        // lv3 가 읍/면/동/리 가 아니면 비움
        if ($lv3 !== '' && !preg_match('/(읍|면|동|리|가)$/u', $lv3)) $lv3 = '';
        return [$lv1, $lv2, $lv3];
    }

    private static function guessCategory(array $keywords, string $title): string
    {
        $hay = mb_strtolower(implode(' ', $keywords) . ' ' . $title);
        if (preg_match('/맛집|식당|음식점|먹거리|restaurant/u', $hay)) return 'restaurant';
        return 'travel';
    }

    /** 짧은 한 줄 요약(200자 이내) — 본문 전문 저장 금지 원칙. og:description 일부 활용 */
    private static function makeSummary(array $meta, string $name, string $lv2): string
    {
        $desc = $meta['og:description'] ?? ($meta['description'] ?? '');
        $desc = trim(preg_replace('/\s+/u', ' ', $desc));
        if ($desc !== '') return mb_substr($desc, 0, 200);
        return trim(($lv2 !== '' ? $lv2 . ' ' : '') . $name);
    }

    private static function isoToDate(string $iso): ?string
    {
        if ($iso === '') return null;
        $ts = strtotime($iso);
        return $ts ? date('Y-m-d', $ts) : null;
    }
}
