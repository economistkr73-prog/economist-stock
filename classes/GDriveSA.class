<?php
/**
 * GDriveSA — 구글 드라이브 서비스계정(SA) 공통 인증 헬퍼
 *
 * 목적: 비공개("제한됨") 드라이브 폴더를 API 키 대신 서비스계정(Bearer 토큰)으로 접근.
 *   - 여행 사진(Travel.class)·인증 이미지 프록시(travel_thumb.php / travel_video.php)가 공용으로 사용
 *   - 명함 스캔(Contact.class)은 자체 SA 로직을 이미 갖고 있어 당장 변경하지 않음(위험 회피)
 *
 * 의존: env/gdrive.inc (GDRIVE_SA_JSON = 서비스계정 JSON 키 경로)
 *   ⚠️ 이 SA 이메일을 대상 드라이브 폴더에 '뷰어' 이상으로 공유해야 접근 가능.
 */
class GDriveSA
{
    private static ?string $token = null;   // 요청 단위 액세스 토큰 캐시

    public static function enabled(): bool
    {
        return defined('GDRIVE_SA_JSON') && GDRIVE_SA_JSON !== '' && is_file(GDRIVE_SA_JSON);
    }

    /** SA JSON → JWT(RS256) → 액세스 토큰 (drive.readonly 스코프). 실패 시 null. */
    public static function token(): ?string
    {
        if (self::$token !== null) return self::$token !== '' ? self::$token : null;
        self::$token = '';
        if (!self::enabled()) return null;

        $sa = json_decode((string)file_get_contents(GDRIVE_SA_JSON), true);
        if (!$sa || empty($sa['client_email']) || empty($sa['private_key'])) return null;

        // 디스크 캐시 확인 (프로세스 간 공유 → 이미지 요청마다 반복되던 oauth 왕복 제거)
        $cacheFile = self::tokenCacheFile($sa['client_email']);
        if (is_file($cacheFile)) {
            $cc = json_decode((string)file_get_contents($cacheFile), true);
            if (!empty($cc['access_token']) && !empty($cc['expires_at']) && $cc['expires_at'] > time()) {
                self::$token = $cc['access_token'];
                return self::$token;
            }
        }

        $b64 = fn($x) => rtrim(strtr(base64_encode($x), '+/', '-_'), '=');
        $now = time();
        $signInput = $b64(json_encode(['alg' => 'RS256', 'typ' => 'JWT'])) . '.' .
            $b64(json_encode([
                'iss'   => $sa['client_email'],
                'scope' => 'https://www.googleapis.com/auth/drive.readonly',
                'aud'   => $sa['token_uri'] ?? 'https://oauth2.googleapis.com/token',
                'iat'   => $now,
                'exp'   => $now + 3600,
            ]));
        if (!openssl_sign($signInput, $sig, $sa['private_key'], OPENSSL_ALGO_SHA256)) return null;
        $jwt = $signInput . '.' . $b64($sig);

        $ch = curl_init($sa['token_uri'] ?? 'https://oauth2.googleapis.com/token');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST           => true,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_TIMEOUT        => 30,
            CURLOPT_POSTFIELDS     => http_build_query([
                'grant_type' => 'urn:ietf:params:oauth:grant-type:jwt-bearer',
                'assertion'  => $jwt,
            ]),
        ]);
        $res = curl_exec($ch);
        curl_close($ch);
        $d = json_decode((string)$res, true);
        if (empty($d['access_token'])) return null;
        self::$token = $d['access_token'];

        // 디스크 캐시에 저장 (만료 5분 여유). 웹루트 밖 임시폴더 + 0600 = 토큰 노출 방지
        $ttl = (int)($d['expires_in'] ?? 3600);
        @file_put_contents($cacheFile, json_encode([
            'access_token' => self::$token,
            'expires_at'   => time() + max(60, $ttl - 300),
        ]), LOCK_EX);
        @chmod($cacheFile, 0600);

        return self::$token;
    }

    /** SA 토큰 디스크 캐시 경로 (웹루트 밖 시스템 임시폴더 — 직접 URL 접근 불가) */
    private static function tokenCacheFile(string $email): string
    {
        return sys_get_temp_dir() . '/econ_gsa_' . substr(sha1($email), 0, 16) . '.json';
    }

    /** curl 용 Authorization 헤더 배열 (['Authorization: Bearer xxx']) — 토큰 없으면 []. */
    public static function authHeader(): array
    {
        $t = self::token();
        return $t === null ? [] : ['Authorization: Bearer ' . $t];
    }
}
?>