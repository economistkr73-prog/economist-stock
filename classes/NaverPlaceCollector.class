<?php
/**
 * NaverPlaceCollector — 네이버 지도 "OO {카테고리}" 검색 결과 수집 + 추이 스냅샷.
 *
 *  · 카테고리(CATS)       : food(맛집)/stay(스테이)/camping(캠핑장). 검색 접미사·요청 경로·
 *                          place.category·수집 임계가 카테고리마다 다르다.
 *  · fetchRegion(q,cat)  : pcmap.place.naver.com 검색 페이지를 완전 브라우저 헤더로 받아
 *                          window.__APOLLO_STATE__ 의 항목들을 표준 레코드로 파싱.
 *                          맛집=restaurant/list, 그 외=place/list(네이버가 업종 판단해 302 리다이렉트,
 *                          캠핑장→accommodation/list 로 자동 전환. FOLLOWLOCATION 으로 따라감).
 *  · parseApollo(html)   : PlaceListBusinessesItem(맛집·일반) + AccommodationSearchItem(숙박·캠핑)
 *                          두 typename 모두 수집. normalizeItem 이 필드 폴백으로 한 형태로 통일.
 *  · selectByRule(items,cat): 리뷰순. 카테고리별 임계(food=1000/500, stay·camping=낮춤).
 *  · ingestOne(rec,...)  : findDuplicate(좌표250m+이름, 보수 재검증) -> 중복=보강 / 신규=upsert.
 *                          어느 경로든 recordStat() 로 (naver_id,period,category) 스냅샷 1행 적재(멱등).
 *  · 추이 조회           : periods()/trendList()/series() — MariaDB 윈도우함수 LAG 로 전월 대비 델타.
 *                          category 필터 지원(맛집/캠핑장/스테이 탭).
 *
 *  cron_naver_collect.php(전국 시군구 월1회·cat별)와 place_review.php(수동 적재)가 공유한다.
 *
 *  ※ 테이블: place_naver_stat(추이) / naver_collect_region(지역 마스터) / naver_collect_log(회차 진행).
 *  ※ place/place_ref/place_tag 적재는 Place 클래스 재사용.
 */
class NaverPlaceCollector
{
    private PDO    $pdo;
    private Place  $place;
    private ?array $chainSet = null;   // 체인 브랜드 집합(lazy, place_chain_brand)

    const BASE_URL = 'https://pcmap.place.naver.com';
    const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36';

    /**
     * 수집 카테고리 정의. key = 내부 식별자(=place.category, =stat.category).
     *   suffix    : 검색어 접미사("OO {suffix}")
     *   path      : pcmap 요청 경로. 'place' 면 네이버가 업종 판단해 적절히 302 리다이렉트.
     *   label     : 사람용 라벨(대시보드 탭)
     *   thr/max   : 수집 임계·최대. big = 리뷰>=thr_big 곳이 big_n 초과(큰 지역) 시, 아니면 sm.
     *   map       : true 면 place 테이블(단일 마스터)에 적재 → 지도 마커 후보. 캠핑·스테이도
     *               2026-06 통합으로 모두 true(과밀은 지도쪽 '뷰포트 상위 N개' 표시로 통제).
     *               false 면 place 미적재·추이 스냅샷만(현재 사용 안 함).
     */
    /**
     * 숙박 업종 화이트리스트(ncat 부분일치).
     * '스테이'·'캠핑장'은 키워드 검색이라 이름에 접미사가 든 비숙박(식당·카페·바·스튜디오·
     * 스터디카페·도서관 등)이 섞임 → 네이버 업종이 숙박류일 때만 통과시킨다.
     * (2026-06-18 종로구 스테이·가평 캠핑장 실측으로 업종 어휘 확정)
     */
    const LODGE_RE = '/숙박|숙소|호텔|모텔|여관|여인숙|펜션|게스트하우스|민박|리조트|콘도|레지던스|템플스테이|글램핑|캠핑|카라반|풀빌라|호스텔|료칸|비앤비|야영/u';

    const CATS = [
        'food'    => ['suffix' => '맛집',   'path' => 'restaurant', 'label' => '맛집', 'map' => true,
                      'thr_big' => 1000, 'max_big' => 100, 'thr_sm' => 500, 'max_sm' => 50, 'big_n' => 20],
        'stay'    => ['suffix' => '스테이', 'path' => 'place',      'label' => '스테이', 'map' => true,
                      'thr_big' => 10,   'max_big' => 60,  'thr_sm' => 10,  'max_sm' => 40, 'big_n' => 15,
                      'ncat_re' => self::LODGE_RE,
                      // 보조 검색어: "OO 스테이" 는 이름에 '스테이'가 든 숙소만 잡혀 펜션이 대거 누락된다
                      // (캠핑/오토캠핑처럼 부분겹침 다른 슬라이스). "OO 펜션" 을 합집합(naver_id 중복제거)으로
                      // 더해 펜션을 포괄한다. LODGE_RE에 '펜션'이 있어 업종 화이트리스트는 그대로 통과. (2026-06-19)
                      'alt_suffixes' => ['펜션']],
        'camping' => ['suffix' => '캠핑장', 'path' => 'place',      'label' => '캠핑장', 'map' => true,
                      'thr_big' => 200,  'max_big' => 60,  'thr_sm' => 50,  'max_sm' => 40, 'big_n' => 15,
                      'ncat_re' => self::LODGE_RE,
                      // 보조 검색어: "OO 캠핑장" 과 "OO 오토캠핑" 은 결과가 절반만 겹치는 다른 슬라이스
                      // (각 100개 컷·랭킹 상이)라, 둘 다 훑어 합집합(naver_id 중복제거)으로 적재해야
                      // 글램핑·카라반·야영장 + 오토캠핑장을 모두 포괄한다. (2026-06-18 실측)
                      'alt_suffixes' => ['오토캠핑']],
    ];

    /** 유효 카테고리 키인지(미정의면 food). */
    public static function cat(string $c): string { return isset(self::CATS[$c]) ? $c : 'food'; }
    public static function catLabel(string $c): string { return self::CATS[self::cat($c)]['label']; }

    /** 카테고리의 검색 접미사 목록(기본 + 보조). camping = ['캠핑장','오토캠핑'], 그 외 1개. */
    public static function suffixes(string $c): array
    {
        $cc = self::CATS[self::cat($c)];
        return array_merge([$cc['suffix']], $cc['alt_suffixes'] ?? []);
    }

    /**
     * 시드 쿼리("프리픽스 기본접미사")의 접미사를 다른 접미사로 교체.
     *   altQuery('강원 평창군 캠핑장', '캠핑장', '오토캠핑') → '강원 평창군 오토캠핑'
     * (접미사는 항상 끝에 붙으므로 끝의 기본접미사만 떼어내고 교체)
     */
    public static function altQuery(string $baseQuery, string $primarySuffix, string $altSuffix): string
    {
        $prefix = preg_replace('/\s*' . preg_quote($primarySuffix, '/') . '\s*$/u', '', $baseQuery);
        return trim($prefix . ' ' . $altSuffix);
    }

    public function __construct(PDO $pdo)
    {
        $this->pdo   = $pdo;
        $this->place = new Place($pdo);
        $this->place->ensureTable();
    }

    /** 이름의 브랜드 키 = 첫 공백 토큰(스타벅스 강남점 → 스타벅스). */
    public static function brandKey(string $name): string
    {
        $t = preg_split('/\s+/u', trim($name));
        return $t[0] ?? '';
    }

    /** 체인 브랜드 집합(lazy). place_chain_brand → [brand => true]. 테이블 없으면 빈 배열. */
    private function chainBrands(): array
    {
        if ($this->chainSet !== null) return $this->chainSet;
        $this->chainSet = [];
        try {
            $rows = $this->pdo->query("SELECT brand FROM place_chain_brand")->fetchAll(PDO::FETCH_COLUMN);
            foreach ($rows as $b) $this->chainSet[(string)$b] = true;
        } catch (\Throwable $e) { /* 테이블 미존재 → 필터 없음 */ }
        return $this->chainSet;
    }

    public function place(): Place { return $this->place; }

    // ============================================================
    //  테이블
    // ============================================================
    public function ensureTables(): void
    {
        $this->pdo->exec(
            "CREATE TABLE IF NOT EXISTS place_naver_stat (
                id          BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                place_id    BIGINT UNSIGNED NOT NULL,
                naver_id    VARCHAR(32)     NULL,
                period      CHAR(7)         NOT NULL,
                category    VARCHAR(16)     NOT NULL DEFAULT 'food',
                score       DECIMAL(3,2)    NULL,
                review      INT             NULL,
                visitor     INT             NULL,
                blog        INT             NULL,
                save        INT             NULL,
                name        VARCHAR(160)    NULL,
                region      VARCHAR(80)     NULL,
                captured_at DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (id),
                UNIQUE KEY uq_place_period (place_id, period),
                KEY idx_period (period),
                KEY idx_cat_period (category, period),
                KEY idx_naver  (naver_id),
                CONSTRAINT fk_stat_place FOREIGN KEY (place_id)
                    REFERENCES place(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
        );
        $this->pdo->exec(
            "CREATE TABLE IF NOT EXISTS naver_collect_region (
                id         INT UNSIGNED NOT NULL AUTO_INCREMENT,
                category   VARCHAR(16)  NOT NULL DEFAULT 'food',
                region_lv1 VARCHAR(20)  NOT NULL,
                region_lv2 VARCHAR(40)  NOT NULL,
                query      VARCHAR(80)  NOT NULL,
                sort_order INT          NOT NULL DEFAULT 0,
                active     TINYINT      NOT NULL DEFAULT 1,
                PRIMARY KEY (id),
                UNIQUE KEY uq_region_cat (category, region_lv1, region_lv2)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
        );
        $this->pdo->exec(
            "CREATE TABLE IF NOT EXISTS naver_collect_log (
                id           BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                period       CHAR(7)         NOT NULL,
                region_id    INT UNSIGNED    NOT NULL,
                status       VARCHAR(12)     NOT NULL DEFAULT 'pending',
                found        INT             NOT NULL DEFAULT 0,
                ingested     INT             NOT NULL DEFAULT 0,
                http         INT             NULL,
                msg          VARCHAR(255)    NULL,
                collected_at DATETIME        NULL,
                PRIMARY KEY (id),
                UNIQUE KEY uq_period_region (period, region_id),
                KEY idx_status (period, status)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
        );
        // 한시적 공개 공유 링크 (랜덤 토큰 + 만료시각). 외부인은 이 토큰으로만 읽기전용 접근. cat=공유한 분류.
        $this->pdo->exec(
            "CREATE TABLE IF NOT EXISTS naver_trend_share (
                id         INT UNSIGNED NOT NULL AUTO_INCREMENT,
                cat        VARCHAR(16)  NOT NULL DEFAULT 'food',
                region     VARCHAR(80)  NULL,
                min_review INT          NOT NULL DEFAULT 0,
                sort       VARCHAR(20)  NOT NULL DEFAULT 'total_score',
                token      VARCHAR(64)  NOT NULL,
                expires_at DATETIME     NOT NULL,
                revoked    TINYINT(1)   NOT NULL DEFAULT 0,
                created_at DATETIME     DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (id),
                UNIQUE KEY uq_nts_token (token),
                KEY idx_nts_cat (cat)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
        );
        // 정합(reconcile) 감시 목록: 이번 회차에 소멸(직접검색 안나옴)한 유명점의 1차 스트라이크.
        // 다음 회차에도 안 나오면(2차) 폐업으로 판단해 place 삭제. place 삭제 시 FK CASCADE 로 함께 정리됨.
        $this->pdo->exec(
            "CREATE TABLE IF NOT EXISTS naver_reconcile_watch (
                place_id      BIGINT UNSIGNED NOT NULL,
                category      VARCHAR(16)     NOT NULL DEFAULT 'food',
                missed_period CHAR(7)         NOT NULL,
                naver_id      VARCHAR(32)     NULL,
                prev_review   INT             NULL,
                name          VARCHAR(160)    NULL,
                created_at    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (place_id),
                KEY idx_recon (category, missed_period),
                CONSTRAINT fk_recon_place FOREIGN KEY (place_id)
                    REFERENCES place(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
        );

        // ── 기존 설치(category 도입 전) 업그레이드: 멱등 ALTER (MariaDB IF [NOT] EXISTS) ──
        // 기존 행은 전부 맛집이므로 DEFAULT 'food' 로 채워진다.
        $alters = [
            "ALTER TABLE place_naver_stat     ADD COLUMN IF NOT EXISTS category VARCHAR(16) NOT NULL DEFAULT 'food' AFTER period",
            "ALTER TABLE place_naver_stat     ADD KEY IF NOT EXISTS idx_cat_period (category, period)",
            "ALTER TABLE naver_collect_region ADD COLUMN IF NOT EXISTS category VARCHAR(16) NOT NULL DEFAULT 'food' AFTER id",
            // region UNIQUE 재구성: (lv1,lv2) → (category,lv1,lv2). 안 하면 동일 시군구의
            // 다른 카테고리 시드가 옛 UNIQUE 와 충돌한다.
            "ALTER TABLE naver_collect_region DROP INDEX IF EXISTS uq_region",
            "ALTER TABLE naver_collect_region ADD UNIQUE KEY IF NOT EXISTS uq_region_cat (category, region_lv1, region_lv2)",
            // 공유 테이블에 공유시점 필터(지역·최소리뷰·정렬) 컬럼 추가(기존 설치 업그레이드)
            "ALTER TABLE naver_trend_share ADD COLUMN IF NOT EXISTS region VARCHAR(80) NULL AFTER cat",
            "ALTER TABLE naver_trend_share ADD COLUMN IF NOT EXISTS min_review INT NOT NULL DEFAULT 0 AFTER region",
            "ALTER TABLE naver_trend_share ADD COLUMN IF NOT EXISTS sort VARCHAR(20) NOT NULL DEFAULT 'total_score' AFTER min_review",
            // 공유시점 태그(칩) 필터 — 콤마로 이어붙인 cuisine 태그 목록(빈 문자열=태그필터 없음)
            "ALTER TABLE naver_trend_share ADD COLUMN IF NOT EXISTS tags VARCHAR(255) NOT NULL DEFAULT '' AFTER sort",
        ];
        foreach ($alters as $sql) {
            try { $this->pdo->exec($sql); } catch (\PDOException $e) { /* 이미 적용됨 등 — 무시 */ }
        }
    }

    // ============================================================
    //  지역 마스터 (전국 시군구 약 229개) — INSERT IGNORE 시드
    // ============================================================
    /**
     * 표준 시군구 목록을 naver_collect_region 에 시드. 반환=신규 삽입 건수.
     * @param string|null $only 특정 카테고리만 시드(null = CATS 전체)
     */
    public function seedRegions(?string $only = null): int
    {
        $ins = $this->pdo->prepare(
            "INSERT IGNORE INTO naver_collect_region (category, region_lv1, region_lv2, query, sort_order)
             VALUES (?,?,?,?,?)"
        );
        // 구(區) 분할로 폐기된 모(母)시: 모시 단위 수집을 중단(active=0)한다. 이제 시드는
        // 행정구(예: '성남시 분당구')만 넣으므로 옛 모시 행은 고아가 된다. place 마커·기존
        // 추이 스냅샷은 보존되며 active=0 은 가역적(되살리려면 active=1).
        $off = $this->pdo->prepare(
            "UPDATE naver_collect_region SET active = 0
              WHERE category = ? AND region_lv2 IN ('" . implode("','", self::SPLIT_PARENTS) . "')"
        );
        $cats = $only !== null ? [self::cat($only)] : array_keys(self::CATS);
        $n = 0;
        foreach ($cats as $category) {
            $suffix = self::CATS[$category]['suffix'];
            $order = 0;
            foreach (self::regionSeed() as $row) {
                [$lv1, $lv2, $short] = $row;
                $query = trim($short . ' ' . $lv2 . ' ' . $suffix);
                $ins->execute([$category, $lv1, $lv2, $query, $order++]);
                $n += $ins->rowCount();
            }
            $off->execute([$category]);
        }
        return $n;
    }

    /**
     * 행정구(일반구) 분할로 모(母)시 단위 수집이 폐기된 시 목록. seedRegions 가 이 행들을
     * active=0 으로 내린다. (광역시 자치구는 애초에 분리 시드돼 여기 해당 없음)
     */
    private const SPLIT_PARENTS = [
        '수원시', '성남시', '안양시', '안산시', '고양시', '용인시',
        '청주시', '천안시', '전주시', '포항시', '창원시',
    ];

    /** [ [시도, 시군구, 검색용 시도단축], ... ] */
    private static function regionSeed(): array
    {
        $map = [
            ['서울특별시', '서울', ['종로구','중구','용산구','성동구','광진구','동대문구','중랑구','성북구','강북구','도봉구','노원구','은평구','서대문구','마포구','양천구','강서구','구로구','금천구','영등포구','동작구','관악구','서초구','강남구','송파구','강동구']],
            ['부산광역시', '부산', ['중구','서구','동구','영도구','부산진구','동래구','남구','북구','해운대구','사하구','금정구','강서구','연제구','수영구','사상구','기장군']],
            ['대구광역시', '대구', ['중구','동구','서구','남구','북구','수성구','달서구','달성군','군위군']],
            ['인천광역시', '인천', ['중구','동구','미추홀구','연수구','남동구','부평구','계양구','서구','강화군','옹진군']],
            ['광주광역시', '광주', ['동구','서구','남구','북구','광산구']],
            ['대전광역시', '대전', ['동구','중구','서구','유성구','대덕구']],
            ['울산광역시', '울산', ['중구','남구','동구','북구','울주군']],
            ['세종특별자치시', '세종', ['세종시']],
            ['경기도', '경기', ['수원시 장안구','수원시 권선구','수원시 팔달구','수원시 영통구','성남시 수정구','성남시 중원구','성남시 분당구','의정부시','안양시 만안구','안양시 동안구','부천시','광명시','평택시','동두천시','안산시 상록구','안산시 단원구','고양시 덕양구','고양시 일산동구','고양시 일산서구','과천시','구리시','남양주시','오산시','시흥시','군포시','의왕시','하남시','용인시 처인구','용인시 기흥구','용인시 수지구','파주시','이천시','안성시','김포시','화성시','광주시','양주시','포천시','여주시','연천군','가평군','양평군']],
            ['강원특별자치도', '강원', ['춘천시','원주시','강릉시','동해시','태백시','속초시','삼척시','홍천군','횡성군','영월군','평창군','정선군','철원군','화천군','양구군','인제군','고성군','양양군']],
            ['충청북도', '충북', ['청주시 상당구','청주시 서원구','청주시 흥덕구','청주시 청원구','충주시','제천시','보은군','옥천군','영동군','증평군','진천군','괴산군','음성군','단양군']],
            ['충청남도', '충남', ['천안시 동남구','천안시 서북구','공주시','보령시','아산시','서산시','논산시','계룡시','당진시','금산군','부여군','서천군','청양군','홍성군','예산군','태안군']],
            ['전라북도', '전북', ['전주시 완산구','전주시 덕진구','군산시','익산시','정읍시','남원시','김제시','완주군','진안군','무주군','장수군','임실군','순창군','고창군','부안군']],
            ['전라남도', '전남', ['목포시','여수시','순천시','나주시','광양시','담양군','곡성군','구례군','고흥군','보성군','화순군','장흥군','강진군','해남군','영암군','무안군','함평군','영광군','장성군','완도군','진도군','신안군']],
            ['경상북도', '경북', ['포항시 남구','포항시 북구','경주시','김천시','안동시','구미시','영주시','영천시','상주시','문경시','경산시','의성군','청송군','영양군','영덕군','청도군','고령군','성주군','칠곡군','예천군','봉화군','울진군','울릉군']],
            ['경상남도', '경남', ['창원시 의창구','창원시 성산구','창원시 마산합포구','창원시 마산회원구','창원시 진해구','진주시','통영시','사천시','김해시','밀양시','거제시','양산시','의령군','함안군','창녕군','고성군','남해군','하동군','산청군','함양군','거창군','합천군']],
            ['제주특별자치도', '제주', ['제주시','서귀포시']],
        ];
        $out = [];
        foreach ($map as $prov) {
            [$lv1, $short, $list] = $prov;
            foreach ($list as $lv2) $out[] = [$lv1, $lv2, $short];
        }
        return $out;
    }

    // ============================================================
    //  fetch + 파싱
    // ============================================================
    /**
     * 한 검색어("OO 맛집")의 1페이지를 받아 표준 레코드 배열로 반환.
     * @return array ['ok'=>bool, 'http'=>int, 'items'=>[rec...], 'msg'=>string]
     */
    public function fetchRegion(string $query, string $category = 'food'): array
    {
        $path = self::CATS[self::cat($category)]['path'];
        $url = self::BASE_URL . '/' . $path . '/list?query=' . rawurlencode($query)
             . '&display=100&sortingOrder=reviewTotalCount';
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_MAXREDIRS      => 3,
            CURLOPT_TIMEOUT        => 20,
            CURLOPT_CONNECTTIMEOUT => 10,
            CURLOPT_ENCODING       => '',          // gzip 자동 해제
            CURLOPT_USERAGENT      => self::UA,
            CURLOPT_HTTPHEADER     => [
                'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8',
                'Accept-Language: ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7',
                'Cache-Control: no-cache',
                'Pragma: no-cache',
                'Sec-Ch-Ua: "Chromium";v="124", "Google Chrome";v="124", "Not-A.Brand";v="99"',
                'Sec-Ch-Ua-Mobile: ?0',
                'Sec-Ch-Ua-Platform: "Windows"',
                'Sec-Fetch-Dest: document',
                'Sec-Fetch-Mode: navigate',
                'Sec-Fetch-Site: none',
                'Sec-Fetch-User: ?1',
                'Upgrade-Insecure-Requests: 1',
            ],
        ]);
        $body = curl_exec($ch);
        $http = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $err  = curl_error($ch);
        curl_close($ch);

        if ($body === false || $body === '') {
            return ['ok' => false, 'http' => $http, 'items' => [], 'msg' => 'empty/curl: ' . $err];
        }
        if ($http === 429) {
            return ['ok' => false, 'http' => 429, 'items' => [], 'msg' => 'rate limited (429)'];
        }
        if ($http >= 400) {
            return ['ok' => false, 'http' => $http, 'items' => [], 'msg' => 'http ' . $http];
        }
        $items = $this->parseApollo((string)$body);
        return ['ok' => true, 'http' => $http, 'items' => $items, 'msg' => 'parsed ' . count($items)];
    }

    /** HTML 의 window.__APOLLO_STATE__ JSON 에서 PlaceListBusinessesItem 추출 -> 표준 레코드. */
    private function parseApollo(string $html): array
    {
        $pos = strpos($html, '__APOLLO_STATE__');
        if ($pos === false) return [];
        $brace = strpos($html, '{', $pos);
        if ($brace === false) return [];
        $json = self::extractBalanced($html, $brace);
        if ($json === '') return [];
        $state = json_decode($json, true);
        if (!is_array($state)) return [];

        // 맛집·일반 = PlaceListBusinessesItem / 숙박·캠핑 = AccommodationSearchItem
        $out = [];
        foreach ($state as $key => $val) {
            if (!is_array($val)) continue;
            $type = (string)($val['__typename'] ?? '');
            $isItem = $type === 'PlaceListBusinessesItem' || $type === 'AccommodationSearchItem'
                   || strpos((string)$key, 'PlaceListBusinessesItem') === 0
                   || strpos((string)$key, 'AccommodationSearchItem') === 0;
            if (!$isItem) continue;
            $rec = $this->normalizeItem($val);
            if ($rec !== null) $out[] = $rec;
        }
        return $out;
    }

    /** $html[$start] 가 '{' 일 때, 문자열/이스케이프를 고려해 짝이 맞는 '}' 까지 부분문자열 반환. */
    private static function extractBalanced(string $s, int $start): string
    {
        $len = strlen($s);
        $depth = 0; $inStr = false; $esc = false;
        for ($i = $start; $i < $len; $i++) {
            $c = $s[$i];
            if ($inStr) {
                if ($esc)            { $esc = false; }
                elseif ($c === '\\') { $esc = true; }
                elseif ($c === '"')  { $inStr = false; }
                continue;
            }
            if ($c === '"')      { $inStr = true; }
            elseif ($c === '{')  { $depth++; }
            elseif ($c === '}')  { $depth--; if ($depth === 0) return substr($s, $start, $i - $start + 1); }
        }
        return '';
    }

    /** Apollo item -> 표준 레코드(ingestOne 입력). 좌표 없으면 null. */
    private function normalizeItem(array $v): ?array
    {
        $name = trim((string)($v['name'] ?? ''));
        $lng  = isset($v['x']) && $v['x'] !== '' ? (float)$v['x'] : null;   // 경도
        $lat  = isset($v['y']) && $v['y'] !== '' ? (float)$v['y'] : null;   // 위도
        if ($name === '' || $lat === null || $lng === null) return null;

        // 방문자 리뷰 수: 맛집·스테이=visitorReviewCount / 캠핑(AccommodationSearchItem)=placeReviewCount 폴백
        $vrev = self::num($v['visitorReviewCount'] ?? ($v['placeReviewCount'] ?? null));
        $brev = self::num($v['blogCafeReviewCount'] ?? null);
        // 평점: visitorReviewScore 우선, 없으면 placeReviewScore. 0/빈값은 "평점 없음"(null).
        $sc = $v['visitorReviewScore'] ?? null;
        if ($sc === null || $sc === '') $sc = $v['placeReviewScore'] ?? null;
        $score = ($sc !== null && $sc !== '' && (float)$sc > 0) ? (float)$sc : null;
        $micro = '';
        if (isset($v['microReview'])) {
            if (is_string($v['microReview'])) $micro = trim($v['microReview']);
            elseif (is_array($v['microReview'])) $micro = trim((string)reset($v['microReview']));
        }
        $cat = trim((string)($v['category'] ?? ($v['businessCategory'] ?? '')));

        return [
            'name'     => $name,
            'lat'      => $lat,
            'lng'      => $lng,
            'road'     => trim((string)($v['roadAddress'] ?? '')),
            'addr'     => trim((string)($v['fullAddress'] ?? ($v['commonAddress'] ?? ($v['address'] ?? '')))),
            'phone'    => trim((string)($v['phone'] ?? ($v['virtualPhone'] ?? ''))),
            'ncat'     => $cat,
            'score'    => $score,
            'vrev'     => $vrev,
            'brev'     => $brev,
            'save'     => isset($v['saveCount']) && $v['saveCount'] !== '' ? (string)$v['saveCount'] : '',
            'nid'      => trim((string)($v['id'] ?? '')),
            'micro'    => $micro,
            'michelin' => !empty($v['michelinGuide']),
            'tv'       => !empty($v['broadcasts']) || !empty($v['broadcastInfo']),
        ];
    }

    /** "3,219" / "9,000+" 등 -> 정수. null/빈값 -> 0. */
    public static function num($v): int
    {
        if ($v === null) return 0;
        return (int)preg_replace('/[^0-9]/', '', (string)$v);
    }

    // ============================================================
    //  수집 규칙
    // ============================================================
    /**
     * 리뷰순 정렬 가정. 리뷰=vrev+brev. 임계·최대는 카테고리별(CATS).
     *   N = 리뷰>=thr_big 곳 수.  N>big_n -> (thr_big/max_big),  아니면 (thr_sm/max_sm).
     * 리뷰 내림차순으로 임계 이상만, 최대 개수까지.
     */
    public function selectByRule(array $items, string $category = 'food'): array
    {
        $category = self::cat($category);
        $c = self::CATS[$category];

        // 업종 필터(숙박 카테고리): 네이버 업종(ncat)이 숙박류일 때만 통과 → 비숙박 제거.
        if (!empty($c['ncat_re'])) {
            $re = $c['ncat_re'];
            $items = array_values(array_filter($items, static function ($it) use ($re) {
                $nc = (string)($it['ncat'] ?? '');
                return $nc !== '' && preg_match($re, $nc) === 1;
            }));
        }

        // 체인(프랜차이즈) 제외(맛집만): 이름 첫 토큰이 체인 브랜드면 '맛집'이 아니므로 버린다.
        if ($category === 'food') {
            $chain = $this->chainBrands();
            if ($chain) {
                $items = array_values(array_filter($items, function ($it) use ($chain) {
                    return !isset($chain[self::brandKey((string)($it['name'] ?? ''))]);
                }));
            }
        }

        foreach ($items as &$it) { $it['_review'] = (int)$it['vrev'] + (int)$it['brev']; }
        unset($it);
        usort($items, fn($a, $b) => $b['_review'] <=> $a['_review']);

        $nBig = 0;
        foreach ($items as $it) if ($it['_review'] >= $c['thr_big']) $nBig++;
        if ($nBig > $c['big_n']) { $thr = $c['thr_big']; $max = $c['max_big']; }
        else                     { $thr = $c['thr_sm'];  $max = $c['max_sm'];  }

        $sel = [];
        foreach ($items as $it) {
            if ($it['_review'] < $thr) break;       // 정렬돼 있으므로 이후는 모두 미만
            $sel[] = $it;
            if (count($sel) >= $max) break;
        }
        return $sel;
    }

    // ============================================================
    //  적재 (중복 보강 / 신규) + 추이 스냅샷
    // ============================================================
    /**
     * 한 레코드 적재. $regionLabel=시군구 라벨, $regionLv1=시도, $period='YYYY-MM'.
     * @return array ['name','action'=>new|enrich|skip, 'id'?, ...]
     */
    public function ingestOne(array $p, string $regionLabel, ?string $regionLv1, string $period, bool $write, string $category = 'food'): array
    {
        $category = self::cat($category);
        // place.category(마커 주분류): food=restaurant / stay=stay / camping=camping
        $placeCat = ['food' => 'restaurant', 'stay' => 'stay', 'camping' => 'camping'][$category] ?? 'restaurant';
        $name = trim((string)($p['name'] ?? ''));
        $lat  = isset($p['lat']) ? (float)$p['lat'] : null;
        $lng  = isset($p['lng']) ? (float)$p['lng'] : null;
        if ($name === '' || $lat === null || $lng === null) {
            return ['name' => $name, 'action' => 'skip', 'msg' => 'name/lat/lng 필요'];
        }

        $nid    = trim((string)($p['nid'] ?? ''));
        $url    = $nid !== '' ? "https://map.naver.com/p/entry/place/{$nid}" : '';
        $micro  = trim((string)($p['micro'] ?? ''));
        $road   = trim((string)($p['road'] ?? ''));
        $addr   = trim((string)($p['addr'] ?? ''));
        $best   = $addr !== '' ? $addr : $road;
        $phone  = trim((string)($p['phone'] ?? ''));
        $ncat   = trim((string)($p['ncat'] ?? ''));
        $visitor = (int)($p['vrev'] ?? 0);
        $blog    = (int)($p['brev'] ?? 0);
        $review  = $visitor + $blog;
        $score   = isset($p['score']) && $p['score'] !== null && $p['score'] !== '' ? (float)$p['score'] : null;
        $saveN   = self::num($p['save'] ?? null);

        $nv = array_filter([
            'id'      => $nid !== '' ? $nid : null,
            'score'   => $score,
            'review'  => $review ?: null,
            'visitor' => isset($p['vrev']) ? $visitor : null,
            'blog'    => isset($p['brev']) ? $blog : null,
            'save'    => isset($p['save']) && $p['save'] !== '' ? (string)$p['save'] : null,
            'micro'   => $micro !== '' ? $micro : null,
            'cat'     => $ncat ?: null,
            'url'     => $url ?: null,
        ], fn($v) => $v !== null && $v !== '');

        $tags = [];
        if ($ncat !== '')          $tags[] = ['kind' => 'cuisine', 'tag' => $ncat];
        if (!empty($p['michelin'])) $tags[] = ['kind' => 'cuisine', 'tag' => '미쉐린'];
        if (!empty($p['tv']))       $tags[] = ['kind' => 'cuisine', 'tag' => 'TV방영'];

        $statM = [
            'score' => $score, 'review' => $review, 'visitor' => $visitor,
            'blog'  => $blog,  'save'   => $saveN,  'name'    => $name,
            'region' => trim((string)$regionLabel), 'category' => $category,
        ];

        // naver_id 우선(고유키) → 없으면 같은 카테고리 안 이름+좌표(캠핑↔맛집 동명 오병합 방지).
        $dup = $this->findDuplicate($name, $lat, $lng, $placeCat, $nid);

        if ($dup) {
            // ── 오매칭/부속 리스팅 가드 ─────────────────────────────────────
            //   "이성당"(리뷰 6.9만)에 "이성당cafe"(리뷰 4.8천)처럼 다른 naver 업소가 접두+100m 로
            //   오매칭돼 유명점의 review_count/naver_id 를 덮어쓰고(추이엔 가짜 폭락) 지도 품질까지
            //   훼손하는 문제. 기존이 리뷰 많은 곳(≥1000)인데 신규가 그 절반 미만이면 다른(작은)
            //   리스팅으로 보고 스킵 — 유명점 데이터 보존. (네이버 리뷰수는 실제로 반토막나지 않음)
            $exRev = (int)$this->pdo->query('SELECT review_count FROM place WHERE id = ' . (int)$dup['id'])->fetchColumn();
            if ($exRev >= 1000 && $review < $exRev * 0.5) {
                return ['name' => $name, 'action' => 'skip', 'id' => $dup['id'], 'match' => $dup['name'],
                        'msg' => "mismatch guard (기존 리뷰 {$exRev} ≫ 신규 {$review})"];
            }
            if (!$write) {
                return ['name' => $name, 'action' => 'enrich', 'id' => $dup['id'], 'match' => $dup['name'], 'dist_m' => $dup['dist_m'], 'review' => $review];
            }
            $this->pdo->prepare(
                "UPDATE place SET
                    address      = IF(address IS NULL OR address = '', :addr, address),
                    phone        = IF(phone IS NULL OR phone = '', :phone, phone),
                    naver_id     = COALESCE(naver_id, :nid2),
                    attributes   = JSON_SET(COALESCE(attributes, JSON_OBJECT()), '$.naver', JSON_EXTRACT(:nv, '$')),
                    review_count = :rc,
                    score        = COALESCE(:sc, score),
                    save_count   = :sv,
                    updated_at   = NOW()
                 WHERE id = :id"
            )->execute([
                ':addr'  => $best !== '' ? mb_substr($best, 0, 500) : null,
                ':phone' => $phone !== '' ? mb_substr($phone, 0, 40) : null,
                ':nid2'  => $nid !== '' ? mb_substr($nid, 0, 32) : null,
                ':nv'    => json_encode($nv, JSON_UNESCAPED_UNICODE),
                ':rc'    => $review,
                ':sc'    => $score,
                ':sv'    => $saveN,
                ':id'    => $dup['id'],
            ]);
            if ($url !== '') $this->place->addRef($dup['id'], ['source_type' => 'official', 'title' => $name, 'url' => $url, 'summary' => $micro]);
            $this->place->addTags($dup['id'], $tags);
            $this->recordStat($nid, $period, (int)$dup['id'], $statM);
            return ['name' => $name, 'action' => 'enrich', 'id' => $dup['id'], 'match' => $dup['name']];
        }

        if (!$write) {
            return ['name' => $name, 'action' => 'new', 'addr' => $best, 'review' => $review];
        }
        $pid = $this->place->upsertPlace([
            'name'       => $name,
            'category'   => $placeCat,
            'address'    => $best !== '' ? $best : null,
            'region_lv1' => ($regionLv1 !== null && $regionLv1 !== '') ? $regionLv1 : null,
            'region_lv2' => $regionLabel !== '' ? $regionLabel : null,
            'lat'        => $lat,
            'lng'        => $lng,
            'phone'      => $phone !== '' ? $phone : null,
            'attributes' => $nv ? ['naver' => $nv] : null,
        ]);
        if ($pid > 0 && $url !== '') $this->place->addRef($pid, ['source_type' => 'official', 'title' => $name, 'url' => $url, 'summary' => $micro]);
        if ($pid > 0) $this->place->addTags($pid, $tags);
        if ($pid > 0) $this->recordStat($nid, $period, $pid, $statM);
        return ['name' => $name, 'action' => 'new', 'id' => $pid];
    }

    /** 추이 스냅샷 1행 (place_id+period 멱등). naver_id 는 정보용(어느 네이버 업소였는지). */
    public function recordStat(string $nid, string $period, int $placeId, array $m): void
    {
        if ($placeId <= 0 || $period === '') return;
        $st = $this->pdo->prepare(
            "INSERT INTO place_naver_stat (place_id, naver_id, period, category, score, review, visitor, blog, save, name, region)
             VALUES (:pid,:nid,:period,:category,:score,:review,:visitor,:blog,:save,:name,:region)
             ON DUPLICATE KEY UPDATE
                naver_id=VALUES(naver_id), category=VALUES(category), score=VALUES(score), review=VALUES(review),
                visitor=VALUES(visitor), blog=VALUES(blog), save=VALUES(save),
                name=VALUES(name), region=VALUES(region), captured_at=NOW()"
        );
        $st->execute([
            ':pid'      => $placeId,
            ':nid'      => $nid !== '' ? mb_substr($nid, 0, 32) : null,
            ':period'   => $period,
            ':category' => self::cat((string)($m['category'] ?? 'food')),
            ':score'    => isset($m['score']) && $m['score'] !== null ? (float)$m['score'] : null,
            ':review'   => isset($m['review'])  ? (int)$m['review']  : null,
            ':visitor'  => isset($m['visitor']) ? (int)$m['visitor'] : null,
            ':blog'     => isset($m['blog'])    ? (int)$m['blog']    : null,
            ':save'     => isset($m['save'])    ? (int)$m['save']    : null,
            ':name'     => isset($m['name'])   ? mb_substr((string)$m['name'], 0, 160) : null,
            ':region'   => isset($m['region']) ? mb_substr((string)$m['region'], 0, 80) : null,
        ]);
    }

    // ============================================================
    //  정합(reconcile) — 소멸 유명점 재분류
    //    이번 회차에 stat 이 사라진 유명점(전월 리뷰>=임계)을 업소명으로 직접검색:
    //      · 나옴(naver_id 일치 or 이름접두+300m+리뷰>=50%) → 이번 회차 실값으로 복구(recordStat)
    //        = "지역검색 100컷 누락"을 되살림.
    //      · 안나옴 → 1차는 감시목록 등록(보류), 다음 회차에도 안나오면 2차=폐업으로 place 삭제.
    //        (네이버 일시적 누락으로 인한 오삭제를 2회 확인으로 방지)
    //      · fetch 실패(429/빈응답) → 건드리지 않고 다음 호출 재시도.
    // ============================================================
    const RECON_MIN = ['food' => 1000, 'stay' => 300, 'camping' => 200];

    /** 'YYYY-MM' → 직전 달 'YYYY-MM'. */
    public static function prevPeriod(string $period): string
    {
        if (!preg_match('/^(\d{4})-(\d{2})$/', $period, $mm)) return $period;
        $y = (int)$mm[1]; $m = (int)$mm[2] - 1;
        if ($m < 1) { $m = 12; $y--; }
        return sprintf('%04d-%02d', $y, $m);
    }

    private static function havMeters(float $la1, float $lo1, float $la2, float $lo2): float
    {
        $R = 6371000.0;
        $dLa = deg2rad($la2 - $la1); $dLo = deg2rad($lo2 - $lo1);
        $a = sin($dLa / 2) ** 2 + cos(deg2rad($la1)) * cos(deg2rad($la2)) * sin($dLo / 2) ** 2;
        return $R * 2 * atan2(sqrt($a), sqrt(1 - $a));
    }

    /**
     * 소멸 후보 목록.
     *   $watched=false(1차): 전월 stat(리뷰>=min) 있고 이번달 stat 없음 + 아직 감시목록에 없음.
     *   $watched=true (2차): 감시목록(이전 회차 1차) 중 이번달 여전히 stat 없음.
     */
    private function reconcileList(string $period, string $prev, string $category, int $min, bool $watched): array
    {
        if ($watched) {
            $sql = "SELECT w.place_id, w.prev_review, w.naver_id,
                           COALESCE(w.name, p.name) AS sname,
                           p.name AS pname, p.lat, p.lng, p.region_lv1, p.region_lv2
                      FROM naver_reconcile_watch w
                      JOIN place p ON p.id = w.place_id
                     WHERE w.category = :c AND w.missed_period < :cur1
                       AND NOT EXISTS (SELECT 1 FROM place_naver_stat s
                                        WHERE s.place_id = w.place_id AND s.period = :cur2 AND s.category = :c2)
                     ORDER BY w.prev_review DESC";
            $st = $this->pdo->prepare($sql);
            $st->execute([':c' => $category, ':c2' => $category, ':cur1' => $period, ':cur2' => $period]);
            return $st->fetchAll(PDO::FETCH_ASSOC);
        }
        $sql = "SELECT pv.place_id, pv.review AS prev_review, pv.naver_id, pv.name AS sname,
                       p.name AS pname, p.lat, p.lng, p.region_lv1, p.region_lv2
                  FROM place_naver_stat pv
                  JOIN place p ON p.id = pv.place_id
                 WHERE pv.period = :prev AND pv.category = :c AND pv.review >= :min
                   AND NOT EXISTS (SELECT 1 FROM place_naver_stat s
                                    WHERE s.place_id = pv.place_id AND s.period = :cur AND s.category = :c2)
                   AND NOT EXISTS (SELECT 1 FROM naver_reconcile_watch w WHERE w.place_id = pv.place_id)
                 ORDER BY pv.review DESC";
        $st = $this->pdo->prepare($sql);
        $st->execute([':prev' => $prev, ':cur' => $period, ':c' => $category, ':c2' => $category, ':min' => $min]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 업소명 직접검색으로 후보를 찾는다. 반환 status = found(m=매칭 레코드) | closed | fail(http). */
    private function reconcileFind(array $r, string $category): array
    {
        $res = $this->fetchRegion((string)$r['sname'], $category);
        if (!$res['ok']) return ['status' => 'fail', 'http' => $res['http']];
        $tn   = self::dupNorm((string)$r['sname']);
        $tnid = trim((string)($r['naver_id'] ?? ''));
        $tRev = (int)($r['prev_review'] ?? 0);
        $tlat = (float)$r['lat']; $tlng = (float)$r['lng'];
        $nidHit = null; $strong = null;
        foreach ($res['items'] as $it) {
            $inid = trim((string)($it['nid'] ?? ''));
            if ($tnid !== '' && $inid === $tnid) {
                $it['_rev'] = (int)$it['vrev'] + (int)$it['brev']; $nidHit = $it; break;
            }
            $en = self::dupNorm((string)$it['name']);
            $nameEq = ($en === $tn) ||
                      (mb_strlen($tn) >= 3 && mb_strlen($en) >= 3 &&
                       (mb_strpos($en, $tn) !== false || mb_strpos($tn, $en) !== false));
            if (!$nameEq || empty($it['lat']) || empty($it['lng'])) continue;
            $d = self::havMeters($tlat, $tlng, (float)$it['lat'], (float)$it['lng']);
            $rev = (int)$it['vrev'] + (int)$it['brev'];
            if ($d <= 300 && $rev >= $tRev * 0.5) {
                if ($strong === null || $rev > $strong['_rev']) { $it['_rev'] = $rev; $strong = $it; }
            }
        }
        $m = $nidHit ?? $strong;
        return $m ? ['status' => 'found', 'm' => $m] : ['status' => 'closed'];
    }

    /** 나옴 → place 품질컬럼 + 이번 회차 stat 을 실값으로 복구(오매칭 가드 없이 = naver_id/이름 확정 매칭). */
    private function reconcileApplyFound(int $pid, array $m, string $period, string $category, ?string $region): void
    {
        $nid  = trim((string)($m['nid'] ?? ''));
        $rev  = (int)($m['_rev'] ?? ((int)($m['vrev'] ?? 0) + (int)($m['brev'] ?? 0)));
        $vis  = (int)($m['vrev'] ?? 0); $blog = (int)($m['brev'] ?? 0);
        $score = (isset($m['score']) && $m['score'] !== null && $m['score'] !== '') ? (float)$m['score'] : null;
        $saveN = self::num($m['save'] ?? null);
        $nv = array_filter([
            'id' => $nid ?: null, 'score' => $score, 'review' => $rev ?: null,
            'visitor' => $vis, 'blog' => $blog,
            'save' => (isset($m['save']) && $m['save'] !== '' ? (string)$m['save'] : null),
            'cat'  => (!empty($m['ncat']) ? $m['ncat'] : null),
            'url'  => ($nid ? "https://map.naver.com/p/entry/place/{$nid}" : null),
        ], fn($v) => $v !== null && $v !== '');
        $this->pdo->prepare(
            "UPDATE place SET naver_id = :nid, review_count = :rc, score = COALESCE(:sc, score),
                save_count = :sv,
                attributes = JSON_SET(COALESCE(attributes, JSON_OBJECT()), '$.naver', JSON_EXTRACT(:nv, '$')),
                updated_at = NOW() WHERE id = :id"
        )->execute([':nid' => $nid ?: null, ':rc' => $rev, ':sc' => $score, ':sv' => $saveN,
                    ':nv' => json_encode($nv, JSON_UNESCAPED_UNICODE), ':id' => $pid]);
        $this->recordStat($nid, $period, $pid, [
            'score' => $score, 'review' => $rev, 'visitor' => $vis, 'blog' => $blog, 'save' => $saveN,
            'name' => ($m['name'] ?? null), 'region' => $region, 'category' => $category,
        ]);
    }

    private function watchAdd(int $pid, string $category, string $period, int $prevReview, string $name, string $nid): void
    {
        $this->pdo->prepare(
            "INSERT INTO naver_reconcile_watch (place_id, category, missed_period, naver_id, prev_review, name)
             VALUES (:pid,:c,:p,:nid,:rev,:nm)
             ON DUPLICATE KEY UPDATE category=VALUES(category), missed_period=VALUES(missed_period),
                 naver_id=VALUES(naver_id), prev_review=VALUES(prev_review), name=VALUES(name)"
        )->execute([':pid' => $pid, ':c' => $category, ':p' => $period, ':nid' => $nid ?: null,
                    ':rev' => $prevReview, ':nm' => mb_substr($name, 0, 160)]);
    }

    /**
     * 이 카테고리·회차 정합 처리. $max=이번 호출 최대 건수, $deadline=microtime 종료시각.
     * self-drain: 복구=이번회차 stat 생김 / 감시=목록등록 / 삭제=place 제거 → 모두 후보집합에서 이탈.
     * 남은(fetch실패·예산초과) 건은 다음 호출에서 이어받음.
     */
    public function reconcile(string $period, string $category, bool $write, int $max, int $delay, float $deadline, int $minReview = 0): array
    {
        $category = self::cat($category);
        $prev = self::prevPeriod($period);
        $min  = $minReview > 0 ? $minReview : (self::RECON_MIN[$category] ?? 1000);

        // 0) 감시목록 자동정리(fetch 없이): 이번달 stat 이 생긴 곳(정기수집이 되살림)은 감시해제.
        $this->pdo->prepare(
            "DELETE w FROM naver_reconcile_watch w
              WHERE w.category = :c
                AND EXISTS (SELECT 1 FROM place_naver_stat s
                             WHERE s.place_id = w.place_id AND s.period = :cur AND s.category = :c2)"
        )->execute([':c' => $category, ':c2' => $category, ':cur' => $period]);

        $work = [];
        foreach ($this->reconcileList($period, $prev, $category, $min, true)  as $r) { $r['_pass'] = 2; $work[] = $r; }
        foreach ($this->reconcileList($period, $prev, $category, $min, false) as $r) { $r['_pass'] = 1; $work[] = $r; }

        $out = ['recovered'=>0, 'watched'=>0, 'deleted'=>0, 'failed'=>0,
                'rate'=>false, 'budget'=>false, 'processed'=>0, 'remaining'=>0, 'lines'=>[]];
        $n = 0; $tot = count($work);
        foreach ($work as $idx => $r) {
            if ($n >= $max)                    { $out['budget'] = true; break; }
            if (microtime(true) > $deadline)   { $out['budget'] = true; break; }
            $pid  = (int)$r['place_id']; $pass = (int)$r['_pass'];
            $find = $this->reconcileFind($r, $category);

            if ($find['status'] === 'fail') {
                $out['failed']++;
                $out['lines'][] = "  ⚠ {$r['pname']} fetch 실패(http{$find['http']})";
                if ((int)$find['http'] === 429) { $out['rate'] = true; break; }
            } elseif ($find['status'] === 'found') {
                if ($write) {
                    $this->reconcileApplyFound($pid, $find['m'], $period, $category, (string)$r['region_lv2']);
                    $this->pdo->prepare("DELETE FROM naver_reconcile_watch WHERE place_id = ?")->execute([$pid]);
                }
                $out['recovered']++;
                $out['lines'][] = "  ✓복구 {$r['pname']} 리뷰 {$r['prev_review']}→{$find['m']['_rev']}";
            } else { // closed
                if ($pass === 2) {
                    if ($write) $this->pdo->prepare("DELETE FROM place WHERE id = ?")->execute([$pid]); // CASCADE
                    $out['deleted']++;
                    $out['lines'][] = "  ✗삭제(2차) {$r['pname']} (전월 {$r['prev_review']}) — 폐업 확정";
                } else {
                    if ($write) $this->watchAdd($pid, $category, $period, (int)$r['prev_review'], (string)$r['sname'], (string)($r['naver_id'] ?? ''));
                    $out['watched']++;
                    $out['lines'][] = "  ⏳감시(1차) {$r['pname']} (전월 {$r['prev_review']}) — 다음 회차 재확인";
                }
            }
            $n++;
            if ($delay > 0 && $idx < $tot - 1) sleep($delay);
        }
        $out['processed'] = $n;
        // 남은 작업(예산·429로 미처리 + fetch실패 잔존) 재계산.
        $out['remaining'] = count($this->reconcileList($period, $prev, $category, $min, true))
                          + count($this->reconcileList($period, $prev, $category, $min, false));
        return $out;
    }

    // ── 중복 판정 (place_review.php 의 findDuplicate + 보수 재검증과 동일 규칙) ──
    private function findDuplicate(string $name, float $lat, float $lng, ?string $category = null, string $nid = ''): ?array
    {
        // 0) naver_id 정확 매칭 — 네이버 place id 는 업소 고유·안정키. 상호/분류가 바뀌어도
        //    같은 업소이며 리뷰 이력도 이어진다(예: 정다운식당→희경, 리뷰 27,656→27,694 승계).
        //    이름·좌표 기반 매칭이 놓치는 개명/이전을 잡아 '오라우팅'(같은 업소가 새 place 로 중복 생성)을 막는다.
        //    ★분류 무관 조회(맛집이 travel 등 다른 분류로 기존 등록된 경우도 동일 업소로 인식).
        //    ※ 소규모 부속 리스팅(○○cafe 등)은 naver_id 가 달라 여기서 안 걸리고, 이름매칭 경로의
        //      리뷰격차 가드(ingestOne)가 계속 차단한다.
        if ($nid !== '') {
            $st = $this->pdo->prepare("SELECT id, name FROM place WHERE naver_id = ? LIMIT 1");
            $st->execute([$nid]);
            if ($row = $st->fetch(PDO::FETCH_ASSOC)) {
                return ['id' => (int)$row['id'], 'name' => $row['name'], 'dist_m' => 0];
            }
        }
        // 1) 이름 + 좌표(250m) 매칭 — naver_id 가 없거나(신규 업소) 아직 place 에 미기록일 때.
        $tn = self::dupNorm($name);
        if ($tn === '') return null;
        $fc = $this->place->searchNearby($lat, $lng, 0.3, $category);
        $best = null;
        foreach (($fc['features'] ?? []) as $f) {
            $p = $f['properties'];
            $distM = (float)($p['dist_km'] ?? 9) * 1000;
            if ($distM > 250) continue;
            $en = self::dupNorm((string)($p['name'] ?? ''));
            if ($en === '') continue;
            $match = ($tn === $en) ||
                     (mb_strlen($tn) >= 3 && mb_strlen($en) >= 3 &&
                      (mb_strpos($en, $tn) !== false || mb_strpos($tn, $en) !== false));
            if (!$match) continue;
            if ($best === null || $distM < $best['dist_m']) {
                $best = ['id' => (int)$p['id'], 'name' => $p['name'], 'dist_m' => (int)round($distM)];
            }
        }
        if (!$best) return null;
        // 보수 재검증: 정확일치 OR 한쪽이 다른쪽 접두(브랜드)+100m 이내 일 때만 동일 업소.
        $en = self::dupNorm($best['name']);
        $prefix = ($tn !== '' && $en !== '' && (strpos($tn, $en) === 0 || strpos($en, $tn) === 0));
        $same   = ($tn === $en) || ($prefix && ($best['dist_m'] ?? 999) <= 100);
        return $same ? $best : null;
    }

    private static function dupNorm(string $s): string
    {
        return preg_replace('/[\s\-·,()\[\]]+/u', '', mb_strtolower(trim($s)));
    }

    // ============================================================
    //  추이 조회 (LAG 윈도우함수)
    // ============================================================
    /** 수집된 회차(period) 목록 — 최신순. category 지정 시 그 카테고리만. */
    public function periods(?string $category = null): array
    {
        if ($category !== null) {
            $st = $this->pdo->prepare(
                "SELECT DISTINCT period FROM place_naver_stat WHERE category = ? ORDER BY period DESC"
            );
            $st->execute([self::cat($category)]);
            return $st->fetchAll(PDO::FETCH_COLUMN);
        }
        return $this->pdo->query("SELECT DISTINCT period FROM place_naver_stat ORDER BY period DESC")
                         ->fetchAll(PDO::FETCH_COLUMN);
    }

    // 시도(광역) 검색용 — region 스냅샷은 시군구뿐이라 "대전" 등 시도로는 안 걸린다.
    //  시도명을 입력하면 place.address 접두로 매칭한다. 도명개정(전북특별자치도 등)·풀네임 혼재를
    //  address 실측(_diag_sido)으로 확정한 접두 목록. cf. places.php 의 plRegionLock 과 동일 발상.
    private const SIDO_PREFIX = [
        '서울' => ['서울'], '부산' => ['부산'], '대구' => ['대구'], '인천' => ['인천'], '광주' => ['광주'],
        '대전' => ['대전'], '울산' => ['울산'], '세종' => ['세종'], '경기' => ['경기'], '강원' => ['강원'],
        '충북' => ['충청북도', '충북'], '충남' => ['충청남도', '충남'],
        '전북' => ['전북', '전라북도'], '전남' => ['전라남도', '전남'],
        '경북' => ['경상북도', '경북'], '경남' => ['경상남도', '경남'], '제주' => ['제주'],
    ];
    private const SIDO_ALIAS = [
        '서울특별시' => '서울', '부산광역시' => '부산', '대구광역시' => '대구', '인천광역시' => '인천',
        '광주광역시' => '광주', '대전광역시' => '대전', '울산광역시' => '울산',
        '세종특별자치시' => '세종', '세종시' => '세종', '경기도' => '경기',
        '강원도' => '강원', '강원특별자치도' => '강원',
        '충청북도' => '충북', '충청남도' => '충남', '전라북도' => '전북', '전북특별자치도' => '전북',
        '전라남도' => '전남', '경상북도' => '경북', '경상남도' => '경남',
        '제주도' => '제주', '제주특별자치도' => '제주',
    ];

    /** 입력이 시도(단축·풀·별칭)면 주소 접두 목록 반환, 아니면 [] (=시군구로 취급). */
    public static function sidoPrefixes(string $in): array
    {
        $in = trim($in);
        if ($in === '') return [];
        if (isset(self::SIDO_PREFIX[$in])) return self::SIDO_PREFIX[$in];
        if (isset(self::SIDO_ALIAS[$in])) return self::SIDO_PREFIX[self::SIDO_ALIAS[$in]];
        return [];
    }

    /** 수집된 지역 목록 — 지역창 자동완성용. 시도(광역) 17개 + 시군구(가나다순). category 지정 시 그 카테고리만. */
    public function regions(?string $category = null): array
    {
        if ($category !== null) {
            $st = $this->pdo->prepare(
                "SELECT DISTINCT region FROM place_naver_stat
                  WHERE category = ? AND region IS NOT NULL AND region <> '' ORDER BY region"
            );
            $st->execute([self::cat($category)]);
            $gu = $st->fetchAll(PDO::FETCH_COLUMN);
        } else {
            $gu = $this->pdo->query(
                "SELECT DISTINCT region FROM place_naver_stat
                  WHERE region IS NOT NULL AND region <> '' ORDER BY region"
            )->fetchAll(PDO::FETCH_COLUMN);
        }
        // 시도명을 앞에(자동완성 상단) — "대전" 입력 시 대전 전체 검색 가능
        return array_values(array_unique(array_merge(array_keys(self::SIDO_PREFIX), $gu)));
    }

    // ============================================================
    //  한시적 공개 공유 (랜덤 토큰 + 만료/취소) — travel.php 패턴
    //   분류(cat)별 활성 링크 1개. 게스트는 ?share=token 으로 그 분류만 읽기전용.
    // ============================================================
    /**
     * 공유 링크 생성(기존 활성 링크는 무효화하고 새 토큰 1개 발급). 공유시점 필터(지역·최소리뷰·정렬)를 함께 고정.
     * @param array $opt region, min_review, sort
     * @return [token, expires_at, cat, region, min_review, sort]
     */
    public function createShare(string $cat, int $ttlSeconds, array $opt = []): array
    {
        $cat    = self::cat($cat);
        $ttl    = max(60, min($ttlSeconds, 90 * 24 * 3600));  // 1분~90일로 클램프
        $token  = bin2hex(random_bytes(16));                  // 추측 불가 32자리
        $region = isset($opt['region']) ? mb_substr(trim((string)$opt['region']), 0, 80) : '';
        $minr   = max(0, (int)($opt['min_review'] ?? 0));
        $sort   = mb_substr((string)($opt['sort'] ?? 'total_score'), 0, 20);
        // 공유시점 태그(칩) 고정 — 파이프(|) 조인 문자열로 정규화(네이버 태그에 콤마 있음·공백제거·최대 255자)
        $tagsIn = $opt['tags'] ?? '';
        if (!is_array($tagsIn)) $tagsIn = preg_split('/\|/', (string)$tagsIn, -1, PREG_SPLIT_NO_EMPTY);
        $tagsIn = array_values(array_filter(array_map('trim', $tagsIn), fn($t) => $t !== ''));
        $tags   = mb_substr(implode('|', array_slice($tagsIn, 0, 20)), 0, 255);
        // 같은 (분류, 지역) 의 기존 링크만 무효화 → 다른 지역(예: 관악구·성동구)은 동시 공유 유지
        $this->revokeShares($cat, $region);
        $this->pdo->prepare(
            "INSERT INTO naver_trend_share (cat, region, min_review, sort, tags, token, expires_at)
             VALUES (?, ?, ?, ?, ?, ?, DATE_ADD(NOW(), INTERVAL ? SECOND))"
        )->execute([$cat, $region, $minr, $sort, $tags, $token, $ttl]);
        $row = $this->getShareByToken($token);
        return ['token' => $token, 'expires_at' => $row['expires_at'] ?? null,
                'cat' => $cat, 'region' => $region, 'min_review' => $minr, 'sort' => $sort, 'tags' => $tags];
    }

    /** 토큰으로 유효한(미만료·미취소) 공유 조회 — 게스트 접근 검증용 */
    public function getValidShare(string $token): ?array
    {
        if ($token === '') return null;
        $st = $this->pdo->prepare(
            "SELECT * FROM naver_trend_share
              WHERE token = ? AND revoked = 0 AND expires_at > NOW() LIMIT 1"
        );
        $st->execute([$token]);
        return $st->fetch(PDO::FETCH_ASSOC) ?: null;
    }

    /**
     * 현재 활성 공유 1건 (소유자 화면에 기존 링크 표시용).
     * region 을 주면 그 (분류,지역) 의 활성 링크, null 이면 분류 통틀어 최신 1건.
     */
    public function getActiveShare(string $cat, ?string $region = null): ?array
    {
        $sql  = "SELECT * FROM naver_trend_share WHERE cat = ? AND revoked = 0 AND expires_at > NOW()";
        $args = [self::cat($cat)];
        if ($region !== null) { $sql .= " AND region = ?"; $args[] = mb_substr(trim($region), 0, 80); }
        $sql .= " ORDER BY id DESC LIMIT 1";
        $st = $this->pdo->prepare($sql);
        $st->execute($args);
        return $st->fetch(PDO::FETCH_ASSOC) ?: null;
    }

    /**
     * 활성 공유 즉시 차단. region 을 주면 그 (분류,지역) 만, null 이면 분류 전체.
     */
    public function revokeShares(string $cat, ?string $region = null): void
    {
        $sql  = "UPDATE naver_trend_share SET revoked = 1 WHERE cat = ?";
        $args = [self::cat($cat)];
        if ($region !== null) { $sql .= " AND region = ?"; $args[] = mb_substr(trim($region), 0, 80); }
        $this->pdo->prepare($sql)->execute($args);
    }

    private function getShareByToken(string $token): ?array
    {
        $st = $this->pdo->prepare("SELECT * FROM naver_trend_share WHERE token = ? LIMIT 1");
        $st->execute([$token]);
        return $st->fetch(PDO::FETCH_ASSOC) ?: null;
    }

    /**
     * 한 회차의 (카테고리별) 목록 + 직전 회차 대비 델타.
     * @param array $opt period(필수), category(food|stay|camping), region(LIKE), min_review,
     *                    sort(d_review|d_score|d_save|d_visitor|d_blog|review|score), dir(desc|asc), limit, offset
     */
    public function trendList(array $opt): array
    {
        $period = (string)($opt['period'] ?? '');
        if ($period === '') return ['period' => '', 'rows' => [], 'total' => 0];

        $sortable = ['d_review','d_score','d_save','d_visitor','d_blog',
                     'review','score','save','visitor','blog','total_score',
                     'rank_up','rank_down'];              // rank_* = 종합순위 전월대비 급등/급락
        $sort = in_array(($opt['sort'] ?? ''), $sortable, true) ? $opt['sort'] : 'total_score';
        $isMove = ($sort === 'rank_up' || $sort === 'rank_down');
        $metric = $isMove ? 'total_score' : $sort;         // 실제 랭킹/정렬 기준 컬럼
        $dir  = (strtolower((string)($opt['dir'] ?? 'desc')) === 'asc') ? 'ASC' : 'DESC';
        $limit  = max(1, min(500, (int)($opt['limit'] ?? 100)));
        $offset = max(0, (int)($opt['offset'] ?? 0));

        $where = ['period = :period'];
        $args  = [':period' => $period];
        if (!empty($opt['category'])) { $where[] = 'category = :category'; $args[':category'] = self::cat((string)$opt['category']); }
        if (!empty($opt['region'])) {
            // 시군구는 region 스냅샷 LIKE. 시도(대전 등)면 place.address 접두로도 매칭(region 엔 시도가 없음).
            $rg = trim((string)$opt['region']);
            $conds = ['region LIKE :region']; $args[':region'] = '%' . $rg . '%';
            $i = 0;
            foreach (self::sidoPrefixes($rg) as $pf) {
                $k = ':sidopf' . $i;
                $conds[] = "EXISTS(SELECT 1 FROM place p WHERE p.id = t.place_id AND p.address LIKE {$k})";
                $args[$k] = $pf . '%';
                $i++;
            }
            $where[] = '(' . implode(' OR ', $conds) . ')';
        }
        if (!empty($opt['min_review'])) { $where[] = 'review >= :minr'; $args[':minr'] = (int)$opt['min_review']; }
        // 태그(칩) 필터 — place_tag(kind=cuisine) 에 선택 태그가 하나라도 있으면 통과(OR).
        //   맛집=음식종류·스테이=숙박유형·캠핑=캠핑유형 이 모두 kind=cuisine 이라 category 는 이미 위에서 걸러짐.
        //   ★구분자는 파이프(|) — 네이버 태그에 콤마가 들어감("카페,디저트"·"칼국수,만두" 등)이라 콤마 불가.
        $tags = $opt['tags'] ?? '';
        if (!is_array($tags)) $tags = preg_split('/\|/', (string)$tags, -1, PREG_SPLIT_NO_EMPTY);
        $tags = array_values(array_filter(array_map('trim', $tags), fn($t) => $t !== ''));
        if ($tags) {
            $ph = [];
            foreach (array_slice($tags, 0, 20) as $i => $tg) { $k = ':tag' . $i; $ph[] = $k; $args[$k] = mb_substr($tg, 0, 40); }
            $where[] = "EXISTS(SELECT 1 FROM place_tag pt WHERE pt.place_id = t.place_id AND pt.kind = 'cuisine' AND pt.tag IN (" . implode(',', $ph) . "))";
        }
        $whereSql = implode(' AND ', $where);

        // 종합점수(0~100): 평점·리뷰·저장·방문·블로그를 가중 합산.
        //   카운트는 스케일 차가 커서 LOG10 로 압축(레퍼런스: 리뷰/방문 1e5, 저장 4e5, 블로그 5e4)·LEAST(1,..)로 상한.
        //   가중치 = 평점8 + 리뷰30 + 저장10 + 방문17 + 블로그35 = 100.
        //   ★평점은 리뷰가 비슷할 때의 변별력 보조 정도라 비중을 낮춤(리뷰/블로그 비중 상향).
        //   ★평점은 NULL(미평가)이 많다 → 0점 처리하면 리뷰 많은 곳이 부당하게 낮아짐.
        //     평점이 없으면 평점 항목을 분모에서도 제외하고 나머지(합 92)로 재정규화(×100/92).
        //     단, 카운트(리뷰·저장 등)의 0/NULL 은 진짜 '적음'이므로 그대로 0점 반영.
        $comp = function (string $sc, string $rv, string $vi, string $bl, string $sv): string {
            $counts = "30*LEAST(1, LOG10(COALESCE($rv,0)+1)/5)"
                    . " + 10*LEAST(1, LOG10(COALESCE($sv,0)+1)/5.6)"
                    . " + 17*LEAST(1, LOG10(COALESCE($vi,0)+1)/5)"
                    . " + 35*LEAST(1, LOG10(COALESCE($bl,0)+1)/4.7)";
            // 평점 있음: 8*평점 + 카운트 / 평점 없음: 카운트/92*100
            return "ROUND(CASE WHEN $sc IS NULL"
                 . " THEN ($counts) / 92 * 100"
                 . " ELSE 8*($sc/5) + ($counts) END, 1)";
        };
        $curComp  = $comp('score', 'review', 'visitor', 'blog', 'save');
        $prevComp = $comp('prev_score', 'prev_review', 'prev_visitor', 'prev_blog', 'prev_save');

        $base =
           "SELECT naver_id, period, category, place_id, name, region, score, review, visitor, blog, save,
                   prev_period,
                   score   - prev_score   AS d_score,
                   review  - prev_review  AS d_review,
                   visitor - prev_visitor AS d_visitor,
                   blog    - prev_blog    AS d_blog,
                   save    - prev_save    AS d_save,
                   {$curComp} AS total_score,
                   CASE WHEN prev_period IS NULL THEN NULL ELSE {$prevComp} END AS prev_total,
                   (SELECT p.address FROM place p WHERE p.id = t.place_id) AS address,
                   (SELECT p.lat FROM place p WHERE p.id = t.place_id) AS lat,
                   (SELECT p.lng FROM place p WHERE p.id = t.place_id) AS lng,
                   (SELECT JSON_UNQUOTE(JSON_EXTRACT(p.attributes, '$.summary'))
                      FROM place p WHERE p.id = t.place_id) AS summary
            FROM (
                SELECT naver_id, period, category, place_id, name, region, score, review, visitor, blog, save,
                       LAG(period)  OVER w AS prev_period,
                       LAG(score)   OVER w AS prev_score,
                       LAG(review)  OVER w AS prev_review,
                       LAG(visitor) OVER w AS prev_visitor,
                       LAG(blog)    OVER w AS prev_blog,
                       LAG(save)    OVER w AS prev_save
                FROM place_naver_stat
                WINDOW w AS (PARTITION BY place_id ORDER BY period)
            ) t
            WHERE {$whereSql}";

        $total = (int)$this->prepRun("SELECT COUNT(*) FROM ({$base}) c", $args)->fetchColumn();

        // ── 전월대비 순위 변동 ─────────────────────────────────────────────
        //   cur_rank  = 현재 정렬기준의 이번 회차 순위(필터 전체 집단 기준·RANK)
        //   prev_rank = 같은 기준으로 지난달 값을 매긴 순위(현재 집단 내 · 신규는 NULL)
        //   값(review 등)·종합점수 정렬에만 의미 있음. 증가순(d_*) 정렬은 prev_rank NULL.
        //   ★prev_<metric> = 현재값 - 델타 (예: review - d_review). prev_total 은 이미 산출됨.
        $prevRankMap = [
            'total_score' => 'prev_total',
            'review'  => '(review  - d_review)',
            'score'   => '(score   - d_score)',
            'save'    => '(save    - d_save)',
            'visitor' => '(visitor - d_visitor)',
            'blog'    => '(blog    - d_blog)',
        ];
        $curRankExpr  = $metric;                       // 랭킹 기준(급등/급락이면 종합점수)
        $prevRankExpr = $prevRankMap[$metric] ?? null; // 증가순(d_*) 정렬이면 순위변동 없음
        // ★순위(RANK)는 표시 순서와 반드시 동일한 정렬을 써야 한다. 표시 ORDER BY 의 타이브레이크
        //   (review DESC, place_id) 를 RANK 에도 넣어 동점끼리 유니크 순위를 매긴다. 안 그러면
        //   표시 순번(리뷰순 12·13·14)과 순위(동점 12·12·12)가 어긋나 배지가 위치변화와 반대로 보인다.
        //   prev_rank 는 지난달 표시순서 = 지난달 값(prev_*) 기준으로 동일 규칙 적용(prev_review = review - d_review).
        $curTie  = 'review DESC, place_id ASC';
        $prevTie = '(review - d_review) DESC, place_id ASC';
        $rankSel  = "RANK() OVER (ORDER BY ({$curRankExpr}) IS NULL, ({$curRankExpr}) {$dir}, {$curTie}) AS cur_rank";
        $rankSel .= $prevRankExpr !== null
            ? ", CASE WHEN b.prev_period IS NULL THEN NULL
                     ELSE RANK() OVER (ORDER BY ({$prevRankExpr}) IS NULL, ({$prevRankExpr}) {$dir}, {$prevTie}) END AS prev_rank"
            : ", NULL AS prev_rank";

        $inner = "SELECT b.*, {$rankSel} FROM ({$base}) b";
        if ($isMove) {
            // 급등순=많이 오른 순 / 급락순=많이 내린 순. 신규(prev_rank NULL)는 이동값 없어 제외.
            $mvDir = ($sort === 'rank_up') ? 'DESC' : 'ASC';
            $sql = "SELECT w.*, (w.prev_rank - w.cur_rank) AS rank_move
                    FROM ({$inner}) w
                    WHERE w.prev_rank IS NOT NULL
                    ORDER BY (w.prev_rank - w.cur_rank) {$mvDir}, w.cur_rank ASC
                    LIMIT {$limit} OFFSET {$offset}";
        } else {
            $sql = "SELECT w.* FROM ({$inner}) w
                    ORDER BY ({$sort}) IS NULL, {$sort} {$dir}, review DESC, place_id ASC
                    LIMIT {$limit} OFFSET {$offset}";
        }
        $rows = $this->prepRun($sql, $args)->fetchAll(PDO::FETCH_ASSOC);
        return ['period' => $period, 'rows' => $rows, 'total' => $total];
    }

    /**
     * 한 분류(+회차)의 태그(칩) 목록 — place_tag(kind=cuisine) 을 곳수 많은 순으로.
     * 칩바 채우기용. period 를 주면 그 회차에 실제 존재하는 태그만(빈 결과 칩 방지).
     * @return [{tag, c}, ...]
     */
    public function catTags(string $cat, string $period = ''): array
    {
        $cat  = self::cat($cat);
        $args = [':c' => $cat];
        $perW = '';
        if ($period !== '') { $perW = ' AND s.period = :p'; $args[':p'] = $period; }
        $sql = "SELECT pt.tag AS tag, COUNT(DISTINCT s.place_id) AS c
                  FROM place_naver_stat s
                  JOIN place_tag pt ON pt.place_id = s.place_id AND pt.kind = 'cuisine'
                 WHERE s.category = :c{$perW}
                 GROUP BY pt.tag
                HAVING c > 0
                ORDER BY c DESC, pt.tag ASC";
        $st = $this->pdo->prepare($sql);
        $st->execute($args);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 한 곳(place_id)의 전 회차 시계열 — 오래된 순. */
    public function series(int $placeId): array
    {
        $st = $this->pdo->prepare(
            "SELECT period, category, score, review, visitor, blog, save, name, region
               FROM place_naver_stat WHERE place_id = ? ORDER BY period ASC"
        );
        $st->execute([$placeId]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    private function prepRun(string $sql, array $args): PDOStatement
    {
        $st = $this->pdo->prepare($sql);
        $st->execute($args);
        return $st;
    }
}
