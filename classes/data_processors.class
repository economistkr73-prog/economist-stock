<?php
// 파일명: classes/data_processors.class

################################################################
// 1. ETF 데이터 처리 함수 (초고속 트랜잭션 & 무중단 업데이트 적용)
function process_etf_csv($pdo, $handle, $ref_date, $is_reset) { 

    // 💡 핵심 로직: 리셋 옵션이 켜져 있다면 테이블을 비우고 고유번호 초기화
    if ($is_reset === true || $is_reset === 'Y') {
        $pdo->exec("TRUNCATE TABLE all_etf_price");
    }

    // 🚀 최적화 1: 무중단 시세 갱신을 위한 ON DUPLICATE KEY UPDATE 방어막 추가
    $query = "INSERT INTO all_etf_price 
              (etf_code, etf_price, etf_rate, trading_value, market_cap, turnover_ratio, uDate) 
              VALUES (:code, :price, :rate, :t_val, :m_cap, :t_ratio, :uDate)
              ON DUPLICATE KEY UPDATE 
              etf_price = VALUES(etf_price), etf_rate = VALUES(etf_rate), 
              trading_value = VALUES(trading_value), market_cap = VALUES(market_cap), 
              turnover_ratio = VALUES(turnover_ratio), uDate = VALUES(uDate)";
              
    $stmt = $pdo->prepare($query);
    
    $success_count = 0;
    $header_skipped = false;

    // 🚀 [해결책] 진행 중인 트랜잭션이 없을 때만 새로 시작합니다!
    $is_transaction_owner = false;
    if (!$pdo->inTransaction()) {
        $pdo->beginTransaction();
        $is_transaction_owner = true; // 내가 트랜잭션을 시작했음을 기억함
    }

    try {
        while (($data = fgetcsv($handle, 1000, ",")) !== FALSE) {
            if (!$header_skipped) { $header_skipped = true; continue; }

            $raw_code   = trim($data[0]);
            $raw_price  = (float) str_replace(',', '', trim($data[2]));
            $raw_rate   = (float) str_replace(',', '', trim($data[4]));
            $raw_t_val  = (float) str_replace(',', '', trim($data[10]));
            $raw_m_cap  = (float) str_replace(',', '', trim($data[11]));

            $etf_code = str_pad($raw_code, 6, '0', STR_PAD_LEFT);
            $trading_value = $raw_t_val / 100000000;
            $market_cap    = $raw_m_cap / 100000000;
            $turnover_ratio = ($market_cap > 0) ? ($trading_value / $market_cap) * 100 : 0;

            $stmt->execute([
                ':code'    => $etf_code,
                ':price'   => $raw_price,
                ':rate'    => $raw_rate,
                ':t_val'   => round($trading_value, 2),
                ':m_cap'   => round($market_cap, 2),
                ':t_ratio' => round($turnover_ratio, 2),
                ':uDate'   => $ref_date
            ]);
            $success_count++;
        }

        // 🚀 [해결책] 내가 연 트랜잭션일 때만 여기서 닫습니다. (아니면 바깥쪽에서 닫게 둠)
        if ($is_transaction_owner) {
            $pdo->commit();
        }

    } catch (Exception $e) {
        // 🚀 [해결책] 에러가 났을 때도, 내가 연 트랜잭션만 롤백시킵니다.
        if ($is_transaction_owner && $pdo->inTransaction()) {
            $pdo->rollBack();
        }
        throw $e;
    }

    // 🚀 최적화 3: 데이터가 1건 이상 성공적으로 등록되었을 때만 후속 작업 실행
    if ($success_count > 0) {
        data_upTime('all_etf_price', 'update', $pdo);

        // 모든 시세가 업데이트 된 후, 마지막으로 요약 테이블 동기화!
        $stockRepo = new StockRepository($pdo);
        $stockRepo->refreshAllStockHoldingsInfo();
    }

    return $success_count;
}
################################################################

################################################################
// 2. 주식 데이터 처리 함수 (초고속 트랜잭션 & 무중단 업데이트 적용)
function process_stock_csv($pdo, $handle, $ref_date, $is_reset) { 
    
    // 💡 핵심 로직: 리셋 옵션이 켜져 있다면 테이블을 비우고 고유번호 초기화
    if ($is_reset === true || $is_reset === 'Y') {
        $pdo->exec("TRUNCATE TABLE all_stock_info");
    }

    // 🚀 최적화 1: 무중단 시세 갱신을 위한 ON DUPLICATE KEY UPDATE 방어막 추가
    $query = "INSERT INTO all_stock_info 
              (stock_code, stock_name, stock_price, stock_high_price, stock_yrate, stock_rate, stock_rate_rt, stock_vol, stock_vol_cap, stock_cap, stock_vol_tot) 
              VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
              ON DUPLICATE KEY UPDATE 
              stock_name = VALUES(stock_name),
              stock_price = VALUES(stock_price),
              stock_high_price = VALUES(stock_high_price),
              stock_yrate = VALUES(stock_yrate),
              stock_rate = VALUES(stock_rate),
              stock_rate_rt = VALUES(stock_rate_rt),
              stock_vol = VALUES(stock_vol),
              stock_vol_cap = VALUES(stock_vol_cap),
              stock_cap = VALUES(stock_cap),
              stock_vol_tot = VALUES(stock_vol_tot)";
              
    $stmt = $pdo->prepare($query);
    
    $success_count = 0;
    $header_skipped = false;

    // 🚀 [해결책] 진행 중인 트랜잭션이 없을 때만 새로 시작합니다!
    $is_transaction_owner = false;
    if (!$pdo->inTransaction()) {
        $pdo->beginTransaction();
        $is_transaction_owner = true; // 내가 트랜잭션을 시작했음을 기억함
    }

    try {
        while (($data = fgetcsv($handle, 1000, ",")) !== FALSE) {
            if (!$header_skipped) { $header_skipped = true; continue; }

            $stock_code = str_pad(trim($data[0]), 6, '0', STR_PAD_LEFT);
            $stock_name = trim(iconv("EUC-KR", "UTF-8//IGNORE", $data[1]));
            
            $stock_price      = (float) str_replace(',', '', trim($data[4] ?? 0));
            $stock_high_price = (float) str_replace(',', '', trim($data[8] ?? 0));
            $stock_yrate      = (float) str_replace(',', '', trim($data[5] ?? 0));
            $stock_rate       = (float) str_replace(',', '', trim($data[6] ?? 0));
            
            $raw_vol          = (float) str_replace(',', '', trim($data[10] ?? 0));
            $raw_vol_cap      = (float) str_replace(',', '', trim($data[11] ?? 0));
            $raw_cap          = (float) str_replace(',', '', trim($data[12] ?? 0));
            $raw_vol_tot      = (float) str_replace(',', '', trim($data[13] ?? 0));

            $stmt->execute([
                $stock_code, $stock_name, $stock_price, $stock_high_price, $stock_yrate, 
                $stock_rate, $stock_rate, $raw_vol, round($raw_vol_cap / 100000000, 2), 
                round($raw_cap / 100000000, 2), $raw_vol_tot
            ]);
            $success_count++;
        }
        
        // 🚀 [해결책] 내가 연 트랜잭션일 때만 여기서 닫습니다. (아니면 바깥쪽에서 닫게 둠)
        if ($is_transaction_owner) {
            $pdo->commit();
        }

    } catch (Exception $e) {
        // 🚀 [해결책] 에러가 났을 때도, 내가 연 트랜잭션만 롤백시킵니다.
        if ($is_transaction_owner && $pdo->inTransaction()) {
            $pdo->rollBack();
        }
        throw $e;
    }

    // 💡 최적화 3: 데이터가 성공적으로 1건 이상 들어갔을 때만 후속 작업 실행
    if ($success_count > 0) {
        // [1] 주식 테이블 업데이트 시간 기록
        data_upTime('all_stock_info', 'update', $pdo);

        // [2] 추세 분석(t1, t2, t3) 과거 데이터 빈칸 채우기!
        update_trend_analysis($pdo, $ref_date);
        
        // 🚀 [3] 모든 작업이 끝난 후, 가장 안전한 시점에 요약 테이블 동기화!
        $stockRepo = new StockRepository($pdo);
        $stockRepo->refreshAllStockHoldingsInfo();
    }

    return $success_count;
}
################################################################



################################################################
// 3. ETF 기본정보 처리 함수 (스마트 동기화 적용)
function process_etf_info_csv($pdo, $handle, $ref_date, $is_reset, $test_on = false) { 
    
    // 💡 1. 쿼리 업데이트: is_new 필드 추가
    // 최초 INSERT 될 때는 'Y', 이미 있어서 UPDATE 될 때는 'N'으로 자동 변경!
    $query = "INSERT INTO all_etf_info 
              (etf_code, etf_name, Listing_Date, classification, return_rate, underlying_index, total_nav, volatility, is_new) 
              VALUES (:code, :name, :date, :class, :rate, :index, :nav, :vol, 'Y')
              ON DUPLICATE KEY UPDATE 
              etf_name = VALUES(etf_name),
              classification = VALUES(classification),
              return_rate = VALUES(return_rate),
              underlying_index = VALUES(underlying_index),
              total_nav = VALUES(total_nav),
              volatility = VALUES(volatility),
              is_new = 'N'"; // 기존 데이터는 신규가 아니므로 N으로 업데이트
              
    $stmt = $pdo->prepare($query);
    
    $success_count = 0;
    $header_skipped = false;
    
    // 💡 2. 업로드된 ETF 코드를 모아둘 빈 배열 준비
    $uploaded_codes = []; 

    while (($line = fgets($handle)) !== false) {
        $line_utf8 = iconv("EUC-KR", "UTF-8//IGNORE", $line);
        if (empty(trim($line_utf8))) continue;

        $val = str_getcsv(trim($line_utf8));

        if (!$header_skipped) { 
            $header_skipped = true; 
            continue; 
        }

        $code  = str_pad(trim($val[0]), 6, '0', STR_PAD_LEFT);
        
        // 💡 배열에 현재 코드 저장 (나중에 삭제 대상을 찾기 위함)
        if (!empty($code)) {
            $uploaded_codes[] = $code;
        }

        $name  = trim($val[1] ?? '');
        $date  = trim($val[2] ?? '');
        $class = trim($val[3] ?? '');
        $rate  = (float) str_replace(',', '', trim($val[5] ?? 0));
        $index = trim($val[6] ?? '');
        
        $raw_nav = (float) str_replace(',', '', trim($val[8] ?? 0));
        $total_nav_billion = $raw_nav / 100000000; 
        
        $vol   = trim($val[10] ?? '');

        if ($test_on) {
            echo "코드: {$code} | 이름: {$name} | 순자산: " . round($total_nav_billion, 2) . "억 <br>";
            continue; 
        }

        $stmt->execute([
            ':code'  => $code,
            ':name'  => $name,
            ':date'  => $date,
            ':class' => $class,
            ':rate'  => $rate,
            ':index' => $index,
            ':nav'   => $total_nav_billion,
            ':vol'   => $vol
        ]);
        $success_count++;
    }

    // 💡 3. 마스터 데이터 동기화 (삭제 로직)
    // 업로드된 코드가 1개 이상 있을 때만 실행 (빈 파일 업로드 방어)
    if (!$test_on && count($uploaded_codes) > 0) {
        
        // '?, ?, ?, ...' 형태로 업로드된 개수만큼 물음표 생성
        $placeholders = implode(',', array_fill(0, count($uploaded_codes), '?'));
        
        // [삭제 1] 자식 테이블 (all_etf_holdings_info) 먼저 삭제 (외래키 무결성 보호)
        $del_holdings_sql = "DELETE FROM all_etf_holdings_info WHERE etf_code NOT IN ($placeholders)";
        $stmt_del_holdings = $pdo->prepare($del_holdings_sql);
        $stmt_del_holdings->execute($uploaded_codes);

        // [삭제 2] 부모 테이블 (all_etf_info)에서 상장폐지된 ETF 삭제
        $del_info_sql = "DELETE FROM all_etf_info WHERE etf_code NOT IN ($placeholders)";
        $stmt_del_info = $pdo->prepare($del_info_sql);
        $stmt_del_info->execute($uploaded_codes);
    }

	   data_upTime('all_etf_info', 'update', $pdo);

    return $success_count;
}###
###################


############################# 
function analyze_csv_preview($file_path) {
    $handle = fopen($file_path, 'r');
    $results = [];
    $count = 0;

    while (($data = fgetcsv($handle, 1000, ",")) !== FALSE && $count < 4) {
        // 인코딩 변환 (한글 깨짐 방지)
        $clean_data = array_map(function($item) {
            return iconv("EUC-KR", "UTF-8//IGNORE", $item);
        }, $data);
        
        $results[] = $clean_data;
        $count++;
    }
    fclose($handle);
    return $results;
} # 끝: analyze_csv_preview
#############################



// 💡 설정 배열: 언제든 일수는 여기서 맘대로 바꿀 수 있습니다!
$TREND_CHECK_DAYS = [
    't1' => 7,  // 1차: 7일 경과
    't2' => 14, // 2차: 14일 경과
    't3' => 30  // 3차: 30일 경과
];

############################# 
function process_condition_csv($pdo, $handle, $ref_date, $analysis_type, $test_on = false) { 
    global $TREND_CHECK_DAYS;
    
    // 💡 쿨다운 기간 설정 (t3 기준. 기본 30일)
    $cooldown_days = $TREND_CHECK_DAYS['t3'] ?? 30;

    // 1. 오늘 기준일로 올라간 동일 조건 데이터 삭제 (유령 데이터 방지)
    if (!$test_on) {
        $del_sql = "DELETE FROM all_condition_analysis WHERE analysis_type = ? AND ref_date = ?";
        $del_stmt = $pdo->prepare($del_sql);
        $del_stmt->execute([$analysis_type, $ref_date]);
    }

    // 2. 지난 30일 이내에 등록된 종목들 가져오기
    $recent_stocks = []; 
    $check_sql = "SELECT stock_code, ref_date AS original_date, IFNULL(last_hit_date, ref_date) AS last_hit_date 
                  FROM all_condition_analysis 
                  WHERE analysis_type = :type 
                    -- 🚀 해결 1: :date 를 :date1 과 :date2 로 분리
                    AND ref_date >= DATE_SUB(:date1, INTERVAL :days DAY)
                    AND ref_date < :date2"; 
    $check_stmt = $pdo->prepare($check_sql);
    
    // 🚀 분리된 파라미터에 동일한 $ref_date 값을 넣어줌
    $check_stmt->execute([
        ':type'  => $analysis_type,
        ':date1' => $ref_date,
        ':date2' => $ref_date,
        ':days'  => $cooldown_days
    ]);
    
    while ($row = $check_stmt->fetch(PDO::FETCH_ASSOC)) {
        $recent_stocks[$row['stock_code']] = [
            'original_date' => $row['original_date'],
            'last_hit_date' => $row['last_hit_date']
        ];
    }

    // 💡 신규 삽입 시 hit_count는 1로, last_hit_date는 오늘 날짜로 들어갑니다.
    $query = "INSERT INTO all_condition_analysis 
              (stock_code, stock_rate, vol_cap, market_cap, analysis_type, ref_date, hit_count, last_hit_date) 
              -- 🚀 해결 2: :date 를 :date1 과 :date2 로 분리
              VALUES (:code, :rate, :trade, :cap, :type, :date1, 1, :date2)
              ON DUPLICATE KEY UPDATE 
              stock_rate = VALUES(stock_rate),
              vol_cap = VALUES(vol_cap),
              market_cap = VALUES(market_cap)";
              
    $stmt = $pdo->prepare($query);
    
    $success_count = 0;
    $skip_count = 0; 
    $is_first_line = true;
    $header_map = []; 

    while (($line = fgets($handle)) !== false) {
        $line_utf8 = iconv("EUC-KR", "UTF-8//IGNORE", $line);
        if (empty(trim($line_utf8))) continue;

        $val = str_getcsv(trim($line_utf8));

        if ($is_first_line) { 
            foreach ($val as $idx => $col_name) {
                $clean_name = str_replace(' ', '', $col_name);
                $header_map[$clean_name] = $idx; 
            }
            $is_first_line = false; 
            continue; 
        }

        $find_idx = function($keyword) use ($header_map) {
            foreach ($header_map as $key => $idx) {
                if (mb_strpos($key, $keyword) !== false) return $idx;
            }
            return -1; 
        };

        $idx_code  = $find_idx('종목코드');
        $idx_rate  = $find_idx('등락률');
        $idx_trade = $find_idx('거래대금');
        $idx_cap   = $find_idx('시가총액');

        if ($idx_code === -1) continue; 

        $raw_code = str_replace("'", "", trim($val[$idx_code] ?? ''));
        $stock_code = str_pad($raw_code, 6, '0', STR_PAD_LEFT);

        // 3. 과거에 등록된 종목이면 횟수(hit_count) 누적
        if (isset($recent_stocks[$stock_code])) {
            $orig_date = $recent_stocks[$stock_code]['original_date'];
            $last_hit  = $recent_stocks[$stock_code]['last_hit_date'];

            if ($test_on) {
                echo "<span style='color:#e67e22; font-weight:bold;'>[{$analysis_type}] 코드: {$stock_code} | 🔄 {$orig_date} 등록종목 재포착! (포착횟수 +1 예정)</span><br>";
            } else {
                if ($last_hit != $ref_date) {
                    $update_hit_sql = "UPDATE all_condition_analysis 
                                       SET hit_count = hit_count + 1, last_hit_date = :today 
                                       WHERE stock_code = :code 
                                         AND analysis_type = :type 
                                         AND ref_date = :orig_date";
                    $hit_stmt = $pdo->prepare($update_hit_sql);
                    $hit_stmt->execute([
                        ':today' => $ref_date,
                        ':code'  => $stock_code,
                        ':type'  => $analysis_type,
                        ':orig_date' => $orig_date
                    ]);
                    
                    $recent_stocks[$stock_code]['last_hit_date'] = $ref_date;
                }
            }
            $skip_count++;
            continue; 
        }

        $stock_rate = (float) str_replace(['%', ','], '', trim($val[$idx_rate] ?? 0));
        $raw_trade = (float) str_replace(',', '', trim($val[$idx_trade] ?? 0));
        $raw_cap   = (float) str_replace(',', '', trim($val[$idx_cap] ?? 0));

        $vol_cap = $raw_trade / 100;
        $stock_cap = $raw_cap * 10;

        if ($test_on) {
            echo "[{$analysis_type}] 코드: {$stock_code} | 등락률: {$stock_rate}% | 거래대금: {$vol_cap}억 | 시총: {$stock_cap}억 <br>";
            continue; 
        }

        // 🚀 분리된 파라미터에 동일한 값을 넣어줌
        $stmt->execute([
            ':code'  => $stock_code,
            ':rate'  => $stock_rate,
            ':trade' => $vol_cap,
            ':cap'   => $stock_cap,
            ':type'  => $analysis_type,
            ':date1' => $ref_date, // 👈 수정됨
            ':date2' => $ref_date  // 👈 수정됨
        ]);
        $success_count++;
    }

    if (!$test_on && $success_count > 0) {
        $target_key = $analysis_type;
        data_upTime($target_key, 'update', $pdo);
    }

    return $success_count;
} # 끝: process_condition_csv
#############################


############################# 
function update_trend_analysis($pdo, $today_date) {
    global $TREND_CHECK_DAYS;

    // 1. t1, t2, t3를 순회하면서 업데이트할 대상이 있는지 찾습니다.
    foreach ($TREND_CHECK_DAYS as $time_step => $days_passed) {
        
        // 예: market_cap_t1 필드명
        $target_field = "market_cap_" . $time_step; 

        // 2. n일 이상 지났고, 아직 해당 필드가 0인 종목들을 오늘자 시총으로 업데이트하는 쿼리
        // (all_stock_info 테이블과 조인하여 오늘의 최신 시가총액을 가져와 꽂아 넣습니다)
$query = "
            UPDATE all_condition_analysis c
            JOIN all_stock_info s ON c.stock_code = s.stock_code 
            SET c.{$target_field} = s.stock_cap
            WHERE c.ref_date <= DATE_SUB(:today, INTERVAL :days DAY)
              AND c.{$target_field} = 0.00
        ";
        
        $stmt = $pdo->prepare($query);
        $stmt->execute([
            ':today' => $today_date,
            ':days'  => $days_passed
        ]);
    }
} # 끝: update_trend_analysis
#############################









?>