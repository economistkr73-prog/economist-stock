<?php
/**
 * Place.class — 전국 여행지 DB (DB 전담)
 *
 * 설계 (PROJECT_BRIEF.md / travel_db_schema.sql):
 *   - place      : 지도 마커 1개 = 장소 1건 (여행지/축제/맛집). dedup_key 로 중복 제거
 *   - place_ref  : 한 장소를 다룬 출처자료 N건 (기사·유튜브·블로그…). url_hash 로 중복 제거
 *   - "장소의 종류(category)" 와 "정보의 출처(source_type)" 는 다른 축 → 테이블 분리
 *   - 자주 거르는 값만 정규 컬럼, 나머지는 attributes(JSON) 한 칸
 *   - 스크래핑 대비: geocode_status(pending/ok/failed) 로 좌표화 추적, 지도엔 'ok' 만
 *
 * 주의: 기존 Travel.class / tbl_travel*(구글드라이브 사진일기) 와는 완전히 별개 기능.
 * 의존: env/cnt.inc 의 $pdo (지오코딩은 GeoCoder.class 가 별도 담당)
 */
class Place
{
    private PDO $pdo;

    public function __construct(PDO $pdo)
    {
        $this->pdo = $pdo;
    }

    // ======================================================
    // 0. 테이블 보장 (Travel/Schedule ensureTable 패턴)
    // ======================================================
    public function ensureTable(): void
    {
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS place (
                id             BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                name           VARCHAR(255)    NOT NULL,
                category       ENUM('travel','event','stay','restaurant','camping','etc')
                                               NOT NULL DEFAULT 'travel',
                address        VARCHAR(500)    NULL,
                region_lv1     VARCHAR(40)     NULL,
                region_lv2     VARCHAR(40)     NULL,
                region_lv3     VARCHAR(40)     NULL,
                lat            DECIMAL(10,7)   NULL,
                lng            DECIMAL(10,7)   NULL,
                geocode_status ENUM('pending','ok','failed')
                                               NOT NULL DEFAULT 'pending',
                period_start   DATE            NULL,
                period_end     DATE            NULL,
                phone          VARCHAR(40)     NULL,
                naver_id       VARCHAR(32)     NULL,
                attributes     JSON            NULL,
                review_count   INT             NULL,
                score          DECIMAL(3,2)    NULL,
                save_count     INT             NULL,
                dedup_key      VARCHAR(120)    NULL,
                is_active      TINYINT(1)      NOT NULL DEFAULT 1,
                created_at     DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
                updated_at     DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                               ON UPDATE CURRENT_TIMESTAMP,
                PRIMARY KEY (id),
                KEY idx_geo      (lat, lng),
                KEY idx_region   (region_lv1, region_lv2),
                KEY idx_category (category),
                KEY idx_review   (review_count),
                KEY idx_naver    (naver_id),
                KEY idx_period   (period_start, period_end),
                UNIQUE KEY uq_dedup (dedup_key)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ");
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS place_ref (
                id            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
                place_id      BIGINT UNSIGNED NOT NULL,
                source_type   ENUM('article','youtube','blog','official','manual')
                                              NOT NULL,
                title         VARCHAR(500)    NULL,
                url           VARCHAR(1000)   NULL,
                url_hash      CHAR(40)        GENERATED ALWAYS AS (SHA1(url)) STORED,
                summary       TEXT            NULL,
                published_at  DATE            NULL,
                extra         JSON            NULL,
                created_at    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (id),
                CONSTRAINT fk_ref_place FOREIGN KEY (place_id)
                    REFERENCES place(id) ON DELETE CASCADE,
                KEY idx_place  (place_id),
                KEY idx_source (source_type),
                UNIQUE KEY uq_place_url (place_id, url_hash)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ");

        // 장소 태그 (M:N) — 부분류(type)/테마(theme,벚꽃)/월(month,1월)/편의(facet,주차).
        // category 는 마커색용 단일 주분류, 그 외 다중 라벨·검색은 모두 여기로.
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS place_tag (
                place_id BIGINT UNSIGNED NOT NULL,
                kind     ENUM('type','theme','month','facet') NOT NULL DEFAULT 'theme',
                tag      VARCHAR(40)     NOT NULL,
                PRIMARY KEY (place_id, kind, tag),
                KEY idx_tag      (tag),
                KEY idx_kind_tag (kind, tag),
                CONSTRAINT fk_ptag_place FOREIGN KEY (place_id)
                    REFERENCES place(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ");
        // 맛집 가이드(중분류)+등급 — place.category='restaurant' 전용. 한 장소가 여러
        // 가이드(블루리본+미쉐린)에 동시 등재 가능(행 N개). 출처 URL 은 place_ref 에,
        // 여기는 '어느 가이드 몇 등급'이라는 사실만. 정의/색/우선순위는 FoodGuide.class.
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS place_guide (
                place_id   BIGINT UNSIGNED NOT NULL,
                guide      VARCHAR(20)     NOT NULL,
                grade      VARCHAR(20)     NULL,
                created_at DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (place_id, guide),
                KEY idx_guide (guide, grade),
                CONSTRAINT fk_pguide_place FOREIGN KEY (place_id)
                    REFERENCES place(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ");
        // 한시적 공개 공유 링크 (페이지 전체를 토큰으로 읽기전용 공개). travel.php 패턴 재사용
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS tbl_place_share (
                id          INT AUTO_INCREMENT PRIMARY KEY,
                token       VARCHAR(64)  NOT NULL,
                expires_at  DATETIME     NOT NULL,
                revoked     TINYINT(1)   NOT NULL DEFAULT 0,
                created_at  DATETIME     DEFAULT CURRENT_TIMESTAMP,
                UNIQUE KEY uq_place_share_token (token)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        // 체인(프랜차이즈) 브랜드 목록 — '맛집' 마커에서 제외할 대상.
        //  brand = 이름 첫 토큰(스타벅스 강남점→스타벅스). kind=auto(자동탐지)/manual(수동).
        //  채움/삭제는 1회용 _mig 스크립트, 수집기(selectByRule)가 이 목록으로 식별.
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS place_chain_brand (
                brand     VARCHAR(60)  NOT NULL,
                kind      VARCHAR(10)  NOT NULL DEFAULT 'auto',
                cnt       INT          NULL,
                added_at  DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (brand)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ");

        // ── 품질 컬럼(리뷰수·평점·저장수) 멱등 업그레이드 ──────────────────
        // 맛집 마커의 품질 정렬/줌 티어링용. 기존 설치(컬럼 도입 전)도 자동 반영.
        // 데이터 백필은 1회용 _mig 스크립트로 처리(여기선 스키마만 보장).
        foreach ([
            "ALTER TABLE place ADD COLUMN IF NOT EXISTS review_count INT NULL AFTER attributes",
            "ALTER TABLE place ADD COLUMN IF NOT EXISTS score DECIMAL(3,2) NULL AFTER review_count",
            "ALTER TABLE place ADD COLUMN IF NOT EXISTS save_count INT NULL AFTER score",
            "ALTER TABLE place ADD KEY IF NOT EXISTS idx_review (review_count)",
            // 단일 마스터 통합(2026-06): 캠핑 분류 + 네이버 업소ID 컬럼(추이 연결·네이버지도 링크용).
            // 'event'(전국여행지 도메인 옛 축제 분류)는 기존 행 보존을 위해 enum에 유지.
            "ALTER TABLE place MODIFY COLUMN category ENUM('travel','event','stay','restaurant','camping','etc') NOT NULL DEFAULT 'travel'",
            "ALTER TABLE place ADD COLUMN IF NOT EXISTS naver_id VARCHAR(32) NULL AFTER phone",
            "ALTER TABLE place ADD KEY IF NOT EXISTS idx_naver (naver_id)",
        ] as $ddl) {
            try { $this->pdo->exec($ddl); } catch (\Throwable $e) { /* 이미 적용됨 */ }
        }
    }

    // ======================================================
    // 1. 적재 (ingest) — 스크래퍼/수동입력 공통
    // ======================================================

    /**
     * 장소 중복 판정 키: 정규화한 이름 + 시군구(region_lv2).
     * 같은 가게가 표기만 살짝 달라도(공백/대소문자) 한 마커로 묶이도록.
     */
    public static function makeDedupKey(string $name, ?string $region_lv2): string
    {
        $norm = preg_replace('/\s+/u', '', mb_strtolower(trim($name)));
        return md5($norm . '|' . trim((string)$region_lv2));
    }

    /**
     * 장소 upsert — dedup_key 기준. 있으면 갱신, 없으면 생성하고 place.id 반환.
     * $p: name, category, address, region_lv1~3, lat, lng, geocode_status,
     *     period_start, period_end, phone, attributes(array|null), dedup_key(선택)
     */
    public function upsertPlace(array $p): int
    {
        $name = trim((string)($p['name'] ?? ''));
        if ($name === '') {
            throw new InvalidArgumentException('place name 은 필수입니다.');
        }
        $dedup = $p['dedup_key'] ?? self::makeDedupKey($name, $p['region_lv2'] ?? null);

        // 좌표가 들어오면 자동으로 ok, 아니면 pending (명시값 우선)
        $status = $p['geocode_status']
            ?? ((isset($p['lat'], $p['lng']) && $p['lat'] !== null && $p['lng'] !== null) ? 'ok' : 'pending');

        $attr = isset($p['attributes']) && $p['attributes'] !== null
            ? json_encode($p['attributes'], JSON_UNESCAPED_UNICODE)
            : null;

        // 품질 컬럼(리뷰수·평점·저장수): 명시값 우선, 없으면 attributes.naver 에서 파생.
        // 정렬/줌 티어링용 비정규화 캐시. 맛집(네이버 수집)만 값이 차고 그 외는 NULL.
        $nvA = (isset($p['attributes']['naver']) && is_array($p['attributes']['naver'])) ? $p['attributes']['naver'] : [];
        $reviewCount = $p['review_count'] ?? (isset($nvA['review']) ? (int)$nvA['review'] : null);
        $scoreVal    = $p['score']        ?? (isset($nvA['score'])  ? (float)$nvA['score'] : null);
        $saveVal     = $p['save_count']   ?? (isset($nvA['save'])   ? (int)preg_replace('/[^0-9]/', '', (string)$nvA['save']) : null);
        // 네이버 업소ID: 명시값 우선, 없으면 attributes.naver.id. (추이 연결·네이버지도 링크용)
        $naverId     = $p['naver_id'] ?? (isset($nvA['id']) && $nvA['id'] !== '' ? (string)$nvA['id'] : null);

        // category 는 명시적으로 들어왔을 때만 갱신(미지정 재적재가 기존 분류를 'travel' 로 덮는 것 방지).
        // INSERT 에는 항상 값이 필요하므로 기본 'travel' 을 넣되, UPDATE 절에서만 조건부 반영.
        $catProvided = array_key_exists('category', $p) && $p['category'] !== null && $p['category'] !== '';
        $catUpdate   = $catProvided ? 'category = VALUES(category),' : '';

        $sql = "INSERT INTO place
                  (name, category, address, region_lv1, region_lv2, region_lv3,
                   lat, lng, geocode_status, period_start, period_end,
                   phone, naver_id, attributes, review_count, score, save_count, dedup_key)
                VALUES
                  (:name, :category, :address, :r1, :r2, :r3,
                   :lat, :lng, :status, :pstart, :pend,
                   :phone, :nid, :attr, :rc, :sc, :sv, :dedup)
                ON DUPLICATE KEY UPDATE
                   id             = LAST_INSERT_ID(id),  -- UPDATE 시에도 lastInsertId()가 올바른 id 반환
                   name           = VALUES(name),
                   {$catUpdate}
                   address        = COALESCE(VALUES(address), address),
                   region_lv1     = COALESCE(VALUES(region_lv1), region_lv1),
                   region_lv2     = COALESCE(VALUES(region_lv2), region_lv2),
                   region_lv3     = COALESCE(VALUES(region_lv3), region_lv3),
                   lat            = COALESCE(VALUES(lat), lat),
                   lng            = COALESCE(VALUES(lng), lng),
                   -- 들어온 행이 실제로 좌표 정보를 가질 때만 status 갱신
                   -- (좌표 없는 재적재가 기존 'ok' 를 'pending' 으로 덮어 마커가 사라지는 것 방지)
                   geocode_status = IF(VALUES(lat) IS NOT NULL, VALUES(geocode_status), geocode_status),
                   period_start   = COALESCE(VALUES(period_start), period_start),
                   period_end     = COALESCE(VALUES(period_end), period_end),
                   phone          = COALESCE(VALUES(phone), phone),
                   naver_id       = COALESCE(VALUES(naver_id), naver_id),
                   attributes     = COALESCE(VALUES(attributes), attributes),
                   review_count   = COALESCE(VALUES(review_count), review_count),
                   score          = COALESCE(VALUES(score), score),
                   save_count     = COALESCE(VALUES(save_count), save_count),
                   updated_at     = CURRENT_TIMESTAMP";
        $st = $this->pdo->prepare($sql);
        $st->execute([
            ':name'     => $name,
            ':category' => $p['category'] ?? 'travel',
            ':address'  => $p['address'] ?? null,
            ':r1'       => $p['region_lv1'] ?? null,
            ':r2'       => $p['region_lv2'] ?? null,
            ':r3'       => $p['region_lv3'] ?? null,
            ':lat'      => $p['lat'] ?? null,
            ':lng'      => $p['lng'] ?? null,
            ':status'   => $status,
            ':pstart'   => $p['period_start'] ?? null,
            ':pend'     => $p['period_end'] ?? null,
            ':phone'    => $p['phone'] ?? null,
            ':nid'      => $naverId,
            ':attr'     => $attr,
            ':rc'       => $reviewCount,
            ':sc'       => $scoreVal,
            ':sv'       => $saveVal,
            ':dedup'    => $dedup,
        ]);

        // id = LAST_INSERT_ID(id) 트릭 덕에 INSERT/UPDATE 양쪽 모두 올바른 id 반환.
        // (만일을 위한 안전망: 그래도 0 이면 dedup_key 로 재조회)
        $id = (int)$this->pdo->lastInsertId();
        if ($id === 0) {
            $q = $this->pdo->prepare("SELECT id FROM place WHERE dedup_key = ?");
            $q->execute([$dedup]);
            $id = (int)$q->fetchColumn();
        }
        return $id;
    }

    /**
     * 출처자료 추가 — url_hash 기준 INSERT IGNORE (같은 링크 중복 무시).
     * $ref: source_type, title, url, summary, published_at, extra(array|null)
     * 반환: 새로 들어갔으면 true, 중복이라 무시됐으면 false
     */
    public function addRef(int $placeId, array $ref): bool
    {
        $extra = isset($ref['extra']) && $ref['extra'] !== null
            ? json_encode($ref['extra'], JSON_UNESCAPED_UNICODE)
            : null;

        $st = $this->pdo->prepare(
            "INSERT IGNORE INTO place_ref
               (place_id, source_type, title, url, summary, published_at, extra)
             VALUES (:pid, :stype, :title, :url, :summary, :pub, :extra)"
        );
        $st->execute([
            ':pid'     => $placeId,
            ':stype'   => $ref['source_type'] ?? 'manual',
            ':title'   => $ref['title'] ?? null,
            ':url'     => $ref['url'] ?? null,
            ':summary' => $ref['summary'] ?? null,
            ':pub'     => $ref['published_at'] ?? null,
            ':extra'   => $extra,
        ]);
        return $st->rowCount() > 0;
    }

    /**
     * 표준 입력 포맷 한 건을 통째로 적재 (스크래퍼 ↔ 적재 공통 진입점).
     * $item: { name, category, address, phone, region_*, lat, lng, attributes{},
     *          ref: { source_type, title, url, summary, published_at, extra{} } }
     * 반환: ['place_id'=>int, 'ref_added'=>bool]
     */
    public function ingest(array $item): array
    {
        // 두 형식 모두 지원:
        //   중첩 { place:{...}, ref:{...} }  (크롤러 파서 출력, 브리프 §6)
        //   평면 { name,..., ref:{...} }     (seed/수동입력, 브리프 §7)
        $placeData = $item['place'] ?? $item;
        $ref       = $item['ref']   ?? null;

        $placeId  = $this->upsertPlace($placeData);
        $refAdded = false;
        if (!empty($ref) && is_array($ref)) {
            $refAdded = $this->addRef($placeId, $ref);
        }
        return ['place_id' => $placeId, 'ref_added' => $refAdded];
    }

    // ======================================================
    // 2. 지도 검색 — 반경 내 장소 → GeoJSON
    // ======================================================

    /**
     * 좌표 반경 검색. 1차 위경도 박스(인덱스) → 2차 Haversine 거리필터 → GeoJSON.
     * @return array GeoJSON FeatureCollection (그대로 json_encode 하면 됨)
     */
    public function searchNearby(
        float $lat, float $lng, float $radiusKm = 5.0,
        ?string $category = null, ?string $keyword = null, int $limit = 300,
        ?string $guide = null, int $minReview = 0, ?array $catMinReview = null,
        ?array $regionIn = null, ?array $categoriesIn = null
    ): array {
        $useRegion = ($regionIn !== null && count($regionIn) > 0);
        $sql = "SELECT p.id, p.name, p.category, p.lat, p.lng, p.phone,
                       p.address, p.region_lv1, p.region_lv2,
                       p.period_start, p.period_end, p.attributes, p.updated_at,
                       p.review_count, p.score, p.save_count,
                       (6371 * ACOS(LEAST(1.0,
                          COS(RADIANS(:lat_c)) * COS(RADIANS(p.lat)) *
                          COS(RADIANS(p.lng) - RADIANS(:lng_c)) +
                          SIN(RADIANS(:lat_s)) * SIN(RADIANS(p.lat))
                       ))) AS dist_km,
                       (SELECT COUNT(*) FROM place_ref r WHERE r.place_id = p.id) AS ref_count,
                       (SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM place_tag t WHERE t.place_id = p.id AND t.kind <> 'month') AS tags,
                       (SELECT GROUP_CONCAT(CONCAT(g.guide, ':', COALESCE(g.grade, '')) ORDER BY g.guide SEPARATOR ',') FROM place_guide g WHERE g.place_id = p.id) AS guides
                FROM place p
                WHERE p.is_active = 1
                  AND p.geocode_status = 'ok'";
        // dist_km 계산(정렬 tie-break)용 중심좌표는 항상 바인딩
        $args = [':lat_c' => $lat, ':lng_c' => $lng, ':lat_s' => $lat];
        if ($useRegion) {
            // 시도 고정 필터 — 반경 무시, 그 시도 전역.
            //  ★실제 주소(address) 접두 매칭. region_lv1 은 '수집 시드값'(어느 검색어로 잡혔는지)이라
            //    경계 장소가 어긋남(예: "강원 원주 캠핑장" 검색에 딸려온 충북 제천 캠핑장이 region_lv1=강원).
            //    address 가 진짜 위치. $regionIn = 시도 주소접두 목록(충북·충청북도 등, 풀/단축형 혼재 대응).
            $ors = [];
            foreach (array_values($regionIn) as $k => $rr) { $pp = ":r1_{$k}"; $ors[] = "p.address LIKE {$pp}"; $args[$pp] = $rr . '%'; }
            $sql .= " AND (" . implode(' OR ', $ors) . ")";
        } else {
            // 반경에 비례한 박스 (위도 1°≈111km, 경도 1°≈111*cos(위도)km)
            $latDelta = $radiusKm / 111.0;
            $cos      = max(cos(deg2rad($lat)), 0.01); // 극지 방어
            $lngDelta = $radiusKm / (111.0 * $cos);
            $sql .= " AND p.lat BETWEEN :lat_min AND :lat_max
                      AND p.lng BETWEEN :lng_min AND :lng_max";
            $args[':lat_min'] = $lat - $latDelta; $args[':lat_max'] = $lat + $latDelta;
            $args[':lng_min'] = $lng - $lngDelta; $args[':lng_max'] = $lng + $lngDelta;
        }
        if ($category !== null && $category !== '') {
            $sql .= " AND p.category = :category";
            $args[':category'] = $category;
        } elseif ($categoriesIn !== null && count($categoriesIn) > 0) {
            // 분류 멀티선택 → category IN
            $cph = [];
            foreach (array_values($categoriesIn) as $k => $cc) { $cp = ":cin{$k}"; $cph[] = $cp; $args[$cp] = $cc; }
            $sql .= " AND p.category IN (" . implode(',', $cph) . ")";
        }
        if ($keyword !== null && $keyword !== '') {
            $sql .= " AND p.name LIKE :kw";
            $args[':kw'] = '%' . $keyword . '%';
        }
        if ($guide !== null && $guide !== '') {
            $sql .= " AND EXISTS (SELECT 1 FROM place_guide g2 WHERE g2.place_id = p.id AND g2.guide = :guide)";
            $args[':guide'] = $guide;
        }
        // 최소 리뷰수 필터.
        //  · $catMinReview(분류별 기준) 가 오면 = '전체' 모드: 맛집·스테이·캠핑을 각 기준으로 함께 노출.
        //    여행지 등 리뷰 없는(review_count NULL) 분류와 가이드 등재는 항상 노출.
        //  · 아니면 단일 $minReview 를 리뷰 보유 분류 전체에 적용(단일 카테고리 검색용).
        if ($catMinReview !== null && $catMinReview) {
            $ors = ["p.review_count IS NULL",
                    "EXISTS (SELECT 1 FROM place_guide g3 WHERE g3.place_id = p.id)"];
            $i = 0;
            foreach ($catMinReview as $cat => $mr) {
                $mr = (int)$mr; $cp = ":cmc{$i}";
                if ($mr > 0) { $vp = ":cmv{$i}"; $ors[] = "(p.category = {$cp} AND p.review_count >= {$vp})"; $args[$vp] = $mr; }
                else         { $ors[] = "p.category = {$cp}"; }   // 0 = 전체(그 분류 모두)
                $args[$cp] = $cat; $i++;
            }
            $sql .= " AND (" . implode(' OR ', $ors) . ")";
        } elseif ($minReview > 0) {
            $sql .= " AND (p.review_count IS NULL
                           OR p.review_count >= :minrev
                           OR EXISTS (SELECT 1 FROM place_guide g3 WHERE g3.place_id = p.id))";
            $args[':minrev'] = $minReview;
        }
        // 정렬: 비맛집(여행지·숙소) 우선 노출 → 맛집은 품질순(리뷰수→평점→저장수) → 거리 동률처리.
        // LIMIT 에 잘려도 '좋은 곳'이 남도록(기존 거리순은 가까운 동네집이 남던 문제).
        if (!$useRegion) $sql .= " HAVING dist_km <= :radius";   // 시도 고정 모드는 반경 제한 없음(그 시도 전역)
        $sql .= " ORDER BY (p.category = 'restaurant') ASC,
                           p.review_count DESC,
                           p.score DESC,
                           p.save_count DESC,
                           dist_km ASC
                  LIMIT {$limit}";
        if (!$useRegion) $args[':radius'] = $radiusKm;

        $st = $this->pdo->prepare($sql);
        $st->execute($args);

        $features = [];
        while ($row = $st->fetch(PDO::FETCH_ASSOC)) {
            $features[] = [
                'type' => 'Feature',
                'geometry' => [
                    'type' => 'Point',
                    'coordinates' => [(float)$row['lng'], (float)$row['lat']], // GeoJSON = [경도, 위도]
                ],
                'properties' => [
                    'id'           => (int)$row['id'],
                    'name'         => $row['name'],
                    'category'     => $row['category'],
                    'phone'        => $row['phone'],
                    'address'      => $row['address'],
                    'region_lv1'   => $row['region_lv1'],
                    'region_lv2'   => $row['region_lv2'],
                    'period_start' => $row['period_start'],
                    'period_end'   => $row['period_end'],
                    'attributes'   => $row['attributes'] ? json_decode($row['attributes'], true) : null,
                    'updated_at'   => $row['updated_at'],
                    'ref_count'    => (int)$row['ref_count'],
                    'tags'         => $row['tags'] ? explode(',', $row['tags']) : [],
                    'guides'       => self::parseGuides($row['guides'] ?? null),
                    'dist_km'      => round((float)$row['dist_km'], 3),
                ],
            ];
        }
        return ['type' => 'FeatureCollection', 'features' => $features];
    }

    // 단건 장소 조회 — 마커/슬라이드 카드 상세보기용. searchNearby 와 동일한 properties 형태.
    public function featureById(int $id): ?array {
        $sql = "SELECT p.id, p.name, p.category, p.lat, p.lng, p.phone,
                       p.address, p.region_lv1, p.region_lv2,
                       p.period_start, p.period_end, p.attributes, p.updated_at,
                       p.review_count, p.score, p.save_count,
                       (SELECT COUNT(*) FROM place_ref r WHERE r.place_id = p.id) AS ref_count,
                       (SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM place_tag t WHERE t.place_id = p.id AND t.kind <> 'month') AS tags,
                       (SELECT GROUP_CONCAT(CONCAT(g.guide, ':', COALESCE(g.grade, '')) ORDER BY g.guide SEPARATOR ',') FROM place_guide g WHERE g.place_id = p.id) AS guides
                FROM place p
                WHERE p.id = :id AND p.is_active = 1
                LIMIT 1";
        $st = $this->pdo->prepare($sql);
        $st->execute([':id' => $id]);
        $row = $st->fetch(PDO::FETCH_ASSOC);
        if (!$row) return null;
        return [
            'type' => 'Feature',
            'geometry' => ['type' => 'Point', 'coordinates' => [(float)$row['lng'], (float)$row['lat']]],
            'properties' => [
                'id'           => (int)$row['id'],
                'name'         => $row['name'],
                'category'     => $row['category'],
                'phone'        => $row['phone'],
                'address'      => $row['address'],
                'region_lv1'   => $row['region_lv1'],
                'region_lv2'   => $row['region_lv2'],
                'period_start' => $row['period_start'],
                'period_end'   => $row['period_end'],
                'attributes'   => $row['attributes'] ? json_decode($row['attributes'], true) : null,
                'updated_at'   => $row['updated_at'],
                'ref_count'    => (int)$row['ref_count'],
                'tags'         => $row['tags'] ? explode(',', $row['tags']) : [],
                'guides'       => self::parseGuides($row['guides'] ?? null),
            ],
        ];
    }

    // ── 경로(회랑) 주변 검색 — 여행 경로 모드 전용 ───────────────
    //  경로선(폴리라인) 좌표를 받아, DB '전체'에서 경로선까지 최단거리 ≤ 반경 인 장소를 반환.
    //  ★지도 필터(지역잠금·분류칩·줌 티어)와 완전 무관 — 경로 전 구간의 맛집·여행지를 빠짐없이.
    //  1) 경로 bbox(+반경 패딩)로 후보를 인덱스 컷 → 2) PHP 에서 점-폴리라인 최단거리로 회랑 판정.

    // 점(lat,lng)에서 선분 A→B 까지 최단거리(km). 국소 평면 근사(수십 km까지 충분).
    private static function ptSegKm(float $lat, float $lng, float $alat, float $alng, float $blat, float $blng): float {
        $R = 6371.0; $d2r = M_PI / 180.0; $cl = cos($lat * $d2r);
        $ax = ($alng - $lng) * $d2r * $cl; $ay = ($alat - $lat) * $d2r;
        $bx = ($blng - $lng) * $d2r * $cl; $by = ($blat - $lat) * $d2r;
        $dx = $bx - $ax; $dy = $by - $ay; $len2 = $dx * $dx + $dy * $dy;
        $t = $len2 > 0 ? -($ax * $dx + $ay * $dy) / $len2 : 0.0;
        if ($t < 0) $t = 0.0; if ($t > 1) $t = 1.0;
        $cx = $ax + $t * $dx; $cy = $ay + $t * $dy;
        return $R * sqrt($cx * $cx + $cy * $cy);
    }
    // 점에서 경로선($path=[[lng,lat],...])까지 최단거리(km)
    private static function pathDistKm(float $lat, float $lng, array $path): float {
        $n = count($path);
        if ($n === 0) return INF;
        if ($n === 1) return self::ptSegKm($lat, $lng, $path[0][1], $path[0][0], $path[0][1], $path[0][0]);
        $best = INF;
        for ($i = 0; $i < $n - 1; $i++) {
            $d = self::ptSegKm($lat, $lng, $path[$i][1], $path[$i][0], $path[$i + 1][1], $path[$i + 1][0]);
            if ($d < $best) $best = $d;
        }
        return $best;
    }

    /**
     * 경로 회랑 검색.
     * @param array      $path        [[lng,lat],...] 경로 폴리라인(도로 경로 또는 지점 직선)
     * @param float      $radiusKm    경로선에서 이 거리 이내
     * @param array|null $categoriesIn 표시할 분류(비면 전체)
     * @param int        $limit       최종 반환 상한(품질순)
     * @return array GeoJSON FeatureCollection (properties.dist_km = 경로선까지 거리)
     */
    public function searchAlongRoute(array $path, float $radiusKm = 5.0, ?array $categoriesIn = null, int $limit = 500, ?array $viewport = null): array {
        // 입력 정제 + 서버측 솎음(최대 300점)
        $pts = [];
        foreach ($path as $p) {
            if (is_array($p) && count($p) >= 2 && is_numeric($p[0]) && is_numeric($p[1])) $pts[] = [(float)$p[0], (float)$p[1]];
        }
        if (count($pts) < 2) return ['type' => 'FeatureCollection', 'features' => []];
        $maxPts = 300;   // 안전망(클라가 길이비례 40~250점 전송). 그 위로만 한 번 더 솎음

        if (count($pts) > $maxPts) {
            $stride = (int)ceil(count($pts) / $maxPts);
            $tmp = [];
            for ($i = 0; $i < count($pts); $i += $stride) $tmp[] = $pts[$i];
            $tmp[] = $pts[count($pts) - 1];
            $pts = $tmp;
        }
        $radiusKm = max(0.3, min(30.0, $radiusKm));
        // 경로 bbox + 반경 패딩
        $minLat = $minLng = INF; $maxLat = $maxLng = -INF;
        foreach ($pts as $p) {
            $minLng = min($minLng, $p[0]); $maxLng = max($maxLng, $p[0]);
            $minLat = min($minLat, $p[1]); $maxLat = max($maxLat, $p[1]);
        }
        $midLat = ($minLat + $maxLat) / 2;
        $latPad = $radiusKm / 111.0; $cos = max(cos(deg2rad($midLat)), 0.01); $lngPad = $radiusKm / (111.0 * $cos);
        $minLat -= $latPad; $maxLat += $latPad; $minLng -= $lngPad; $maxLng += $lngPad;
        // ★뷰포트 증분: 현재 지도 화면 bbox 와 교집합 → 화면 밖 후보는 아예 안 끌어옴(장거리 경로 속도 핵심).
        if ($viewport && isset($viewport['minLat'], $viewport['maxLat'], $viewport['minLng'], $viewport['maxLng'])) {
            $minLat = max($minLat, (float)$viewport['minLat']); $maxLat = min($maxLat, (float)$viewport['maxLat']);
            $minLng = max($minLng, (float)$viewport['minLng']); $maxLng = min($maxLng, (float)$viewport['maxLng']);
            if ($minLat > $maxLat || $minLng > $maxLng) return ['type' => 'FeatureCollection', 'features' => []];   // 화면이 경로 회랑과 안 겹침
        }
        // 분류 필터
        $allowed = ['travel', 'stay', 'restaurant', 'camping', 'etc'];
        $cats = [];
        if ($categoriesIn) {
            foreach ($categoriesIn as $c) { $c = trim((string)$c); if ($c !== '' && in_array($c, $allowed, true)) $cats[] = $c; }
        }
        $args = [':latmin' => $minLat, ':latmax' => $maxLat, ':lngmin' => $minLng, ':lngmax' => $maxLng];
        $catFilter = '';
        if ($cats) {
            $ph = [];
            foreach (array_values($cats) as $k => $cc) { $cp = ":c{$k}"; $ph[] = $cp; $args[$cp] = $cc; }
            $catFilter = " AND p.category IN (" . implode(',', $ph) . ")";
        }
        // ★1단계(가벼움): bbox 내 후보를 인덱스 컬럼만으로 '리뷰 컷 없이 전부'.
        //  회랑(경로선 ≤ 반경) 판정을 먼저 해야, 시골 도로변 맛집(리뷰 적음)이
        //  도시 고리뷰 맛집에 밀려 후보에서 탈락하지 않는다(=긴 경로에서 맛집이 통째로 사라지던 버그).
        $sql1 = "SELECT p.id, p.category, p.lat, p.lng, p.review_count, p.score, p.save_count
                 FROM place p
                 WHERE p.is_active = 1 AND p.geocode_status = 'ok'
                   AND p.lat BETWEEN :latmin AND :latmax
                   AND p.lng BETWEEN :lngmin AND :lngmax" . $catFilter . "
                 LIMIT 60000";
        $st = $this->pdo->prepare($sql1);
        $st->execute($args);
        $byCat = [];
        while ($row = $st->fetch(PDO::FETCH_ASSOC)) {
            $d = self::pathDistKm((float)$row['lat'], (float)$row['lng'], $pts);
            if ($d > $radiusKm) continue;          // 경로선에서 반경 밖이면 제외
            $byCat[$row['category']][] = ['id' => (int)$row['id'], 'd' => round($d, 3)];
        }
        if (!$byCat) return ['type' => 'FeatureCollection', 'features' => []];
        // 분류 내 정렬 = '경로선에 가까운 순'(상한에 잘려도 경로변 가까운 곳이 모든 구간에서 살아남게).
        foreach ($byCat as $ck => &$arr) {
            usort($arr, function ($a, $b) { return $a['d'] <=> $b['d']; });
        }
        unset($arr);
        // ★분류 라운드로빈으로 limit 까지 — 모든 분류(특히 맛집)가 고르게 포함되게. id 선정 + 거리 맵.
        $pick = []; $distById = [];
        $catKeys = array_keys($byCat);
        $idx = array_fill_keys($catKeys, 0);
        $active = true;
        while (count($pick) < $limit && $active) {
            $active = false;
            foreach ($catKeys as $ck) {
                if ($idx[$ck] < count($byCat[$ck])) {
                    $rec = $byCat[$ck][$idx[$ck]++];
                    $pick[] = $rec['id']; $distById[$rec['id']] = $rec['d'];
                    $active = true;
                    if (count($pick) >= $limit) break;
                }
            }
        }
        if (!$pick) return ['type' => 'FeatureCollection', 'features' => []];
        // ★2단계: 선정된 id 들만 전체 상세(무거운 태그/가이드 서브쿼리는 이들에만).
        $in = []; $a2 = [];
        foreach (array_values($pick) as $k => $pid) { $pp = ":p{$k}"; $in[] = $pp; $a2[$pp] = $pid; }
        $sql2 = "SELECT p.id, p.name, p.category, p.lat, p.lng, p.phone,
                        p.address, p.region_lv1, p.region_lv2,
                        p.period_start, p.period_end, p.attributes, p.updated_at,
                        p.review_count, p.score, p.save_count,
                        (SELECT COUNT(*) FROM place_ref r WHERE r.place_id = p.id) AS ref_count,
                        (SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM place_tag t WHERE t.place_id = p.id AND t.kind <> 'month') AS tags,
                        (SELECT GROUP_CONCAT(CONCAT(g.guide, ':', COALESCE(g.grade, '')) ORDER BY g.guide SEPARATOR ',') FROM place_guide g WHERE g.place_id = p.id) AS guides
                 FROM place p
                 WHERE p.id IN (" . implode(',', $in) . ")";
        $st2 = $this->pdo->prepare($sql2);
        $st2->execute($a2);
        $rowById = [];
        while ($r = $st2->fetch(PDO::FETCH_ASSOC)) $rowById[(int)$r['id']] = $r;
        // 라운드로빈 순서대로 feature 빌드
        $features = [];
        foreach ($pick as $pid) {
            $row = $rowById[$pid] ?? null;
            if (!$row) continue;
            $features[] = [
                'type' => 'Feature',
                'geometry' => ['type' => 'Point', 'coordinates' => [(float)$row['lng'], (float)$row['lat']]],
                'properties' => [
                    'id'           => (int)$row['id'],
                    'name'         => $row['name'],
                    'category'     => $row['category'],
                    'phone'        => $row['phone'],
                    'address'      => $row['address'],
                    'region_lv1'   => $row['region_lv1'],
                    'region_lv2'   => $row['region_lv2'],
                    'period_start' => $row['period_start'],
                    'period_end'   => $row['period_end'],
                    'attributes'   => $row['attributes'] ? json_decode($row['attributes'], true) : null,
                    'updated_at'   => $row['updated_at'],
                    'ref_count'    => (int)$row['ref_count'],
                    'tags'         => $row['tags'] ? explode(',', $row['tags']) : [],
                    'guides'       => self::parseGuides($row['guides'] ?? null),
                    'dist_km'      => $distById[$pid] ?? null,
                ],
            ];
        }
        return ['type' => 'FeatureCollection', 'features' => $features];
    }

    // ══ 여행지도 저장함(트립) — 경로(route)+찜(picks)을 이름 붙여 여러 개 저장 ══
    private static $tripTableReady = false;
    private function ensureTripTable(): void {
        if (self::$tripTableReady) return;
        $this->pdo->exec("CREATE TABLE IF NOT EXISTS travel_trip (
            id INT AUTO_INCREMENT PRIMARY KEY,
            owner VARCHAR(100) NOT NULL DEFAULT '',
            name VARCHAR(200) NOT NULL,
            route_json MEDIUMTEXT NULL,
            picks_json MEDIUMTEXT NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
            UNIQUE KEY uq_owner_name (owner, name)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
        // 공유 토큰 컬럼(기존 테이블에도 추가 — MariaDB 10.6 IF NOT EXISTS)
        try { $this->pdo->exec("ALTER TABLE travel_trip ADD COLUMN IF NOT EXISTS share_token VARCHAR(40) NULL"); } catch (\Throwable $e) {}
        try { $this->pdo->exec("ALTER TABLE travel_trip ADD COLUMN IF NOT EXISTS share_expires DATETIME NULL"); } catch (\Throwable $e) {}
        try { $this->pdo->exec("ALTER TABLE travel_trip ADD UNIQUE INDEX IF NOT EXISTS uq_share_token (share_token)"); } catch (\Throwable $e) {}
        self::$tripTableReady = true;
    }
    /** 저장(같은 owner·name 이면 덮어쓰기). route/picks 는 JSON 문자열. @return int trip id */
    public function tripSave(string $owner, string $name, string $routeJson, string $picksJson): int {
        $this->ensureTripTable();
        $st = $this->pdo->prepare("INSERT INTO travel_trip (owner, name, route_json, picks_json)
            VALUES (:o, :n, :r, :p)
            ON DUPLICATE KEY UPDATE route_json = VALUES(route_json), picks_json = VALUES(picks_json)");
        $st->execute([':o' => $owner, ':n' => $name, ':r' => $routeJson, ':p' => $picksJson]);
        $q = $this->pdo->prepare("SELECT id FROM travel_trip WHERE owner = :o AND name = :n LIMIT 1");
        $q->execute([':o' => $owner, ':n' => $name]);
        return (int)$q->fetchColumn();
    }
    /** 내 트립 목록(가벼움: 지점·찜 개수만). @return array [{id,name,stops,picks,updated_at}] */
    public function tripList(string $owner): array {
        $this->ensureTripTable();
        $st = $this->pdo->prepare("SELECT id, name, route_json, picks_json, updated_at
            FROM travel_trip WHERE owner = :o ORDER BY updated_at DESC");
        $st->execute([':o' => $owner]);
        $out = [];
        while ($r = $st->fetch(PDO::FETCH_ASSOC)) {
            $route = $r['route_json'] ? json_decode($r['route_json'], true) : [];
            $picks = $r['picks_json'] ? json_decode($r['picks_json'], true) : [];
            $out[] = [
                'id'         => (int)$r['id'],
                'name'       => $r['name'],
                'stops'      => is_array($route) ? count($route) : 0,
                'picks'      => is_array($picks) ? count($picks) : 0,
                'updated_at' => $r['updated_at'],
            ];
        }
        return $out;
    }
    /** 트립 불러오기(소유자 본인만). @return array|null {name, route, picks} */
    public function tripLoad(string $owner, int $id): ?array {
        $this->ensureTripTable();
        $st = $this->pdo->prepare("SELECT name, route_json, picks_json FROM travel_trip WHERE id = :i AND owner = :o LIMIT 1");
        $st->execute([':i' => $id, ':o' => $owner]);
        $r = $st->fetch(PDO::FETCH_ASSOC);
        if (!$r) return null;
        return [
            'name'  => $r['name'],
            'route' => $r['route_json'] ? json_decode($r['route_json'], true) : [],
            'picks' => $r['picks_json'] ? json_decode($r['picks_json'], true) : [],
        ];
    }
    /** 트립 삭제(소유자 본인만). */
    public function tripDelete(string $owner, int $id): bool {
        $this->ensureTripTable();
        $st = $this->pdo->prepare("DELETE FROM travel_trip WHERE id = :i AND owner = :o");
        $st->execute([':i' => $id, ':o' => $owner]);
        return $st->rowCount() > 0;
    }
    /** 공유 토큰 발급/갱신(본인 소유만) — 한시적(TTL). 토큰 없으면 생성, 만료시각은 항상 NOW()+TTL 로 갱신.
     *  @return array|null {token, expires_at} */
    public function tripShare(string $owner, int $id, int $ttlSeconds = 604800): ?array {
        $this->ensureTripTable();
        $ttl = max(3600, min($ttlSeconds, 90 * 24 * 3600));   // 1시간~90일 클램프
        $st = $this->pdo->prepare("SELECT share_token FROM travel_trip WHERE id = :i AND owner = :o LIMIT 1");
        $st->execute([':i' => $id, ':o' => $owner]);
        $row = $st->fetch(PDO::FETCH_ASSOC);
        if (!$row) return null;
        $token = $row['share_token'] ?: bin2hex(random_bytes(16));
        $u = $this->pdo->prepare("UPDATE travel_trip SET share_token = :t, share_expires = DATE_ADD(NOW(), INTERVAL :ttl SECOND)
                                  WHERE id = :i AND owner = :o");
        $u->execute([':t' => $token, ':ttl' => $ttl, ':i' => $id, ':o' => $owner]);
        $q = $this->pdo->prepare("SELECT share_expires FROM travel_trip WHERE id = :i AND owner = :o LIMIT 1");
        $q->execute([':i' => $id, ':o' => $owner]);
        return ['token' => $token, 'expires_at' => $q->fetchColumn()];
    }
    /** 공유 토큰으로 트립 조회(공개·소유자 무관·미만료만). @return array|null {name, route, picks} */
    public function tripByToken(string $token): ?array {
        if ($token === '') return null;
        $this->ensureTripTable();
        $st = $this->pdo->prepare("SELECT name, route_json, picks_json FROM travel_trip
                                   WHERE share_token = :t AND share_expires IS NOT NULL AND share_expires > NOW() LIMIT 1");
        $st->execute([':t' => $token]);
        $r = $st->fetch(PDO::FETCH_ASSOC);
        if (!$r) return null;
        return [
            'name'  => $r['name'],
            'route' => $r['route_json'] ? json_decode($r['route_json'], true) : [],
            'picks' => $r['picks_json'] ? json_decode($r['picks_json'], true) : [],
        ];
    }
    /** 영구 공유 토큰 발급/갱신(본인 소유만) — 만료 없음(share_expires=2099). 캘린더 일정에 연결해 항상 열람.
     *  @return array|null {token, name} */
    public function tripSharePerm(string $owner, int $id): ?array {
        $this->ensureTripTable();
        $st = $this->pdo->prepare("SELECT share_token, name FROM travel_trip WHERE id = :i AND owner = :o LIMIT 1");
        $st->execute([':i' => $id, ':o' => $owner]);
        $row = $st->fetch(PDO::FETCH_ASSOC);
        if (!$row) return null;
        $token = $row['share_token'] ?: bin2hex(random_bytes(16));
        $u = $this->pdo->prepare("UPDATE travel_trip SET share_token = :t, share_expires = '2099-12-31 23:59:59'
                                  WHERE id = :i AND owner = :o");
        $u->execute([':t' => $token, ':i' => $id, ':o' => $owner]);
        return ['token' => $token, 'name' => $row['name']];
    }

    /**
     * ★통합 검색 — 분류(멀티) × 공간(뷰포트/지역/전국) × 도메인별 태그(독립 누적)를 한 쿼리로.
     *  결과 = 선택 분류들의 '합집합'. 각 도메인은 자기 태그로만 좁혀지고, 서로·분류를 초기화하지 않는다.
     *  예) 강원 + [여행지,맛집] + 여행태그:계곡 + 맛집태그:생선회
     *      → (강원 여행지 중 계곡) ∪ (강원 맛집 중 생선회). 한쪽 태그 미선택이면 그 분류는 전체.
     *  $opts:
     *   - mode         : 'viewport'|'region'|'nation'
     *   - lat,lng,radiusKm : 뷰포트(mode=viewport) 중심·반경
     *   - regionIn     : array  주소접두 목록(mode=region)
     *   - categories   : array  표시할 분류(비면 전체 5종)
     *   - travelTags   : array  여행지(theme/month)를 AND 로 좁힘
     *   - foodTags     : array  맛집(cuisine/grade)을 AND 로 좁힘
     *   - guide        : string 맛집 가이드 EXISTS
     *   - catMinReview : map    {restaurant,stay,camping} 분류별 최소 리뷰(뷰포트 줌 티어)
     *   - limit        : int
     */
    public function searchUnified(array $opts): array
    {
        $allCats = ['travel', 'restaurant', 'stay', 'camping', 'etc'];
        $mode    = in_array($opts['mode'] ?? 'viewport', ['viewport', 'region', 'nation'], true) ? $opts['mode'] : 'viewport';
        $lat     = (float)($opts['lat'] ?? 0);
        $lng     = (float)($opts['lng'] ?? 0);
        $radius  = max(0.1, min(600.0, (float)($opts['radiusKm'] ?? 5)));
        $regionIn = array_values(array_filter(array_map('trim', (array)($opts['regionIn'] ?? [])), fn($r) => $r !== ''));
        $cats    = array_values(array_intersect($allCats, (array)($opts['categories'] ?? [])));
        if (!$cats) $cats = $allCats;   // 미지정 = 전체(오버레이 등 하위호환)
        $travelTags = array_values(array_unique(array_filter(array_map('trim', (array)($opts['travelTags'] ?? [])), fn($t) => $t !== '')));
        $foodTags   = array_values(array_unique(array_filter(array_map('trim', (array)($opts['foodTags']   ?? [])), fn($t) => $t !== '')));
        $stayTags   = array_values(array_unique(array_filter(array_map('trim', (array)($opts['stayTags']   ?? [])), fn($t) => $t !== '')));
        $campTags   = array_values(array_unique(array_filter(array_map('trim', (array)($opts['campingTags'] ?? [])), fn($t) => $t !== '')));
        $guide   = trim((string)($opts['guide'] ?? '')); $guide = ($guide !== '' && FoodGuide::exists($guide)) ? $guide : null;
        $catMr   = (array)($opts['catMinReview'] ?? []);
        $limit   = max(50, min(3000, (int)($opts['limit'] ?? 500)));
        if ($mode === 'region' && !$regionIn) $mode = 'nation';   // 지역 모드인데 접두 없음 → 전국

        $args = [':lat_c' => $lat, ':lng_c' => $lng, ':lat_s' => $lat];
        $sql  = "SELECT p.id, p.name, p.category, p.lat, p.lng, p.phone,
                        p.address, p.region_lv1, p.region_lv2,
                        p.period_start, p.period_end, p.attributes, p.updated_at,
                        p.review_count, p.score, p.save_count,
                        (6371 * ACOS(LEAST(1.0,
                           COS(RADIANS(:lat_c)) * COS(RADIANS(p.lat)) *
                           COS(RADIANS(p.lng) - RADIANS(:lng_c)) +
                           SIN(RADIANS(:lat_s)) * SIN(RADIANS(p.lat))
                        ))) AS dist_km,
                        (SELECT COUNT(*) FROM place_ref r WHERE r.place_id = p.id) AS ref_count,
                        (SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM place_tag t WHERE t.place_id = p.id AND t.kind <> 'month') AS tags,
                        (SELECT GROUP_CONCAT(CONCAT(g.guide, ':', COALESCE(g.grade, '')) ORDER BY g.guide SEPARATOR ',') FROM place_guide g WHERE g.place_id = p.id) AS guides
                 FROM place p
                 WHERE p.is_active = 1 AND p.geocode_status = 'ok'";

        // ── 공간 범위
        if ($mode === 'region') {
            $ors = [];
            foreach ($regionIn as $k => $rr) { $pp = ":r1_{$k}"; $ors[] = "p.address LIKE {$pp}"; $args[$pp] = $rr . '%'; }
            $sql .= " AND (" . implode(' OR ', $ors) . ")";
        } elseif ($mode === 'viewport') {
            $latDelta = $radius / 111.0;
            $cos      = max(cos(deg2rad($lat)), 0.01);
            $lngDelta = $radius / (111.0 * $cos);
            $sql .= " AND p.lat BETWEEN :lat_min AND :lat_max AND p.lng BETWEEN :lng_min AND :lng_max";
            $args[':lat_min'] = $lat - $latDelta; $args[':lat_max'] = $lat + $latDelta;
            $args[':lng_min'] = $lng - $lngDelta; $args[':lng_max'] = $lng + $lngDelta;
        }   // mode==='nation' → 공간 필터 없음(전국)

        // ── 도메인별 태그 서브쿼리(있을 때만 — 모든 태그를 보유한 장소만)
        $mkTagClause = function (array $tags, string $pfx) use (&$args) {
            if (!$tags) return '';
            $ph = [];
            foreach ($tags as $i => $t) { $pp = ":{$pfx}{$i}"; $ph[] = $pp; $args[$pp] = $t; }
            return " AND p.id IN (SELECT pt.place_id FROM place_tag pt WHERE pt.tag IN (" . implode(',', $ph) . ")
                     GROUP BY pt.place_id HAVING COUNT(DISTINCT pt.tag) = " . count($tags) . ")";
        };
        $travelClause = $mkTagClause($travelTags, 'tt');
        $foodClause   = $mkTagClause($foodTags, 'ft');
        $stayClause   = $mkTagClause($stayTags, 'sg');
        $campClause   = $mkTagClause($campTags, 'cg');
        $guideClause  = '';
        if ($guide !== null) { $guideClause = " AND EXISTS (SELECT 1 FROM place_guide g2 WHERE g2.place_id = p.id AND g2.guide = :guide)"; $args[':guide'] = $guide; }

        // ── 분류별 OR 절(선택 분류들의 합집합). 각 도메인은 자기 태그/리뷰티어로만 좁힘.
        $reviewTier = function (string $c, string $vp) use ($catMr, &$args) {
            $mr = (int)($catMr[$c] ?? 0);
            if ($mr <= 0) return '';
            $args[$vp] = $mr;
            // 리뷰 없는(NULL) 곳·가이드 등재는 항상 노출, 그 외엔 리뷰 기준 이상.
            return " AND (p.review_count IS NULL OR p.review_count >= {$vp} OR EXISTS (SELECT 1 FROM place_guide g3 WHERE g3.place_id = p.id))";
        };
        $catClauses = [];
        foreach ($cats as $c) {
            if ($c === 'travel') {
                $catClauses[] = "(p.category = 'travel'{$travelClause})";
            } elseif ($c === 'restaurant') {
                $catClauses[] = "(p.category = 'restaurant'{$foodClause}{$guideClause}" . $reviewTier('restaurant', ':mr_r') . ")";
            } elseif ($c === 'stay') {
                $catClauses[] = "(p.category = 'stay'{$stayClause}" . $reviewTier('stay', ':mr_s') . ")";
            } elseif ($c === 'camping') {
                $catClauses[] = "(p.category = 'camping'{$campClause}" . $reviewTier('camping', ':mr_c') . ")";
            } else {
                $catClauses[] = "(p.category = 'etc')";
            }
        }
        $sql .= " AND (" . implode(' OR ', $catClauses) . ")";

        if ($mode === 'viewport') { $sql .= " HAVING dist_km <= :radius"; $args[':radius'] = $radius; }
        $sql .= " ORDER BY (p.category = 'restaurant') ASC,
                           p.review_count DESC, p.score DESC, p.save_count DESC,
                           dist_km ASC
                  LIMIT {$limit}";

        $st = $this->pdo->prepare($sql);
        $st->execute($args);
        $features = [];
        while ($row = $st->fetch(PDO::FETCH_ASSOC)) {
            $features[] = [
                'type' => 'Feature',
                'geometry' => ['type' => 'Point', 'coordinates' => [(float)$row['lng'], (float)$row['lat']]],
                'properties' => [
                    'id'           => (int)$row['id'],
                    'name'         => $row['name'],
                    'category'     => $row['category'],
                    'phone'        => $row['phone'],
                    'address'      => $row['address'],
                    'region_lv1'   => $row['region_lv1'],
                    'region_lv2'   => $row['region_lv2'],
                    'period_start' => $row['period_start'],
                    'period_end'   => $row['period_end'],
                    'attributes'   => $row['attributes'] ? json_decode($row['attributes'], true) : null,
                    'updated_at'   => $row['updated_at'],
                    'ref_count'    => (int)$row['ref_count'],
                    'tags'         => $row['tags'] ? explode(',', $row['tags']) : [],
                    'guides'       => self::parseGuides($row['guides'] ?? null),
                    'dist_km'      => ($mode === 'viewport') ? round((float)$row['dist_km'], 3) : null,
                ],
            ];
        }
        return ['type' => 'FeatureCollection', 'features' => $features];
    }

    /** 단일 태그 검색(편의 래퍼) */
    public function searchByTag(string $tag, int $limit = 1500): array
    {
        return $this->searchByTags([$tag], $limit);
    }

    /**
     * 여러 태그 AND 검색 → GeoJSON. 주어진 태그를 '모두' 가진 ok 장소만(반경 무관).
     * searchNearby 와 동일한 properties.
     */
    public function searchByTags(array $tags, int $limit = 1500, ?string $guide = null, ?string $category = null, ?array $regionIn = null): array
    {
        $tags  = array_values(array_unique(array_filter(array_map('trim', $tags), fn($t) => $t !== '')));
        $guide = ($guide !== null && $guide !== '') ? $guide : null;
        // 태그도 가이드도 없으면 검색 의미 없음
        if (!$tags && $guide === null) return ['type' => 'FeatureCollection', 'features' => []];

        $args  = [];
        $where = ["p.is_active = 1", "p.geocode_status = 'ok'"];
        if ($category !== null && $category !== '') {
            $where[] = "p.category = :cat"; $args[':cat'] = $category;
        }
        // 시도 고정 필터(주소 접두) — 태그 검색을 그 시도로 한정(예: 강원 벚꽃).
        if ($regionIn !== null && count($regionIn) > 0) {
            $ors = [];
            foreach (array_values($regionIn) as $i => $rr) { $rp = ":r1_{$i}"; $ors[] = "p.address LIKE {$rp}"; $args[$rp] = $rr . '%'; }
            $where[] = "(" . implode(' OR ', $ors) . ")";
        }
        if ($guide !== null) {
            $where[] = "EXISTS (SELECT 1 FROM place_guide g2 WHERE g2.place_id = p.id AND g2.guide = :guide)";
            $args[':guide'] = $guide;
        }
        if ($tags) {
            $ph = [];
            foreach ($tags as $i => $t) { $ph[] = ":t{$i}"; $args[":t{$i}"] = $t; }
            $inList = implode(',', $ph);
            $need   = count($tags);
            $where[] = "p.id IN (
                       SELECT pt.place_id FROM place_tag pt
                        WHERE pt.tag IN ({$inList})
                        GROUP BY pt.place_id
                       HAVING COUNT(DISTINCT pt.tag) = {$need}
                   )";
        }
        $sql = "SELECT p.id, p.name, p.category, p.lat, p.lng, p.phone,
                       p.address, p.region_lv1, p.region_lv2,
                       p.period_start, p.period_end, p.attributes, p.updated_at,
                       (SELECT COUNT(*) FROM place_ref r WHERE r.place_id = p.id) AS ref_count,
                       (SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM place_tag t WHERE t.place_id = p.id AND t.kind <> 'month') AS tags,
                       (SELECT GROUP_CONCAT(CONCAT(g.guide, ':', COALESCE(g.grade, '')) ORDER BY g.guide SEPARATOR ',') FROM place_guide g WHERE g.place_id = p.id) AS guides
                  FROM place p
                 WHERE " . implode("\n                   AND ", $where) . "
                 ORDER BY (p.category = 'restaurant') ASC,
                          p.review_count DESC, p.score DESC, p.save_count DESC,
                          p.name
                 LIMIT {$limit}";
        $st = $this->pdo->prepare($sql);
        $st->execute($args);
        $features = [];
        while ($row = $st->fetch(PDO::FETCH_ASSOC)) {
            $features[] = [
                'type' => 'Feature',
                'geometry' => ['type' => 'Point', 'coordinates' => [(float)$row['lng'], (float)$row['lat']]],
                'properties' => [
                    'id'           => (int)$row['id'],
                    'name'         => $row['name'],
                    'category'     => $row['category'],
                    'phone'        => $row['phone'],
                    'address'      => $row['address'],
                    'region_lv1'   => $row['region_lv1'],
                    'region_lv2'   => $row['region_lv2'],
                    'period_start' => $row['period_start'],
                    'period_end'   => $row['period_end'],
                    'attributes'   => $row['attributes'] ? json_decode($row['attributes'], true) : null,
                    'updated_at'   => $row['updated_at'],
                    'ref_count'    => (int)$row['ref_count'],
                    'tags'         => $row['tags'] ? explode(',', $row['tags']) : [],
                    'guides'       => self::parseGuides($row['guides'] ?? null),
                    'dist_km'      => null,
                ],
            ];
        }
        return ['type' => 'FeatureCollection', 'features' => $features];
    }
    /**
     * 마커 클릭 시: 그 장소의 출처자료 링크 목록 (최신순).
     */
    public function getRefs(int $placeId): array
    {
        $st = $this->pdo->prepare(
            "SELECT id, source_type, title, url, summary, published_at, extra
               FROM place_ref
              WHERE place_id = ?
              ORDER BY published_at DESC, id DESC"
        );
        $st->execute([$placeId]);
        $rows = $st->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as &$r) {
            $r['extra'] = $r['extra'] ? json_decode($r['extra'], true) : null;
        }
        return $rows;
    }

    // ======================================================
    //  미분류(보관) 장소 — 잘못 묶인 기사를 삭제하지 않고 보존
    // ======================================================
    /** '(미분류)' 보관 장소(싱글톤) id. 없으면 생성. 좌표없음+is_active=0 → 지도/목록 어디에도 안 뜸 */
    public function getUncategorizedId(): int
    {
        $id = (int)$this->pdo->query(
            "SELECT id FROM place
              WHERE JSON_UNQUOTE(JSON_EXTRACT(attributes, '$.system')) = 'uncategorized'
              ORDER BY id LIMIT 1"
        )->fetchColumn();
        if ($id > 0) return $id;
        $st = $this->pdo->prepare(
            "INSERT INTO place (name, category, geocode_status, is_active, attributes, dedup_key)
             VALUES ('(미분류)', 'etc', 'pending', 0, JSON_OBJECT('system', 'uncategorized'), :dk)"
        );
        $st->execute([':dk' => md5('__system_uncategorized__')]);
        return (int)$this->pdo->lastInsertId();
    }

    /**
     * 한 장소에서 기사(ref)를 '(미분류)' 보관함으로 이동 — 삭제 아님(데이터 보존).
     * 같은 기사가 이미 보관함에 있으면(uq 충돌) 원래 행 제거(중복 정리).
     * @return array{ok:bool, bucket:int, dedup?:bool}
     */
    public function detachRef(int $refId, int $fromPlaceId): array
    {
        if ($refId <= 0 || $fromPlaceId <= 0) return ['ok' => false, 'bucket' => 0];
        $bucket = $this->getUncategorizedId();
        if ($bucket === $fromPlaceId) return ['ok' => false, 'bucket' => $bucket];
        try {
            $st = $this->pdo->prepare("UPDATE place_ref SET place_id = ? WHERE id = ? AND place_id = ?");
            $st->execute([$bucket, $refId, $fromPlaceId]);
            return ['ok' => $st->rowCount() > 0, 'bucket' => $bucket];
        } catch (PDOException $e) {
            if ($e->getCode() === '23000') {   // 이미 보관함에 동일 기사 → 원래 것 삭제
                $d = $this->pdo->prepare("DELETE FROM place_ref WHERE id = ? AND place_id = ?");
                $d->execute([$refId, $fromPlaceId]);
                return ['ok' => $d->rowCount() > 0, 'bucket' => $bucket, 'dedup' => true];
            }
            throw $e;
        }
    }

    /** 미분류 보관함의 기사 목록(최신순) */
    public function listUncategorizedRefs(int $limit = 2000): array
    {
        $bucket = $this->getUncategorizedId();
        $limit  = max(1, min(5000, $limit));
        $st = $this->pdo->prepare(
            "SELECT id, source_type, title, url, summary, published_at
               FROM place_ref WHERE place_id = ?
              ORDER BY published_at DESC, id DESC LIMIT {$limit}"
        );
        $st->execute([$bucket]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 미분류 보관함의 기사 1건 영구 삭제(보관함에 있는 것만 안전 삭제) @return int */
    public function purgeRef(int $refId): int
    {
        if ($refId <= 0) return 0;
        $bucket = $this->getUncategorizedId();
        $st = $this->pdo->prepare("DELETE FROM place_ref WHERE id = ? AND place_id = ?");
        $st->execute([$refId, $bucket]);
        return $st->rowCount();
    }

    /** 기사(ref) 1건 영구 삭제 — 지정 장소에 속한 것만 안전 삭제 @return int */
    public function deleteRef(int $refId, int $placeId): int
    {
        if ($refId <= 0 || $placeId <= 0) return 0;
        $st = $this->pdo->prepare("DELETE FROM place_ref WHERE id = ? AND place_id = ?");
        $st->execute([$refId, $placeId]);
        return $st->rowCount();
    }

    /** 우리 DB 장소를 이름으로 검색(재연결 대상 선택용). 미분류·비활성 제외 */
    public function findPlacesByName(string $kw, int $limit = 20): array
    {
        $kw = trim($kw);
        if ($kw === '') return [];
        $limit = max(1, min(50, $limit));
        $st = $this->pdo->prepare(
            "SELECT id, name, category, region_lv1, region_lv2, geocode_status
               FROM place
              WHERE is_active = 1
                AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(attributes, '$.system')), '') <> 'uncategorized'
                AND name LIKE :kw
              ORDER BY (geocode_status = 'ok') DESC, name LIMIT {$limit}"
        );
        $st->execute([':kw' => '%' . $kw . '%']);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 통합 검색창 자동완성용 — 우리 DB의 좌표 있는(ok) 장소를 이름으로 검색(좌표 포함) @return array */
    public function searchByNameForBox(string $kw, int $limit = 8): array
    {
        $kw = trim($kw);
        if ($kw === '') return [];
        $limit = max(1, min(20, $limit));
        $st = $this->pdo->prepare(
            "SELECT id, name, category, address, region_lv1, region_lv2, lat, lng
               FROM place
              WHERE is_active = 1 AND geocode_status = 'ok'
                AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(attributes, '$.system')), '') <> 'uncategorized'
                AND name LIKE :kw
              ORDER BY (name = :exact) DESC, CHAR_LENGTH(name), name LIMIT {$limit}"
        );
        $st->execute([':kw' => '%' . $kw . '%', ':exact' => $kw]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 미분류 보관함의 기사를 특정 장소로 재연결(이동). uq 충돌 시 보관함 행 삭제(이미 그 장소에 있음).
     * @return array{ok:bool, dedup?:bool}
     */
    public function reattachRef(int $refId, int $toPlaceId): array
    {
        if ($refId <= 0 || $toPlaceId <= 0) return ['ok' => false];
        $bucket = $this->getUncategorizedId();
        if ($toPlaceId === $bucket) return ['ok' => false];
        try {
            $st = $this->pdo->prepare("UPDATE place_ref SET place_id = ? WHERE id = ? AND place_id = ?");
            $st->execute([$toPlaceId, $refId, $bucket]);
            return ['ok' => $st->rowCount() > 0];
        } catch (PDOException $e) {
            if ($e->getCode() === '23000') {
                $d = $this->pdo->prepare("DELETE FROM place_ref WHERE id = ? AND place_id = ?");
                $d->execute([$refId, $bucket]);
                return ['ok' => $d->rowCount() > 0, 'dedup' => true];
            }
            throw $e;
        }
    }

    /**
     * 장소명으로 좌표 1건 찾기 (주소 지오코딩이 실패하는 POI 이름 검색 폴백용).
     * 정확히 일치하는 이름을 우선, 없으면 부분일치. ok 상태만 대상.
     * @return array|null ['name','lat','lng'] 또는 null
     */
    public function findByName(string $kw): ?array
    {
        $kw = trim($kw);
        if ($kw === '') return null;
        $st = $this->pdo->prepare(
            "SELECT name, lat, lng
               FROM place
              WHERE geocode_status = 'ok' AND name LIKE :kw
              ORDER BY (name = :exact) DESC, id
              LIMIT 1"
        );
        $st->execute([':kw' => '%' . $kw . '%', ':exact' => $kw]);
        $row = $st->fetch(PDO::FETCH_ASSOC);
        return $row ?: null;
    }

    // ======================================================
    // 3. 지오코딩 배치 지원 (GeoCoder.class 가 실제 API 호출)
    // ======================================================

    /** 좌표화 안 된(pending) + 주소 있는 행 N개 — 배치 지오코딩 대상 */
    public function pendingForGeocode(int $limit = 50): array
    {
        $st = $this->pdo->prepare(
            "SELECT id, name, address, region_lv1, region_lv2
               FROM place
              WHERE geocode_status = 'pending'
                AND address IS NOT NULL AND address <> ''
              ORDER BY id
              LIMIT {$limit}"
        );
        $st->execute();
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 주소가 없는 pending (장소명만 있는 건) — 이름+지역으로 카카오 키워드 좌표화용 */
    public function pendingByName(int $limit = 50): array
    {
        $st = $this->pdo->prepare(
            "SELECT id, name, region_lv1, region_lv2
               FROM place
              WHERE geocode_status = 'pending'
                AND (address IS NULL OR address = '')
                AND name IS NOT NULL AND name <> ''
              ORDER BY id
              LIMIT {$limit}"
        );
        $st->execute();
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /** 지오코딩 결과 반영. 성공이면 lat/lng+ok, 실패면 failed */
    public function setGeocode(int $id, ?float $lat, ?float $lng, string $status): void
    {
        $st = $this->pdo->prepare(
            "UPDATE place SET lat = :lat, lng = :lng, geocode_status = :st WHERE id = :id"
        );
        $st->execute([
            ':lat' => $status === 'ok' ? $lat : null,
            ':lng' => $status === 'ok' ? $lng : null,
            ':st'  => $status,
            ':id'  => $id,
        ]);
    }

    // ======================================================
    // 한시적 공개 공유 링크 (로그인 없이 지도 열람) — travel.php 패턴 재사용
    // ======================================================

    /** 공유 링크 발급. 기존 활성 링크는 무효화하고 새 토큰 1개만 유지. @return [token, expires_at] */
    public function createShare(int $ttlSeconds): array
    {
        $this->revokeShares();                                // 활성 링크는 1개만
        $ttl   = max(60, min($ttlSeconds, 30 * 24 * 3600));   // 1분~30일 클램프
        $token = bin2hex(random_bytes(16));                   // 추측 불가 32자리
        $this->pdo->prepare(
            "INSERT INTO tbl_place_share (token, expires_at)
             VALUES (?, DATE_ADD(NOW(), INTERVAL ? SECOND))"
        )->execute([$token, $ttl]);
        $row = $this->getShareByToken($token);
        return ['token' => $token, 'expires_at' => $row['expires_at'] ?? null];
    }

    /** 토큰으로 유효한(미만료·미취소) 공유 조회 — 게스트 접근 검증용 */
    public function getValidShare(string $token): ?array
    {
        if ($token === '') return null;
        $st = $this->pdo->prepare(
            "SELECT * FROM tbl_place_share
              WHERE token = ? AND revoked = 0 AND expires_at > NOW() LIMIT 1"
        );
        $st->execute([$token]);
        return $st->fetch() ?: null;
    }

    /** 현재 활성 공유 1건 (소유자 화면의 기존 링크 표시용) */
    public function getActiveShare(): ?array
    {
        $st = $this->pdo->query(
            "SELECT * FROM tbl_place_share
              WHERE revoked = 0 AND expires_at > NOW()
              ORDER BY id DESC LIMIT 1"
        );
        return $st->fetch() ?: null;
    }

    /** 모든 활성 공유 즉시 차단 ('공유 중단') */
    public function revokeShares(): void
    {
        $this->pdo->exec("UPDATE tbl_place_share SET revoked = 1 WHERE revoked = 0");
    }

    private function getShareByToken(string $token): ?array
    {
        $st = $this->pdo->prepare("SELECT * FROM tbl_place_share WHERE token = ? LIMIT 1");
        $st->execute([$token]);
        return $st->fetch() ?: null;
    }

    /**
     * 장소 수정용: 이름/분류 변경 + (좌표 지정 시) lat/lng + geocode_status='ok'.
     * null 인 항목은 미변경. 좌표는 lat/lng 둘 다 와야 적용(ok 로 마킹 → 지도에 표시됨).
     * @return bool 1건 이상 SET 되어 실행했으면 true
     */
    public function adminUpdate(int $id, ?string $name, ?string $category, ?float $lat, ?float $lng, ?string $address = null): bool
    {
        if ($id <= 0) return false;
        $sets = []; $params = [':id' => $id];
        if ($name !== null && $name !== '') {
            $sets[] = 'name = :name';     $params[':name'] = mb_substr($name, 0, 255);
        }
        $allowed = ['travel', 'stay', 'restaurant', 'etc'];
        if ($category !== null && in_array($category, $allowed, true)) {
            $sets[] = 'category = :cat';  $params[':cat'] = $category;
        }
        if ($lat !== null && $lng !== null) {
            $sets[] = 'lat = :lat'; $sets[] = 'lng = :lng'; $sets[] = "geocode_status = 'ok'";
            $params[':lat'] = $lat; $params[':lng'] = $lng;
        }
        if ($address !== null && $address !== '') {
            $sets[] = 'address = :addr'; $params[':addr'] = mb_substr($address, 0, 255);
        }
        if (!$sets) return false;
        $sets[] = 'updated_at = NOW()';
        $st = $this->pdo->prepare('UPDATE place SET ' . implode(', ', $sets) . ' WHERE id = :id');
        return $st->execute($params);
    }

    /**
     * 한 출처(기사)가 여러 장소를 다룰 때 — 원본 장소의 출처자료(place_ref)를 새 장소로 복제.
     * url_hash 는 (place_id, url_hash) 복합 UNIQUE 라 장소가 다르면 같은 URL 도 INSERT 된다
     * (같은 장소로의 재복제는 IGNORE 로 무시).
     * @return int 복제된 ref 건수
     */
    public function copyRefs(int $fromId, int $toId): int
    {
        if ($fromId <= 0 || $toId <= 0 || $fromId === $toId) return 0;
        $st = $this->pdo->prepare(
            "INSERT IGNORE INTO place_ref
               (place_id, source_type, title, url, summary, published_at, extra)
             SELECT :to, source_type, title, url, summary, published_at, extra
               FROM place_ref WHERE place_id = :from"
        );
        $st->execute([':to' => $toId, ':from' => $fromId]);
        return $st->rowCount();
    }

    /**
     * 멀티 등록 — 원본 장소($srcId)와 같은 기사를 공유하는 새 장소를 좌표와 함께 생성.
     * 새 place(좌표=ok) upsert 후 $srcId 의 출처자료를 복제 연결한다.
     * @return int 새(또는 dedup 으로 합쳐진) place id
     */
    public function addLinkedPlace(int $srcId, string $name, string $category, float $lat, float $lng, string $address = ''): int
    {
        $name = trim($name);
        if ($name === '') throw new InvalidArgumentException('place name 은 필수입니다.');
        $allowed = ['travel', 'stay', 'restaurant', 'etc'];
        if (!in_array($category, $allowed, true)) $category = 'travel';
        $newId = $this->upsertPlace([
            'name'           => $name,
            'category'       => $category,
            'lat'            => $lat,
            'lng'            => $lng,
            'address'        => ($address !== '' ? $address : null),
            'geocode_status' => 'ok',
        ]);
        if ($newId > 0 && $newId !== $srcId) {
            $this->copyRefs($srcId, $newId);
        }
        return $newId;
    }

    /**
     * 장소 삭제 (소유자 전용). place_ref 는 FK ON DELETE CASCADE 로 함께 삭제된다.
     * @return int 삭제된 place 행 수(0 또는 1)
     */
    public function deletePlace(int $id): int
    {
        if ($id <= 0) return 0;
        $st = $this->pdo->prepare("DELETE FROM place WHERE id = ?");
        $st->execute([$id]);
        return $st->rowCount();
    }

    /**
     * 장소 병합(중복 정리) — $fromIds 의 기사(place_ref)·태그(place_tag)를 대표 $toId 로 이관 후
     * $fromIds 장소들을 삭제한다. 같은 URL/태그가 이미 대표에 있으면 IGNORE(중복 스킵→from 삭제 시 CASCADE 정리).
     * 대표 장소의 이름/좌표/분류 등 자체 필드는 건드리지 않는다.
     * @return array{ok:bool, merged?:int, to_id?:int, ref_count?:int, msg?:string}
     */
    public function mergePlaces(int $toId, array $fromIds): array
    {
        $toId = (int)$toId;
        $fromIds = array_values(array_unique(array_filter(
            array_map('intval', $fromIds), fn($x) => $x > 0 && $x !== $toId
        )));
        if ($toId <= 0 || !$fromIds) return ['ok' => false, 'msg' => '대상/병합 id 오류'];
        $bucket = $this->getUncategorizedId();
        if ($toId === $bucket || in_array($bucket, $fromIds, true)) {
            return ['ok' => false, 'msg' => '미분류 보관함은 병합에 쓸 수 없습니다'];
        }
        // 대표가 실제 존재하는지 확인
        $chk = $this->pdo->prepare("SELECT COUNT(*) FROM place WHERE id = ?");
        $chk->execute([$toId]);
        if (!(int)$chk->fetchColumn()) return ['ok' => false, 'msg' => '대표 장소를 찾을 수 없습니다'];

        $in = implode(',', $fromIds);   // 모두 정수로 정제됨 — 주입 위험 없음
        $this->pdo->beginTransaction();
        try {
            // 기사 이관 (대표에 같은 URL 있으면 uq_place_url 충돌 → UPDATE IGNORE 스킵, from 삭제 시 CASCADE 정리)
            $this->pdo->exec("UPDATE IGNORE place_ref SET place_id = {$toId} WHERE place_id IN ({$in})");
            // 태그 이관 (중복은 INSERT IGNORE)
            $this->pdo->exec(
                "INSERT IGNORE INTO place_tag (place_id, kind, tag)
                 SELECT {$toId}, kind, tag FROM place_tag WHERE place_id IN ({$in})"
            );
            // 맛집 가이드 이관 (대표에 같은 guide 있으면 기존 grade 유지 = IGNORE)
            $this->pdo->exec(
                "INSERT IGNORE INTO place_guide (place_id, guide, grade)
                 SELECT {$toId}, guide, grade FROM place_guide WHERE place_id IN ({$in})"
            );
            // 중복 장소 삭제 (남은 ref/tag 는 FK CASCADE)
            $del = $this->pdo->prepare("DELETE FROM place WHERE id IN ({$in})");
            $del->execute();
            $deleted = $del->rowCount();
            $this->pdo->commit();
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            return ['ok' => false, 'msg' => $e->getMessage()];
        }
        $refCnt = (int)$this->pdo->query("SELECT COUNT(*) FROM place_ref WHERE place_id = {$toId}")->fetchColumn();
        return ['ok' => true, 'merged' => $deleted, 'to_id' => $toId, 'ref_count' => $refCnt];
    }

    // ======================================================
    //  태그 (place_tag) — 다중 라벨·검색용
    // ======================================================
    private const TAG_KINDS = ['type', 'theme', 'month', 'facet', 'cuisine', 'grade'];

    /** 한 장소의 태그 목록 [{kind, tag}] (월=숫자순, 그 외 종류·이름순) */
    public function getTags(int $placeId): array
    {
        if ($placeId <= 0) return [];
        $st = $this->pdo->prepare(
            "SELECT kind, tag FROM place_tag WHERE place_id = ?
              ORDER BY FIELD(kind,'type','theme','facet','month'),
                       CAST(REGEXP_REPLACE(tag,'[^0-9]','') AS UNSIGNED), tag"
        );
        $st->execute([$placeId]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 장소 태그 전체 교체 (소유자 편집). 잘못된 kind/빈 tag 는 건너뛰고,
     * 같은 (kind,tag) 중복은 PK 로 무시. 최대 50개.
     * @param array $tags [{kind, tag}, ...]
     */
    public function setTags(int $placeId, array $tags): void
    {
        if ($placeId <= 0) return;
        $clean = [];
        foreach ($tags as $t) {
            $kind = (string)($t['kind'] ?? 'theme');
            $tag  = trim((string)($t['tag'] ?? ''));
            if ($tag === '' || !in_array($kind, self::TAG_KINDS, true)) continue;
            $clean[$kind . "\0" . mb_substr($tag, 0, 40)] = ['kind' => $kind, 'tag' => mb_substr($tag, 0, 40)];
            if (count($clean) >= 50) break;
        }
        $this->pdo->beginTransaction();
        try {
            $this->pdo->prepare("DELETE FROM place_tag WHERE place_id = ?")->execute([$placeId]);
            if ($clean) {
                $ins = $this->pdo->prepare(
                    "INSERT IGNORE INTO place_tag (place_id, kind, tag) VALUES (?, ?, ?)"
                );
                foreach ($clean as $row) $ins->execute([$placeId, $row['kind'], $row['tag']]);
            }
            $this->pdo->commit();
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
    }

    /**
     * 기존 태그 목록 [{tag, kind, cnt}] (사용빈도순).
     * @param bool $mappableOnly 상단 칩바용: kind 무시·월 제외하고 '지도에 뜨는(ok·활성)'
     *   장소 기준 태그별 distinct 개수 → 클릭 시 searchByTags 결과와 카운트가 일치한다.
     *   false(기본): 자동완성·태그관리용 — (tag, kind)별 전체 행 수.
     */
    public function listTags(int $limit = 500, bool $mappableOnly = false, ?string $kind = null, ?string $category = null, ?array $regionIn = null): array
    {
        $limit = max(1, min(2000, $limit));
        // kind 는 콤마로 여러 종류 허용(예: 'cuisine,grade' = 맛집 칩바)
        $kinds = array_values(array_filter(array_map('trim', explode(',', (string)$kind)), fn($k) => $k !== ''));
        $kindArgs = []; $kindIn = '';
        if ($kinds) {
            $ph = [];
            foreach ($kinds as $i => $k) { $ph[] = ":k{$i}"; $kindArgs[":k{$i}"] = $k; }
            $kindIn = implode(',', $ph);
        }
        // 분류 스코프(칩바 분류별 분리용): 그 분류 장소에 달린 태그만.
        //  예) 같은 kind=cuisine 이라도 category=restaurant=음식종류 / category=stay=숙박유형 / camping=캠핑유형 으로 분리.
        $allowedCat = ['travel', 'restaurant', 'stay', 'camping', 'etc'];
        $catCond = ''; $catArg = [];
        if ($category !== null && in_array($category, $allowedCat, true)) { $catCond = " AND p.category = :pcat"; $catArg[':pcat'] = $category; }
        // 지역 스코프(시도 고정 시): 그 지역 장소의 태그·카운트만(예: 강원 뷔페 5). 주소 접두 매칭.
        $regCond = ''; $regArg = [];
        $regs = array_values(array_filter(array_map('trim', (array)($regionIn ?? [])), fn($r) => $r !== ''));
        if ($regs) {
            $ors = [];
            foreach ($regs as $i => $rr) { $rp = ":tlr{$i}"; $ors[] = "p.address LIKE {$rp}"; $regArg[$rp] = $rr . '%'; }
            $regCond = " AND (" . implode(' OR ', $ors) . ")";
        }
        if ($mappableOnly) {
            // 여행 칩바(kind 미지정): 월·음식·등급 제외 / 맛집 칩바: 지정 kind IN
            $kindCond = $kinds ? "pt.kind IN ({$kindIn})" : "pt.kind NOT IN ('month','cuisine','grade')";
            $st = $this->pdo->prepare(
                "SELECT pt.tag, MIN(pt.kind) kind, COUNT(DISTINCT pt.place_id) cnt
                   FROM place_tag pt
                   JOIN place p ON p.id = pt.place_id
                  WHERE {$kindCond} AND p.is_active = 1 AND p.geocode_status = 'ok'{$catCond}{$regCond}
                  GROUP BY pt.tag ORDER BY cnt DESC, pt.tag LIMIT {$limit}"
            );
            $st->execute($kindArgs + $catArg + $regArg);
            return $st->fetchAll(PDO::FETCH_ASSOC);
        }
        // cat = 그 태그가 가장 많이 달린 장소 분류(대표 분류). 태그 관리 모달이 분류별로 묶는 데 사용.
        //  → 같은 kind=cuisine 이라도 한식=restaurant / 펜션=stay / 캠핑=camping 으로 정확히 분리됨.
        $catSub = "(SELECT p2.category FROM place_tag x JOIN place p2 ON p2.id = x.place_id
                     WHERE x.tag = place_tag.tag GROUP BY p2.category ORDER BY COUNT(*) DESC LIMIT 1)";
        if ($kinds) {
            $st = $this->pdo->prepare(
                "SELECT tag, kind, COUNT(*) cnt, {$catSub} AS cat FROM place_tag
                  WHERE kind IN ({$kindIn})
                  GROUP BY tag, kind ORDER BY cnt DESC, tag LIMIT {$limit}"
            );
            $st->execute($kindArgs);
            return $st->fetchAll(PDO::FETCH_ASSOC);
        }
        $st = $this->pdo->query(
            "SELECT tag, kind, COUNT(*) cnt, {$catSub} AS cat FROM place_tag
              GROUP BY tag, kind ORDER BY cnt DESC, tag LIMIT {$limit}"
        );
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 태그 이름변경 = 병합. $from 을 가진 모든 장소의 태그를 $to 로 이관한다.
     * $to 가 이미 있는 장소는 INSERT IGNORE 로 자연 병합(중복 제거), kind 는 보존.
     * @return int 이관(삭제)된 원본 행 수
     */
    public function renameTag(string $from, string $to): int
    {
        $from = trim($from);
        $to   = trim(mb_substr($to, 0, 40));
        if ($from === '' || $to === '' || $from === $to) return 0;
        $this->pdo->beginTransaction();
        try {
            $this->pdo->prepare(
                "INSERT IGNORE INTO place_tag (place_id, kind, tag)
                 SELECT place_id, kind, :to FROM place_tag WHERE tag = :from"
            )->execute([':to' => $to, ':from' => $from]);
            $del = $this->pdo->prepare("DELETE FROM place_tag WHERE tag = :from");
            $del->execute([':from' => $from]);
            $n = $del->rowCount();
            $this->pdo->commit();
            return $n;
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
    }

    /** 태그 완전 삭제(모든 장소에서 제거). @return int 삭제된 행 수 */
    public function deleteTag(string $tag): int
    {
        $tag = trim($tag);
        if ($tag === '') return 0;
        $st = $this->pdo->prepare("DELETE FROM place_tag WHERE tag = ?");
        $st->execute([$tag]);
        return $st->rowCount();
    }

    /**
     * 태그 추가(기존 유지) — 자동 태깅 백필용. INSERT IGNORE 라 중복/수동태그 안 건드림.
     * @param array $tags [{kind, tag}, ...]
     * @return int 실제로 새로 추가된 행 수
     */
    public function addTags(int $placeId, array $tags): int
    {
        if ($placeId <= 0 || !$tags) return 0;
        $ins = $this->pdo->prepare("INSERT IGNORE INTO place_tag (place_id, kind, tag) VALUES (?,?,?)");
        $n = 0;
        foreach ($tags as $t) {
            $kind = (string)($t['kind'] ?? 'theme');
            $tag  = trim((string)($t['tag'] ?? ''));
            if ($tag === '' || !in_array($kind, self::TAG_KINDS, true)) continue;
            $ins->execute([$placeId, $kind, mb_substr($tag, 0, 40)]);
            $n += $ins->rowCount();
        }
        return $n;
    }

    // ======================================================
    //  맛집 가이드 (place_guide) — 중분류(블루리본/미쉐린)+등급
    //  정의·색·우선순위·등급라벨은 FoodGuide.class. 여기는 저장/조회 전담.
    // ======================================================

    /** "guide:grade,guide2:grade2" 문자열(GROUP_CONCAT) → [{guide, grade}] */
    public static function parseGuides(?string $s): array
    {
        if ($s === null || $s === '') return [];
        $out = [];
        foreach (explode(',', $s) as $pair) {
            if ($pair === '') continue;
            $p = explode(':', $pair, 2);
            $g = trim($p[0]);
            if ($g === '') continue;
            $out[] = ['guide' => $g, 'grade' => (isset($p[1]) && $p[1] !== '') ? $p[1] : null];
        }
        return $out;
    }

    /** 한 장소의 가이드 목록 [{guide, grade}] */
    public function getGuides(int $placeId): array
    {
        if ($placeId <= 0) return [];
        $st = $this->pdo->prepare("SELECT guide, grade FROM place_guide WHERE place_id = ? ORDER BY guide");
        $st->execute([$placeId]);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 한 장소의 가이드 전체 교체 (수정모달). $guides = [{guide, grade}, ...].
     * 빈 guide 스킵, 같은 guide 중복은 마지막 값, 최대 10개.
     */
    public function setGuides(int $placeId, array $guides): void
    {
        if ($placeId <= 0) return;
        $clean = [];
        foreach ($guides as $g) {
            $guide = trim((string)($g['guide'] ?? ''));
            if ($guide === '') continue;
            $grade = trim((string)($g['grade'] ?? ''));
            $clean[mb_substr($guide, 0, 20)] = $grade !== '' ? mb_substr($grade, 0, 20) : null;
            if (count($clean) >= 10) break;
        }
        $this->pdo->beginTransaction();
        try {
            $this->pdo->prepare("DELETE FROM place_guide WHERE place_id = ?")->execute([$placeId]);
            if ($clean) {
                $ins = $this->pdo->prepare("INSERT INTO place_guide (place_id, guide, grade) VALUES (?, ?, ?)");
                foreach ($clean as $guide => $grade) $ins->execute([$placeId, $guide, $grade]);
            }
            $this->pdo->commit();
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
    }

    /** 가이드 1건 추가(기존 유지) — 적재/백필용. 이미 있으면 grade 갱신. @return bool */
    public function addGuide(int $placeId, string $guide, ?string $grade = null): bool
    {
        $guide = trim($guide);
        if ($placeId <= 0 || $guide === '') return false;
        $st = $this->pdo->prepare(
            "INSERT INTO place_guide (place_id, guide, grade) VALUES (?, ?, ?)
             ON DUPLICATE KEY UPDATE grade = COALESCE(VALUES(grade), grade)"
        );
        $st->execute([
            $placeId, mb_substr($guide, 0, 20),
            ($grade !== null && $grade !== '') ? mb_substr($grade, 0, 20) : null,
        ]);
        return true;
    }

    /**
     * 가이드별 장소 수(상단 칩바용). 지도에 뜨는(ok·활성) 맛집 기준 distinct.
     * @return array [{guide, cnt}] cnt 내림차순
     */
    public function guideCounts(?array $regionIn = null): array
    {
        $regCond = ''; $args = [];
        $regs = array_values(array_filter(array_map('trim', (array)($regionIn ?? [])), fn($r) => $r !== ''));
        if ($regs) {
            $ors = [];
            foreach ($regs as $i => $rr) { $rp = ":gr{$i}"; $ors[] = "p.address LIKE {$rp}"; $args[$rp] = $rr . '%'; }
            $regCond = " AND (" . implode(' OR ', $ors) . ")";
        }
        $st = $this->pdo->prepare(
            "SELECT g.guide, COUNT(DISTINCT g.place_id) cnt
               FROM place_guide g
               JOIN place p ON p.id = g.place_id
              WHERE p.is_active = 1 AND p.geocode_status = 'ok' AND p.category = 'restaurant'{$regCond}
              GROUP BY g.guide ORDER BY cnt DESC, g.guide"
        );
        $st->execute($args);
        return $st->fetchAll(PDO::FETCH_ASSOC);
    }
}
