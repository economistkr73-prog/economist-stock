<?php
/**
 * Kiwoom.class — 키움증권 REST API (분봉 수집 전용)
 *
 * ══ 왜 키움인가 ════════════════════════════════════════════════════════
 * 네이버 분봉은 <b>최근 7거래일</b>만 준다(실측 2026-08-04). 단타 화면의 보관 창이
 * 10거래일이라 네이버만으로는 처음부터 못 채운다. 키움은 약 1년을 보관하므로
 * ① 신규 등록 종목의 10거래일 초기 적재 ② 며칠 놓친 구멍의 치유 가 가능해진다.
 * 네이버는 <b>폴백과 장중 실시간</b>으로 남긴다(토큰이 필요 없고 빠르다).
 *
 * ══ ★주문 API 는 절대 부르지 않는다 ════════════════════════════════════
 * 이 클래스는 «조회 TR 화이트리스트»(TR_MAP)에 있는 것만 호출한다. 그 밖의 api-id 는
 * 예외를 던진다 — 실수로든 남의 코드에서든 주문·정정·취소가 나갈 길을 막는다.
 *
 * ══ 인증 ═══════════════════════════════════════════════════════════════
 * appkey/secretkey 는 env/kiwoom.inc (웹 루트 밖 · gitignore). 접근토큰만 dt_token 에 캐시하고
 * 만료 10분 전에 새로 받는다.
 *
 * ══ 실측으로 확정된 것 (2026-08-04 · 005930 ka10080 실호출) ════════════
 *   · 목록 키   stk_min_pole_chart_qry · 시각 필드 cntr_tm ('YYYYMMDDHHMMSS')
 *   · 가격 필드 cur_prc/open_pric/high_pric/low_pric (부호 붙음) · 거래량 trde_qty
 *   · <b>시각은 봉의 «시작»</b> — TS_BASE='start'. 네이버 381봉과 같은 분 288 : 1분 당겨 89.
 *     구조로도 같은 답이다 — 09:00 있고 08:59 없음 / 15:19 있고 15:20 없음(동시호가) / 15:30 단일가.
 *   · <b>_AL(SOR) 은 거래량 기준이 네이버와 다르다</b> — KRX 29,246,067 · NXT 14,315,959 · _AL 43,555,914.
 *     네이버가 폴백이자 장중 실시간 소스라 섞이면 안 되므로 env 의 KIWOOM_NO_SOR=true (KRX 단독).
 * 파싱은 여전히 «있을 법한 이름 여러 개»를 훑는 느슨한 방식이다(pickList/pick) — 필드명이 바뀌어도 살아남게.
 */
class Kiwoom
{
    public const HOST      = 'https://api.kiwoom.com';
    public const HOST_MOCK = 'https://mockapi.kiwoom.com';

    /**
     * ★조회 전용 화이트리스트. 여기 없는 api-id 는 부를 수 없다.
     *   ka10080 주식분봉차트조회요청 · ka10081 주식일봉차트조회요청(예비)
     *   ka10095 관심종목정보요청 — <b>복수 종목 현재가를 한 요청에</b> (2026-08-06 신설)
     */
    public const TR_MAP = [
        'ka10080' => '/api/dostk/chart',
        'ka10081' => '/api/dostk/chart',
        'ka10095' => '/api/dostk/stkinfo',
    ];

    /**
     * ka10095 한 요청의 종목 수 상한 — <b>실측 2026-08-06</b>.
     * 50·100 은 정상(각 0.03초), <b>150 은 return_code=5 로 거절</b>된다.
     */
    public const QUOTE_CHUNK = 100;

    /**
     * ★ 키움 분봉의 시각이 그 봉의 «시작»인가 «종료»인가 — [V-1] <b>2026-08-04 실측 확정: 'start'</b>.
     *   'start' 면 그대로 쓰고, 'end' 면 저장 전에 1분 당긴다.
     *   근거: 네이버 381봉과 대조해 같은 분 일치 288 · 1분 당겨 일치 89. 그리고 봉의 경계가
     *   09:00 시작(08:59 없음) · 15:19 끝(15:20 없음 = 동시호가) · 마지막 시간외 19:59 로 떨어진다
     *   — 종료 기준이면 09:01~15:20 · 20:00 이어야 한다.
     *   잘못 잡으면 <b>전 데이터가 1분씩 밀리고</b> 네이버 폴백분과 섞이면서 조용히 깨진다.
     */
    public const TS_BASE = 'start';

    /** 1 req/s (버스트 2) 기준 — 콜 사이 <b>기본</b> 간격 */
    public const GAP_USEC = 1000000;

    /**
     * 이번 인스턴스가 실제로 쓸 콜 간격(마이크로초). 기본은 GAP_USEC.
     *
     * ★상수를 늘리지 않고 인스턴스로 덮는 이유 — 늦게 돌아야 하는 쪽은 수천 콜을 쏟아붓는
     *   급등주 아카이브뿐이다. 상수를 만지면 매일 20종목만 받는 `dt_min` 까지 함께 느려진다.
     */
    private int $gap = self::GAP_USEC;

    private PDO $pdo;
    private string $appkey  = '';
    private string $secret  = '';
    private string $host    = self::HOST;
    public  array  $log     = [];

    public function __construct(PDO $pdo)
    {
        $this->pdo = $pdo;
        $f = $_SERVER['DOCUMENT_ROOT'] . '/env/kiwoom.inc';
        if (is_file($f)) require_once $f;
        if (defined('KIWOOM_APP_KEY'))    $this->appkey = (string)KIWOOM_APP_KEY;
        if (defined('KIWOOM_SECRET_KEY')) $this->secret = (string)KIWOOM_SECRET_KEY;
        if (defined('KIWOOM_MOCK') && KIWOOM_MOCK) $this->host = self::HOST_MOCK;
    }

    /**
     * 콜 사이 간격을 늦춘다(초 단위 실수 허용). 키움 한도에 여유를 두고 싶을 때 쓴다.
     * 기본(1초)보다 <b>짧게는 못 준다</b> — 한도를 넘기는 방향으로는 열지 않는다.
     */
    public function setGap(float $sec): void
    {
        $this->gap = max(self::GAP_USEC, (int)round($sec * 1000000));
    }

    /** 지금 쓰는 콜 간격(초) — 로그·예상 시간 계산용 */
    public function gap(): float
    {
        return $this->gap / 1000000;
    }

    public function hasKey(): bool
    {
        return $this->appkey !== '' && $this->secret !== '';
    }

    // ══ 토큰 ════════════════════════════════════════════════════════════
    /**
     * 접근토큰. dt_token 에 캐시하고 만료 10분 전에 재발급한다.
     * @throws RuntimeException 키가 없거나 발급 실패
     */
    public function token(bool $force = false): string
    {
        if (!$this->hasKey()) {
            throw new RuntimeException('키움 인증키가 없습니다 (env/kiwoom.inc).');
        }
        if (!$force) {
            $st = $this->pdo->prepare("SELECT token FROM dt_token
                                        WHERE id=1 AND expires_at > DATE_ADD(NOW(), INTERVAL 10 MINUTE)");
            $st->execute();
            $t = $st->fetchColumn();
            if ($t) return (string)$t;
        }

        $res = $this->http('POST', '/oauth2/token', [
            'grant_type' => 'client_credentials',
            'appkey'     => $this->appkey,
            'secretkey'  => $this->secret,
        ], []);

        $body  = $res['body'];
        $token = (string)($body['token'] ?? $body['access_token'] ?? '');
        if ($token === '') {
            throw new RuntimeException('토큰 발급 실패: ' . $this->errText($res));
        }
        // expires_dt = 'YYYYMMDDHHMMSS' (없으면 보수적으로 6시간)
        $exp = (string)($body['expires_dt'] ?? '');
        $expAt = (strlen($exp) === 14)
            ? substr($exp, 0, 4) . '-' . substr($exp, 4, 2) . '-' . substr($exp, 6, 2) . ' '
              . substr($exp, 8, 2) . ':' . substr($exp, 10, 2) . ':' . substr($exp, 12, 2)
            : date('Y-m-d H:i:s', time() + 6 * 3600);

        $st = $this->pdo->prepare("
            INSERT INTO dt_token (id, token, expires_at, upd_at) VALUES (1, ?, ?, NOW())
            ON DUPLICATE KEY UPDATE token=VALUES(token), expires_at=VALUES(expires_at), upd_at=NOW()
        ");
        $st->execute([$token, $expAt]);
        return $token;
    }

    // ══ 분봉 ════════════════════════════════════════════════════════════
    /**
     * 주식분봉차트조회 (ka10080).
     *
     * @param string $code   6자리 (env 의 KIWOOM_NO_SOR 가 false 일 때만 `_AL`(SOR) 을 붙여 보낸다)
     * @param int    $tic    분 단위. 우리는 언제나 1
     * @param string $from   Y-m-d — 이 날 <b>이전</b> 봉이 나오면 연속조회를 멈춘다
     * @param int    $maxCall 연속조회 상한 (한 콜 ≈ 900봉 · 10거래일이면 5콜 안팎)
     * @param string $baseDt  Y-m-d — <b>이 날까지</b>의 봉부터 역방향으로 받는다 (빈 값이면 오늘부터)
     *
     * ★base_dt 는 2026-08-05 실호출로 확인했다 — 지정하면 그 날 장 마감까지의 900봉이 온다.
     *   없으면 언제나 «오늘»부터 되짚어야 해서, 두 달 전 구간에 닿는 데만 20콜이 든다(005930 실측).
     *   과거 구간을 받을 때는 <b>반드시</b> 넣는다 — 콜 수가 네 배 차이난다.
     * @return array ['rows'=>정규화된 봉, 'calls'=>int, 'raw_first'=>원본 첫 항목(진단용)]
     */
    public function minute(string $code, int $tic = 1, string $from = '', int $maxCall = 8,
                           string $baseDt = ''): array
    {
        $code = Dt::cleanCode($code);
        $stk  = $code . (defined('KIWOOM_NO_SOR') && KIWOOM_NO_SOR ? '' : '_AL');
        $token = $this->token();

        $rows = [];
        $cont = ''; $next = '';
        $calls = 0; $rawFirst = null;

        for ($i = 0; $i < $maxCall; $i++) {
            $hdr = [
                'authorization: Bearer ' . $token,
                'api-id: ka10080',
                'cont-yn: ' . ($cont === 'Y' ? 'Y' : 'N'),
                'next-key: ' . $next,
            ];
            $body = [
                'stk_cd'       => $stk,
                'tic_scope'    => (string)$tic,
                'upd_stkpc_tp' => '1',            // 수정주가 — 네이버(수정주가 계열)와 기준을 맞춘다
            ];
            // 연속조회에도 같은 본문을 그대로 보낸다(위치는 next-key 가 잡는다)
            if ($baseDt !== '') $body['base_dt'] = str_replace('-', '', $baseDt);
            $res = $this->call('ka10080', $body, $hdr);
            $calls++;

            $list = self::pickList($res['body']);
            if ($rawFirst === null && $list) $rawFirst = $list[0];
            if (!$list) break;

            $oldest = '';
            foreach ($list as $r) {
                $bar = self::mapBar($r);
                if (!$bar) continue;
                $rows[$bar['t']] = $bar;
                if ($oldest === '' || $bar['t'] < $oldest) $oldest = $bar['t'];
            }

            $cont = strtoupper(trim((string)($res['head']['cont-yn'] ?? '')));
            $next = trim((string)($res['head']['next-key'] ?? ''));
            if ($cont !== 'Y' || $next === '') break;
            if ($from !== '' && $oldest !== '' && substr($oldest, 0, 10) < $from) break;
            usleep($this->gap);
        }

        ksort($rows);
        $rows = Dt::normalize(array_values($rows));
        if ($from !== '') {
            $rows = array_values(array_filter($rows, fn($r) => substr($r['t'], 0, 10) >= $from));
        }
        return ['rows' => $rows, 'calls' => $calls, 'raw_first' => $rawFirst];
    }

    /**
     * ★조사용 원본 호출 — 응답을 <b>가공하지 않고</b> 그대로 준다.
     *
     * `minute()` 은 최신부터 역방향으로만 페이징한다. 두 달 전 구간을 받으려면 종목당
     * 열댓 콜이 필요한데, 「기준일」 인자가 있으면 그 자리로 바로 뛸 수 있다.
     * 키움 문서로는 확인이 안 돼 <b>실호출로</b> 답하려고 낸 문이다.
     *
     * 화이트리스트(TR_MAP)는 그대로 지난다 — 조회 TR 밖은 여전히 예외를 던진다.
     *
     * @param array  $body   기본 인자에 «더할» 것 (예: ['base_dt' => '20260605'])
     * @param string $contYn 연속조회 헤더
     * @return array ['code'=>int, 'head'=>array, 'body'=>array] 원본
     */
    public function minuteRaw(string $code, array $body = [], string $contYn = 'N', string $nextKey = ''): array
    {
        $code = Dt::cleanCode($code);
        $stk  = $code . (defined('KIWOOM_NO_SOR') && KIWOOM_NO_SOR ? '' : '_AL');
        $hdr  = [
            'authorization: Bearer ' . $this->token(),
            'api-id: ka10080',
            'cont-yn: ' . ($contYn === 'Y' ? 'Y' : 'N'),
            'next-key: ' . $nextKey,
        ];
        return $this->call('ka10080', array_merge([
            'stk_cd'       => $stk,
            'tic_scope'    => '1',
            'upd_stkpc_tp' => '1',
        ], $body), $hdr);
    }
    // ══ 일봉 (ka10081) ══════════════════════════════════════════════════
    /**
     * 일봉을 받는다 — <b>거래대금까지 한 번에</b>.
     *
     * ══ 실측으로 확정한 것 (2026-08-06 · 000660 실호출) ══════════════════
     *   경로   POST /api/dostk/chart · api-id ka10081 (ka10080 과 같은 경로)
     *   목록   응답 키 <b>stk_dt_pole_chart_qry</b> · <b>한 콜 600봉</b> (cont-yn=Y 로 더)
     *   필드   dt(YYYYMMDD) · open_pric · high_pric · low_pric · <b>cur_prc(종가)</b> ·
     *          trde_qty · <b>trde_prica(거래대금)</b> · trde_tern_rt(회전율)
     *   단위   ★<b>trde_prica = 백만원</b> (ka10095 와 같다) → 원은 ×1,000,000
     *
     * ★★<b>네이버 일봉과 값이 같다</b> — 같은 종목 과거 7거래일의 종가·거래량이 <b>전부 일치</b>했다.
     *   (어긋난 것은 «오늘» 한 건뿐이고 그건 장중이라 받은 시점이 다른 것이다.)
     *   그래서 대상 종목만 이쪽으로 돌려도 <b>과거 차트가 달라지지 않는다</b> —
     *   급등주 아카이브가 겪은 「수정주가 기준이 상수배로 어긋나는」 함정이 여기엔 없다.
     *
     * ★<code>upd_stkpc_tp='1'</code>(수정주가)를 준다 — 네이버가 수정주가 계열이라 기준을 맞춘다.
     *
     * @param  string $code
     * @param  int    $want    필요한 봉 수 (600 을 넘으면 연속조회)
     * @param  string $baseDt  기준일(YYYYMMDD 또는 Y-m-d). 비우면 오늘
     * @return array [['t'=>'Y-m-d',o,h,l,c,v,'a'=>거래대금(원)], …] 오름차순
     */
    public function daily(string $code, int $want = 600, string $baseDt = ''): array
    {
        $code = Dt::cleanCode($code);
        if ($code === '') return [];
        $stk   = $code . (defined('KIWOOM_NO_SOR') && KIWOOM_NO_SOR ? '' : '_AL');
        $want  = max(1, min(3000, $want));
        $token = $this->token();

        $rows = [];
        $cont = 'N'; $next = '';
        /* ★<b>base_dt 는 필수다</b> — 빼면 `[1511:필수입력 파라미터=base_dt]` 로 거절당한다
         *   (분봉 ka10080 은 없어도 되는데 일봉은 다르다. 실측 2026-08-06에 걸렸다).
         *   비워 들어오면 오늘로 채운다 — 「그 날 마감까지의 600봉」이 온다. */
        $base = ($baseDt !== '') ? str_replace('-', '', $baseDt) : date('Ymd');

        for ($i = 0; $i < 6; $i++) {                 // 600봉 × 6 = 3,600봉 상한
            $body = ['stk_cd' => $stk, 'base_dt' => $base, 'upd_stkpc_tp' => '1'];

            $res = $this->call('ka10081', $body, [
                'authorization: Bearer ' . $token,
                'api-id: ka10081',
                'cont-yn: ' . ($cont === 'Y' ? 'Y' : 'N'),
                'next-key: ' . $next,
            ]);

            $list = $res['body']['stk_dt_pole_chart_qry'] ?? self::pickList($res['body']);
            if (!$list) break;

            foreach ($list as $r) {
                if (!is_array($r)) continue;
                $d = (string)self::pick($r, ['dt']);
                if (strlen($d) !== 8) continue;
                $c = self::num(self::pick($r, ['cur_prc', 'close_pric']));
                if ($c <= 0) continue;
                $o  = self::num(self::pick($r, ['open_pric']));
                $hi = self::num(self::pick($r, ['high_pric']));
                $lo = self::num(self::pick($r, ['low_pric']));
                $t  = substr($d, 0, 4) . '-' . substr($d, 4, 2) . '-' . substr($d, 6, 2);

                $rows[$t] = [
                    't' => $t,
                    'o' => $o ?: $c, 'h' => $hi ?: max($o ?: $c, $c),
                    'l' => $lo ?: min($o ?: $c, $c), 'c' => $c,
                    'v' => self::num(self::pick($r, ['trde_qty'])),
                    // 백만원 → 원. 일봉 소비자(dailychart)는 «원»으로 읽는다(krx_amt 와 같은 단위)
                    'a' => self::num(self::pick($r, ['trde_prica'])) * 1000000,
                ];
            }
            if (count($rows) >= $want) break;

            $cont = strtoupper(trim((string)($res['head']['cont-yn'] ?? '')));
            $next = trim((string)($res['head']['next-key'] ?? ''));
            if ($cont !== 'Y' || $next === '') break;
            usleep($this->gap);
        }

        ksort($rows);
        $rows = array_values($rows);
        if (count($rows) > $want) $rows = array_slice($rows, -$want);   // 최근 N봉만
        return $rows;
    }

    // ══ 관심종목 현재가 (ka10095) ═══════════════════════════════════════
    /**
     * 복수 종목의 <b>현재가·등락·거래량·시총·거래대금</b>을 한 요청에 받는다.
     *
     * ══ 실측으로 확정한 것 (2026-08-06 · 005930 외 4종목 실호출) ══════════
     *   경로   POST /api/dostk/stkinfo · api-id ka10095 · 본문 {"stk_cd":"005930|000660|…"}
     *   목록   응답 최상위 키 <b>atn_stk_infr</b>
     *   상한   <b>100종목</b> (150 은 return_code=5) · 100종목이 0.03초
     *   단위   ★<b>mac(시가총액) = 억원 그대로</b> — 「현재가 × stkcnt(천주) ÷ 1억 = mac」 이
     *          5종목 전부에서 <b>비 1.0000</b> 으로 떨어졌다. all_stock_info.stock_cap 과 같은 단위다.
     *          ★<b>trde_prica(거래대금) = 백만원</b> → 억원은 ÷100.
     *          (DB 와의 배율이 101.6~104.9 로 나오는데, 100 이 단위이고 나머지는 <b>시간차</b>다 —
     *           DB 는 크론 값이고 이쪽은 실시간이라 그 사이 쌓인 거래대금이다.)
     *
     * ★<code>_AL</code>(SOR) 접미사를 붙이지 않는다 — 분봉과 같은 <b>KRX 단독</b> 기준이라야
     *   한 종목의 값이 소스마다 다른 말을 하지 않는다(KIWOOM_NO_SOR 와 같은 규칙).
     *   실측에서 거래량이 네이버 대비 1.004~1.049 로 나왔는데 이건 기준 차이가 아니라 시간차다
     *   (기준이 달랐다면 <code>_AL</code> 처럼 1.49배가 나온다).
     *
     * ★키움 숫자는 <b>부호가 붙어 온다</b>("-230750"). 부호는 등락 방향이고 절대값이 값이다 —
     *   num() 이 abs() 한다. 등락 방향은 rate 의 부호로 따로 온다.
     *
     * @param  string[] $codes 6자리 종목코드
     * @return array<string,array> code => [name, price, diff, rate, vol, capEok, amtEok, tm]
     *         못 받은 종목은 <b>키 자체가 없다</b> (호출자가 그 사실을 알 수 있게)
     */
    public function quotes(array $codes): array
    {
        $codes = array_values(array_unique(array_filter(array_map(
            static fn($c) => Dt::cleanCode((string)$c), $codes))));
        if (!$codes) return [];

        $out   = [];
        $first = true;
        foreach (array_chunk($codes, self::QUOTE_CHUNK) as $chunk) {
            if (!$first) usleep($this->gap);        // 1 req/s — 청크 사이에만 쉰다
            $first = false;

            $res = $this->call('ka10095', ['stk_cd' => implode('|', $chunk)], [
                'authorization: Bearer ' . $this->token(),
                'api-id: ka10095',
                'cont-yn: N',
                'next-key: ',
            ]);

            foreach (($res['body']['atn_stk_infr'] ?? []) as $r) {
                if (!is_array($r)) continue;
                $code = Dt::cleanCode((string)($r['stk_cd'] ?? ''));
                if ($code === '') continue;

                $price = self::num(self::pick($r, ['cur_prc']));
                if ($price <= 0) continue;          // 거래정지·미상장 — 0 으로 덮지 않는다

                /* 등락은 부호가 살아 있어야 한다. flu_rt 는 "-6.20" 처럼 그대로 오고,
                 * pred_pre 는 절대값을 쓰되 방향을 flu_rt 에서 빌린다. */
                $rate = (float)str_replace([',', '+'], '', (string)($r['flu_rt'] ?? '0'));
                $diff = self::num(self::pick($r, ['pred_pre']));
                if ($rate < 0) $diff = -$diff;

                $out[$code] = [
                    'name'   => trim((string)($r['stk_nm'] ?? '')),
                    'price'  => (int)round($price),
                    'diff'   => (int)round($diff),
                    'rate'   => $rate,
                    'vol'    => (int)round(self::num(self::pick($r, ['trde_qty']))),
                    'capEok' => (int)round(self::num(self::pick($r, ['mac']))),          // 억원 그대로
                    'amtEok' => round(self::num(self::pick($r, ['trde_prica'])) / 100, 2), // 백만원 → 억원
                    'tm'     => (string)($r['cntr_tm'] ?? ''),
                ];
            }
        }
        return $out;
    }

    // ══ 응답 해석 ═══════════════════════════════════════════════════════
    /** 본문에서 «배열인 값»을 찾는다 — 필드명이 문서와 달라도 살아남게 */
    private static function pickList($body): array
    {
        if (!is_array($body)) return [];
        foreach (['stk_min_pole_chart_qry', 'stk_min_pole_chart', 'output', 'output2'] as $k) {
            if (isset($body[$k]) && is_array($body[$k])) return array_values($body[$k]);
        }
        foreach ($body as $v) {
            if (is_array($v) && $v && is_array(reset($v))) return array_values($v);
        }
        return [];
    }

    /** 여러 이름 후보 중 먼저 있는 값 */
    private static function pick(array $r, array $keys)
    {
        foreach ($keys as $k) {
            if (isset($r[$k]) && $r[$k] !== '') return $r[$k];
        }
        return null;
    }

    /** 키움 숫자는 부호가 붙어 온다("+131900", "-131600") — 절대값이 곧 가격이다 */
    private static function num($v): float
    {
        return abs((float)preg_replace('/[^0-9.\-]/', '', (string)$v));
    }

    /** 원본 한 항목 → ['t'=>'Y-m-d H:i', o,h,l,c,v] · 못 읽으면 null */
    public static function mapBar(array $r): ?array
    {
        $tm = (string)self::pick($r, ['cntr_tm', 'stck_cntg_hour', 'dt', 'tm']);
        if (strlen($tm) < 12) return null;

        $y = substr($tm, 0, 4); $mo = substr($tm, 4, 2); $d = substr($tm, 6, 2);
        $h = substr($tm, 8, 2); $mi = substr($tm, 10, 2);
        $ts = strtotime("$y-$mo-$d $h:$mi:00");
        if (!$ts) return null;
        if (self::TS_BASE === 'end') $ts -= 60;      // 종료 기준이면 «시작»으로 당긴다

        $c = self::num(self::pick($r, ['cur_prc', 'close_pric', 'stck_prpr', 'clos_prc']));
        if ($c <= 0) return null;
        $o = self::num(self::pick($r, ['open_pric', 'opn_prc', 'stck_oprc']));
        $hi = self::num(self::pick($r, ['high_pric', 'hgh_prc', 'stck_hgpr']));
        $lo = self::num(self::pick($r, ['low_pric', 'lw_prc', 'stck_lwpr']));
        $v  = self::num(self::pick($r, ['trde_qty', 'cntg_vol', 'acml_vol']));

        return ['t' => date('Y-m-d H:i', $ts),
                'o' => $o ?: $c, 'h' => $hi ?: max($o ?: $c, $c),
                'l' => $lo ?: min($o ?: $c, $c), 'c' => $c, 'v' => $v];
    }

    // ══ HTTP ════════════════════════════════════════════════════════════
    /** 화이트리스트를 지나는 유일한 문 */
    private function call(string $trId, array $body, array $headers): array
    {
        if (!isset(self::TR_MAP[$trId])) {
            throw new RuntimeException("허용되지 않은 TR 입니다: {$trId} (조회 전용)");
        }
        $res = $this->http('POST', self::TR_MAP[$trId], $body, $headers);

        // 429 = 레이트리밋. 지수 백오프로 두 번까지 다시
        for ($i = 0; $i < 2 && $res['code'] === 429; $i++) {
            usleep((int)(self::GAP_USEC * pow(2, $i + 1)));
            $res = $this->http('POST', self::TR_MAP[$trId], $body, $headers);
        }
        if ($res['code'] === 401) {                       // 토큰 만료 — 한 번만 다시 받는다
            $t = $this->token(true);
            foreach ($headers as &$h) {
                if (stripos($h, 'authorization:') === 0) $h = 'authorization: Bearer ' . $t;
            }
            unset($h);
            $res = $this->http('POST', self::TR_MAP[$trId], $body, $headers);
        }
        if ($res['code'] >= 400) {
            throw new RuntimeException("키움 {$trId} 오류 " . $res['code'] . ': ' . $this->errText($res));
        }
        // 정상 응답 안의 오류코드 (키움은 200 으로도 실패를 알린다)
        $rc = $res['body']['return_code'] ?? null;
        if ($rc !== null && (int)$rc !== 0) {
            throw new RuntimeException("키움 {$trId} 실패(" . $rc . '): '
                . (string)($res['body']['return_msg'] ?? ''));
        }
        return $res;
    }

    private function http(string $method, string $path, array $body, array $headers): array
    {
        $ch = curl_init($this->host . $path);
        $hdr = array_merge(['Content-Type: application/json;charset=UTF-8'], $headers);

        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_CUSTOMREQUEST  => $method,
            CURLOPT_POSTFIELDS     => json_encode($body, JSON_UNESCAPED_UNICODE),
            CURLOPT_HTTPHEADER     => $hdr,
            CURLOPT_TIMEOUT        => 15,
            CURLOPT_CONNECTTIMEOUT => 7,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_HEADER         => true,
        ]);
        $raw  = curl_exec($ch);
        $err  = curl_error($ch);
        $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
        $hlen = (int)curl_getinfo($ch, CURLINFO_HEADER_SIZE);
        curl_close($ch);

        if ($raw === false) {
            return ['code' => 0, 'head' => [], 'body' => [], 'err' => $err, 'raw' => ''];
        }
        $head = [];
        foreach (explode("\r\n", substr($raw, 0, $hlen)) as $line) {
            $p = strpos($line, ':');
            if ($p > 0) $head[strtolower(trim(substr($line, 0, $p)))] = trim(substr($line, $p + 1));
        }
        $text = substr($raw, $hlen);
        $json = json_decode($text, true);

        return ['code' => $code, 'head' => $head,
                'body' => is_array($json) ? $json : [], 'err' => $err,
                'raw'  => mb_substr($text, 0, 400)];
    }

    private function errText(array $res): string
    {
        $b = $res['body'];
        return (string)($b['return_msg'] ?? $b['error_description'] ?? $b['message']
                        ?? ($res['err'] ?: $res['raw']));
    }

    // ══ 진단 [V-1] [V-4] ════════════════════════════════════════════════
    /**
     * 같은 종목·같은 날을 키움과 네이버 양쪽에서 받아 대조한다.
     *
     * 답해야 하는 것 둘:
     *   V-1 시각 기준 — 그대로 겹칠 때와 1분 당겼을 때 중 <b>어느 쪽이 더 맞나</b>
     *   V-4 거래량   — SOR(_AL) 과 네이버 통합 수치가 같은 것을 세고 있나
     */
    public function diag(string $code): array
    {
        $code = Dt::cleanCode($code);
        $out  = ['code' => $code, 'ok' => false];

        $k = $this->minute($code, 1, date('Y-m-d', strtotime('-3 day')), 3);
        $kb = [];
        foreach ($k['rows'] as $r) $kb[$r['t']] = $r;
        $out['kiwoom_bars'] = count($kb);
        $out['raw_first']   = $k['raw_first'];

        $api = new NaverFinanceAPI();
        $nv  = $api->getMinuteOhlc($code);
        $nb  = [];
        foreach (($nv['success'] ?? []) as $r) $nb[$r['t']] = $r;
        $out['naver_bars'] = count($nb);
        if (!$kb || !$nb) { $out['msg'] = '한쪽 데이터가 비어 대조할 수 없습니다.'; return $out; }

        // 네이버가 준 날(=오늘 또는 최근 거래일)만 견준다
        $day  = substr(array_key_first($nb), 0, 10);
        $same = 0; $shift = 0; $cmp = 0; $volSame = 0;
        foreach ($nb as $t => $n) {
            if (substr($t, 0, 10) !== $day) continue;
            $cmp++;
            if (isset($kb[$t]) && (int)$kb[$t]['c'] === (int)$n['c']) $same++;
            $t2 = date('Y-m-d H:i', strtotime($t) - 60);
            if (isset($kb[$t2]) && (int)$kb[$t2]['c'] === (int)$n['c']) $shift++;
            if (isset($kb[$t]) && (int)$kb[$t]['v'] === (int)$n['v']) $volSame++;
        }
        /* ★ '+=' 는 왼쪽에 이미 있는 키를 «덮지 않는다». 위에서 'ok'=>false 로 초기화해 뒀으므로
         *   여기서 += 를 쓰면 대조가 성공해도 화면에는 영영 「대조 실패」로 나온다(실제로 그랬다). */
        $out = array_merge($out, [
            'ok' => true, 'day' => $day, 'compared' => $cmp,
            'match_same_minute'  => $same,      // TS_BASE='start' 가 맞다는 증거
            'match_shift_1min'   => $shift,     // TS_BASE='end' 가 맞다는 증거
            'volume_match'       => $volSame,
            'verdict' => $shift > $same * 1.2 ? "TS_BASE 를 'end' 로 바꿔야 합니다"
                       : ($same > 0 ? "TS_BASE='start' 가 맞습니다" : '판정 불가 — 표본이 없습니다'),
            'volume_note' => $cmp > 0 && $volSame < $cmp * 0.5
                       ? '거래량 기준이 다릅니다(SOR vs 네이버) — 한 종목의 봉에 소스를 섞지 마세요'
                       : '거래량 기준 일치',
        ]);
        return $out;
    }
}
?>
