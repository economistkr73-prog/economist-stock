<?php
/**
 * Nw.class — 원룸(노르웨이의숲) 임대 관리 도메인 클래스
 * 테이블: nw_building(건물) / nw_unit(호실) / nw_contract(임대계약) / nw_payment(월세납부이력)
 * 구 nw_name/nw_room/nw_renter/nw_renter_fee_history 는 건드리지 않는다(mig_nw_schema.php로 1회 이관).
 */
class Nw {

    private PDO $pdo;

    public function __construct(PDO $pdo) {
        $this->pdo = $pdo;
    }

    // ==========================================================
    // 테이블 생성 (idempotent)
    // ==========================================================
    public function ensureTable(): void {
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS nw_building (
                id          INT AUTO_INCREMENT PRIMARY KEY,
                name        VARCHAR(100) NOT NULL,
                biz_no      VARCHAR(20)  DEFAULT NULL,
                address     VARCHAR(200) DEFAULT NULL,
                category    VARCHAR(50)  DEFAULT NULL,
                purpose     VARCHAR(50)  DEFAULT NULL,
                land_size   DECIMAL(10,2) DEFAULT 0,
                floor_size  DECIMAL(10,2) DEFAULT 0,
                sort_order  INT DEFAULT 0,
                created_at  DATETIME DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS nw_unit (
                id           INT AUTO_INCREMENT PRIMARY KEY,
                building_id  INT NOT NULL,
                room_no      VARCHAR(20) NOT NULL,
                room_size    DECIMAL(10,2) DEFAULT 0,
                bank_loan    BIGINT DEFAULT 0,
                sort_order   INT DEFAULT 0,
                created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_building (building_id),
                FOREIGN KEY (building_id) REFERENCES nw_building(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS nw_contract (
                id                   INT AUTO_INCREMENT PRIMARY KEY,
                room_id              INT NOT NULL,
                status               ENUM('active','ended') NOT NULL DEFAULT 'active',
                contract_type        ENUM('jeonse','semi_monthly','monthly') NOT NULL DEFAULT 'monthly',
                tenant_name          VARCHAR(50)  DEFAULT NULL,
                tenant_ssn           VARCHAR(20)  DEFAULT NULL,
                tenant_phone         VARCHAR(20)  DEFAULT NULL,
                co_tenant_name       VARCHAR(50)  DEFAULT NULL,
                co_tenant_ssn        VARCHAR(20)  DEFAULT NULL,
                co_tenant_phone      VARCHAR(20)  DEFAULT NULL,
                deposit              BIGINT DEFAULT 0,
                deposit_registered   TINYINT(1) DEFAULT 0,
                down_payment         BIGINT DEFAULT 0,
                contract_date        DATE DEFAULT NULL,
                balance_amount       BIGINT DEFAULT 0,
                balance_date         DATE DEFAULT NULL,
                contract_end_date    DATE DEFAULT NULL,
                rent_fee             BIGINT DEFAULT 0,
                maintenance_fee      BIGINT DEFAULT 0,
                rent_pay_day         TINYINT DEFAULT NULL,
                agent_office         VARCHAR(50) DEFAULT NULL,
                agent_phone          VARCHAR(20) DEFAULT NULL,
                agent_ceo            VARCHAR(30) DEFAULT NULL,
                special_terms        TEXT,
                renewal_type         ENUM('initial','extended','implied') NOT NULL DEFAULT 'initial',
                first_contract_date  DATE DEFAULT NULL,
                ended_at             DATETIME DEFAULT NULL,
                ended_reason         ENUM('expired','terminated_early','renewed') DEFAULT NULL,
                created_at           DATETIME DEFAULT CURRENT_TIMESTAMP,
                updated_at           DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
                INDEX idx_room_status (room_id, status),
                FOREIGN KEY (room_id) REFERENCES nw_unit(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS nw_payment (
                id             INT AUTO_INCREMENT PRIMARY KEY,
                contract_id    INT NOT NULL,
                pay_date       DATE NOT NULL,
                rent_fee       BIGINT DEFAULT 0,
                maintenance_fee BIGINT DEFAULT 0,
                memo           VARCHAR(200) DEFAULT NULL,
                created_at     DATETIME DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_contract_pay (contract_id, pay_date),
                FOREIGN KEY (contract_id) REFERENCES nw_contract(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        // 실제 퇴거일(묵시적갱신·중도해지 등 계약서 만료일과 다른 실제 종료). 멱등 추가.
        $this->pdo->exec("ALTER TABLE nw_contract ADD COLUMN IF NOT EXISTS move_out_date DATE DEFAULT NULL AFTER contract_end_date");
        // 귀속월(YYYY-MM): 납부일과 별개로 "어느 달 것"인지 — 늦은/선납 처리
        $this->pdo->exec("ALTER TABLE nw_payment ADD COLUMN IF NOT EXISTS bill_ym VARCHAR(7) DEFAULT NULL AFTER pay_date");
        // 주차비: 관리비처럼 매월 청구 항목. 멱등 추가.
        $this->pdo->exec("ALTER TABLE nw_contract ADD COLUMN IF NOT EXISTS parking_fee BIGINT DEFAULT 0 AFTER maintenance_fee");
        $this->pdo->exec("ALTER TABLE nw_payment ADD COLUMN IF NOT EXISTS parking_fee BIGINT DEFAULT 0 AFTER maintenance_fee");
        // 공과금(수도·전기): 변동요금. 납부액은 nw_payment, 월별 부과액은 nw_utility_charge(호실+월). 멱등.
        $this->pdo->exec("ALTER TABLE nw_payment ADD COLUMN IF NOT EXISTS water_fee BIGINT DEFAULT 0 AFTER parking_fee");
        $this->pdo->exec("ALTER TABLE nw_payment ADD COLUMN IF NOT EXISTS electric_fee BIGINT DEFAULT 0 AFTER water_fee");
        $this->pdo->exec("CREATE TABLE IF NOT EXISTS nw_utility_charge (id INT AUTO_INCREMENT PRIMARY KEY, unit_id INT NOT NULL, bill_ym VARCHAR(7) NOT NULL, water_fee BIGINT DEFAULT 0, electric_fee BIGINT DEFAULT 0, memo VARCHAR(200) DEFAULT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE KEY uq_room_ym (unit_id, bill_ym)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS span_months TINYINT DEFAULT 1 AFTER electric_fee");
        // 검침 기반: 전기·냉수·온수 직전/현재 검침값(사용량 계산). 멱등.
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS elec_prev INT DEFAULT 0 AFTER span_months");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS elec_cur INT DEFAULT 0 AFTER elec_prev");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS cold_prev INT DEFAULT 0 AFTER elec_cur");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS cold_cur INT DEFAULT 0 AFTER cold_prev");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS hot_prev INT DEFAULT 0 AFTER cold_cur");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS hot_cur INT DEFAULT 0 AFTER hot_prev");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS read_prev_date DATE DEFAULT NULL AFTER hot_cur");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS read_cur_date DATE DEFAULT NULL AFTER read_prev_date");
        $this->pdo->exec("ALTER TABLE nw_utility_charge ADD COLUMN IF NOT EXISTS bill_weight TINYINT DEFAULT 2 AFTER read_cur_date");
        // 청구월별 요금 상수(건물 단위)
        $this->pdo->exec("CREATE TABLE IF NOT EXISTS nw_utility_config (id INT AUTO_INCREMENT PRIMARY KEY, building_id INT NOT NULL, bill_ym VARCHAR(7) NOT NULL, water_base DECIMAL(12,2) DEFAULT 2160, water_unit DECIMAL(12,2) DEFAULT 930, elec_tv DECIMAL(12,2) DEFAULT 2500, elec_base DECIMAL(12,2) DEFAULT 910, elec_unit DECIMAL(12,3) DEFAULT 93.3, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE KEY uq_bld_ym (building_id, bill_ym)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");

        // 계약서 원본 이미지(사진). 계약 저장 전 스캔 단계에서 먼저 저장되므로 contract_id는 NULL 허용 후 나중에 링크.
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS nw_contract_image (
                id           INT AUTO_INCREMENT PRIMARY KEY,
                contract_id  INT DEFAULT NULL,
                unit_id      INT DEFAULT NULL,
                mime         VARCHAR(64) NOT NULL,
                filename     VARCHAR(255) DEFAULT NULL,
                image_data   LONGBLOB NOT NULL,
                created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_contract (contract_id)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");
    }

    // ==========================================================
    // 건물
    // ==========================================================
    public function listBuildings(): array {
        return $this->pdo->query("SELECT * FROM nw_building ORDER BY sort_order, id")->fetchAll();
    }

    public function getBuilding(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_building WHERE id=:id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch() ?: null;
    }

    public function addBuilding(array $d): int {
        $stmt = $this->pdo->prepare("
            INSERT INTO nw_building (name, biz_no, address, category, purpose, land_size, floor_size)
            VALUES (:name, :biz_no, :address, :category, :purpose, :land_size, :floor_size)
        ");
        $stmt->execute([
            ':name'       => $d['name'] ?? '',
            ':biz_no'     => $d['biz_no'] ?: null,
            ':address'    => $d['address'] ?: null,
            ':category'   => $d['category'] ?: null,
            ':purpose'    => $d['purpose'] ?: null,
            ':land_size'  => ($d['land_size'] ?? '') !== '' ? (float)$d['land_size'] : 0,
            ':floor_size' => ($d['floor_size'] ?? '') !== '' ? (float)$d['floor_size'] : 0,
        ]);
        return (int)$this->pdo->lastInsertId();
    }

    // ==========================================================
    // 호실
    // ==========================================================
    public function listUnits(int $buildingId): array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_unit WHERE building_id=:b ORDER BY sort_order, room_no, id");
        $stmt->execute([':b' => $buildingId]);
        return $stmt->fetchAll();
    }

    public function getUnit(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_unit WHERE id=:id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch() ?: null;
    }

    public function addUnit(array $d): int {
        $stmt = $this->pdo->prepare("
            INSERT INTO nw_unit (building_id, room_no, room_size, bank_loan)
            VALUES (:building_id, :room_no, :room_size, :bank_loan)
        ");
        $stmt->execute([
            ':building_id' => $d['building_id'],
            ':room_no'     => $d['room_no'] ?? '',
            ':room_size'   => ($d['room_size'] ?? '') !== '' ? (float)$d['room_size'] : 0,
            ':bank_loan'   => ($d['bank_loan'] ?? '') !== '' ? (int)$d['bank_loan'] : 0,
        ]);
        return (int)$this->pdo->lastInsertId();
    }

    // ==========================================================
    // 계약
    // ==========================================================
    public function getActiveContractByRoom(int $roomId): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_contract WHERE room_id=:r AND status='active' ORDER BY id DESC LIMIT 1");
        $stmt->execute([':r' => $roomId]);
        return $stmt->fetch() ?: null;
    }

    /** 건물 내 전체 호실의 활성계약을 room_id => 계약 형태로 한 번에 조회 (N+1 방지) */
    public function listActiveContractsByBuilding(int $buildingId): array {
        $stmt = $this->pdo->prepare("
            SELECT c.* FROM nw_contract c
            JOIN nw_unit u ON u.id = c.room_id
            WHERE u.building_id = :b AND c.status = 'active'
        ");
        $stmt->execute([':b' => $buildingId]);
        $out = [];
        foreach ($stmt->fetchAll() as $row) {
            $out[(int)$row['room_id']] = $row;
        }
        return $out;
    }

    public function getContract(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_contract WHERE id=:id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch() ?: null;
    }

    public function listContractsByRoom(int $roomId): array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_contract WHERE room_id=:r ORDER BY id DESC");
        $stmt->execute([':r' => $roomId]);
        return $stmt->fetchAll();
    }

    /** 빈 문자열/미전달을 0으로, 그 외는 정수로 강제 (strict mode BIGINT 컬럼에 ''가 들어가는 것 방지) */
    private function num($v): int {
        return ($v === null || $v === '') ? 0 : (int)$v;
    }

    private function contractParams(array $d): array {
        return [
            ':contract_type'       => $d['contract_type'] ?? 'monthly',
            ':tenant_name'         => $d['tenant_name'] ?: null,
            ':tenant_ssn'          => $d['tenant_ssn'] ?: null,
            ':tenant_phone'        => $d['tenant_phone'] ?: null,
            ':co_tenant_name'      => $d['co_tenant_name'] ?: null,
            ':co_tenant_ssn'       => $d['co_tenant_ssn'] ?: null,
            ':co_tenant_phone'     => $d['co_tenant_phone'] ?: null,
            ':deposit'             => $this->num($d['deposit'] ?? null),
            ':deposit_registered'  => !empty($d['deposit_registered']) ? 1 : 0,
            ':down_payment'        => $this->num($d['down_payment'] ?? null),
            ':contract_date'       => $d['contract_date'] ?: null,
            ':balance_amount'      => $this->num($d['balance_amount'] ?? null),
            ':balance_date'        => $d['balance_date'] ?: null,
            ':contract_end_date'   => $d['contract_end_date'] ?: null,
            ':move_out_date'       => $d['move_out_date'] ?: null,
            ':rent_fee'            => $this->num($d['rent_fee'] ?? null),
            ':maintenance_fee'     => $this->num($d['maintenance_fee'] ?? null),
            ':parking_fee'         => $this->num($d['parking_fee'] ?? null),
            ':rent_pay_day'        => ($d['rent_pay_day'] ?? '') !== '' ? (int)$d['rent_pay_day'] : null,
            ':agent_office'        => $d['agent_office'] ?: null,
            ':agent_phone'         => $d['agent_phone'] ?: null,
            ':agent_ceo'           => $d['agent_ceo'] ?: null,
            ':special_terms'       => $d['special_terms'] ?: null,
        ];
    }

    public function addContract(array $d): int {
        $stmt = $this->pdo->prepare("
            INSERT INTO nw_contract
                (room_id, status, contract_type, tenant_name, tenant_ssn, tenant_phone,
                 co_tenant_name, co_tenant_ssn, co_tenant_phone,
                 deposit, deposit_registered, down_payment, contract_date,
                 balance_amount, balance_date, contract_end_date, move_out_date,
                 rent_fee, maintenance_fee, parking_fee, rent_pay_day,
                 agent_office, agent_phone, agent_ceo, special_terms,
                 renewal_type, first_contract_date)
            VALUES
                (:room_id, 'active', :contract_type, :tenant_name, :tenant_ssn, :tenant_phone,
                 :co_tenant_name, :co_tenant_ssn, :co_tenant_phone,
                 :deposit, :deposit_registered, :down_payment, :contract_date,
                 :balance_amount, :balance_date, :contract_end_date, :move_out_date,
                 :rent_fee, :maintenance_fee, :parking_fee, :rent_pay_day,
                 :agent_office, :agent_phone, :agent_ceo, :special_terms,
                 :renewal_type, :first_contract_date)
        ");
        $stmt->execute($this->contractParams($d) + [
            ':room_id'             => $d['room_id'],
            ':renewal_type'        => $d['renewal_type'] ?? 'initial',
            ':first_contract_date' => $d['first_contract_date'] ?: ($d['contract_date'] ?: null),
        ]);
        return (int)$this->pdo->lastInsertId();
    }

    public function updateContract(int $id, array $d): void {
        $stmt = $this->pdo->prepare("
            UPDATE nw_contract SET
                contract_type=:contract_type, tenant_name=:tenant_name, tenant_ssn=:tenant_ssn, tenant_phone=:tenant_phone,
                co_tenant_name=:co_tenant_name, co_tenant_ssn=:co_tenant_ssn, co_tenant_phone=:co_tenant_phone,
                deposit=:deposit, deposit_registered=:deposit_registered, down_payment=:down_payment, contract_date=:contract_date,
                balance_amount=:balance_amount, balance_date=:balance_date, contract_end_date=:contract_end_date, move_out_date=:move_out_date,
                rent_fee=:rent_fee, maintenance_fee=:maintenance_fee, parking_fee=:parking_fee, rent_pay_day=:rent_pay_day,
                agent_office=:agent_office, agent_phone=:agent_phone, agent_ceo=:agent_ceo, special_terms=:special_terms
            WHERE id=:id
        ");
        $stmt->execute($this->contractParams($d) + [':id' => $id]);
    }

    /** 만기연장: 기존 계약을 renewed로 닫고, 최초계약일을 이어받은 신규 계약을 만든다(이력 보존). */
    public function renewContract(int $oldId, array $newTerms): int {
        $old = $this->getContract($oldId);
        if (!$old) throw new RuntimeException('기존 계약을 찾을 수 없습니다.');

        $this->pdo->beginTransaction();
        try {
            $stmt = $this->pdo->prepare("UPDATE nw_contract SET status='ended', ended_at=NOW(), ended_reason='renewed' WHERE id=:id");
            $stmt->execute([':id' => $oldId]);

            $newTerms['room_id']             = $old['room_id'];
            $newTerms['renewal_type']        = (($newTerms['renewal_type'] ?? '') === 'implied') ? 'implied' : 'extended'; // 연장(정식) 또는 묵시적(조건변경 자동연장)
            $newTerms['first_contract_date'] = $old['first_contract_date'] ?: $old['contract_date'];
            $newId = $this->addContract($newTerms);

            $this->pdo->commit();
            return $newId;
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
    }

    /** 묵시적갱신: 신규행 없이 현재 계약에 표시만 한다. */
    public function markImpliedRenewal(int $id): void {
        $stmt = $this->pdo->prepare("UPDATE nw_contract SET renewal_type='implied' WHERE id=:id AND status='active'");
        $stmt->execute([':id' => $id]);
    }

    /** 계약종료: 만료 또는 중도해지. */
    public function endContract(int $id, ?string $moveOutDate = null): void {
        $mo = ($moveOutDate && preg_match('/^\d{4}-\d{2}-\d{2}$/', $moveOutDate)) ? $moveOutDate : date('Y-m-d');
        // 실제 퇴거일이 계약 만료일보다 이르면 중도해지, 아니면(만기 도래·경과·만료일 미상) 만료로 자동 판정
        $c = $this->getContract($id);
        $end = substr((string)($c['contract_end_date'] ?? ''), 0, 10);
        $reason = ($end !== '' && $mo < $end) ? 'terminated_early' : 'expired';
        $stmt = $this->pdo->prepare("UPDATE nw_contract SET status='ended', ended_at=NOW(), ended_reason=:r, move_out_date=:mo WHERE id=:id");
        $stmt->execute([':r' => $reason, ':mo' => $mo, ':id' => $id]);
    }

    // ==========================================================
    // 월세/관리비 납부이력
    // ==========================================================
    public function listPayments(int $contractId): array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_payment WHERE contract_id=:c ORDER BY pay_date DESC, id DESC");
        $stmt->execute([':c' => $contractId]);
        return $stmt->fetchAll();
    }

    /** 건물 내 계약별·연도별 납부합계(월세+관리비): [contract_id][year] => 합계. 미납 계산용. */
    public function paymentSumsByBuilding(int $buildingId): array {
        $stmt = $this->pdo->prepare("
            SELECT p.contract_id, LEFT(COALESCE(p.bill_ym, DATE_FORMAT(p.pay_date, '%Y-%m')), 4) AS y, SUM(p.rent_fee + p.maintenance_fee + p.parking_fee) AS amt
            FROM nw_payment p
            JOIN nw_contract c ON c.id = p.contract_id
            JOIN nw_unit u ON u.id = c.room_id
            WHERE u.building_id = :b
            GROUP BY p.contract_id, y
        ");
        $stmt->execute([':b' => $buildingId]);
        $out = [];
        foreach ($stmt->fetchAll() as $r) {
            $out[(int)$r['contract_id']][(int)$r['y']] = (int)$r['amt'];
        }
        return $out;
    }

    /** 건물별 최종 납부일(가장 최근 pay_date) — [building_id => 'YYYY-MM-DD']. 납부 없으면 키 없음. */
    public function lastPaymentDatesByBuilding(): array {
        $stmt = $this->pdo->query("
            SELECT u.building_id AS bid, MAX(p.pay_date) AS last_date
            FROM nw_payment p
            JOIN nw_contract c ON c.id = p.contract_id
            JOIN nw_unit u ON u.id = c.room_id
            GROUP BY u.building_id
        ");
        $out = [];
        foreach ($stmt->fetchAll() as $r) {
            $out[(int)$r['bid']] = substr((string)$r['last_date'], 0, 10);
        }
        return $out;
    }
    /** 건물 내 전체 계약(활성+종료)을 호실정보와 함께. 호실별 납부 이력 집계용(과거 세입자 포함). */
    public function listAllContractsByBuilding(int $buildingId): array {
        $stmt = $this->pdo->prepare("
            SELECT c.*, u.room_no, u.id AS unit_id, u.sort_order AS unit_sort
            FROM nw_contract c
            JOIN nw_unit u ON u.id = c.room_id
            WHERE u.building_id = :b
            ORDER BY u.sort_order, u.room_no, u.id, c.contract_date, c.id
        ");
        $stmt->execute([':b' => $buildingId]);
        return $stmt->fetchAll();
    }

    /** 호실의 모든 계약(과거+현재)에 걸친 납부 이력(세입자명 포함), 최신순. */
    public function listPaymentsByRoom(int $roomId): array {
        $stmt = $this->pdo->prepare("
            SELECT p.*, c.tenant_name, c.contract_type
            FROM nw_payment p
            JOIN nw_contract c ON c.id = p.contract_id
            WHERE c.room_id = :r
            ORDER BY p.pay_date DESC, p.id DESC
        ");
        $stmt->execute([':r' => $roomId]);
        return $stmt->fetchAll();
    }

    public function getLastPayment(int $contractId): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM nw_payment WHERE contract_id=:c ORDER BY pay_date DESC, id DESC LIMIT 1");
        $stmt->execute([':c' => $contractId]);
        return $stmt->fetch() ?: null;
    }

    public function addPayment(array $d): int {
        $payDate = $d['pay_date'] ?: date('Y-m-d');
        $billYm = (isset($d['bill_ym']) && preg_match('/^\d{4}-\d{2}$/', (string)$d['bill_ym'])) ? $d['bill_ym'] : substr((string)$payDate, 0, 7);
        $stmt = $this->pdo->prepare("
            INSERT INTO nw_payment (contract_id, pay_date, bill_ym, rent_fee, maintenance_fee, parking_fee, water_fee, electric_fee, memo)
            VALUES (:contract_id, :pay_date, :bill_ym, :rent_fee, :maintenance_fee, :parking_fee, :water_fee, :electric_fee, :memo)
        ");
        $stmt->execute([
            ':contract_id'     => $d['contract_id'],
            ':pay_date'        => $payDate,
            ':bill_ym'         => $billYm,
            ':rent_fee'        => $this->num($d['rent_fee'] ?? null),
            ':maintenance_fee' => $this->num($d['maintenance_fee'] ?? null),
            ':parking_fee'     => $this->num($d['parking_fee'] ?? null),
            ':water_fee'       => $this->num($d['water_fee'] ?? null),
            ':electric_fee'    => $this->num($d['electric_fee'] ?? null),
            ':memo'            => $d['memo'] ?: null,
        ]);
        return (int)$this->pdo->lastInsertId();
    }

    /** 납부 수정(금액·날짜·귀속월·메모) */
    public function updatePayment(int $id, array $d): void {
        $payDate = $d['pay_date'] ?: date('Y-m-d');
        $billYm = (isset($d['bill_ym']) && preg_match('/^\d{4}-\d{2}$/', (string)$d['bill_ym'])) ? $d['bill_ym'] : substr((string)$payDate, 0, 7);
        $stmt = $this->pdo->prepare("
            UPDATE nw_payment SET pay_date=:pd, bill_ym=:by, rent_fee=:rf, maintenance_fee=:mf, parking_fee=:pk, water_fee=:wf, electric_fee=:ef, memo=:memo WHERE id=:id
        ");
        $stmt->execute([
            ':pd' => $payDate, ':by' => $billYm,
            ':rf' => $this->num($d['rent_fee'] ?? null),
            ':mf' => $this->num($d['maintenance_fee'] ?? null),
            ':pk' => $this->num($d['parking_fee'] ?? null),
            ':wf' => $this->num($d['water_fee'] ?? null),
            ':ef' => $this->num($d['electric_fee'] ?? null),
            ':memo' => $d['memo'] ?: null,
            ':id' => $id,
        ]);
    }

    /** 납부 삭제 */
    public function deletePayment(int $id): void {
        $stmt = $this->pdo->prepare("DELETE FROM nw_payment WHERE id=:id");
        $stmt->execute([':id' => $id]);
    }

    // ==========================================================
    // 공과금 부과액 (호실·월별) — 변동요금은 계약 아닌 월별 부과
    /** 호실의 월별 공과금 부과액: [bill_ym] => ['water'=>, 'electric'=>] */
    public function utilityChargesByRoom(int $unitId): array {
        $stmt = $this->pdo->prepare("SELECT bill_ym, water_fee, electric_fee FROM nw_utility_charge WHERE unit_id=:u");
        $stmt->execute([':u' => $unitId]);
        $out = [];
        foreach ($stmt->fetchAll() as $r) { $out[$r['bill_ym']] = ['water' => (int)$r['water_fee'], 'electric' => (int)$r['electric_fee']]; }
        return $out;
    }

    /** 건물의 특정 청구월 공과금 부과액: [unit_id => ['water','electric','span']] */
    public function utilityChargesForBuildingMonth(int $buildingId, string $billYm): array {
        $stmt = $this->pdo->prepare("SELECT c.unit_id, c.water_fee, c.electric_fee, c.span_months FROM nw_utility_charge c JOIN nw_unit u ON u.id = c.unit_id WHERE u.building_id = :b AND c.bill_ym = :ym");
        $stmt->execute([':b' => $buildingId, ':ym' => $billYm]);
        $out = [];
        foreach ($stmt->fetchAll() as $r) { $out[(int)$r['unit_id']] = ['water' => (int)$r['water_fee'], 'electric' => (int)$r['electric_fee'], 'span' => (int)$r['span_months']]; }
        return $out;
    }

    /** 건물의 공과금 청구월 목록(과거 내역): 월별 합계·호실수 */
    public function utilityChargeMonths(int $buildingId): array {
        $stmt = $this->pdo->prepare("SELECT c.bill_ym, MAX(c.span_months) AS span, SUM(c.water_fee) AS water, SUM(c.electric_fee) AS electric, COUNT(*) AS units FROM nw_utility_charge c JOIN nw_unit u ON u.id = c.unit_id WHERE u.building_id = :b GROUP BY c.bill_ym ORDER BY c.bill_ym DESC");
        $stmt->execute([':b' => $buildingId]);
        return $stmt->fetchAll();
    }

    /** 청구월 요금 상수(없으면 직전월 → 기본값 상속) */
    public function getUtilityConfig(int $buildingId, string $billYm): array {
        $def = ['water_base' => 2160, 'water_unit' => 930, 'elec_tv' => 2500, 'elec_base' => 910, 'elec_unit' => 93.3];
        $sel = "SELECT water_base, water_unit, elec_tv, elec_base, elec_unit FROM nw_utility_config WHERE building_id=:b AND bill_ym";
        $stmt = $this->pdo->prepare($sel . "=:ym");
        $stmt->execute([':b' => $buildingId, ':ym' => $billYm]);
        $row = $stmt->fetch();
        if (!$row) {
            $stmt = $this->pdo->prepare($sel . "<:ym ORDER BY bill_ym DESC LIMIT 1");
            $stmt->execute([':b' => $buildingId, ':ym' => $billYm]);
            $row = $stmt->fetch();
        }
        if (!$row) return $def;
        return ['water_base' => (float)$row['water_base'], 'water_unit' => (float)$row['water_unit'], 'elec_tv' => (float)$row['elec_tv'], 'elec_base' => (float)$row['elec_base'], 'elec_unit' => (float)$row['elec_unit']];
    }

    public function saveUtilityConfig(int $buildingId, string $billYm, array $c): void {
        if (!preg_match('/^\d{4}-\d{2}$/', $billYm)) return;
        $stmt = $this->pdo->prepare("INSERT INTO nw_utility_config (building_id, bill_ym, water_base, water_unit, elec_tv, elec_base, elec_unit) VALUES (:b,:ym,:wb,:wu,:et,:eb,:eu) ON DUPLICATE KEY UPDATE water_base=:wb2, water_unit=:wu2, elec_tv=:et2, elec_base=:eb2, elec_unit=:eu2");
        $stmt->execute([':b'=>$buildingId, ':ym'=>$billYm, ':wb'=>$c['water_base'], ':wu'=>$c['water_unit'], ':et'=>$c['elec_tv'], ':eb'=>$c['elec_base'], ':eu'=>$c['elec_unit'], ':wb2'=>$c['water_base'], ':wu2'=>$c['water_unit'], ':et2'=>$c['elec_tv'], ':eb2'=>$c['elec_base'], ':eu2'=>$c['elec_unit']]);
    }

    /** 건물 청구월 검침·요금 [unit_id => row] */
    public function utilityReadingsForBuildingMonth(int $buildingId, string $billYm): array {
        $stmt = $this->pdo->prepare("SELECT c.unit_id, c.elec_prev, c.elec_cur, c.cold_prev, c.cold_cur, c.hot_prev, c.hot_cur, c.read_prev_date, c.read_cur_date, c.bill_weight, c.water_fee, c.electric_fee FROM nw_utility_charge c JOIN nw_unit u ON u.id=c.unit_id WHERE u.building_id=:b AND c.bill_ym=:ym");
        $stmt->execute([':b'=>$buildingId, ':ym'=>$billYm]);
        $out = [];
        foreach ($stmt->fetchAll() as $r) { $out[(int)$r['unit_id']] = $r; }
        return $out;
    }

    /** 직전 청구월(현재 이전 최신)의 현재검침 → 이번 직전검침 자동입력 [unit_id => [elec,cold,hot]] */
    public function prevReadingsForBuilding(int $buildingId, string $billYm): array {
        $stmt = $this->pdo->prepare("SELECT c.unit_id, c.elec_cur, c.cold_cur, c.hot_cur, c.read_cur_date, c.read_prev_date, c.bill_ym, m.maxym FROM nw_utility_charge c JOIN nw_unit u ON u.id = c.unit_id JOIN (SELECT c2.unit_id, MAX(CASE WHEN c2.elec_cur > 0 THEN c2.bill_ym END) AS realym, MAX(c2.bill_ym) AS maxym FROM nw_utility_charge c2 JOIN nw_unit u2 ON u2.id = c2.unit_id WHERE u2.building_id = :b AND c2.bill_ym < :ym GROUP BY c2.unit_id) m ON m.unit_id = c.unit_id AND m.realym = c.bill_ym WHERE u.building_id = :b2");
        $stmt->execute([':b' => $buildingId, ':ym' => $billYm, ':b2' => $buildingId]);
        $out = [];
        foreach ($stmt->fetchAll() as $r) { $out[(int)$r['unit_id']] = ['elec'=>(int)$r['elec_cur'], 'cold'=>(int)$r['cold_cur'], 'hot'=>(int)$r['hot_cur'], 'cdate'=>$r['read_cur_date'], 'pdate'=>$r['read_prev_date'], 'from'=>$r['bill_ym'], 'maxym'=>$r['maxym']]; }
        return $out;
    }

    /** 검침·요금 upsert(호실+월). 검침값 + 계산된 수도/전기 청구요금 저장. */
    public function saveUtilityReading(int $unitId, string $billYm, array $d): void {
        if (!preg_match('/^\d{4}-\d{2}$/', $billYm)) return;
        $stmt = $this->pdo->prepare("INSERT INTO nw_utility_charge (unit_id, bill_ym, elec_prev, elec_cur, cold_prev, cold_cur, hot_prev, hot_cur, read_prev_date, read_cur_date, bill_weight, water_fee, electric_fee) VALUES (:u,:ym,:ep,:ec,:cp,:cc,:hp,:hc,:rpd,:rcd,:bw,:wf,:ef) ON DUPLICATE KEY UPDATE elec_prev=:ep2, elec_cur=:ec2, cold_prev=:cp2, cold_cur=:cc2, hot_prev=:hp2, hot_cur=:hc2, read_prev_date=:rpd2, read_cur_date=:rcd2, bill_weight=:bw2, water_fee=:wf2, electric_fee=:ef2");
        $stmt->execute([':u'=>$unitId, ':ym'=>$billYm, ':ep'=>(int)$d['elec_prev'], ':ec'=>(int)$d['elec_cur'], ':cp'=>(int)$d['cold_prev'], ':cc'=>(int)$d['cold_cur'], ':hp'=>(int)$d['hot_prev'], ':hc'=>(int)$d['hot_cur'], ':rpd'=>($d['read_prev_date'] ?: null), ':rcd'=>($d['read_cur_date'] ?: null), ':bw'=>(int)($d['bill_weight'] ?? 2), ':wf'=>(int)$d['water_fee'], ':ef'=>(int)$d['electric_fee'], ':ep2'=>(int)$d['elec_prev'], ':ec2'=>(int)$d['elec_cur'], ':cp2'=>(int)$d['cold_prev'], ':cc2'=>(int)$d['cold_cur'], ':hp2'=>(int)$d['hot_prev'], ':hc2'=>(int)$d['hot_cur'], ':rpd2'=>($d['read_prev_date'] ?: null), ':rcd2'=>($d['read_cur_date'] ?: null), ':bw2'=>(int)($d['bill_weight'] ?? 2), ':wf2'=>(int)$d['water_fee'], ':ef2'=>(int)$d['electric_fee']]);
    }

    /** 월별 공과금 부과액 upsert(호실+월 UNIQUE) */
    public function upsertUtilityCharge(int $unitId, string $billYm, int $water, int $electric, int $span = 1): void {
        if (!preg_match('/^\d{4}-\d{2}$/', $billYm)) return;
        $stmt = $this->pdo->prepare("INSERT INTO nw_utility_charge (unit_id, bill_ym, water_fee, electric_fee, span_months) VALUES (:u, :b, :w, :e, :s) ON DUPLICATE KEY UPDATE water_fee=:w2, electric_fee=:e2, span_months=:s2");
        $stmt->execute([':u' => $unitId, ':b' => $billYm, ':w' => $water, ':e' => $electric, ':w2' => $water, ':e2' => $electric, ':s' => $span, ':s2' => $span]);
    }

    // ==========================================================
    // 은행 거래내역 → 납부 일괄등록 (매칭 + 벌크 인서트)
    // ==========================================================

    /** 건물 내 활성계약 목록(호실번호 포함) — 은행내역 매칭용 */
    public function listActiveContractsForMatch(int $buildingId): array {
        $stmt = $this->pdo->prepare("
            SELECT c.id, c.tenant_name, c.co_tenant_name, c.rent_fee, c.maintenance_fee, c.parking_fee,
                   c.contract_type, u.room_no, u.id AS unit_id
            FROM nw_contract c
            JOIN nw_unit u ON u.id = c.room_id
            WHERE u.building_id = :b AND c.status = 'active'
            ORDER BY u.sort_order, u.room_no, u.id
        ");
        $stmt->execute([':b' => $buildingId]);
        return $stmt->fetchAll();
    }

    /** 호실번호 정규화: 공백/'호' 제거 + 소문자 (예: 'B01호'→'b01', '301'→'301') */
    private function normRoom(string $s): string {
        return strtolower(str_replace('호', '', preg_replace('/\s+/', '', $s)));
    }

    /**
     * 은행 거래 행들을 건물 활성계약에 자동매칭한다(순수 로직·검토화면용).
     * @param array $contracts listActiveContractsForMatch() 결과
     * @param array $rows      BankXls::parse()['rows']
     * @param array $existKeys "contractId|YYYY-MM-DD" => true (이미 등록된 납부, 중복표시용)
     * @return array 검토용 행 배열
     */
    public function matchBankRows(array $contracts, array $rows, array $existKeys = [], string $fromDate = '', string $toDate = ''): array {
        // ★원칙: 자료(엑셀)의 거래 기간에 재실이 겹치는 계약만 후보로 (해당 기간에 연관된 것만).
        if ($fromDate !== '' && $toDate !== '') {
            $contracts = array_values(array_filter($contracts, function ($c) use ($fromDate, $toDate) {
                $cd = substr((string)($c['contract_date'] ?? ''), 0, 10);
                if ($cd === '') return true; // 계약일 미상은 보수적으로 포함
                $oe = substr((string)(($c['move_out_date'] ?? '') ?: ($c['contract_end_date'] ?? '')), 0, 10);
                $end = (($c['status'] ?? '') === 'active' || $oe === '') ? '9999-12-31' : $oe;
                return $cd <= $toDate && $end >= $fromDate; // 재실기간이 파일기간과 겹침
            }));
        }

        // 드롭다운 후보(기간 내 계약)
        $candidates = [];
        foreach ($contracts as $c) {
            $ps = $c['contract_date'] ? substr((string)$c['contract_date'], 2, 2) . '.' . substr((string)$c['contract_date'], 5, 2) : '';
            $oe = ($c['move_out_date'] ?? '') ?: ($c['contract_end_date'] ?? '');
            $pe = $oe ? substr((string)$oe, 2, 2) . '.' . substr((string)$oe, 5, 2) : '';
            $per = ($ps || $pe) ? ' (' . $ps . '~' . $pe . ')' : '';
            $candidates[] = [
                'contract_id' => (int)$c['id'],
                'label' => $c['room_no'] . '호 · ' . ($c['tenant_name'] ?: '(무기명)') . $per,
                'rent_fee' => (int)$c['rent_fee'],
                'maintenance_fee' => (int)$c['maintenance_fee'],
                'parking_fee' => (int)($c['parking_fee'] ?? 0),
            ];
        }

        $out = [];
        foreach ($rows as $r) {
            $cp    = (string)($r['counterparty'] ?? '');
            $dep   = (int)($r['deposit'] ?? 0);
            $wd    = (int)($r['withdraw'] ?? 0);
            $date  = (string)($r['date'] ?? '');
            $jeok  = (string)($r['jeokyo'] ?? '');
            $cpLow = strtolower(preg_replace('/\s+/', '', $cp));

            // 귀속월: 입금자/메모의 'N월' → 그 달(늦은납부=작년·선납=내년 보정). 없으면 납부일 월.
            $billYm = substr($date, 0, 7);
            if (preg_match('/(\d{1,2})\s*월/u', $cp, $bmm)) {
                $bm = (int)$bmm[1];
                if ($bm >= 1 && $bm <= 12) {
                    $py = (int)substr($date, 0, 4); $pm = (int)substr($date, 5, 2); $by = $py;
                    if ($bm - $pm >= 6) $by = $py - 1; elseif ($bm - $pm <= -6) $by = $py + 1;
                    $billYm = sprintf('%04d-%02d', $by, $bm);
                }
            }
            $base = [
                'date' => $date, 'datetime' => $r['datetime'] ?? $date, 'bill_ym' => $billYm,
                'counterparty' => $cp, 'deposit' => $dep, 'withdraw' => $wd, 'jeokyo' => $jeok,
                'contract_id' => null, 'confidence' => 'none', 'match_reason' => '',
                'rent_fee' => 0, 'maintenance_fee' => 0, 'parking_fee' => 0, 'water_fee' => 0, 'electric_fee' => 0, 'dup' => false,
                'include' => false, 'skip_reason' => '',
            ];

            // 출금·이자·기타는 스킵(입금만 대상)
            if ($dep <= 0 || $wd > 0) { $base['skip_reason'] = '출금'; $out[] = $base; continue; }
            if (preg_match('/이자|세금/u', $cp) || preg_match('/이자/u', $jeok)) { $base['skip_reason'] = '이자'; $out[] = $base; continue; }

            $isMgmtOnly = (bool)preg_match('/관리비/u', $cp);

            // 계약별 점수 산정
            $best = null; $bestScore = 0; $tie = false;
            foreach ($contracts as $c) {
                $roomHit = false;
                $roomN = $this->normRoom((string)$c['room_no']);
                if ($roomN !== '' && strpos($cpLow, $roomN) !== false) $roomHit = true;

                $nameHit = false;
                $cpN = preg_replace('/[\s\x{3000}\x{00A0}]+/u', '', $cp); // 공백(전각 　 포함) 제거
                foreach ([$c['tenant_name'], $c['co_tenant_name']] as $nm) {
                    $nm = trim((string)$nm);
                    $nmN = preg_replace('/[\s\x{3000}\x{00A0}]+/u', '', $nm);
                    if ($nmN === '') continue;
                    if (mb_strpos($cpN, $nmN) !== false) { $nameHit = true; break; } // 계약명이 입금자에 포함(공백 무시)
                    // 은행이 긴 이름을 자른 경우(KHAN TATYANA→KHAN TATYA): 한쪽이 다른쪽 접두면 매칭(5자+)
                    if (mb_strlen($nmN) >= 5 && (mb_strpos($nmN, $cpN) === 0 || mb_strpos($cpN, $nmN) === 0)) { $nameHit = true; break; }
                }

                $rent = (int)$c['rent_fee']; $mnt = (int)$c['maintenance_fee']; $park = (int)($c['parking_fee'] ?? 0); $rmt = $rent + $mnt + $park;
                $amtHit = ($rmt > 0 && $dep === $rmt) || ($rent > 0 && $dep === $rent) || ($mnt > 0 && $dep === $mnt);

                // 입금일이 계약 재실기간(계약일~퇴거일/만료일, 활성은 진행중)에 포함되는지
                $dateHit = false;
                $cd = substr((string)($c['contract_date'] ?? ''), 0, 10);
                $oe = substr((string)(($c['move_out_date'] ?? '') ?: ($c['contract_end_date'] ?? '')), 0, 10);
                if ($cd !== '' && $date >= $cd) {
                    if (($c['status'] ?? '') === 'active' || $oe === '' || $date <= $oe) $dateHit = true;
                }

                $score = ($roomHit ? 5 : 0) + ($nameHit ? 5 : 0) + ($amtHit ? 2 : 0);
                if ($score <= 0) continue;             // 호실·이름·금액 중 하나는 있어야 후보
                if ($dateHit) $score += 3;             // 재실기간 포함이면 가산(같은 호실 여러 계약 중 시점 맞는 것)
                if ($score > $bestScore) { $bestScore = $score; $best = ['c' => $c, 'room' => $roomHit, 'name' => $nameHit, 'amt' => $amtHit, 'date' => $dateHit]; $tie = false; }
                elseif ($score === $bestScore) { $tie = true; }
            }

            if ($best === null) { $out[] = $base; continue; } // 미매칭

            $c = $best['c'];
            $cid = (int)$c['id'];
            $rent = (int)$c['rent_fee']; $mnt = (int)$c['maintenance_fee'];

            // 금액 분할(확정 규칙): 관리비는 계약 정액 고정, 차액은 월세로.
            //   전세(월세=0)·관리비전용 입금은 전액을 관리비로 본다.
            $park = (int)($c['parking_fee'] ?? 0); $pp = min($park, $dep); $rem = $dep - $pp; // 주차비 정액 우선 차감
            if ($isMgmtOnly || $rent === 0) { $pm = $rem;            $pr = 0; }
            else                            { $pm = min($mnt, $rem); $pr = $rem - $pm; }

            // 신뢰도
            $reasons = [];
            if ($best['name']) $reasons[] = '이름';
            if ($best['room']) $reasons[] = '호실';
            if ($best['amt'])  $reasons[] = '금액';
            if (!empty($best['date'])) $reasons[] = '기간';
            $twoStrong = ($best['name'] && $best['room']) || (!empty($best['date']) && ($best['name'] || $best['room']));
            $strongPlusAmt = ($best['name'] || $best['room']) && $best['amt'];
            if ($tie && !$twoStrong)       $conf = 'low';
            elseif ($twoStrong || $strongPlusAmt) $conf = 'high';
            elseif ($best['name'] || $best['room']) $conf = 'mid';
            else                            $conf = 'low';

            $roomId = (int)($c['room_id'] ?? $c['unit_id'] ?? 0);
            $dup = isset($existKeys[$roomId . '|' . $date]); // 같은 호실·같은 날짜면 이미등록

            $out[] = array_merge($base, [
                'contract_id' => $cid,
                'confidence' => $conf,
                'match_reason' => implode('+', $reasons),
                'rent_fee' => $pr, 'maintenance_fee' => $pm, 'parking_fee' => $pp, 'water_fee' => 0, 'electric_fee' => 0,
                'dup' => $dup,
                'include' => !$dup && $conf !== 'low', // 확실한 것만 기본 체크
            ]);
        }

        return ['rows' => $out, 'candidates' => $candidates];
    }

    /** 특정 계약·날짜 범위의 기존 납부키(중복표시용) */
    public function existingPaymentKeys(array $contractIds, string $fromDate, string $toDate): array {
        $contractIds = array_values(array_unique(array_map('intval', $contractIds)));
        if (!$contractIds) return [];
        $ph = implode(',', array_fill(0, count($contractIds), '?'));
        $stmt = $this->pdo->prepare("
            SELECT c.room_id, p.pay_date FROM nw_payment p
            JOIN nw_contract c ON c.id = p.contract_id
            WHERE p.contract_id IN ($ph) AND p.pay_date BETWEEN ? AND ?
        ");
        $stmt->execute(array_merge($contractIds, [$fromDate, $toDate]));
        $keys = [];
        foreach ($stmt->fetchAll() as $row) { $keys[(int)$row['room_id'] . '|' . $row['pay_date']] = true; } // 호실+날짜 기준
        return $keys;
    }

    /** 같은 계약·같은 날짜 납부가 이미 있는지(벌크 인서트 안전망) */
    private function paymentExistsOn(int $contractId, string $payDate): bool {
        $stmt = $this->pdo->prepare("SELECT 1 FROM nw_payment WHERE contract_id=:c AND pay_date=:d LIMIT 1");
        $stmt->execute([':c' => $contractId, ':d' => $payDate]);
        return (bool)$stmt->fetchColumn();
    }

    /** 같은 호실(계약의 room)·같은 날짜에 이미 납부가 있는지 — 호실 단위 중복 방지(계약 바뀌어도) */
    private function paymentExistsInRoom(int $contractId, string $payDate): bool {
        $stmt = $this->pdo->prepare("
            SELECT 1 FROM nw_payment p
            JOIN nw_contract c ON c.id = p.contract_id
            WHERE c.room_id = (SELECT room_id FROM nw_contract WHERE id = :cid) AND p.pay_date = :d
            LIMIT 1
        ");
        $stmt->execute([':cid' => $contractId, ':d' => $payDate]);
        return (bool)$stmt->fetchColumn();
    }

    /** 같은 호실·같은 날짜·같은 금액의 중복 납부 제거(가장 오래된 id만 남김). 반환=삭제 건수. */
    public function dedupeRoomPayments(?int $buildingId = null): int {
        $where = $buildingId ? "AND cA.room_id IN (SELECT id FROM nw_unit WHERE building_id = :b)" : '';
        $stmt = $this->pdo->prepare("
            DELETE pA FROM nw_payment pA
            JOIN nw_contract cA ON cA.id = pA.contract_id
            JOIN nw_payment pB ON pB.id < pA.id
            JOIN nw_contract cB ON cB.id = pB.contract_id AND cB.room_id = cA.room_id
            WHERE pA.pay_date = pB.pay_date
              AND pA.rent_fee = pB.rent_fee AND pA.maintenance_fee = pB.maintenance_fee AND pA.parking_fee = pB.parking_fee
              $where
        ");
        if ($buildingId) $stmt->bindValue(':b', $buildingId, PDO::PARAM_INT);
        $stmt->execute();
        return $stmt->rowCount();
    }

    /** 검토 확정된 납부들을 트랜잭션으로 일괄 등록(계약·날짜 중복은 스킵) */
    public function bulkAddPayments(array $items): array {
        $inserted = 0; $skipped = 0;
        $this->pdo->beginTransaction();
        try {
            foreach ($items as $it) {
                $cid = (int)($it['contract_id'] ?? 0);
                $date = (string)($it['pay_date'] ?? '');
                if (!$cid || !preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) { $skipped++; continue; }
                if ($this->paymentExistsInRoom($cid, $date)) { $skipped++; continue; }
                $this->addPayment([
                    'contract_id'     => $cid,
                    'pay_date'        => $date,
                    'bill_ym'         => $it['bill_ym'] ?? null,
                    'rent_fee'        => $it['rent_fee'] ?? 0,
                    'maintenance_fee' => $it['maintenance_fee'] ?? 0,
                    'parking_fee'     => $it['parking_fee'] ?? 0,
                    'water_fee'       => $it['water_fee'] ?? 0,
                    'electric_fee'    => $it['electric_fee'] ?? 0,
                    'memo'            => $it['memo'] ?? null,
                ]);
                $inserted++;
            }
            $this->pdo->commit();
        } catch (Throwable $e) {
            $this->pdo->rollBack();
            throw $e;
        }
        return ['inserted' => $inserted, 'skipped' => $skipped];
    }

    // ==========================================================
    // 모니터링 계산
    // ==========================================================

    /** 계약만기 상태: implied(묵시적갱신中) / warn(D-30이내) / danger(D-7이내) / ok(여유)
     *  임대차보호법상 만기일이 지난 활성 계약, 또는 renewal_type='implied' 는 '묵시적 갱신중'으로 본다. */
    public function expiryStatus(array $contract): array {
        $implied = (($contract['renewal_type'] ?? '') === 'implied');

        if (empty($contract['contract_end_date'])) {
            return $implied
                ? ['level' => 'implied', 'dday' => null, 'label' => '묵시적 갱신중']
                : ['level' => 'ok', 'dday' => null, 'label' => '-'];
        }
        $today = new DateTimeImmutable('today');
        $end   = new DateTimeImmutable($contract['contract_end_date']);
        $dday  = (int)$today->diff($end)->format('%r%a');

        if ($implied || $dday < 0) {
            return ['level' => 'implied', 'dday' => $dday, 'label' => '묵시적 갱신중'];
        }
        if ($dday <= 7)       { $level = 'danger'; $label = 'D-' . $dday; }
        elseif ($dday <= 30)  { $level = 'warn';   $label = 'D-' . $dday; }
        else                  { $level = 'ok';     $label = 'D-' . $dday; }

        return ['level' => $level, 'dday' => $dday, 'label' => $label];
    }

    /** 계약 id => 해당 계약의 가장 최근 납부기록, 여러 계약을 한 번의 쿼리로 일괄 조회 (N+1 방지) */
    public function listLastPayments(array $contractIds): array {
        $contractIds = array_values(array_unique(array_map('intval', $contractIds)));
        if (!$contractIds) return [];
        $ph = implode(',', array_fill(0, count($contractIds), '?'));
        $stmt = $this->pdo->prepare("
            SELECT p.* FROM nw_payment p
            INNER JOIN (
                SELECT contract_id, MAX(pay_date) AS max_date
                FROM nw_payment WHERE contract_id IN ($ph)
                GROUP BY contract_id
            ) m ON p.contract_id = m.contract_id AND p.pay_date = m.max_date
        ");
        $stmt->execute($contractIds);
        $out = [];
        foreach ($stmt->fetchAll() as $row) {
            $out[(int)$row['contract_id']] = $row;
        }
        return $out;
    }

    /** 이번 달 월세 납부 상태: na(전세) / paid(완료) / due(예정) / overdue(연체)
     *  $lastPayment: false=직접 조회(단건용), null=납부이력 없음, array=미리 조회해온 값(목록 렌더용, N+1 방지) */
    public function paymentStatus(array $contract, $lastPayment = false): array {
        if ($contract['contract_type'] === 'jeonse') {
            return ['level' => 'na', 'days' => 0, 'label' => '전세'];
        }

        $payDay = (int)($contract['rent_pay_day'] ?? 0) ?: 1;
        $today  = new DateTimeImmutable('today');

        $daysInMonth = (int)$today->format('t');
        $dueDay      = min($payDay, $daysInMonth);
        $dueDate     = new DateTimeImmutable($today->format('Y-m-') . sprintf('%02d', $dueDay));

        $prevMonthAnchor = $dueDate->modify('-1 month');
        $prevDaysInMonth = (int)$prevMonthAnchor->format('t');
        $prevDueDay      = min($payDay, $prevDaysInMonth);
        $prevDue         = new DateTimeImmutable($prevMonthAnchor->format('Y-m-') . sprintf('%02d', $prevDueDay));

        $last = $lastPayment === false ? $this->getLastPayment((int)$contract['id']) : $lastPayment;
        if ($last) {
            $payDate = new DateTimeImmutable($last['pay_date']);
            if ($payDate > $prevDue) {
                return ['level' => 'paid', 'days' => 0, 'label' => '납부완료(' . $payDate->format('m/d') . ')'];
            }
        }

        if ($today <= $dueDate) {
            $dday = (int)$today->diff($dueDate)->format('%a');
            return ['level' => 'due', 'days' => $dday, 'label' => '납부예정(D-' . $dday . ')'];
        }

        $overdueDays = (int)$dueDate->diff($today)->format('%a');
        return ['level' => 'overdue', 'days' => $overdueDays, 'label' => '연체 ' . $overdueDays . '일'];
    }

    /** 대시보드 요약: 건물/호실/공실 카운트 + 연체·만기임박 알림 리스트 */
    public function dashboardSummary(): array {
        $totalBuildings = (int)$this->pdo->query("SELECT COUNT(*) FROM nw_building")->fetchColumn();
        $totalUnits     = (int)$this->pdo->query("SELECT COUNT(*) FROM nw_unit")->fetchColumn();

        $activeContracts = $this->pdo->query("
            SELECT c.*, u.room_no, u.id AS unit_id, b.id AS building_id, b.name AS building_name
            FROM nw_contract c
            JOIN nw_unit u ON u.id = c.room_id
            JOIN nw_building b ON b.id = u.building_id
            WHERE c.status = 'active'
        ")->fetchAll();

        $occupiedUnitIds = array_unique(array_column($activeContracts, 'unit_id'));
        $lastPayments    = $this->listLastPayments(array_column($activeContracts, 'id'));

        $overdueList   = [];
        $expiringList  = [];
        foreach ($activeContracts as $c) {
            $pay = $this->paymentStatus($c, $lastPayments[(int)$c['id']] ?? null);
            if ($pay['level'] === 'overdue') {
                $overdueList[] = $c + ['pay' => $pay];
            }
            $exp = $this->expiryStatus($c);
            if (in_array($exp['level'], ['warn', 'danger'], true)) {
                $expiringList[] = $c + ['exp' => $exp];
            }
        }
        usort($overdueList,  fn($a, $b) => $b['pay']['days'] <=> $a['pay']['days']);
        usort($expiringList, fn($a, $b) => $a['exp']['dday'] <=> $b['exp']['dday']);

        return [
            'totalBuildings' => $totalBuildings,
            'totalUnits'     => $totalUnits,
            'occupiedUnits'  => count($occupiedUnitIds),
            'vacantUnits'    => $totalUnits - count($occupiedUnitIds),
            'overdueList'    => $overdueList,
            'expiringList'   => $expiringList,
        ];
    }

    // ==========================================================
    // 계약서 이미지 (DB 저장 + Claude Vision 자동 판독)
    // ==========================================================

    /** 계약서 이미지를 DB에 저장하고 id 반환. contract_id는 아직 없으면 null(스캔 시점). */
    public function saveContractImage(?int $contractId, ?int $unitId, string $mime, string $bytes, ?string $filename): int {
        $stmt = $this->pdo->prepare("
            INSERT INTO nw_contract_image (contract_id, unit_id, mime, filename, image_data)
            VALUES (:cid, :uid, :mime, :fn, :data)
        ");
        $stmt->bindValue(':cid',  $contractId, $contractId === null ? PDO::PARAM_NULL : PDO::PARAM_INT);
        $stmt->bindValue(':uid',  $unitId,     $unitId === null ? PDO::PARAM_NULL : PDO::PARAM_INT);
        $stmt->bindValue(':mime', $mime);
        $stmt->bindValue(':fn',   $filename);
        $stmt->bindValue(':data', $bytes, PDO::PARAM_LOB);
        $stmt->execute();
        return (int)$this->pdo->lastInsertId();
    }

    /** 계약 저장 후 이미지를 그 계약에 연결. */
    public function linkContractImage(int $imageId, int $contractId): void {
        $stmt = $this->pdo->prepare("UPDATE nw_contract_image SET contract_id=:cid WHERE id=:id");
        $stmt->execute([':cid' => $contractId, ':id' => $imageId]);
    }

    /** 계약서 이미지 삭제(잘못 올린 사진 정리). */
    public function deleteContractImage(int $id): void {
        $stmt = $this->pdo->prepare("DELETE FROM nw_contract_image WHERE id=:id");
        $stmt->execute([':id' => $id]);
    }

    /** 원본 이미지 1건(바이너리 포함) — 이미지 서빙용. */
    public function getContractImage(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT id, contract_id, mime, filename, image_data FROM nw_contract_image WHERE id=:id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch() ?: null;
    }

    /** 계약에 딸린 이미지 목록(바이너리 제외) — 폼/상세 썸네일용. */
    public function listContractImages(int $contractId): array {
        $stmt = $this->pdo->prepare("SELECT id, mime, filename, created_at FROM nw_contract_image WHERE contract_id=:cid ORDER BY id DESC");
        $stmt->execute([':cid' => $contractId]);
        return $stmt->fetchAll();
    }

    /**
     * 계약서 사진을 Claude Vision(claude-opus-4-8)으로 판독해 폼 필드값 배열을 반환.
     * env/anthropic.inc(ANTHROPIC_API_KEY)가 로드돼 있어야 한다. 실패 시 null.
     */
    public function extractContractFromImage(string $imageBytes, string $mime): ?array {
        if (!defined('ANTHROPIC_API_KEY') || ANTHROPIC_API_KEY === '') return null;
        if (!in_array($mime, ['image/jpeg', 'image/png', 'image/gif', 'image/webp'], true)) $mime = 'image/jpeg';

        $sys = "너는 한국 부동산(원룸/오피스텔) 임대차 계약서 이미지에서 정보를 추출하는 도우미다. "
             . "반드시 아래 키만 가진 JSON 객체 하나만 출력한다. 설명 문장이나 코드펜스(```)는 절대 쓰지 마라. 값을 못 찾으면 빈 문자열로 둔다.\n"
             . "키: contract_type, tenant_name, tenant_ssn, tenant_phone, co_tenant_name, co_tenant_ssn, co_tenant_phone, "
             . "deposit, down_payment, balance_amount, contract_date, balance_date, contract_end_date, rent_fee, maintenance_fee, parking_fee, "
             . "rent_pay_day, deposit_registered, agent_office, agent_phone, agent_ceo, special_terms.\n"
             . "규칙:\n"
             . "- contract_type: 월세(차임)가 있으면 'monthly', 차임 없이 보증금만이면 'jeonse', 큰 보증금과 월세가 함께면 'semi_monthly'.\n"
             . "- 금액(deposit=보증금, down_payment=계약금, balance_amount=잔금, rent_fee=차임/월세, maintenance_fee=관리비, parking_fee=월 주차비): 숫자만(콤마·원·글자 제거). 관리비·주차비는 특약에 적힌 월 금액, 없으면 0.\n"
             . "- 날짜(contract_date=계약체결일, balance_date=잔금지급일, contract_end_date=임대차 존속기간 종료일): 반드시 'YYYY-MM-DD' 형식.\n"
             . "- tenant_*: 임차인(빌린 사람) 정보. co_tenant_*: 임차인이 둘일 때만. 임대인/공동임대인/공인중개사 정보는 tenant에 넣지 마라.\n"
             . "- tenant_ssn: 주민등록번호를 '######-#######'(하이픈 포함 13자리) 형식으로. 없으면 빈 문자열.\n"
             . "- rent_pay_day: 매월 며칠 납부인지 1~31 숫자만.\n"
             . "- deposit_registered: 전세권설정 문구가 있으면 1, 아니면 0.\n"
             . "- agent_office=공인중개사 사무소 명칭, agent_phone=중개사 전화, agent_ceo=중개사 대표자/개업공인중개사 이름.\n"
             . "- special_terms: 특약사항 전체를 줄바꿈 유지해 그대로.";

        $payload = [
            'model'      => 'claude-opus-4-8',
            'max_tokens' => 2048,
            'system'     => $sys,
            'messages'   => [[
                'role'    => 'user',
                'content' => [
                    ['type' => 'image', 'source' => ['type' => 'base64', 'media_type' => $mime, 'data' => base64_encode($imageBytes)]],
                    ['type' => 'text', 'text' => '이 계약서 이미지의 정보를 위 규칙대로 JSON 으로만 출력해줘.'],
                ],
            ]],
        ];

        $ch = curl_init('https://api.anthropic.com/v1/messages');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST           => true,
            CURLOPT_HTTPHEADER     => [
                'x-api-key: ' . ANTHROPIC_API_KEY,
                'anthropic-version: 2023-06-01',
                'content-type: application/json',
            ],
            CURLOPT_POSTFIELDS     => json_encode($payload),
            CURLOPT_TIMEOUT        => 90,
            CURLOPT_SSL_VERIFYPEER => false,
        ]);
        $res  = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        if ($res === false || $code !== 200) return null;

        $data = json_decode($res, true);
        $text = '';
        foreach ($data['content'] ?? [] as $blk) {
            if (($blk['type'] ?? '') === 'text') { $text = (string)($blk['text'] ?? ''); break; }
        }
        $text = trim($text);
        if ($text === '') return null;
        $text = preg_replace('/^```(?:json)?\s*|\s*```$/', '', $text);
        $fields = json_decode($text, true);
        if (!is_array($fields) && preg_match('/\{.*\}/s', $text, $m)) $fields = json_decode($m[0], true);
        return is_array($fields) ? $fields : null;
    }
}
?>
