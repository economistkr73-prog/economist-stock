<?php
// 파일 위치: ./classes/Chart_Helper.php

class ChartHelper {
    
 
    /**
     * 📊 공통 ECharts 트리맵(Treemap) 렌더링
     */
    public static function renderTreemapChart(string $container_id, array $data, array $mapping_keys, int $limit = 0): string {
        // 💡 갯수 제한이 있으면 클래스 내부에서 알아서 데이터를 자릅니다!
        if ($limit > 0) {
            $data = array_slice($data, 0, $limit);
        }

        $name_key   = $mapping_keys['name'];   
        $size_key   = $mapping_keys['size'];   
        $color_key  = $mapping_keys['color'];  
        $code_key   = $mapping_keys['code'];   
        $row_prefix = $mapping_keys['row_prefix'] ?? 'row_';

        $treemap_data = [];
        
        foreach ($data as $row) {
            $size_val  = (float)($row[$size_key] ?? 0);
            $color_val = (float)($row[$color_key] ?? 0);
            
            if ($size_val <= 0) continue; 

            // 한국 시장용 히트맵 색상 계산
            if ($color_val > 0) {
                $intensity = min(1, $color_val / 30);
                $alpha = 0.3 + ($intensity * 0.7); 
                $color = "rgba(225, 35, 74, {$alpha})"; 
            } elseif ($color_val < 0) {
                $intensity = min(1, abs($color_val) / 30); 
                $alpha = 0.3 + ($intensity * 0.7);
                $color = "rgba(0, 82, 164, {$alpha})"; 
            } else {
                $color = "#94a3b8"; 
            }

            // 크기에 비례하는 폰트 사이즈 계산
            $dynamic_font_size = max(11, min(32, 11 + ($size_val * 1.5)));

			$rounded_rate = round($color_val, 2);

            $treemap_data[] = [
				'name' => $row[$name_key] . "\n" . ($rounded_rate > 0 ? '+' : '') . $rounded_rate . "%",
                'value' => $size_val,
                'itemStyle' => ['color' => $color],
                'label' => ['fontSize' => round($dynamic_font_size)],
                'stock_code' => $row[$code_key],
                'raw_name' => $row[$name_key],
                'raw_rate' => $rounded_rate
            ];
        }

        if (empty($treemap_data)) return "";

        $treemap_json = json_encode($treemap_data, JSON_UNESCAPED_UNICODE);

        $html = "
        <script src='https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js'></script>
        <div id='{$container_id}' style='width: 100%; height: 400px; margin-bottom: 25px; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0;'></div>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            var chartDom = document.getElementById('{$container_id}');
            if (!chartDom) return;
            
            var myChart = echarts.init(chartDom);
            var option = {
                tooltip: {
                    formatter: function (info) {
                        return '<div style=\"font-weight:bold; margin-bottom:4px;\">' + info.data.raw_name + '</div>' +
                               '크기 기준: ' + info.value + '<br>' +
                               '색상 기준: ' + (info.data.raw_rate > 0 ? '+' : '') + Number(info.data.raw_rate).toFixed(2);
                    }
                },
                series: [{
                    type: 'treemap',
                    width: '100%',
                    height: '100%',
                    roam: false, 
                    nodeClick: false, 
                    breadcrumb: { show: false }, 
                    label: {
                        show: true,
                        formatter: '{b}',
                        color: '#ffffff',
                        fontWeight: 'bold',
                        fontFamily: 'Pretendard, sans-serif'
                    },
                    itemStyle: {
                        borderColor: '#ffffff',
                        borderWidth: 1.5,
                        gapWidth: 1
                    },
                    data: {$treemap_json}
                }]
            };
            
            myChart.setOption(option);

            myChart.on('click', function(params) {
                var stockCode = params.data.stock_code;
                var rowId = '{$row_prefix}' + stockCode;
                var rowElement = document.getElementById(rowId);
                
                if(rowElement) {
                    rowElement.scrollIntoView({behavior: 'smooth', block: 'center'});
                    var linkElement = rowElement.querySelector('a');
                    if(linkElement) {
                        linkElement.click();
                    }
                }
            });
            
            window.addEventListener('resize', function() {
                myChart.resize();
            });
        });
        </script>
        ";

        return $html;
    }

public static function getSortIcon(string $current_sort, string $target_sort): string {
        $icon_active_down = "<span style='color:#e1234a; margin-left:4px; font-size:12px;'>▼</span>";
        $icon_active_up   = "<span style='color:#e1234a; margin-left:4px; font-size:12px;'>▲</span>";
        $icon_inactive    = "<span style='color:#cbd5e0; margin-left:4px; font-size:12px; transition: color 0.2s;'>↕</span>";

        // 특별 케이스: 등락률 (rise / fall 토글)
        if ($target_sort === 'rate') {
            if ($current_sort === 'rise') return $icon_active_down;
            if ($current_sort === 'fall') return $icon_active_up;
            return $icon_inactive;
        }

        // 일반 케이스: 현재 정렬 기준과 대상 기준이 일치하면 내림차순(▼) 표시
        if ($current_sort === $target_sort) {
            return $icon_active_down;
        }

        return $icon_inactive;
} # end of getSortIcon
##########################










##########################
} # end of class: chart helper class
##########################

