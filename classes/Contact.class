<?php
// classes/Contact.class — 주소록 + 일정 참석자 연결 DB 전담

class Contact {

    private PDO $pdo;

    public function __construct(PDO $pdo) {
        $this->pdo = $pdo;
        $this->ensureTable();
    }

    // ── 테이블 자동 생성 ──────────────────────────────────────
    public function ensureTable(): void {
        // 주소록
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS tbl_contact (
                id           INT AUTO_INCREMENT PRIMARY KEY,
                name         VARCHAR(100) NOT NULL,
                phone        VARCHAR(30)  DEFAULT NULL,
                email        VARCHAR(120) DEFAULT NULL,
                organization VARCHAR(100) DEFAULT NULL COMMENT '소속/회사',
                position     VARCHAR(50)  DEFAULT NULL COMMENT '직책',
                tel          VARCHAR(30)  DEFAULT NULL COMMENT '유선전화',
                address      VARCHAR(200) DEFAULT NULL COMMENT '주소',
                corp_phone   VARCHAR(30)  DEFAULT NULL COMMENT '회사전화',
                fax          VARCHAR(30)  DEFAULT NULL COMMENT '팩스',
                group_name   VARCHAR(50)  DEFAULT '기타' COMMENT '그룹',
                memo         TEXT,
                src_id       INT          DEFAULT NULL COMMENT '기존 mypims_id.id_no (import 추적)',
                created_at   DATETIME     DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_name (name),
                INDEX idx_group (group_name),
                UNIQUE KEY uniq_src (src_id)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS src_id     INT          DEFAULT NULL COMMENT '기존 mypims_id.id_no'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS tel        VARCHAR(30)  DEFAULT NULL COMMENT '유선전화'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS address    VARCHAR(200) DEFAULT NULL COMMENT '주소'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS corp_phone VARCHAR(30)  DEFAULT NULL COMMENT '회사전화'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS fax        VARCHAR(30)  DEFAULT NULL COMMENT '팩스'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS eng_name   VARCHAR(100) DEFAULT NULL COMMENT '영문이름'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS department VARCHAR(100) DEFAULT NULL COMMENT '소속부서'");
        $this->pdo->exec("ALTER TABLE tbl_contact ADD COLUMN IF NOT EXISTS website    VARCHAR(200) DEFAULT NULL COMMENT '웹사이트'");
        // src_id 유니크 인덱스 (없으면 추가)
        try { $this->pdo->exec("ALTER TABLE tbl_contact ADD UNIQUE KEY uniq_src (src_id)"); } catch (Exception $e) {}
        // 일정-참석자 연결 (다대다)
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS tbl_schedule_attendee (
                id          INT AUTO_INCREMENT PRIMARY KEY,
                schedule_id INT NOT NULL,
                contact_id  INT NOT NULL,
                created_at  DATETIME DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (schedule_id) REFERENCES tbl_schedule(id) ON DELETE CASCADE,
                FOREIGN KEY (contact_id)  REFERENCES tbl_contact(id)  ON DELETE CASCADE,
                UNIQUE KEY uniq_sa (schedule_id, contact_id)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");
        // 그룹 등록부 (빈 그룹도 독립 관리 — 연락처 유무와 무관하게 존재)
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS tbl_contact_group (
                id         INT AUTO_INCREMENT PRIMARY KEY,
                name       VARCHAR(50) NOT NULL,
                sort_order INT DEFAULT 0,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                UNIQUE KEY uniq_cg_name (name)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");
        // 최초 1회: 기존 연락처의 그룹명을 등록부로 백필 (등록부가 비어있을 때만)
        $cgCnt = (int)$this->pdo->query("SELECT COUNT(*) FROM tbl_contact_group")->fetchColumn();
        if ($cgCnt === 0) {
            $this->pdo->exec("
                INSERT IGNORE INTO tbl_contact_group (name, sort_order)
                SELECT group_name, 0 FROM tbl_contact
                 WHERE TRIM(IFNULL(group_name,'')) <> ''
                 GROUP BY group_name
            ");
        }
    }

    // ── 주소록 CRUD ───────────────────────────────────────────
    public function listAll(string $search = '', string $group = ''): array {
        $where = []; $params = [];
        if ($search !== '') {
            $kw = '%' . $search . '%';
            $where[] = "(name LIKE :kw1 OR phone LIKE :kw2 OR tel LIKE :kw3 OR email LIKE :kw4 OR organization LIKE :kw5)";
            $params[':kw1'] = $kw;
            $params[':kw2'] = $kw;
            $params[':kw3'] = $kw;
            $params[':kw4'] = $kw;
            $params[':kw5'] = $kw;
        }
        if ($group !== '') {
            $where[] = "group_name = :grp";
            $params[':grp'] = $group;
        }
        $sql = "SELECT * FROM tbl_contact";
        if ($where) $sql .= " WHERE " . implode(' AND ', $where);
        $sql .= " ORDER BY name ASC";
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute($params);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    public function getById(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM tbl_contact WHERE id=:id");
        $stmt->execute([':id' => $id]);
        return $stmt->fetch(PDO::FETCH_ASSOC) ?: null;
    }

    public function create(array $d): int {
        $stmt = $this->pdo->prepare(
            "INSERT INTO tbl_contact
               (name, eng_name, phone, tel, email, organization, department, position,
                address, corp_phone, fax, website, group_name, memo)
             VALUES
               (:name, :eng_name, :phone, :tel, :email, :org, :dept, :pos,
                :addr, :corp_phone, :fax, :website, :grp, :memo)"
        );
        $stmt->execute($this->buildParams($d));
        return (int)$this->pdo->lastInsertId();
    }

    public function update(array $d): void {
        $stmt = $this->pdo->prepare(
            "UPDATE tbl_contact SET
               name=:name, eng_name=:eng_name, phone=:phone, tel=:tel, email=:email,
               organization=:org, department=:dept, position=:pos, address=:addr,
               corp_phone=:corp_phone, fax=:fax, website=:website, group_name=:grp, memo=:memo
             WHERE id=:id"
        );
        $params = $this->buildParams($d);
        $params[':id'] = (int)$d['id'];
        $stmt->execute($params);
    }

    public function delete(int $id): void {
        $this->pdo->prepare("DELETE FROM tbl_contact WHERE id=:id")->execute([':id' => $id]);
    }

    // 그룹 목록 = 등록부 그룹(빈 그룹 포함) ∪ 연락처에서 쓰이는 미등록 그룹 ∪ 미분류 버킷
    // 각 행: group_name, cnt(소속 인원), sort_order
    public function groups(): array {
        $sql = "
            SELECT g.name AS group_name,
                   COALESCE(c.cnt, 0) AS cnt,
                   g.sort_order AS sort_order
              FROM tbl_contact_group g
              LEFT JOIN (
                    SELECT group_name, COUNT(*) AS cnt
                      FROM tbl_contact GROUP BY group_name
              ) c ON c.group_name = g.name
            UNION
            SELECT o.group_name, o.cnt, 999999 AS sort_order
              FROM (
                    SELECT group_name, COUNT(*) AS cnt
                      FROM tbl_contact
                     WHERE TRIM(IFNULL(group_name,'')) <> ''
                       AND group_name NOT IN (SELECT name FROM tbl_contact_group)
                     GROUP BY group_name
              ) o
            UNION
            SELECT '' AS group_name,
                   (SELECT COUNT(*) FROM tbl_contact WHERE TRIM(IFNULL(group_name,'')) = '') AS cnt,
                   -1 AS sort_order
            ORDER BY group_name
        ";
        return $this->pdo->query($sql)->fetchAll(PDO::FETCH_ASSOC);
    }

    // ── 그룹 관리 ─────────────────────────────────────────────
    // 빈 그룹 추가. 이미 있으면 false 반환.
    public function addGroup(string $name): bool {
        $name = trim($name);
        if ($name === '') return false;
        $max = (int)$this->pdo->query("SELECT COALESCE(MAX(sort_order),0) FROM tbl_contact_group")->fetchColumn();
        $stmt = $this->pdo->prepare("INSERT IGNORE INTO tbl_contact_group (name, sort_order) VALUES (:n, :so)");
        $stmt->execute([':n' => $name, ':so' => $max + 1]);
        return $stmt->rowCount() > 0;
    }

    // 이름변경 + 통합. to 가 이미 존재하면 두 그룹이 합쳐진다(merged=true).
    public function renameGroup(string $from, string $to): array {
        $from = trim($from); $to = trim($to);
        if ($from === '' || $to === '') return ['ok' => false, 'msg' => '그룹명을 입력하세요.'];
        if ($from === $to)               return ['ok' => true, 'merged' => false, 'moved' => 0];

        $this->pdo->beginTransaction();
        try {
            $chk = $this->pdo->prepare("SELECT COUNT(*) FROM tbl_contact_group WHERE name = :to");
            $chk->execute([':to' => $to]);
            $merged = (int)$chk->fetchColumn() > 0;

            // 소속 연락처 group_name 일괄 변경
            $upd = $this->pdo->prepare("UPDATE tbl_contact SET group_name = :to WHERE group_name = :from");
            $upd->execute([':to' => $to, ':from' => $from]);
            $moved = $upd->rowCount();

            // 등록부에서 from 제거 후 to 등록 보장
            $this->pdo->prepare("DELETE FROM tbl_contact_group WHERE name = :from")->execute([':from' => $from]);
            $max = (int)$this->pdo->query("SELECT COALESCE(MAX(sort_order),0) FROM tbl_contact_group")->fetchColumn();
            $this->pdo->prepare("INSERT IGNORE INTO tbl_contact_group (name, sort_order) VALUES (:n, :so)")
                      ->execute([':n' => $to, ':so' => $max + 1]);

            $this->pdo->commit();
            return ['ok' => true, 'merged' => $merged, 'moved' => $moved];
        } catch (Exception $e) {
            $this->pdo->rollBack();
            return ['ok' => false, 'msg' => $e->getMessage()];
        }
    }

    // 그룹 삭제 → 소속 연락처는 미분류(빈 group_name)로 이동
    public function deleteGroup(string $name): array {
        $name = trim($name);
        if ($name === '') return ['ok' => false, 'msg' => '그룹명이 비었습니다.'];
        $this->pdo->beginTransaction();
        try {
            $upd = $this->pdo->prepare("UPDATE tbl_contact SET group_name = '' WHERE group_name = :n");
            $upd->execute([':n' => $name]);
            $moved = $upd->rowCount();
            $this->pdo->prepare("DELETE FROM tbl_contact_group WHERE name = :n")->execute([':n' => $name]);
            $this->pdo->commit();
            return ['ok' => true, 'moved' => $moved];
        } catch (Exception $e) {
            $this->pdo->rollBack();
            return ['ok' => false, 'msg' => $e->getMessage()];
        }
    }


    // ── 참석자 연결 ───────────────────────────────────────────

    // 여러 일정의 참석자를 한 번에 (id => [contacts])
    public function getAttendeesMap(array $scheduleIds): array {
        if (empty($scheduleIds)) return [];
        $ids = array_filter(array_map('intval', $scheduleIds));
        if (empty($ids)) return [];
        $ph = implode(',', array_fill(0, count($ids), '?'));
        $stmt = $this->pdo->prepare(
            "SELECT sa.schedule_id, c.id, c.name
             FROM tbl_schedule_attendee sa
             JOIN tbl_contact c ON sa.contact_id = c.id
             WHERE sa.schedule_id IN ({$ph})
             ORDER BY c.name ASC"
        );
        $stmt->execute(array_values($ids));
        $map = [];
        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $r) {
            $map[$r['schedule_id']][] = ['id' => (int)$r['id'], 'name' => $r['name']];
        }
        return $map;
    }

    // 일정 참석자 설정 (기존 삭제 후 재등록)
    public function setAttendees(int $scheduleId, array $contactIds): void {
        $this->pdo->prepare("DELETE FROM tbl_schedule_attendee WHERE schedule_id=:sid")
                  ->execute([':sid' => $scheduleId]);
        $ins = $this->pdo->prepare(
            "INSERT IGNORE INTO tbl_schedule_attendee (schedule_id, contact_id) VALUES (:sid, :cid)"
        );
        foreach (array_unique(array_map('intval', $contactIds)) as $cid) {
            if ($cid > 0) $ins->execute([':sid' => $scheduleId, ':cid' => $cid]);
        }
    }

    // ── CSV(명함) 일괄 등록 ───────────────────────────────────
    // $rows: 각 행이 연관배열 (name, eng_name, position, department, organization,
    //        phone, email, website, address, tel, fax, group_name)
    // 이름+모바일(또는 이메일) 동일하면 갱신, 아니면 신규
    public function importRows(array $rows): array {
        $res = ['imported' => 0, 'updated' => 0, 'skip' => 0, 'total' => 0];

        foreach ($rows as $d) {
            $name = trim($d['name'] ?? '');
            if ($name === '') { $res['skip']++; continue; }
            $res['total']++;

            // ── 동일인 판단 (개인 고유값 우선) ──
            // 1순위: 전화(모바일)  2순위: 이메일  3순위(연락처 없을 때): 이름+회사
            // → 동명이인은 전화/이메일이 다르므로 자동으로 별개 인물로 구분됨
            $phone = trim($d['phone'] ?? '');
            $email = trim($d['email'] ?? '');
            $org   = trim($d['organization'] ?? '');
            $existId = null;

            if ($phone !== '') {
                // 형식 차이(하이픈/공백) 무시 — 숫자만 비교
                $pdigits = preg_replace('/\D+/', '', $phone);
                if ($pdigits !== '') {
                    $chk = $this->pdo->prepare(
                        "SELECT id FROM tbl_contact
                          WHERE REGEXP_REPLACE(IFNULL(phone,''), '[^0-9]', '') = :p LIMIT 1"
                    );
                    $chk->execute([':p' => $pdigits]);
                    $existId = $chk->fetchColumn() ?: null;
                }
            }
            if (!$existId && $email !== '') {
                $chk = $this->pdo->prepare("SELECT id FROM tbl_contact WHERE email = :e LIMIT 1");
                $chk->execute([':e' => $email]);
                $existId = $chk->fetchColumn() ?: null;
            }
            if (!$existId && $phone === '' && $email === '') {
                // 연락처가 전혀 없으면 이름+회사로 약하게 매칭 (동명이인 구분용)
                $chk = $this->pdo->prepare(
                    "SELECT id FROM tbl_contact WHERE name = :n AND IFNULL(organization,'') = :o LIMIT 1"
                );
                $chk->execute([':n' => $name, ':o' => $org]);
                $existId = $chk->fetchColumn() ?: null;
            }

            if ($existId) {
                // 기존 인물: CSV에 값이 있는 필드만 갱신하고,
                // 비었거나 CSV에 없는 필드는 기존 DB 값을 보존한다
                // (드라이브 재동기화가 앱에서 입력한 memo·회사전화 등을 덮어쓰지 않도록)
                $old = $this->getById((int)$existId) ?: [];
                $keepFields = ['eng_name','phone','tel','email','organization','department',
                               'position','address','corp_phone','fax','website','group_name','memo'];
                foreach ($keepFields as $f) {
                    $new = isset($d[$f]) ? trim((string)$d[$f]) : '';
                    if ($new === '' && isset($old[$f])) $d[$f] = $old[$f];
                }
                $d['id'] = (int)$existId;
                $this->update($d);
                $res['updated']++;
            } else {
                $this->create($d);
                $res['imported']++;
            }
        }
        return $res;
    }

    // ── 인물별 일정 히스토리 ──────────────────────────────────
    public function getScheduleHistory(int $contactId): array {
        $stmt = $this->pdo->prepare(
            "SELECT s.id, s.title, s.start_dt, s.end_dt, s.event_type,
                    s.category, s.color, s.is_done, s.memo
             FROM tbl_schedule_attendee sa
             JOIN tbl_schedule s ON sa.schedule_id = s.id
             WHERE sa.contact_id = :cid
             ORDER BY s.start_dt DESC"
        );
        $stmt->execute([':cid' => $contactId]);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }


    // ── 인물별 기념일 조회 ────────────────────────────────────
    public function getAnniversaries(int $contactId): array {
        $stmt = $this->pdo->prepare(
            "SELECT s.id, s.title, s.start_dt, s.event_type, s.category,
                    s.color, s.icon, s.recur_rule, s.is_lunar, s.lunar_month, s.lunar_day, s.memo
             FROM tbl_schedule_attendee sa
             JOIN tbl_schedule s ON sa.schedule_id = s.id
             WHERE sa.contact_id = :cid AND s.event_type = 'anniversary'
             ORDER BY MONTH(s.start_dt), DAY(s.start_dt)"
        );
        $stmt->execute([':cid' => $contactId]);
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as &$r) {
            if (!empty($r['recur_rule']) && is_string($r['recur_rule'])) {
                $r['recur_rule'] = json_decode($r['recur_rule'], true);
            }
        }
        unset($r);
        return $rows;
    }
    // ── private ───────────────────────────────────────────────
    private function buildParams(array $d): array {
        return [
            ':name'       => trim($d['name'] ?? ''),
            ':eng_name'   => trim($d['eng_name'] ?? '') ?: null,
            ':phone'      => trim($d['phone'] ?? '') ?: null,
            ':tel'        => trim($d['tel'] ?? '') ?: null,
            ':email'      => trim($d['email'] ?? '') ?: null,
            ':org'        => trim($d['organization'] ?? '') ?: null,
            ':dept'       => trim($d['department'] ?? '') ?: null,
            ':pos'        => trim($d['position'] ?? '') ?: null,
            ':addr'       => trim($d['address'] ?? '') ?: null,
            ':corp_phone' => trim($d['corp_phone'] ?? '') ?: null,
            ':fax'        => trim($d['fax'] ?? '') ?: null,
            ':website'    => trim($d['website'] ?? '') ?: null,
            ':grp'        => isset($d['group_name']) ? trim($d['group_name']) : '기타',
            ':memo'       => $d['memo'] ?? '',
        ];
    }

    // ── 명함 이미지 → 주소록 (구글드라이브 서비스계정 + Claude Vision) ──
    // env/gdrive.inc(CONTACT_CARD_DRIVE_FOLDER_ID + GDRIVE_SA_JSON) 와
    // env/anthropic.inc(ANTHROPIC_API_KEY) 가 있어야 동작한다.
    // 서비스 계정(폴더 '편집자' 공유)으로 목록·다운로드·'스캔완료' 폴더 이동을 모두 처리한다.
    private static ?string $saToken = null;   // 요청 단위 액세스 토큰 캐시

    private function cardDriveEnabled(): bool {
        return defined('CONTACT_CARD_DRIVE_FOLDER_ID') && CONTACT_CARD_DRIVE_FOLDER_ID !== ''
            && defined('GDRIVE_SA_JSON') && GDRIVE_SA_JSON !== '' && file_exists(GDRIVE_SA_JSON);
    }

    // 서비스 계정 JSON → JWT(RS256) → 액세스 토큰 (drive 스코프). 실패 시 null.
    private function saAccessToken(): ?string {
        if (self::$saToken !== null) return self::$saToken !== '' ? self::$saToken : null;
        self::$saToken = '';
        if (!$this->cardDriveEnabled()) return null;
        $sa = json_decode((string)file_get_contents(GDRIVE_SA_JSON), true);
        if (!$sa || empty($sa['client_email']) || empty($sa['private_key'])) return null;

        $b64 = fn($x) => rtrim(strtr(base64_encode($x), '+/', '-_'), '=');
        $now = time();
        $signInput = $b64(json_encode(['alg' => 'RS256', 'typ' => 'JWT'])) . '.' .
            $b64(json_encode([
                'iss'   => $sa['client_email'],
                'scope' => 'https://www.googleapis.com/auth/drive',
                'aud'   => $sa['token_uri'] ?? 'https://oauth2.googleapis.com/token',
                'iat'   => $now,
                'exp'   => $now + 3600,
            ]));
        if (!openssl_sign($signInput, $sig, $sa['private_key'], OPENSSL_ALGO_SHA256)) return null;
        $jwt = $signInput . '.' . $b64($sig);

        $ch = curl_init($sa['token_uri'] ?? 'https://oauth2.googleapis.com/token');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true, CURLOPT_POST => true, CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_TIMEOUT => 30,
            CURLOPT_POSTFIELDS => http_build_query([
                'grant_type' => 'urn:ietf:params:oauth:grant-type:jwt-bearer', 'assertion' => $jwt,
            ]),
        ]);
        $res = curl_exec($ch); curl_close($ch);
        $d = json_decode((string)$res, true);
        if (empty($d['access_token'])) return null;
        self::$saToken = $d['access_token'];
        return self::$saToken;
    }

    // Bearer 토큰으로 Drive API 호출 (GET 기본, POST/PATCH 지원). 실패 시 ''.
    private function driveApi(string $url, string $method = 'GET', ?string $body = null): string {
        $tok = $this->saAccessToken();
        if ($tok === null) return '';
        $hdr = ['Authorization: Bearer ' . $tok];
        if ($body !== null) $hdr[] = 'Content-Type: application/json';
        $opt = [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_TIMEOUT        => 60,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_HTTPHEADER     => $hdr,
        ];
        if ($method !== 'GET') $opt[CURLOPT_CUSTOMREQUEST] = $method;
        if ($body !== null)    $opt[CURLOPT_POSTFIELDS]    = $body;
        $ch = curl_init($url);
        curl_setopt_array($ch, $opt);
        $res = curl_exec($ch);
        curl_close($ch);
        return $res === false ? '' : $res;
    }

    // 명함 폴더 안 이미지 목록 ('스캔완료'로 옮긴 파일은 상위폴더가 바뀌어 자동 제외됨)
    private function listCardImages(): array {
        $q = "'" . CONTACT_CARD_DRIVE_FOLDER_ID . "' in parents and mimeType contains 'image/' and trashed=false";
        $files = []; $pageToken = '';
        do {
            $params = [
                'q'        => $q,
                'fields'   => 'nextPageToken,files(id,name,mimeType)',
                'pageSize' => 100,
                'orderBy'  => 'createdTime',
            ];
            if ($pageToken !== '') $params['pageToken'] = $pageToken;
            $json = $this->driveApi('https://www.googleapis.com/drive/v3/files?' . http_build_query($params));
            $data = json_decode($json, true);
            if (isset($data['error'])) {
                throw new RuntimeException('Drive API: ' . ($data['error']['message'] ?? 'unknown'));
            }
            foreach ($data['files'] ?? [] as $f) $files[] = $f;
            $pageToken = $data['nextPageToken'] ?? '';
        } while ($pageToken !== '');
        return $files;
    }

    private function downloadDriveFile(string $fileId): string {
        return $this->driveApi('https://www.googleapis.com/drive/v3/files/' . rawurlencode($fileId) . '?alt=media');
    }

    // '스캔완료' 하위폴더 id (없으면 생성). 실패 시 null.
    private function ensureDoneFolder(): ?string {
        static $doneId = null;
        if ($doneId !== null) return $doneId !== '' ? $doneId : null;
        $doneId = '';
        $parent = CONTACT_CARD_DRIVE_FOLDER_ID;
        $q = rawurlencode("'$parent' in parents and mimeType='application/vnd.google-apps.folder' and name='스캔완료' and trashed=false");
        $data = json_decode($this->driveApi("https://www.googleapis.com/drive/v3/files?q=$q&fields=files(id,name)"), true);
        if (!empty($data['files'][0]['id'])) { $doneId = $data['files'][0]['id']; return $doneId; }
        $body = json_encode(['name' => '스캔완료', 'mimeType' => 'application/vnd.google-apps.folder', 'parents' => [$parent]]);
        $data = json_decode($this->driveApi('https://www.googleapis.com/drive/v3/files?fields=id', 'POST', $body), true);
        if (!empty($data['id'])) { $doneId = $data['id']; return $doneId; }
        return null;
    }

    // 파일을 '스캔완료' 폴더로 이동 (best-effort). 성공 시 true.
    private function moveToDoneFolder(string $fileId, string $newName = ''): bool {
        $done = $this->ensureDoneFolder();
        if (!$done) return false;
        $url = 'https://www.googleapis.com/drive/v3/files/' . rawurlencode($fileId)
             . '?addParents=' . rawurlencode($done)
             . '&removeParents=' . rawurlencode(CONTACT_CARD_DRIVE_FOLDER_ID)
             . '&fields=id';
        $body = ($newName !== '') ? json_encode(['name' => $newName]) : '{}';
        $data = json_decode($this->driveApi($url, 'PATCH', $body), true);
        return !empty($data['id']) && empty($data['error']);
    }

    // 저장 파일명: 업체명_이름_전화번호 (빈 항목은 건너뜀, 원본 확장자 보존)
    private function buildCardFileName(array $d, string $origName): string {
        $san = function ($s) {
            $s = preg_replace('/[\/\\\\\r\n\t]+/', ' ', (string)$s);
            return trim(preg_replace('/\s+/', ' ', $s));
        };
        $parts = array_values(array_filter(
            [$san($d['organization'] ?? ''), $san($d['name'] ?? ''), $san($d['phone'] ?? '')],
            fn($x) => $x !== ''
        ));
        $base = $parts ? implode('_', $parts) : ($san($origName) ?: 'card');
        $ext = '';
        if (preg_match('/\.(jpe?g|png|gif|webp)$/i', $origName, $m)) $ext = $m[0];
        return $base . $ext;
    }

    // Claude Vision 으로 명함 이미지에서 연락처 필드 추출
    private function extractCardWithClaude(string $imageBytes, string $mime): ?array {
        if (!defined('ANTHROPIC_API_KEY') || ANTHROPIC_API_KEY === '') return null;
        if (!in_array($mime, ['image/jpeg', 'image/png', 'image/gif', 'image/webp'], true)) {
            $mime = 'image/jpeg';
        }
        $sys = "너는 명함(business card) 이미지에서 연락처 정보를 추출하는 도우미다. "
             . "반드시 아래 키를 가진 JSON 객체 하나만 출력한다. 설명 문장이나 코드펜스(```)는 절대 쓰지 마라. "
             . "값을 못 찾으면 빈 문자열로 둔다. "
             . "키: name, eng_name, phone, tel, email, organization, department, position, address, website, fax. "
             . "phone=휴대폰번호, tel=유선(사무실)전화, organization=회사/기관명, position=직책. "
             . "한글 이름은 name 에, 영문 이름은 eng_name 에 넣는다.";
        $payload = [
            'model'      => 'claude-haiku-4-5',
            'max_tokens' => 1024,
            'system'     => $sys,
            'messages'   => [[
                'role'    => 'user',
                'content' => [
                    ['type' => 'image', 'source' => ['type' => 'base64', 'media_type' => $mime, 'data' => base64_encode($imageBytes)]],
                    ['type' => 'text', 'text' => '이 명함의 정보를 위 규칙대로 JSON 으로만 출력해줘.'],
                ],
            ]],
        ];
        $ch = curl_init('https://api.anthropic.com/v1/messages');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST           => true,
            CURLOPT_HTTPHEADER     => [
                'x-api-key: ' . ANTHROPIC_API_KEY,
                'anthropic-version: 2023-06-01',
                'content-type: application/json',
            ],
            CURLOPT_POSTFIELDS     => json_encode($payload),
            CURLOPT_TIMEOUT        => 60,
            CURLOPT_SSL_VERIFYPEER => false,
        ]);
        $res  = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        if ($res === false || $code !== 200) return null;

        $data = json_decode($res, true);
        $text = '';
        foreach ($data['content'] ?? [] as $blk) {
            if (($blk['type'] ?? '') === 'text') { $text = (string)($blk['text'] ?? ''); break; }
        }
        if (trim($text) === '') return null;

        $text   = trim($text);
        $text   = preg_replace('/^```(?:json)?\s*|\s*```$/', '', $text);
        $fields = json_decode($text, true);
        if (!is_array($fields) && preg_match('/\{.*\}/s', $text, $m)) {
            $fields = json_decode($m[0], true);
        }
        return is_array($fields) ? $fields : null;
    }

    // 방금 적재/갱신된 연락처 id 찾기 (전화 숫자비교 → 이메일)
    private function findContactIdFor(array $d): ?int {
        $phone = trim($d['phone'] ?? '');
        if ($phone !== '') {
            $pd = preg_replace('/\D+/', '', $phone);
            if ($pd !== '') {
                $st = $this->pdo->prepare(
                    "SELECT id FROM tbl_contact WHERE REGEXP_REPLACE(IFNULL(phone,''), '[^0-9]', '') = :p LIMIT 1"
                );
                $st->execute([':p' => $pd]);
                $id = $st->fetchColumn();
                if ($id) return (int)$id;
            }
        }
        $email = trim($d['email'] ?? '');
        if ($email !== '') {
            $st = $this->pdo->prepare("SELECT id FROM tbl_contact WHERE email = :e LIMIT 1");
            $st->execute([':e' => $email]);
            $id = $st->fetchColumn();
            if ($id) return (int)$id;
        }
        return null;
    }

    // 명함 폴더 스캔 → Vision 추출 → 주소록 적재 → '스캔완료' 폴더로 이동
    // $limit>0 이면 이번 호출에서 최대 그만큼만 새로 처리 (타임아웃 방지, 반복 호출 가능)
    public function scanCardsFromDrive(int $limit = 0): array {
        if (!$this->cardDriveEnabled()) {
            return ['error' => '명함 스캔 설정이 없습니다. (env/gdrive.inc 의 CONTACT_CARD_DRIVE_FOLDER_ID / GDRIVE_SA_JSON)'];
        }
        if (!defined('ANTHROPIC_API_KEY') || ANTHROPIC_API_KEY === '') {
            return ['error' => 'Claude API 키가 없습니다. (env/anthropic.inc 의 ANTHROPIC_API_KEY)'];
        }
        if ($this->saAccessToken() === null) {
            return ['error' => '구글 서비스계정 인증 실패. env/gdrive_sa.json 확인 및 폴더를 SA 이메일에 "편집자"로 공유했는지 확인하세요.'];
        }

        // 스캔 이력 (이동 실패해도 재스캔 방지 — 이중 안전장치)
        $this->pdo->exec("
            CREATE TABLE IF NOT EXISTS tbl_contact_card_scan (
                drive_file_id VARCHAR(120) PRIMARY KEY,
                file_name     VARCHAR(255) DEFAULT NULL,
                contact_id    INT          DEFAULT NULL,
                status        VARCHAR(20)  DEFAULT 'ok',
                scanned_at    DATETIME     DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
        ");

        $images = $this->listCardImages();
        $res = ['total_files' => count($images), 'scanned' => 0, 'imported' => 0,
                'updated' => 0, 'moved' => 0, 'skipped' => 0, 'failed' => 0];

        $chk = $this->pdo->prepare("SELECT 1 FROM tbl_contact_card_scan WHERE drive_file_id = :id");
        $rec = $this->pdo->prepare(
            "INSERT IGNORE INTO tbl_contact_card_scan (drive_file_id, file_name, contact_id, status)
             VALUES (:id, :fn, :cid, :st)"
        );

        $done = 0;
        foreach ($images as $img) {
            $fid = $img['id'] ?? '';
            if ($fid === '') continue;

            $chk->execute([':id' => $fid]);
            if ($chk->fetchColumn()) { $res['skipped']++; continue; }
            if ($limit > 0 && $done >= $limit) break;
            $done++; $res['scanned']++;

            $bytes = $this->downloadDriveFile($fid);
            if ($bytes === '') {
                $rec->execute([':id' => $fid, ':fn' => $img['name'] ?? '', ':cid' => null, ':st' => 'download_fail']);
                $res['failed']++; continue;
            }

            $fields = $this->extractCardWithClaude($bytes, $img['mimeType'] ?? 'image/jpeg');
            if (!$fields || trim($fields['name'] ?? '') === '') {
                $rec->execute([':id' => $fid, ':fn' => $img['name'] ?? '', ':cid' => null, ':st' => 'extract_fail']);
                $res['failed']++; continue;
            }

            $fields['group_name'] = '';                 // 그룹 공란 → '신규'로 적재
            $imp = $this->importRows([$fields]);        // dedup(전화정규화)+기존값 보존 재사용
            $res['imported'] += $imp['imported'];
            $res['updated']  += $imp['updated'];

            $cid   = $this->findContactIdFor($fields);
            $rename = $this->buildCardFileName($fields, $img['name'] ?? '');
            $moved  = $this->moveToDoneFolder($fid, $rename);   // 이름변경+이동(best-effort)
            if ($moved) $res['moved']++;
            $rec->execute([':id' => $fid, ':fn' => $img['name'] ?? '', ':cid' => $cid, ':st' => $moved ? 'ok_moved' : 'ok']);
        }
        return $res;
    }

}

